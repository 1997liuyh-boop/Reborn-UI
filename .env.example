# ============ Docus AI 助手 ============
# 构建期开关:存在即启用助手 UI(实际请求经 server/plugins/ai-provider.ts 走下方端点)
AI_GATEWAY_API_KEY=enabled

# AI 模型服务密钥与端点(OpenAI 兼容格式,baseUrl 需以 /v1 结尾)
# 密钥请勿提交到仓库!本地写入 .env,部署环境通过 GitHub Actions Secrets 注入
NUXT_AI_PROVIDER_API_KEY=your-api-key-here
NUXT_AI_PROVIDER_BASE_URL=https://your-gateway-host/v1

# 可选:运行时覆盖默认模型(默认 deepseek-v4-pro,见 nuxt.config.ts 的 assistant.model)
# NUXT_ASSISTANT_MODEL=deepseek-v4-pro

# ============ 用户登录与聊天记录 ============
# session cookie 加密密钥(≥32 字符随机串)
NUXT_SESSION_PASSWORD=please-generate-a-random-string-of-32-plus-chars
# 飞书开放平台应用凭证(未配置时登录入口自动隐藏;回调地址需登记 {站点}/api/auth/feishu/callback)
NUXT_FEISHU_APP_ID=cli_xxx
NUXT_FEISHU_APP_SECRET=xxx
