<template>
  <view
    v-if="!isHidden"
    class="rb-badge"
    :class="[
      typeClass,
      {
        'rb-badge--rounded': rounded,
        'rb-badge--plain': plain,
      },
      pt.className,
    ]"
  >
    <slot name="icon"></slot>
    <text v-if="icon" class="rb-badge__icon">{{ icon }}</text>

    <text class="rb-badge__text">
      <slot></slot>
    </text>

    <text v-if="closable" class="rb-badge__close" @tap.stop="close">×</text>
  </view>
</template>

<script setup lang="ts">
import { computed, ref, type PropType } from "vue";

defineOptions({
  name: "reborn-badge",
});

const props = defineProps({
  pt: {
    type: Object,
    default: () => ({}),
  },
  type: {
    type: String as PropType<"primary" | "success" | "warn" | "error" | "info" | "neutral">,
    default: "primary",
  },
  icon: {
    type: String,
    default: "",
  },
  rounded: {
    type: Boolean,
    default: false,
  },
  closable: {
    type: Boolean,
    default: false,
  },
  plain: {
    type: Boolean,
    default: false,
  },
});

const emit = defineEmits(["close"]);

const isHidden = ref(false);

const pt = computed(() => props.pt ?? {});
const typeClass = computed(() => `rb-badge--${props.type}`);

function close() {
  isHidden.value = true;
  emit("close");
}
</script>

<style scoped>
.rb-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: #fff;
  background-color: var(--color-primary);
  border: 2rpx solid transparent;
}

.rb-badge__text {
  font-weight: 500;
}

.rb-badge__icon {
  font-size: 22rpx;
}

.rb-badge__close {
  font-size: 24rpx;
  line-height: 1;
}

.rb-badge--rounded {
  border-radius: 9999rpx;
}

.rb-badge--plain {
  background-color: transparent;
  color: var(--color-primary);
  border-color: currentColor;
}

.rb-badge--success {
  background-color: var(--color-success);
}

.rb-badge--warn {
  background-color: var(--color-warning);
}

.rb-badge--error {
  background-color: var(--color-error);
}

.rb-badge--info {
  background-color: var(--color-info);
}

.rb-badge--neutral {
  background-color: var(--color-neutral);
}

.rb-badge--plain.rb-badge--success {
  color: var(--color-success);
}

.rb-badge--plain.rb-badge--warn {
  color: var(--color-warning);
}

.rb-badge--plain.rb-badge--error {
  color: var(--color-error);
}

.rb-badge--plain.rb-badge--info {
  color: var(--color-info);
}

.rb-badge--plain.rb-badge--neutral {
  color: var(--color-neutral);
}
</style>
