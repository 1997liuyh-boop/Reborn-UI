+
+// [Reborn UI 补丁] 代码经 base64url 编码进哈希,与 app/utils/playgroundCode.ts 的格式保持一致
+function runInPlayground() {
+  const bytes = new TextEncoder().encode(trimmedCode.value)
+  let binary = ''
+  bytes.forEach((b) => {
