+// ============ [Reborn UI 补丁] 登录态 + 聊天记录 ============
+interface RebornAuthUser { id: string, name: string, avatar?: string }
+interface RebornConversation { id: string, title: string, updatedAt: string }
+
+const authUser = ref<RebornAuthUser | null>(null)
+const feishuEnabled = ref(false)
