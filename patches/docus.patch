+  try {
+    await $fetch('/api/auth/dev-login', { method: 'POST' })
+    await fetchAuthUser()
+  }
+  catch {
+    toast.add({ description: '本地开发登录失败', icon: 'i-lucide-alert-circle', color: 'error', duration: 4000 })
+  }
+}
+
+// 登录态就绪后补发:未登录期间被拦下的 pending 问题,或上轮以用户消息结尾的续答
