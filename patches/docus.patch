+  if (!authUser.value) return
+  historyList.value = await $fetch<RebornConversation[]>('/api/chat/list').catch(() => [])
+}
+
+// 弹层由 UPopover 触发器自身开合,打开时拉取最新列表
+watch(historyOpen, (open) => {
