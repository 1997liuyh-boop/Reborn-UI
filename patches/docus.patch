+async function openConversation(id: string) {
+  try {
+    const res = await $fetch<{ messages: UIMessage[] }>(`/api/chat/${id}`)
+    chat.stop()
+    chat.messages.length = 0
+    chat.messages.push(...res.messages)
+    messages.value = chat.messages
+    conversationId.value = id
+    historyOpen.value = false
+  }
+  catch { /* 会话可能已删除 */ }
+}
+
+async function removeConversation(id: string) {
+  await $fetch(`/api/chat/${id}`, { method: 'DELETE' }).catch(() => {})
+  historyList.value = historyList.value.filter(c => c.id !== id)
+  if (conversationId.value === id) conversationId.value = undefined
+}
+// ============ [Reborn UI 补丁] 结束 ============
