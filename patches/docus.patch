+const historyList = ref<RebornConversation[]>([])
+const historyOpen = ref(false)
+
+async function fetchAuthUser() {
+  try {
+    const res = await $fetch<{ user: RebornAuthUser | null, feishuEnabled: boolean }>('/api/auth/me')
+    authUser.value = res.user
+    feishuEnabled.value = res.feishuEnabled
+  }
+  catch { /* 接口不可用时静默降级为未登录 */ }
+  finally {
+    authReady.value = true
+  }
+}
+
+/** 服务端已对 AI 端点强制鉴权(server/middleware/ai-guard.ts),前端在发送前同步拦截 */
+function ensureLoggedIn(): boolean {
+  if (authUser.value) return true
+  toast.add({
+    description: 'AI 助手需登录后使用',
+    icon: 'i-lucide-lock',
+    color: 'warning',
+    duration: 4000,
+  })
+  return false
+}
+
+/** 本地开发免飞书凭证的模拟登录(生产构建中 /api/auth/dev-login 返回 404) */
+async function devLogin() {
+  try {
+    await $fetch('/api/auth/dev-login', { method: 'POST' })
+    await fetchAuthUser()
+  }
+  catch {
+    toast.add({ description: '本地开发登录失败', icon: 'i-lucide-alert-circle', color: 'error', duration: 4000 })
+  }
+}
+
+// 登录态就绪后补发:未登录期间被拦下的 pending 问题,或上轮以用户消息结尾的续答
+watch(authUser, (user) => {
+  if (!user) return
+  if (pendingMessage.value) {
+    if (messages.value.length === 0 && chat.messages.length > 0) {
+      chat.messages.length = 0
+    }
+    chat.sendMessage({ text: pendingMessage.value })
+    clearPending()
+  }
+  else if (chat.lastMessage?.role === 'user' && chat.status === 'ready') {
+    chat.regenerate()
+  }
+})
+
+async function saveHistory() {
+  if (!authUser.value || chat.messages.length === 0) return
+  try {
+    const res = await $fetch<{ id: string }>('/api/chat/save', {
+      method: 'POST',
+      body: { conversationId: conversationId.value, messages: chat.messages },
+    })
+    conversationId.value = res.id
+  }
+  catch { /* 保存失败不打断对话 */ }
+}
+
+async function loadHistoryList() {
+  if (!authUser.value) return
+  historyList.value = await $fetch<RebornConversation[]>('/api/chat/list').catch(() => [])
+}
+
+// 弹层由 UPopover 触发器自身开合,打开时拉取最新列表
+watch(historyOpen, (open) => {
+  if (open) loadHistoryList()
