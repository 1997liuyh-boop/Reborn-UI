+async function fetchAuthUser() {
+  try {
+    const res = await $fetch<{ user: RebornAuthUser | null, feishuEnabled: boolean }>('/api/auth/me')
+    authUser.value = res.user
+    feishuEnabled.value = res.feishuEnabled
+  }
+  catch { /* 接口不可用时静默降级为未登录 */ }
+  finally {
+    authReady.value = true
+  }
+}
+
+/** 服务端已对 AI 端点强制鉴权(server/middleware/ai-guard.ts),前端在发送前同步拦截 */
+function ensureLoggedIn(): boolean {
+  if (authUser.value) return true
+  toast.add({
+    description: 'AI 助手需登录后使用',
+    icon: 'i-lucide-lock',
+    color: 'warning',
+    duration: 4000,
+  })
+  return false
+}
+
+/** 本地开发免飞书凭证的模拟登录(生产构建中 /api/auth/dev-login 返回 404) */
