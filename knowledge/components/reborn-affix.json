{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-affix",
  "title": "Affix 悬浮",
  "description": "用于固定悬浮元素并支持拖拽、自动吸附屏幕边缘的跨端悬浮组件。",
  "category": "navigation",
  "tags": [],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "zIndex",
      "type": "number",
      "required": false,
      "description": "浮动元素的层级。",
      "default": "500"
    },
    {
      "name": "size",
      "type": "number",
      "required": false,
      "description": "浮动元素的尺寸（宽/高，单位 px），参与拖拽边界与吸附位置计算。",
      "default": "40"
    },
    {
      "name": "left",
      "type": "number",
      "required": false,
      "description": "初始左边距 (px)。未指定 `right` 时作为水平位置依据。",
      "default": "10"
    },
    {
      "name": "right",
      "type": "number",
      "required": false,
      "description": "初始右边距 (px)。指定后优先级高于 `left`。",
      "default": "undefined"
    },
    {
      "name": "top",
      "type": "number",
      "required": false,
      "description": "初始上边距 (px)。指定后垂直位置按「屏幕高度 − size − top」计算。",
      "default": "undefined"
    },
    {
      "name": "bottom",
      "type": "number",
      "required": false,
      "description": "初始下边距 (px)。未指定 `top` 时作为垂直位置依据。",
      "default": "10"
    },
    {
      "name": "gap",
      "type": "number",
      "required": false,
      "description": "吸附到屏幕边缘后的留边距离 (px)。",
      "default": "10"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用拖拽交互；元素仍会显示。",
      "default": "false"
    },
    {
      "name": "noSnapping",
      "type": "boolean",
      "required": false,
      "description": "是否禁用松手后的自动边缘吸附。",
      "default": "false"
    },
    {
      "name": "safeArea",
      "type": "boolean",
      "required": false,
      "description": "新增：是否考虑安全区域（默认为 true）",
      "default": "true"
    }
  ],
  "events": [],
  "slots": [
    {
      "name": "default",
      "description": "自定义悬浮内容。"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-affix/RebornAffixDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-affix/RebornAffixDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "悬浮球、快捷操作入口需要用户可拖拽调整位置时。",
    "悬浮按钮需要拖到边缘后自动吸附（可用 noSnapping 关闭）时。",
    "刘海屏/底部黑条设备上需要安全区避让（safeArea 默认开启）时。"
  ],
  "whenNotToUse": [
    "固定位置的悬浮操作按钮无需拖拽，改用 reborn-fab。",
    "滚动到阈值后出现的返回顶部按钮，改用 reborn-back-top。",
    "元素滚动吸顶，改用 reborn-sticky。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端可用，依赖 @vueuse/core。",
    "水平定位 right 优先级高于 left；垂直方向未指定 top 时以 bottom（默认 10）为准。",
    "disabled 仅禁用拖拽交互，元素仍会显示。",
    "gap 控制吸附到边缘后的留边距离（默认 10px），size 为浮动元素宽高（默认 40px）。"
  ],
  "dependencies": [
    "@vueuse/core",
    "tailwind-variants"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-affix"
  },
  "sourceRefs": {
