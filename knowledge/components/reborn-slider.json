{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-slider",
  "title": "滑块",
  "description": "用于在数值区间内拖动取值的滑块组件，支持单值与范围两种模式。",
  "category": "form",
  "tags": [
    "css",
    "tailwind",
    "slider",
    "range",
    "uniapp"
  ],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "modelValue",
      "type": "number",
      "required": false,
      "description": "v-model 绑定的值，单值模式使用",
      "default": "0"
    },
    {
      "name": "values",
      "type": "number[]",
      "required": false,
      "description": "v-model:values 绑定的值，范围模式使用",
      "default": "() => [0, 0]"
    },
    {
      "name": "min",
      "type": "number",
      "required": false,
      "description": "最小值",
      "default": "0"
    },
    {
      "name": "max",
      "type": "number",
      "required": false,
      "description": "最大值",
      "default": "100"
    },
    {
      "name": "step",
      "type": "number",
      "required": false,
      "description": "步长",
      "default": "1"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用",
      "default": "false"
    },
    {
      "name": "trackHeight",
      "type": "number",
      "required": false,
      "description": "线的高度",
      "default": "4"
    },
    {
      "name": "showValue",
      "type": "boolean",
      "required": false,
      "description": "是否显示当前值",
      "default": "false"
    },
    {
      "name": "range",
      "type": "boolean",
      "required": false,
      "description": "是否启用范围选择",
      "default": "false"
    },
    {
      "name": "size",
      "type": "typeof sliderSizes[number]",
      "required": false,
      "description": "尺寸",
      "default": "'md'"
    },
    {
      "name": "color",
      "type": "typeof sliderColors[number]",
      "required": false,
      "description": "颜色",
      "default": "'primary'"
    },
    {
      "name": "ui",
      "type": "Partial<{\n    wrapper: ClassValue\n    inner: ClassValue\n    picker: ClassValue\n    track: ClassValue\n    progress: ClassValue\n    thumb: ClassValue\n    thumbActive: ClassValue\n    value: ClassValue\n  }>",
      "required": false,
      "description": "样式覆盖",
      "default": "() => ({})"
    },
    {
      "name": "customClass",
      "type": "any",
      "required": false,
      "description": "自定义 class"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "追加到根节点的自定义类名"
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "description": "单值变化。"
    },
    {
      "name": "update:values",
      "description": "范围值变化。"
    },
    {
      "name": "change",
      "description": "拖拽结束后的最终值。"
    },
    {
      "name": "changing",
      "description": "拖拽中的实时值。"
    }
  ],
  "slots": [
    {
      "name": "thumb",
      "description": "自定义滑块本体（单值模式生效），需将 `value.style` 应用到自定义节点以保持定位。"
    },
    {
      "name": "value",
      "description": "自定义数值显示，`value` 为当前值文本（范围模式为 `起 - 止`）。"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-slider/RebornSliderDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-slider/RebornSliderDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "音量、进度、价格等连续数值的调节，需要 min / max / step 控制取值。",
    "区间筛选场景：开启 range 并用 v-model:values 绑定 [起, 止] 数组。",
    "需要展示当前值（showValue）或用 thumb / value 插槽自定义滑块与数值显示。"
  ],
  "whenNotToUse": [
    "人机滑动验证改用 reborn-slide-verify（仅 uniapp）。",
    "需要精确键入数字改用 reborn-input-number。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端均可用。",
    "单值模式用 v-model，范围模式必须同时设置 range=true 并改用 v-model:values 绑定数组。",
    "除 update:modelValue / update:values 外还提供 change 与 changing 两个事件，回调值为数值或数组。"
  ],
  "dependencies": [
    "clsx"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-slider"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-slider/RebornSlider.vue",
      "app/components/reborn/ui/reborn-slider/index.ts",
      "app/components/reborn/ui/reborn-slider/reborn-slider.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-slider/RebornSlider.vue",
      "packages/uniapp-project/src/components/reborn-slider/index.ts",
      "packages/uniapp-project/src/components/reborn-slider/reborn-slider.config.ts"
    ]
  },
  "docPath": "content/2.components/input-and-forms/reborn-slider.md",
