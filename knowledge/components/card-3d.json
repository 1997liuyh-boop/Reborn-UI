{
  "$schema": "../schema/component.schema.json",
  "id": "card-3d",
  "title": "3D 卡片效果",
  "description": "用于悬停时随鼠标产生透视倾斜、子元素分层浮起的 3D 卡片组件。",
  "category": "data-display",
  "tags": [
    "css",
    "tailwind",
    "card",
    "aceternity-ui"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "class",
      "type": "string",
      "required": false,
      "description": "用于内层容器的额外样式类。",
      "default": "null"
    },
    {
      "name": "containerClass",
      "type": "string",
      "required": false,
      "description": "用于外层容器的额外样式类。",
      "default": "null"
    },
    {
      "name": "as",
      "type": "string",
      "required": false,
      "description": "渲染该元素使用的 HTML 标签或组件。",
      "default": "\"div\""
    },
    {
      "name": "translateX",
      "type": "number",
      "required": false,
      "description": "X 轴平移（像素）。",
      "default": "0"
    },
    {
      "name": "translateY",
      "type": "number",
      "required": false,
      "description": "Y 轴平移（像素）。",
      "default": "0"
    },
    {
      "name": "translateZ",
      "type": "number",
      "required": false,
      "description": "Z 轴平移（像素），用于控制纵深效果。",
      "default": "0"
    },
    {
      "name": "rotateX",
      "type": "number",
      "required": false,
      "description": "绕 X 轴旋转角度（度）。",
      "default": "0"
    },
    {
      "name": "rotateY",
      "type": "number",
      "required": false,
      "description": "绕 Y 轴旋转角度（度）。",
      "default": "0"
    },
    {
      "name": "rotateZ",
      "type": "number",
      "required": false,
      "description": "绕 Z 轴旋转角度（度）。",
      "default": "0"
    }
  ],
  "events": [],
  "slots": [
    {
      "name": "default",
      "description": ""
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/card-3d/CardDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "产品展示卡需要鼠标跟随的 3D 透视交互。",
    "卡片内标题、图片、按钮需要不同 translateZ 纵深分层浮起的场景。",
    "落地页需要强交互感的重点卡片。"
  ],
  "whenNotToUse": [
    "只需悬停高光光泽，改用 glare-card。",
    "需要正反面翻转展示内容，改用 flip-card。",
    "根据鼠标进入方向显示覆盖层，改用 direction-aware-hover。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "必须按 CardContainer > CardBody > CardItem 三层结构组合使用，单独使用无效。",
    "translateX/Y/Z 与 rotateX/Y/Z 是 CardItem 的 props，控制该元素悬停时的位移与旋转；translateZ 越大浮起越明显。",
    "CardItem 的 as prop 可改渲染标签（如 a、button、p），默认 div。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add card-3d"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/card-3d/CardBody.vue",
      "app/components/reborn/ui/card-3d/CardContainer.vue",
      "app/components/reborn/ui/card-3d/CardItem.vue",
      "app/components/reborn/ui/card-3d/index.ts",
      "app/components/reborn/ui/card-3d/useMouseState.ts"
    ]
  },
