      "name": "defaultValue",
      "type": "string | number",
      "required": false,
      "description": "非受控模式下的初始值，未绑定 v-model 时生效"
    },
    {
      "name": "modelValue",
      "type": "string | number",
      "required": false,
      "description": "输入框绑定值（v-model）"
    },
    {
      "name": "class",
      "type": "HTMLAttributes[\"class\"]",
      "required": false,
      "description": "输入框本体的额外 CSS 类。"
    },
    {
      "name": "containerClass",
      "type": "HTMLAttributes[\"class\"]",
      "required": false,
      "description": "外层渐变容器的额外 CSS 类，宽度等布局类通常设在此。"
    }
  ],
  "events": [
