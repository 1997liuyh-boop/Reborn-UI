  "related": [],
  "whenToUse": [
    "登录、注册等营销感较强的表单需要悬停高亮输入框时。",
    "web 落地页表单想要跟随鼠标的径向边框效果时。"
  ],
  "whenNotToUse": [
    "常规业务表单或跨端场景，改用 reborn-input。",
    "需要占位文字消失动画的搜索框，改用 vanishing-input。",
    "多行文本输入，改用 reborn-textarea。"
  ],
  "pitfalls": [
    "仅 web 端可用，依赖 @vueuse/core。",
    "组件名为 IInput（文件 IInput.vue），与 reborn-input 不是同一组件。",
    "样式分两层：class 作用于输入框本体，containerClass 作用于外层容器（宽度通常设在 containerClass 上）。"
  ],
  "dependencies": [
    "@vueuse/core"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add input"
  },
