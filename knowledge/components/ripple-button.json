{
  "$schema": "../schema/component.schema.json",
  "id": "ripple-button",
  "title": "波纹按钮",
  "description": "用于点击时产生可自定义颜色与时长波纹反馈的按钮组件。",
  "category": "basic",
  "tags": [
    "css",
    "tailwind",
    "button",
    "magic-ui"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "class",
      "type": "HTMLAttributes[\"class\"]",
      "required": false,
      "description": "用于自定义样式的额外 CSS 类。"
    },
    {
      "name": "rippleColor",
      "type": "string",
      "required": false,
      "description": "波纹效果的颜色。",
      "default": "\"#ADD8E6\""
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "description": "波纹动画的持续时间（毫秒）。",
      "default": "600"
    }
  ],
  "events": [
    {
      "name": "click",
      "payload": "(e: \"click\", event: MouseEvent): void;",
      "description": "点击事件"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": ""
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "code": "<template>\n  <div class=\"grid place-content-center p-8\">\n    <RippleButton> Click me! </RippleButton>\n  </div>\n</template>\n",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "落地页 CTA 需要点击波纹反馈动效时。",
    "需要 Material 风格点击涟漪的按钮。",
    "需要自定义波纹颜色（rippleColor）与动画时长的营销按钮。"
  ],
  "whenNotToUse": [
    "常规业务表单按钮，改用 reborn-button（同时支持 web 与 uniapp）。",
    "需要持续闪光动画吸引注意，改用 shimmer-button。",
    "需要渐变边框动效，改用 gradient-button。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "duration 单位为毫秒（默认 600），控制波纹扩散时长。",
    "波纹默认颜色为 #ADD8E6，深色背景下需自行调整 rippleColor。",
    "按钮内容通过默认插槽传入，点击通过 click 事件监听。"
  ],
