  "whenToUse": [
    "正面放图片、背面放说明文字的双面信息卡。",
    "团队成员、产品简介等需要翻面查看详情的卡片。"
  ],
  "whenNotToUse": [
    "需要鼠标跟随的 3D 透视浮起，改用 card-3d。",
    "文字悬停揭示效果，改用 text-reveal-card。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "正面内容放默认插槽，背面内容放 back 插槽。",
    "rotate 仅接受 \"x\" 或 \"y\"（默认 \"y\"），决定翻转轴向。"
