{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-page",
  "title": "页面容器 Page",
  "description": "用于 uniapp 页面最外层的页面容器组件，可配置页面标题与描述文案。",
  "category": "layout",
  "tags": [
    "uniapp",
    "layout",
    "page"
  ],
  "platforms": [
    "uniapp"
  ],
  "props": [
    {
      "name": "title",
      "type": "string",
      "default": "''",
      "required": false,
      "description": "页面标题，渲染在默认头部区域"
    },
    {
      "name": "description",
      "type": "string",
      "default": "''",
      "required": false,
      "description": "页面描述文案，渲染在标题下方"
    },
    {
      "name": "customClass",
      "type": "string",
      "default": "''",
      "required": false,
      "description": "追加到页面根容器的自定义类名"
    },
    {
      "name": "ui",
      "type": "PageUI",
      "default": "() => ({})",
      "required": false,
      "description": "分区样式覆盖对象，键位见下方 PageUI 键位表"
    }
  ],
  "events": [],
  "slots": [
    {
      "name": "header",
      "description": "自定义页面头部区域，提供后完全替换默认的标题/描述渲染"
    },
    {
      "name": "default",
      "description": "页面主体内容（body 区域）"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-page/RebornPageDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-page/RebornPageDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [
    "reborn-toast"
  ],
  "whenToUse": [
    "uniapp 页面需要统一的根容器与页面级结构时。",
    "需要通过 header 插槽自定义页面头部区域时。",
    "需要展示页面标题（title）与描述（description）文案时。"
  ],
  "whenNotToUse": [
    "web 端页面主体布局改用 reborn-main。",
    "普通内容分区容器（web）改用 reborn-container。"
  ],
  "pitfalls": [
    "仅 uniapp 端可用。",
    "接口仅含 title/description/customClass/ui 四个 props 与 header/default 两个插槽，无事件。",
    "知识条目暂无示例与详细描述，复杂用法需参考源码。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-page"
  },
