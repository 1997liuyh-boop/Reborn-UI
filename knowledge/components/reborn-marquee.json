{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-marquee",
  "title": "跑马灯",
  "description": "用于横向或纵向无限循环滚动内容的跑马灯组件，支持悬停暂停与渐隐遮罩。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind",
    "magic-ui"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "应用于根容器的自定义类名。",
      "default": "''"
    },
    {
      "name": "reverse",
      "type": "boolean",
      "required": false,
      "description": "反转滚动方向。",
      "default": "false"
    },
    {
      "name": "pauseOnHover",
      "type": "boolean",
      "required": false,
      "description": "鼠标悬停时暂停动画。",
      "default": "false"
    },
    {
      "name": "vertical",
      "type": "boolean",
      "required": false,
      "description": "orientation=\"vertical\"` 的兼容别名，传入后优先生效。",
      "default": "false"
    },
    {
      "name": "orientation",
      "type": "RebornMarqueeOrientation",
      "required": false,
      "description": "设置滚动方向。",
      "default": "'horizontal'"
    },
    {
      "name": "repeat",
      "type": "number",
      "required": false,
      "description": "重复渲染插槽内容的次数。",
      "default": "4"
    },
    {
      "name": "overlay",
      "type": "boolean",
      "required": false,
      "description": "是否显示两端的渐隐遮罩。",
      "default": "true"
    },
    {
      "name": "ui",
      "type": "RebornMarqueeUI",
      "required": false,
      "description": "覆盖 `root`、`content`、`overlayStart`、`overlayEnd` 等插槽类名。",
      "default": "() => ({})"
    }
  ],
