{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-waterfall",
  "title": "Waterfall 瀑布流",
  "description": "用于 uniapp 中按列分流渲染瀑布流布局的容器组件，数据经实例方法维护、每项由 item 插槽渲染。",
  "category": "layout",
  "tags": [
    "uniapp",
    "waterfall",
    "layout",
    "list"
  ],
  "platforms": [
    "uniapp"
  ],
  "props": [
    {
      "name": "ui",
      "type": "any",
      "required": false,
      "description": "按内部结构键覆盖类名，见下方「自定义样式（ui）」。",
      "default": "() => ({})"
    },
    {
      "name": "customClass",
      "type": "string",
      "required": false,
      "description": "追加到根容器的自定义类名。"
    },
    {
      "name": "column",
      "type": "number",
      "required": false,
      "description": "瀑布流列数，默认为2列",
      "default": "2"
    },
    {
      "name": "gutter",
      "type": "number",
      "required": false,
      "description": "列间距，单位为px",
      "default": "16"
    },
    {
      "name": "nodeKey",
      "type": "string",
      "required": false,
      "description": "数据项的唯一标识字段名，默认为\"id\"",
      "default": "\"id\""
    }
  ],
  "events": [],
  "slots": [
    {
      "name": "item",
      "props": "",
      "description": "渲染单个瀑布流条目，`item` 为数据对象，`index` 为其在所在列中的索引。"
    }
  ],
