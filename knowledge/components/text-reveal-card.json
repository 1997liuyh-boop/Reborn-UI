  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "code": "<template>\n  <DemoSection\n    title=\"基础用法\"\n    description=\"卡片自己带深色表面；文案是效果的一部分。\"\n  >\n    <DemoBlock layout=\"stack\">\n      <TextRevealCard class=\"mx-auto\">\n        <template #header>\n          <h2 class=\"mb-2 text-lg font-semibold text-white\">文字揭示</h2>\n          <p class=\"text-gray-6 text-sm\">把鼠标移到文字上，看看藏着什么。</p>\n        </template>\n        <template #text>\n          <p class=\"bg-[#323238] bg-clip-text py-4 text-sm font-bold text-transparent sm:py-6 sm:text-3xl md:py-10 md:text-[3rem]\">\n            准备好看见被藏起来的东西\n          </p>\n        </template>\n        <template #revealText>\n          <p\n            :style=\"{\n              textShadow: '4px 4px 15px rgba(0,0,0,0.5)',\n            }\"\n            class=\"bg-linear-to-b from-white to-neutral-300 bg-clip-text py-4 text-sm font-bold text-white sm:py-6 sm:text-3xl md:py-10 md:text-[3rem]\"\n          >\n            光会揭开影子藏住的东西\n          </p>\n        </template>\n      </TextRevealCard>\n      <TextRevealCard\n        :stars-count=\"500\"\n        stars-class=\"bg-red-500\"\n        class=\"mx-auto\"\n      >\n        <template #header>\n          <h2 class=\"mb-2 text-3xl font-semibold\">文字揭示</h2>\n          <p class=\"text-gray-6 text-sm\">把鼠标移到文字上，看看藏着什么。</p>\n        </template>\n        <template #text>\n          <p class=\"text-white\">\n            揭示动画会把藏起来的内容慢慢展开，增强交互感。可以由滚动、点击或进入视口触发。\n          </p>\n        </template>\n        <template #revealText>\n          <p class=\"text-red-500\">\n            揭示动画会把藏起来的内容慢慢展开，增强交互感。可以由滚动、点击或进入视口触发。\n          </p>\n        </template>\n      </TextRevealCard>\n    </DemoBlock>\n  </DemoSection>\n</template>\n",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "深色卡片内做「滑动揭示隐藏文案」的互动彩蛋。",
    "两段文案的前后对比展示（如乱码与原文、暗示与答案）。"
  ],
  "whenNotToUse": [
    "大面积双层内容的鼠标遮罩揭示，改用 svg-mask。",
    "刮开涂层式互动，改用 scratch-to-reveal。",
    "单段文字的悬停描边效果，改用 text-hover-effect。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "内容需分别放入 text（默认显示）与 revealText（揭示后显示）具名插槽，另有 header 插槽放标题区。",
    "starsCount 控制漂浮星星数量（默认 130），starsClass 自定义星星样式。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add text-reveal-card"
