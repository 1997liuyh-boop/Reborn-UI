{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-text",
  "title": "文本 Text",
  "description": "用于展示文本并内置类型格式化、脱敏与多行省略的增强文本组件。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind",
    "text",
    "format",
    "mask",
    "uniapp"
  ],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "ui",
      "type": "{\n    base: string\n  }",
      "required": false,
      "description": "透传样式",
      "default": "() => ({\n    base: '',\n  })"
    },
    {
      "name": "customClass",
      "type": "string",
      "required": false,
      "description": "",
      "default": "''"
    },
    {
      "name": "color",
      "type": "'primary' | 'secondary' | 'success' | 'info' | 'warning' | 'error' | 'neutral'",
      "required": false,
      "description": "文本颜色",
      "options": [
        "primary",
        "secondary",
        "success",
        "info",
        "warning",
        "error",
        "neutral"
      ]
    },
    {
      "name": "size",
      "type": "number",
      "required": false,
      "description": "字体大小"
    },
    {
      "name": "value",
      "type": "string | number | null",
      "required": false,
      "description": "显示的值",
      "default": "null"
    },
    {
      "name": "type",
      "type": "string",
      "required": false,
      "description": "文本类型",
      "default": "'default'"
    },
    {
      "name": "mask",
      "type": "boolean",
      "required": false,
      "description": "是否开启脱敏/加密",
      "default": "false"
    },
    {
      "name": "currency",
      "type": "string",
      "required": false,
      "description": "金额货币符号",
      "default": "'¥'"
    },
    {
      "name": "precision",
      "type": "number",
      "required": false,
      "description": "金额小数位数",
      "default": "2"
    },
    {
      "name": "maskStart",
      "type": "number",
      "required": false,
      "description": "脱敏起始位置",
      "default": "3"
    },
    {
      "name": "maskEnd",
      "type": "number",
      "required": false,
      "description": "脱敏结束位置",
      "default": "4"
    },
    {
      "name": "maskChar",
      "type": "string",
      "required": false,
      "description": "脱敏替换字符",
      "default": "'*'"
    },
    {
      "name": "ellipsis",
      "type": "boolean",
      "required": false,
      "description": "是否省略号",
      "default": "false"
    },
    {
      "name": "lines",
      "type": "number",
      "required": false,
      "description": "最大行数，仅在ellipsis时生效",
      "default": "1"
    },
    {
      "name": "selectable",
      "type": "boolean",
      "required": false,
      "description": "是否可选择",
      "default": "false"
    },
    {
      "name": "space",
      "type": "string",
      "required": false,
      "description": "显示连续空格",
      "default": "''"
    },
    {
      "name": "decode",
      "type": "boolean",
      "required": false,
      "description": "是否解码 (app平台如需解析字符实体，需要配置为 true)",
      "default": "false"
    },
    {
      "name": "preWrap",
      "type": "boolean",
      "required": false,
      "description": "是否保留单词",
      "default": "false"
    },
    {
      "name": "currencyPosition",
      "type": "\"before\" | \"after\"",
      "required": false,
      "description": "货币符号位置"
    },
    {
      "name": "tooltip",
      "type": "boolean",
      "required": false,
      "description": "是否开启 Tooltip (自动检测省略并显示)",
      "default": "false"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": ""
    },
    {
      "name": "thousandsIcon",
      "type": "string",
      "required": false,
      "description": "是否开启千分位符"
    }
  ],
  "events": [],
  "slots": [
    {
      "name": "default",
      "description": ""
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-text/RebornTextDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-text/RebornTextDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [
    "reborn-tooltip"
  ],
  "whenToUse": [
    "手机号、姓名、卡号、邮箱等敏感信息脱敏展示（type + mask，可配 maskStart / maskEnd / maskChar）。",
    "金额格式化展示（type='amount'，currency 符号与 precision 小数位）。",
    "长文本多行省略（ellipsis + lines）。"
  ],
  "whenNotToUse": [
    "需要用户输入文本改用 reborn-input 或 reborn-textarea。",
    "打字机等文字动画效果改用 reborn-typewriter（仅 web）。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端均可用。",
    "脱敏与格式化基于 value prop 与 type（default / phone / name / amount / card / email），mask 默认 false 需显式开启。",
    "ellipsis 生效时由 lines 控制最大行数，默认 1 行。",
    "selectable / space / decode 等属性对应 uniapp text 原生能力。"
  ],
  "dependencies": [
    "clsx"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-text"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-text/RebornText.vue",
      "app/components/reborn/ui/reborn-text/index.ts",
      "app/components/reborn/ui/reborn-text/reborn-text.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-text/RebornText.vue",
      "packages/uniapp-project/src/components/reborn-text/reborn-text.config.ts"
    ]
  },
  "docPath": "content/2.components/miscellaneous/reborn-text.md",
  "_meta": {
