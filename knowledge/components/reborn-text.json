  "examples": [
    {
      "title": "Web 演示",
      "code": "<script setup lang=\"ts\">\nimport RebornText from \"~/components/reborn/ui/reborn-text/RebornText.vue\";\nimport { textColors } from \"~/components/reborn/ui/reborn-text/reborn-text.config\";\n\nconst color = ref<any>(\"primary\");\n</script>\n\n<template>\n    <div class=\"flex w-full flex-col gap-10\">\n        <div\n            class=\"flex flex-wrap items-center gap-6 rounded-lg border bg-gray-50/60 p-4 dark:border-gray-800 dark:bg-gray-900/40\">\n            <div class=\"flex items-center gap-2\">\n                <span class=\"text-sm font-medium text-gray-500 dark:text-gray-400\">颜色</span>\n                <USelect v-model=\"color\" :items=\"[...textColors]\" class=\"w-28\" />\n            </div>\n        </div>\n\n        <div class=\"grid gap-8\">\n            <div class=\"space-y-4\">\n                <h3 class=\"text-base font-medium text-gray-400 dark:text-gray-500\">颜色</h3>\n                <div class=\"flex flex-wrap gap-4\">\n                    <RebornText v-for=\"c in textColors\" :key=\"c\" :color=\"c\">{{ c }}</RebornText>\n                </div>\n            </div>\n\n            <div class=\"space-y-4\">\n                <h3 class=\"text-base font-medium text-gray-400 dark:text-gray-500\">文本格式化</h3>\n                <div class=\"grid gap-3 md:grid-cols-2\">\n                    <div class=\"space-y-1\">\n                        <span class=\"text-xs text-gray-400\">手机号脱敏</span>\n                        <div>\n                            <RebornText :color=\"color\" type=\"phone\" value=\"13812345678\" mask />\n                        </div>\n                    </div>\n                    <div class=\"space-y-1\">\n                        <span class=\"text-xs text-gray-400\">姓名脱敏</span>\n                        <div>\n                            <RebornText :color=\"color\" type=\"name\" value=\"张三丰\" mask />\n                        </div>\n                    </div>\n                    <div class=\"space-y-1\">\n                        <span class=\"text-xs text-gray-400\">金额</span>\n                        <div>\n                            <RebornText :color=\"color\" type=\"amount\" :value=\"12345.6\" />\n                        </div>\n                    </div>\n                    <div class=\"space-y-1\">\n                        <span class=\"text-xs text-gray-400\">银行卡脱敏</span>\n                        <div>\n                            <RebornText :color=\"color\" type=\"card\" value=\"6222021234567890\" mask />\n                        </div>\n                    </div>\n                    <div class=\"space-y-1\">\n                        <span class=\"text-xs text-gray-400\">邮箱脱敏</span>\n                        <div>\n                            <RebornText :color=\"color\" type=\"email\" value=\"hello@example.com\" mask />\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"space-y-4\">\n                <h3 class=\"text-base font-medium text-gray-400 dark:text-gray-500\">自动气泡提示 (Tooltip)</h3>\n                <div class=\"grid gap-6\">\n                    <div class=\"flex flex-col gap-1\">\n                        <span class=\"text-xs text-gray-400\">单行省略 + Tooltip</span>\n                        <RebornText :color=\"color\" ellipsis tooltip class=\"max-w-[100px]\">\n                            这是一段很长的单行文本内容，超出会显示省略号和气泡\n                        </RebornText>\n                    </div>\n                    <div class=\"flex flex-col gap-1\">\n                        <span class=\"text-xs text-gray-400\">单行未省略 (无 Tooltip)</span>\n                        <RebornText :color=\"color\" ellipsis tooltip class=\"max-w-[200px]\">\n                            短文本\n                        </RebornText>\n                    </div>\n                    <div class=\"flex flex-col gap-1\">\n                        <span class=\"text-xs text-gray-400\">多行省略 + Tooltip</span>\n                        <RebornText :color=\"color\" ellipsis :lines=\"2\" tooltip class=\"max-w-xs\">\n                            这是一段很长的文本内容，用于测试多行文本省略且显示 Tooltip\n                            功能。当内容超出指定行数时，会显示省略号并显示 Tooltip。这是一段延伸内容，确保一定会超出两行显示。\n                        </RebornText>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</template>\n",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "code": "<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport RebornCard from '@/components/reborn-card/RebornCard.vue'\nimport RebornPage from '@/components/reborn-page/RebornPage.vue'\nimport { textColors } from '@/components/reborn-text/reborn-text.config'\nimport RebornText from '@/components/reborn-text/RebornText.vue'\n\nconst lines = ref([\n  '《游子吟》',\n  '慈母手中线，',\n  '游子身上衣。',\n  '临行密密缝，',\n  '意恐迟迟归。',\n  '谁言寸草心，',\n  '报得三春晖。',\n])\n</script>\n\n<template>\n  <RebornPage title=\"Text 文本\" description=\"文本组件，支持多种文本类型展示，包括手机号、金额、内容超出省略等功能，并提供数据脱敏能力\">\n    <RebornCard title=\"基本用法\" custom-class=\"space-y-4\">\n      <RebornText>\n        春江花月夜\n      </RebornText>\n    </RebornCard>\n\n    <RebornCard title=\"基本用法\" custom-class=\"space-y-4\">\n      <RebornText v-for=\"(item, index) in lines\" :key=\"index\" :ui=\"{ base: 'block' }\" :color=\"textColors[index]\">\n        {{ item }}\n      </RebornText>\n    </RebornCard>\n\n    <RebornCard title=\"省略号\" custom-class=\"space-y-4\">\n      <RebornText ellipsis>\n        夫以铜为镜，可以正衣冠；以史为镜，可以知兴替；以人为镜，可以明得失。朕尝保此三镜，以防己过。今魏徵殂逝，遂亡一镜矣\n      </RebornText>\n    </RebornCard>\n\n    <RebornCard title=\"多行省略号\" custom-class=\"space-y-4\">\n      <RebornText ellipsis :lines=\"2\">\n        夫以铜为镜，可以正衣冠；以史为镜，可以知兴替；以人为镜，可以明得失。朕尝保此三镜，以防己过。今魏徵殂逝，遂亡一镜矣\n      </RebornText>\n    </RebornCard>\n\n    <RebornCard title=\"金额\" custom-class=\"space-y-4\">\n      <RebornText :value=\"123456789.123456789\" :precision=\"2\" currency=\"¥\" type=\"amount\" />\n    </RebornCard>\n\n    <RebornCard title=\"手机号脱敏\" custom-class=\"space-y-4\">\n      <RebornText type=\"phone\" mask value=\"13800138000\" />\n    </RebornCard>\n\n    <RebornCard title=\"姓名脱敏\" custom-class=\"space-y-4\">\n      <RebornText type=\"name\" mask value=\"张三\" />\n    </RebornCard>\n\n    <RebornCard title=\"银行卡脱敏\" custom-class=\"space-y-4\">\n      <RebornText type=\"card\" mask value=\"6222021234567890123\" />\n    </RebornCard>\n\n    <RebornCard title=\"邮箱脱敏\" custom-class=\"space-y-4\">\n      <RebornText type=\"email\" mask value=\"example@example.com\" />\n    </RebornCard>\n\n    <RebornCard title=\"自定义脱敏字符\" custom-class=\"space-y-4\">\n      <RebornText type=\"phone\" value=\"13800138000\" mask mask-char=\"#\" />\n    </RebornCard>\n  </RebornPage>\n</template>\n\n<style lang=\"scss\" scoped></style>\n",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [
