  "examples": [
    {
      "title": "Web 演示",
      "code": "<script setup lang=\"ts\">\r\nimport RebornText from \"~/components/reborn/ui/reborn-text/RebornText.vue\";\r\nimport { textColors } from \"~/components/reborn/ui/reborn-text/reborn-text.config\";\r\n\r\nconst color = ref<any>(\"primary\");\r\n</script>\r\n\r\n<template>\r\n    <div class=\"flex w-full flex-col gap-10\">\r\n        <div\r\n            class=\"flex flex-wrap items-center gap-6 rounded-lg border bg-gray-50/60 p-4 dark:border-gray-800 dark:bg-gray-900/40\">\r\n            <div class=\"flex items-center gap-2\">\r\n                <span class=\"text-sm font-medium text-gray-500 dark:text-gray-400\">颜色</span>\r\n                <USelect v-model=\"color\" :items=\"[...textColors]\" class=\"w-28\" />\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"grid gap-8\">\r\n            <div class=\"space-y-4\">\r\n                <h3 class=\"text-base font-medium text-gray-400 dark:text-gray-500\">颜色</h3>\r\n                <div class=\"flex flex-wrap gap-4\">\r\n                    <RebornText v-for=\"c in textColors\" :key=\"c\" :color=\"c\">{{ c }}</RebornText>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"space-y-4\">\r\n                <h3 class=\"text-base font-medium text-gray-400 dark:text-gray-500\">文本格式化</h3>\r\n                <div class=\"grid gap-3 md:grid-cols-2\">\r\n                    <div class=\"space-y-1\">\r\n                        <span class=\"text-xs text-gray-400\">手机号脱敏</span>\r\n                        <div>\r\n                            <RebornText :color=\"color\" type=\"phone\" value=\"13812345678\" mask />\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"space-y-1\">\r\n                        <span class=\"text-xs text-gray-400\">姓名脱敏</span>\r\n                        <div>\r\n                            <RebornText :color=\"color\" type=\"name\" value=\"张三丰\" mask />\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"space-y-1\">\r\n                        <span class=\"text-xs text-gray-400\">金额</span>\r\n                        <div>\r\n                            <RebornText :color=\"color\" type=\"amount\" :value=\"12345.6\" />\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"space-y-1\">\r\n                        <span class=\"text-xs text-gray-400\">银行卡脱敏</span>\r\n                        <div>\r\n                            <RebornText :color=\"color\" type=\"card\" value=\"6222021234567890\" mask />\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"space-y-1\">\r\n                        <span class=\"text-xs text-gray-400\">邮箱脱敏</span>\r\n                        <div>\r\n                            <RebornText :color=\"color\" type=\"email\" value=\"hello@example.com\" mask />\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"space-y-4\">\r\n                <h3 class=\"text-base font-medium text-gray-400 dark:text-gray-500\">自动气泡提示 (Tooltip)</h3>\r\n                <div class=\"grid gap-6\">\r\n                    <div class=\"flex flex-col gap-1\">\r\n                        <span class=\"text-xs text-gray-400\">单行省略 + Tooltip</span>\r\n                        <RebornText :color=\"color\" ellipsis tooltip class=\"max-w-[100px]\">\r\n                            这是一段很长的单行文本内容，超出会显示省略号和气泡\r\n                        </RebornText>\r\n                    </div>\r\n                    <div class=\"flex flex-col gap-1\">\r\n                        <span class=\"text-xs text-gray-400\">单行未省略 (无 Tooltip)</span>\r\n                        <RebornText :color=\"color\" ellipsis tooltip class=\"max-w-[200px]\">\r\n                            短文本\r\n                        </RebornText>\r\n                    </div>\r\n                    <div class=\"flex flex-col gap-1\">\r\n                        <span class=\"text-xs text-gray-400\">多行省略 + Tooltip</span>\r\n                        <RebornText :color=\"color\" ellipsis :lines=\"2\" tooltip class=\"max-w-xs\">\r\n                            这是一段很长的文本内容，用于测试多行文本省略且显示 Tooltip\r\n                            功能。当内容超出指定行数时，会显示省略号并显示 Tooltip。这是一段延伸内容，确保一定会超出两行显示。\r\n                        </RebornText>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</template>\r\n",
