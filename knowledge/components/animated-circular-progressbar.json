  "examples": [
    {
      "title": "Web 演示",
      "code": "<script setup lang=\"ts\">\r\nimport { onBeforeUnmount, onMounted, ref } from \"vue\";\r\n\r\nconst value = ref(0);\r\n\r\nfunction handleIncrement(prev: number) {\r\n  return prev === 100 ? 0 : prev + 10;\r\n}\r\n\r\nlet interval: ReturnType<typeof setInterval>;\r\n\r\nonMounted(() => {\r\n  value.value = handleIncrement(value.value);\r\n  interval = setInterval(() => {\r\n    value.value = handleIncrement(value.value);\r\n  }, 2000);\r\n});\r\n\r\nonBeforeUnmount(() => {\r\n  if (interval) {\r\n    clearInterval(interval);\r\n  }\r\n});\r\n</script>\r\n\r\n<template>\r\n  <div class=\"flex items-center justify-center py-1\">\r\n    <AnimatedCircularProgressBar\r\n      :max=\"100\"\r\n      :min=\"0\"\r\n      :value=\"value\"\r\n    />\r\n  </div>\r\n</template>\r\n",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "展示任务完成度、下载或上传进度。",
    "仪表盘中展示指标占比，数值变化时需要平滑动画。",
    "需要在圆环中心直接显示百分比数字的场景。"
  ],
  "whenNotToUse": [
    "需要用户拖动改变数值的输入场景，改用 balance-slider 等表单组件。",
    "静态展示一个数字即可时，无需引入动画进度条。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "duration 单位为秒（默认 1），与其他组件的毫秒单位不同。"
  ],
