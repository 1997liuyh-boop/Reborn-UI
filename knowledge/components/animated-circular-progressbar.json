  "examples": [
    {
      "title": "Web 演示",
      "code": "<script setup lang=\"ts\">\nimport { onBeforeUnmount, onMounted, ref } from \"vue\";\n\nconst value = ref(0);\n\nfunction handleIncrement(prev: number) {\n  return prev === 100 ? 0 : prev + 10;\n}\n\nlet interval: ReturnType<typeof setInterval>;\n\nonMounted(() => {\n  value.value = handleIncrement(value.value);\n  interval = setInterval(() => {\n    value.value = handleIncrement(value.value);\n  }, 2000);\n});\n\nonBeforeUnmount(() => {\n  if (interval) {\n    clearInterval(interval);\n  }\n});\n</script>\n\n<template>\n  <div class=\"flex items-center justify-center py-1\">\n    <AnimatedCircularProgressBar\n      :max=\"100\"\n      :min=\"0\"\n      :value=\"value\"\n    />\n  </div>\n</template>\n",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "展示任务完成度、下载或上传进度。",
    "仪表盘中展示指标占比，数值变化时需要平滑动画。",
    "需要在圆环中心直接显示百分比数字的场景。"
  ],
  "whenNotToUse": [
    "需要用户拖动改变数值的输入场景，改用 balance-slider 等表单组件。",
    "静态展示一个数字即可时，无需引入动画进度条。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "duration 单位为秒（默认 1），与其他组件的毫秒单位不同。"
  ],
