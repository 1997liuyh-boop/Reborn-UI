{
  "$schema": "../schema/component.schema.json",
  "id": "vanishing-input",
  "title": "占位符滚动与消失输入框",
  "description": "用于占位符轮换滚动、提交时文字呈消失动画的单行输入组件。",
  "category": "form",
  "tags": [
    "css",
    "tailwind",
    "input",
    "aceternity-ui"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "placeholders",
      "type": "string[]",
      "required": false,
      "description": "占位文本数组，每 3 秒轮换显示，仅在输入为空时可见。",
      "default": "() => [\"Placeholder 1\", \"Placeholder 2\", \"Placeholder 3\"]"
    },
    {
      "name": "modelValue",
      "type": "string",
      "required": false,
      "description": "双向绑定值",
      "vModel": true,
      "default": "\"\""
    }
  ],
  "events": [
    {
      "name": "submit",
      "description": "按回车或点击提交按钮时触发，参数为提交时的文本；随后播放消失动画。"
    },
    {
      "name": "change",
      "description": "输入值变化时触发，参数为模拟的事件对象；动画期间不触发。"
    },
    {
      "name": "update:modelValue",
      "description": "modelValue 变化时触发（v-model 同步）"
    }
  ],
  "slots": [],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "code": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\n\nconst placeholders = [\n  \"Why is my code always broken?\",\n  \"What does 'undefined' even mean?\",\n  \"How to center a div (for real this time)\",\n  \"Am I smarter than a compiler?\",\n  \"Do loops ever get dizzy?\",\n];\nconst text = ref(\"\");\n</script>\n\n<template>\n  <div class=\"flex h-[40rem] flex-col items-center justify-center px-4\">\n    <h2 class=\"mb-10 text-center text-xl text-black sm:mb-20 sm:text-5xl dark:text-white\">\n      Ask Anything Silly\n    </h2>\n    <VanishingInput\n      v-model=\"text\"\n      :placeholders=\"placeholders\"\n    />\n  </div>\n</template>\n",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "AI 问答、搜索入口需要轮换展示示例问题占位符时。",
    "落地页互动输入框需要提交动效增强反馈。"
  ],
  "whenNotToUse": [
    "常规表单输入，改用 reborn-input（同时支持 web 与 uniapp）。",
    "需要目录选择、图片搜索的高级搜索框，改用 reborn-search-box。",
    "需要发光视觉的搜索输入，改用 halo-search。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "通过 v-model（modelValue）双向绑定输入值。",
    "placeholders 为字符串数组轮换显示，不传时使用内置的 3 条默认占位文本。",
    "提交时触发 submit 事件并播放文字消失动画，输入变化触发 change 事件。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add vanishing-input"
  },
