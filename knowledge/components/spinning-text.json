  "examples": [
    {
      "title": "Web 演示",
      "code": "<script lang=\"ts\" setup></script>\n\n<template>\n  <ClientOnly>\n    <div class=\"flex min-h-[350px] w-full items-center justify-center\">\n      <SpinningText text=\"learn more · earn more · grow more ·\" />\n    </div>\n  </ClientOnly>\n</template>\n<style scoped></style>\n",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "圆形徽章、印章式的旋转标语。",
    "环绕 Logo 或按钮外圈循环转动的文字装饰。",
    "需要通过 reverse、duration 控制旋转方向与转速的场景。"
  ],
  "whenNotToUse": [
    "一组词轮换切换展示，改用 flip-words 或 morphing-text。",
    "横向滚动的跑马灯文字，改用 reborn-marquee。"
  ],
  "pitfalls": [
    "仅 web 端可用，依赖 motion-v，示例包裹在 ClientOnly 中使用。",
    "text 为必填 prop；示例文本以「·」分隔且以其结尾，使环形首尾衔接自然。",
    "duration 单位为秒（默认 10 秒一圈），radius 控制圆周半径（默认 5）。",
    "可通过 transition 与 variants 自定义动画细节。"
  ],
  "dependencies": [
    "motion-v"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add spinning-text"
