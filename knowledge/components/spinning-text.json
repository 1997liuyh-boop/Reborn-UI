      "default": "\"\""
    },
    {
      "name": "reverse",
      "type": "boolean",
      "required": false,
      "description": "是否反向旋转。",
      "default": "false"
    },
    {
      "name": "radius",
      "type": "number",
      "required": false,
      "description": "文字旋转路径的半径。",
      "default": "5"
    },
    {
      "name": "transition",
      "type": "Transition",
      "required": false,
      "description": "动画的自定义过渡效果。"
    },
    {
      "name": "variants",
      "type": "{\n    container?: Variant;\n    item?: Variant;\n  }",
      "required": false,
      "description": "容器与子项动画的变体。"
    }
