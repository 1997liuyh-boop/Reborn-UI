{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-select-trigger",
  "title": "reborn-select-trigger",
  "description": "用于各类下拉选择组件复用的触发器与浮层容器内部基础组件。",
  "category": "misc",
  "tags": [],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "text",
      "type": "string",
      "required": false,
      "description": "显示文本",
      "default": "''"
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "description": "占位符",
      "default": "'请选择'"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用",
      "default": "false"
    },
    {
      "name": "focus",
      "type": "boolean",
      "required": false,
      "description": "是否聚焦",
      "default": "false"
    },
    {
      "name": "size",
      "type": "(typeof selectTriggerSizes)[number]",
      "required": false,
      "description": "尺寸",
      "default": "'md'"
    },
    {
      "name": "color",
      "type": "(typeof selectTriggerColors)[number]",
      "required": false,
      "description": "颜色",
      "default": "'primary'"
    },
    {
      "name": "clearable",
      "type": "boolean",
      "required": false,
      "description": "",
      "default": "true"
    },
    {
      "name": "ui",
      "type": "Partial<{\n    wrapper: ClassValue\n    content: ClassValue\n    text: ClassValue\n    placeholder: ClassValue\n    iconWrapper: ClassValue\n    clearIcon: ClassValue\n    arrowIcon: ClassValue\n  }>",
      "required": false,
      "description": "样式覆盖"
    },
    {
      "name": "customClass",
      "type": "any",
      "required": false,
      "description": "自定义 class"
    },
    {
      "name": "displayText",
      "type": "string",
      "required": false,
      "description": "",
      "default": "\"\""
    },
    {
      "name": "isOpen",
      "type": "boolean",
      "required": false,
      "description": "",
      "default": "false"
    },
    {
      "name": "icon",
      "type": "string",
      "required": false,
      "description": "",
      "default": "\"lucide:chevron-down\""
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": ""
    },
    {
      "name": "bordered",
      "type": "boolean",
      "required": false,
      "description": "",
      "default": "true"
    },
    {
      "name": "showArrow",
      "type": "boolean",
      "required": false,
      "description": "是否显示箭头",
      "default": "true"
    },
    {
      "name": "arrowAnimation",
      "type": "boolean",
      "required": false,
      "description": "展开时箭头是否旋转",
      "default": "true"
    },
    {
      "name": "closeOn",
      "type": "\"click\" | \"mousedown\"",
      "required": false,
      "description": "关闭下拉的时机： - 'click'：在触发器（含下拉面板）外完成一次点击后才收起（默认） - 'mousedown'：在触发器（含下拉面板）外发生任意按下类鼠标事件（左键/右键/中键按下）立即收起",
      "default": "\"click\""
    },
    {
      "name": "scrollToActive",
      "type": "(instant?: boolean) => void",
      "required": false,
      "description": ""
    },
    {
      "name": "error",
      "type": "boolean",
      "required": false,
      "description": ""
    },
    {
      "name": "portal",
      "type": "boolean",
      "required": false,
      "description": "是否把浮层传送到 body。 默认开启：浮层留在触发器内时会被任意祖先的 overflow 裁掉 （典型场景：RebornDialog 的 panel 恒为 overflow-hidden，scrollable 时 body 还叠一层 overflow-y-auto）， 而 z-index 只决定绘制顺序、无法突破裁剪。 开启后浮层传送到 body，并使用文档坐标锚定触发器，页面滚动时不依赖 JS 每帧重算。 仅当调用方确实需要浮层随父容器一起滚动、一起被裁剪时才关掉。",
      "default": "true"
    }
  ],
  "events": [
    {
      "name": "open",
      "payload": "(e: 'open'): void",
      "description": ""
    },
    {
