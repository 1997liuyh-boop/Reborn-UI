      "payload": "(e: \"keydown\", event: KeyboardEvent): void;",
      "description": ""
    },
    {
      "name": "enter",
      "payload": "(e: \"enter\"): void;",
      "description": ""
    },
    {
      "name": "afterEnter",
      "payload": "(e: \"afterEnter\"): void;",
      "description": ""
    },
    {
      "name": "close",
      "payload": "(e: \"close\"): void;",
      "description": "在触发器外发生了 closeOn 指定的鼠标事件，请求父组件收起下拉"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": ""
    },
    {
      "name": "clear-icon",
      "description": ""
