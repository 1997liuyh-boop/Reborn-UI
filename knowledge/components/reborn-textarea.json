{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-textarea",
  "title": "多行输入框",
  "description": "用于多行文本输入的输入框组件，支持自动增高、字数统计与键盘行为配置。",
  "category": "form",
  "tags": [
    "css",
    "tailwind",
    "textarea",
    "uniapp"
  ],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "color",
      "type": "typeof textareaColors[number]",
      "required": false,
      "description": "颜色",
      "default": "'primary'"
    },
    {
      "name": "customClass",
      "type": "string",
      "required": false,
      "description": "自定义样式类",
      "default": "''"
    },
    {
      "name": "ui",
      "type": "Record<string, any>",
      "required": false,
      "description": "UI 覆盖",
      "default": "() => ({})"
    },
    {
      "name": "modelValue",
      "type": "string",
      "required": true,
      "description": "绑定值",
      "default": "''"
    },
    {
      "name": "size",
      "type": "typeof textareaSizes[number]",
      "required": false,
      "description": "尺寸",
      "default": "'md'"
    },
    {
      "name": "border",
      "type": "boolean",
      "required": false,
      "description": "是否显示边框",
      "default": "true"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用",
      "default": "false"
    },
    {
      "name": "readonly",
      "type": "boolean",
      "required": false,
      "description": "是否只读",
      "default": "false"
    },
    {
      "name": "showWordLimit",
      "type": "boolean",
      "required": false,
      "description": "是否显示字数统计",
      "default": "true"
    },
    {
      "name": "name",
      "type": "string",
      "required": false,
      "description": "名称",
      "default": "''"
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "description": "占位符",
      "default": "() => '请输入'"
    },
    {
      "name": "placeholderClass",
      "type": "string",
      "required": false,
      "description": "占位符样式类",
      "default": "''"
    },
    {
      "name": "placeholderStyle",
      "type": "string",
      "required": false,
      "description": "占位符样式",
      "default": "''"
    },
    {
      "name": "maxlength",
      "type": "number",
      "required": false,
      "description": "最大输入长度",
      "default": "100"
    },
    {
      "name": "autofocus",
      "type": "boolean",
      "required": false,
      "description": "是否自动聚焦",
      "default": "false"
    },
    {
      "name": "confirmType",
      "type": "string",
      "required": false,
      "description": "设置键盘右下角按钮的文字",
      "default": "'done'"
    },
    {
      "name": "cursor",
      "type": "number",
      "required": false,
      "description": "指定focus时的光标位置",
      "default": "0"
    },
    {
      "name": "confirmHold",
      "type": "boolean",
      "required": false,
      "description": "点击键盘确认按钮时是否保持键盘不收起",
      "default": "false"
    },
    {
      "name": "height",
      "type": "number | string",
      "required": false,
      "description": "高度",
      "default": "140"
    },
    {
      "name": "autoHeight",
      "type": "boolean",
      "required": false,
      "description": "是否自动增高",
      "default": "false"
    },
    {
      "name": "fixed",
      "type": "boolean",
      "required": false,
      "description": "如果 textarea 是在一个 position:fixed 的区域，需要显示指定属性 fixed 为 true",
      "default": "false"
    },
    {
      "name": "cursorSpacing",
      "type": "number",
      "required": false,
      "description": "光标与键盘的距离",
      "default": "5"
    },
    {
      "name": "cursorColor",
      "type": "string",
      "required": false,
      "description": "指定光标颜色",
      "default": "''"
    },
    {
      "name": "showConfirmBar",
      "type": "boolean",
      "required": false,
      "description": "是否显示键盘上方带有”完成“按钮那一栏",
      "default": "true"
    },
    {
      "name": "selectionStart",
      "type": "number",
      "required": false,
      "description": "光标起始位置",
      "default": "-1"
    },
    {
      "name": "selectionEnd",
      "type": "number",
      "required": false,
      "description": "光标结束位置",
      "default": "-1"
    },
    {
      "name": "adjustPosition",
      "type": "boolean",
      "required": false,
      "description": "盘弹起时，是否自动上推页面",
      "default": "true"
    },
    {
      "name": "inputmode",
      "type": "'none' | 'text' | 'decimal' | 'numeric' | 'tel' | 'search' | 'email' | 'url'",
      "required": false,
      "description": "它提供了用户在编辑元素或其内容时可能输入的数据类型的提示。",
      "default": "'text'"
    },
    {
      "name": "holdKeyboard",
      "type": "boolean",
      "required": false,
      "description": "focus时，点击页面的时候不收起键盘",
      "default": "false"
    },
    {
      "name": "disableDefaultPadding",
      "type": "boolean",
      "required": false,
      "description": "是否禁用默认内边距",
      "default": "true"
    },
    {
      "name": "adjustKeyboardTo",
      "type": "string",
      "required": false,
      "description": "键盘对齐位置",
      "default": "'cursor'"
    },
    {
      "name": "rows",
      "type": "number",
      "required": false,
      "description": "默认行数，决定初始高度（仅 Web）。",
      "default": "4"
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "description": "输入内容变化时触发，同步 v-model 绑定值"
    },
    {
      "name": "input",
      "description": "每次输入时触发，参数为原生事件对象（e.detail.value 为当前文本）"
    },
    {
      "name": "change",
      "description": "输入内容与上一次不同时触发，参数为最新文本"
    },
    {
      "name": "focus",
      "description": "输入框聚焦、键盘弹起时触发"
    },
    {
      "name": "blur",
      "description": "输入框失焦、键盘收起时触发，并执行表单 blur 校验"
    },
    {
      "name": "confirm",
      "description": "点击键盘右下角确认按钮时触发（按钮文字由 confirmType 决定）"
    },
    {
      "name": "linechange",
      "description": "输入行数变化时触发，e.detail 含 height、lineCount 等信息"
    },
    {
      "name": "keyboardheightchange",
      "description": "键盘高度变化时触发，e.detail 含 height 与 duration"
    }
  ],
  "slots": [
    {
      "name": "limit",
      "description": "自定义字数统计区域，`length` 为当前长度、`max` 为 `maxlength`；仅在 `showWordLimit` 开启时渲染。"
    }
  ],
  "exposes": [
    {
      "name": "isFocus",
      "description": "当前是否处于聚焦状态（响应式 ref，可读取样式聚焦态）"
    },
    {
      "name": "focus",
      "description": "让输入框重新聚焦并唤起键盘"
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-textarea/RebornTextareaDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-textarea/RebornTextareaDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "备注、评论、描述等多行文本录入。",
    "需要字数统计与上限（maxlength + showWordLimit，limit 插槽可自定义统计区）。",
    "内容随输入自动增高（autoHeight）。"
  ],
  "whenNotToUse": [
    "单行输入改用 reborn-input。",
    "短信验证码等分格输入改用 reborn-input-otp。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端均可用。",
    "maxlength 默认 100，长内容需显式调大；showWordLimit 默认 true 但需设置 maxlength 才有意义。",
    "confirmType、cursorSpacing、adjustPosition、holdKeyboard、showConfirmBar 等属性对应 uniapp 原生 textarea 能力，主要在小程序 / App 端生效。",
    "高度由 height（默认 140）与 rows（默认 4）共同影响，开启 autoHeight 后自动增高。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-textarea"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-textarea/RebornTextarea.vue",
      "app/components/reborn/ui/reborn-textarea/reborn-textarea.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-textarea/RebornTextarea.vue",
      "packages/uniapp-project/src/components/reborn-textarea/index.ts",
      "packages/uniapp-project/src/components/reborn-textarea/reborn-textarea.config.ts"
    ]
  },
  "docPath": "content/2.components/input-and-forms/reborn-textarea.md",
  "_meta": {
    "contentHash": "a5d420246cf38b19ee9565a1f036afecb904599a",
    "hasOverride": true,
    "extractors": {
      "web": "ok",
      "uniapp": "ok",
      "docs": "found"
    }
  }
}
