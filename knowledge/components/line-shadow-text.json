    "web"
  ],
  "props": [
    {
      "name": "shadowColor",
      "type": "string",
      "required": false,
      "description": "阴影效果的颜色。",
      "default": "\"black\""
    },
    {
      "name": "as",
      "type": "keyof HTMLElement",
      "required": false,
      "description": "渲染文字所用的 HTML 元素。",
      "default": "\"span\" as keyof HTMLElement"
