{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-popup",
  "title": "Popup 弹出层",
  "description": "用于从上下左右四个方向弹出面板的双端弹出层组件，支持手势滑动关闭与安全区适配。",
  "category": "navigation",
  "tags": [],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "customClass",
      "type": "string",
      "required": false,
      "description": "自定义根元素类名",
      "default": "''"
    },
    {
      "name": "customStyle",
      "type": "string",
      "required": false,
      "description": "自定义根元素样式",
      "default": "''"
    },
    {
      "name": "modelValue",
      "type": "boolean",
      "required": false,
      "description": "是否显示弹出层 (v-model)",
      "default": "false"
    },
    {
      "name": "position",
      "type": "PopupPosition",
      "required": false,
      "description": "弹出位置：top, bottom, left, right, center",
      "default": "'bottom'"
    },
    {
      "name": "transition",
      "type": "TransitionName",
      "required": false,
      "description": "自定义过渡动画名称",
      "default": "''"
    },
    {
      "name": "closeOnClickModal",
      "type": "boolean",
      "required": false,
      "description": "是否可以通过点击遮罩层关闭",
      "default": "true"
    },
    {
      "name": "maskClosable",
      "type": "boolean",
      "required": false,
      "description": "是否可以通过点击遮罩层关闭 (别名)",
      "default": "true"
    },
    {
      "name": "duration",
      "type": "number | boolean",
      "required": false,
      "description": "动画时长 (单位ms)，设为 false 则禁用动画",
      "default": "300"
    },
    {
      "name": "modal",
      "type": "boolean",
      "required": false,
      "description": "是否需要遮罩层",
      "default": "true"
    },
    {
      "name": "showMask",
      "type": "boolean",
      "required": false,
      "description": "是否需要遮罩层 (别名)",
      "default": "true"
    },
    {
      "name": "zIndex",
      "type": "number",
      "required": false,
      "description": "弹出层的层级 z-index",
      "default": "25"
    },
    {
      "name": "overlayZIndex",
      "type": "number",
      "required": false,
      "description": "弹出层的层级 z-index (别名)",
      "default": "25"
    },
    {
      "name": "modalStyle",
      "type": "string",
      "required": false,
      "description": "遮罩层的自定义样式",
      "default": "''"
    },
    {
      "name": "safeAreaInsetBottom",
      "type": "boolean",
      "required": false,
      "description": "是否开启底部安全区域适配",
      "default": "true"
    },
    {
      "name": "safeAreaInsetTop",
      "type": "boolean",
      "required": false,
      "description": "是否开启顶部安全区域适配",
      "default": "true"
    },
    {
      "name": "lazyRender",
      "type": "boolean",
      "required": false,
      "description": "是否在显示时才渲染内容",
      "default": "true"
    },
    {
      "name": "lockScroll",
      "type": "boolean",
      "required": false,
      "description": "是否在出现时将 body 滚动锁定",
      "default": "true"
    },
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "弹出层的标题",
      "default": "''"
    },
    {
      "name": "showHeader",
      "type": "boolean",
      "required": false,
      "description": "是否显示头部（包含标题和关闭按钮）",
      "default": "true"
    },
    {
      "name": "showClose",
      "type": "boolean",
      "required": false,
      "description": "是否显示关闭按钮",
      "default": "true"
    },
    {
      "name": "size",
      "type": "number | string",
      "required": false,
      "description": "弹出层的大小 (宽度或高度)",
      "default": "'30%'"
    },
    {
      "name": "swipeClose",
      "type": "boolean",
      "required": false,
      "description": "是否开启手势滑动关闭 (仅限底部位置)",
      "default": "true"
    },
    {
      "name": "swipeCloseThreshold",
      "type": "number",
      "required": false,
      "description": "手势滑动关闭的触发阈值（手指竖直位移 px，不与阻尼位移混用）",
      "default": "120"
    },
    {
      "name": "ui",
      "type": "any",
      "required": false,
      "description": "自定义 UI 配置",
      "default": "{}"
    },
    {
      "name": "rootPortal",
      "type": "boolean",
      "required": false,
      "description": "是否使用 reborn-root-portal (别名)",
      "default": "false"
    },
    {
      "name": "enablePortal",
      "type": "boolean",
      "required": false,
      "description": "是否使用 reborn-root-portal",
      "default": "false"
    },
    {
      "name": "color",
      "type": "PopupColor",
      "required": false,
      "description": "主题色 (影响手势滑块等)",
      "default": "'neutral'"
    },
    {
      "name": "round",
      "type": "boolean",
      "required": false,
      "description": "是否显示圆角样式",
      "default": "true"
    },
    {
      "name": "appendToBody",
      "type": "boolean",
      "required": false,
      "description": "是否将弹出层插入至 body 节点",
      "default": "false"
    },
    {
      "name": "appendTo",
      "type": "string | HTMLElement",
      "required": false,
      "description": "指定弹出层插入的节点",
      "default": "'body'"
    },
    {
      "name": "beforeClose",
      "type": "(done: (cancel?: boolean) => void) => void",
      "required": false,
      "description": "关闭前的回调，会暂停关闭"
    },
    {
      "name": "closeOnPressEscape",
      "type": "boolean",
      "required": false,
      "description": "是否可以通过按下 ESC 键关闭",
      "default": "true"
    },
    {
      "name": "openDelay",
      "type": "number",
      "required": false,
      "description": "开启延迟，单位毫秒",
      "default": "0"
    },
    {
      "name": "closeDelay",
      "type": "number",
      "required": false,
      "description": "关闭延迟，单位毫秒",
      "default": "0"
    },
    {
      "name": "destroyOnClose",
      "type": "boolean",
      "required": false,
      "description": "关闭时是否销毁内部元素",
      "default": "false"
    },
    {
      "name": "modalPenetrable",
      "type": "boolean",
      "required": false,
      "description": "遮罩层是否可穿透（即不处理任何鼠标事件）",
      "default": "false"
    },
    {
      "name": "resizable",
      "type": "boolean",
      "required": false,
      "description": "是否可以通过拖拽调整大小",
      "default": "false"
    },
    {
      "name": "modalClass",
      "type": "string",
      "required": false,
      "description": "遮罩层的自定义类名",
      "default": "''"
    },
    {
      "name": "headerClass",
      "type": "string",
      "required": false,
      "description": "头部的自定义类名",
      "default": "''"
    },
    {
      "name": "bodyClass",
      "type": "string",
      "required": false,
      "description": "内容主体的自定义类名",
      "default": "''"
    },
    {
      "name": "footerClass",
      "type": "string",
      "required": false,
      "description": "底部页脚的自定义类名",
      "default": "''"
    },
    {
      "name": "headerAriaLevel",
      "type": "string",
      "required": false,
      "description": "头部标题的 aria-level 属性",
      "default": "'2'"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "自定义根元素类名"
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "description": "显隐状态变化时触发，参数为最新的显示状态（v-model 同步）",
      "payload": "(value: boolean)"
    },
    {
      "name": "before-enter",
      "description": "显隐状态变化时触发，参数为最新的显示状态（v-model 同步）",
      "payload": "-"
    },
    {
      "name": "enter",
      "description": "进入过渡进行中触发（面板开始滑入）",
      "payload": "-"
    },
    {
      "name": "before-leave",
      "description": "进入过渡进行中触发（面板开始滑入）",
      "payload": "-"
    },
    {
      "name": "leave",
      "description": "离开过渡进行中触发（面板开始滑出）",
      "payload": "-"
    },
    {
      "name": "after-leave",
      "description": "离开过渡进行中触发（面板开始滑出）",
      "payload": "-"
    },
    {
      "name": "after-enter",
      "description": "进入过渡结束后触发",
      "payload": "-"
    },
    {
      "name": "click-modal",
      "description": "点击遮罩层时触发",
      "payload": "-"
    },
    {
      "name": "close",
      "description": "关闭弹出层时触发（动画开始）",
      "payload": "-"
    },
    {
      "name": "open",
      "description": "开启弹出层时触发（动画开始）",
      "payload": "-"
    },
    {
      "name": "opened",
      "description": "开启且动画完成时触发",
      "payload": "-"
    },
    {
      "name": "closed",
      "description": "关闭且动画完成时触发",
      "payload": "-"
    },
    {
      "name": "open-auto-focus",
      "payload": "(e: 'open-auto-focus'): void;",
      "description": "自动聚焦至打开状态"
    },
    {
      "name": "close-auto-focus",
      "payload": "(e: 'close-auto-focus'): void;",
      "description": "自动聚焦至关闭状态"
    },
    {
      "name": "resize-start",
      "payload": "(e: 'resize-start'): void;",
      "description": "开始拖拽缩放"
    },
    {
      "name": "resize",
      "payload": "(e: 'resize', size: number): void;",
      "description": "拖拽缩放中"
    },
    {
      "name": "resize-end",
      "payload": "(e: 'resize-end'): void;",
      "description": "结束拖拽缩放"
    }
  ],
  "slots": [
    {
      "name": "header",
      "description": "头部区域，替换默认的标题文本"
    },
    {
      "name": "default",
      "description": "弹层主体内容"
    },
    {
      "name": "footer",
      "description": "底部页脚区域，常用于操作按钮组"
    }
  ],
  "exposes": [
    {
      "name": "handleClose",
      "description": "手动关闭弹出层（等价于把 v-model 置为 false，会正常走关闭事件与动画）"
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "code": "<script setup lang=\"ts\">\n// ─── 交互演练场 ─────────────────────────────────────────────────\n\n/** 弹出方向 */\nconst positionOptions = [\n  { label: \"居中 center\", value: \"center\" },\n  { label: \"顶部 top\", value: \"top\" },\n  { label: \"底部 bottom\", value: \"bottom\" },\n  { label: \"左侧 left\", value: \"left\" },\n  { label: \"右侧 right\", value: \"right\" },\n];\n\n/** 过渡动画；留空表示按 position 自动推导 */\nconst transitionOptions = [\n  { label: \"自动（跟随 position）\", value: \"\" },\n  { label: \"fade 淡入淡出\", value: \"fade\" },\n  { label: \"fade-up 上浮淡入\", value: \"fade-up\" },\n  { label: \"fade-down 下沉淡入\", value: \"fade-down\" },\n  { label: \"zoom 缩放\", value: \"zoom\" },\n  { label: \"zoom-in 放大进入\", value: \"zoom-in\" },\n  { label: \"zoom-out 缩小进入\", value: \"zoom-out\" },\n  { label: \"slide-up 上滑\", value: \"slide-up\" },\n  { label: \"slide-right 右滑\", value: \"slide-right\" },\n];\n\nconst state = ref<Record<string, any>>({\n  position: \"center\",\n  transition: \"\",\n  size: \"420px\",\n  title: \"RebornPopup 演示\",\n  showHeader: true,\n  showClose: true,\n  modal: true,\n  resizable: false,\n  round: true,\n});\n\n/** 演练场控制面板配置 */\nconst controls = [\n  {\n    title: \"方向与尺寸\",\n    children: [\n      {\n        label: \"弹出方向\",\n        key: \"position\",\n        component: \"select\" as const,\n        defaultValue: \"center\",\n        props: { options: positionOptions },\n      },\n      {\n        label: \"过渡动画\",\n        key: \"transition\",\n        component: \"select\" as const,\n        defaultValue: \"\",\n        props: { options: transitionOptions },\n      },\n      {\n        label: \"尺寸（宽或高，随方向而定）\",\n        key: \"size\",\n        component: \"input\" as const,\n        defaultValue: \"420px\",\n      },\n    ],\n  },\n  {\n    title: \"结构与交互\",\n    children: [\n      { label: \"标题文案\", key: \"title\", component: \"input\" as const, defaultValue: \"RebornPopup 演示\" },\n      { label: \"显示头部\", key: \"showHeader\", component: \"checkbox\" as const, defaultValue: true },\n      { label: \"显示关闭按钮\", key: \"showClose\", component: \"checkbox\" as const, defaultValue: true },\n      { label: \"显示遮罩层\", key: \"modal\", component: \"checkbox\" as const, defaultValue: true },\n      { label: \"边缘拖拽缩放\", key: \"resizable\", component: \"checkbox\" as const, defaultValue: false },\n      { label: \"圆角样式\", key: \"round\", component: \"checkbox\" as const, defaultValue: true },\n    ],\n  },\n];\n\n/** 演练场右上角展示的等价代码 */\nconst popupCode = computed(() => {\n  const s = state.value;\n  const props: string[] = ['v-model=\"open\"'];\n\n  if (s.position !== \"bottom\") props.push(`position=\"${s.position}\"`);\n  if (s.transition) props.push(`transition=\"${s.transition}\"`);\n  if (s.size !== \"30%\") props.push(`size=\"${s.size}\"`);\n  if (s.title) props.push(`title=\"${s.title}\"`);\n  if (!s.showHeader) props.push(\":show-header=\\\"false\\\"\");\n  if (!s.showClose) props.push(\":show-close=\\\"false\\\"\");\n  if (!s.modal) props.push(\":modal=\\\"false\\\"\");\n  if (s.resizable) props.push(\"resizable\");\n  if (!s.round) props.push(\":round=\\\"false\\\"\");\n\n  return `<RebornPopup\\n  ${props.join(\"\\n  \")}\\n>\\n  弹出层内容\\n</RebornPopup>`;\n});\n\n/** 演练场弹出层的开关 */\nconst playgroundOpen = ref(false);\n\n// ─── 场景演示状态 ───────────────────────────────────────────────\n\n/** 三层嵌套弹出层 */\nconst nestedLevel1 = ref(false);\nconst nestedLevel2 = ref(false);\nconst nestedLevel3 = ref(false);\n\n/** 一次性收起所有嵌套层 */\nfunction closeAllNested() {\n  nestedLevel1.value = false;\n  nestedLevel2.value = false;\n  nestedLevel3.value = false;\n}\n\n/** 带页脚与关闭拦截的表单式弹出层 */\nconst formOpen = ref(false);\nconst agreed = ref(false);\n\n/** 最近一次关闭是否被拦截 */\nconst lastBlocked = ref(false);\n\n/** 未勾选协议时阻止关闭；done(true) 表示取消本次关闭 */\nfunction guardClose(done: (cancel?: boolean) => void) {\n  if (agreed.value) {\n    done();\n    return;\n  }\n  lastBlocked.value = true;\n  done(true);\n}\n\n/** 无遮罩弹出层：不锁定页面滚动，可继续操作背后内容 */\nconst maskFreeOpen = ref(false);\n</script>\n\n<template>\n  <div class=\"flex w-full min-w-0 flex-col\">\n    <Playground\n      v-model=\"state\"\n      :controls=\"controls\"\n      :code=\"popupCode\"\n      component-name=\"RebornPopup\"\n      title=\"交互演练场\"\n      description=\"position 决定贴边方向与默认动画；size 在左右方向表示宽度，在上下方向表示高度。\"\n    >\n      <RebornButton\n        label=\"打开弹出层\"\n        @click=\"playgroundOpen = true\"\n      >\n        <template #leading>\n          <Icon name=\"lucide:panel-right-open\" />\n        </template>\n      </RebornButton>\n\n      <RebornPopup\n        v-model=\"playgroundOpen\"\n        append-to-body\n        :position=\"state.position\"\n        :transition=\"state.transition\"\n        :size=\"state.size\"\n        :title=\"state.title\"\n        :show-header=\"state.showHeader\"\n        :show-close=\"state.showClose\"\n        :modal=\"state.modal\"\n        :resizable=\"state.resizable\"\n        :round=\"state.round\"\n      >\n        <div class=\"flex flex-col gap-3 p-4\">\n          <p class=\"text-muted text-sm leading-relaxed\">\n            弹出层自带表面样式与阴影，内容区直接书写业务结构即可，无需再包一层卡片。\n          </p>\n          <p\n            v-if=\"state.resizable && state.position !== 'center'\"\n            class=\"text-dimmed flex items-center gap-2 text-xs\"\n          >\n            <Icon name=\"lucide:grab\" />\n            拖拽弹出层的内侧边缘可实时调整尺寸。\n          </p>\n          <RebornButton\n            variant=\"soft\"\n            color=\"neutral\"\n            label=\"关闭\"\n            @click=\"playgroundOpen = false\"\n          />\n        </div>\n      </RebornPopup>\n    </Playground>\n\n    <DemoSection\n      title=\"多层嵌套\"\n      description=\"嵌套弹出层的 z-index 与遮罩会自动按层级递增，内层不会被外层遮罩压住。\"\n    >\n      <DemoBlock\n        layout=\"row\"\n        align=\"center\"\n      >\n        <RebornButton\n          variant=\"outline\"\n          label=\"打开第一层\"\n          @click=\"nestedLevel1 = true\"\n        />\n      </DemoBlock>\n\n      <RebornPopup\n        v-model=\"nestedLevel1\"\n        append-to-body\n        position=\"center\"\n        title=\"第一层\"\n        size=\"420px\"\n      >\n        <div class=\"flex flex-col gap-4 p-4\">\n          <p class=\"text-muted text-sm leading-relaxed\">\n            复杂业务里经常需要在当前会话之上再开一个子流程，此时直接嵌套即可。\n          </p>\n          <RebornButton\n            variant=\"soft\"\n            label=\"开启第二层\"\n            @click=\"nestedLevel2 = true\"\n          />\n        </div>\n\n        <RebornPopup\n          v-model=\"nestedLevel2\"\n          append-to-body\n          position=\"center\"\n          title=\"第二层\"\n          size=\"340px\"\n        >\n          <div class=\"flex flex-col gap-4 p-4\">\n            <p class=\"text-muted text-sm leading-relaxed\">层级与遮罩已自动处理，无需手写 z-index。</p>\n            <RebornButton\n              variant=\"soft\"\n              color=\"neutral\"\n              label=\"开启第三层\"\n              @click=\"nestedLevel3 = true\"\n            />\n          </div>\n\n          <RebornPopup\n            v-model=\"nestedLevel3\"\n            append-to-body\n            position=\"center\"\n            title=\"第三层\"\n            size=\"280px\"\n          >\n            <div class=\"flex flex-col items-center gap-3 p-4 text-center\">\n              <Icon\n                name=\"lucide:check-circle\"\n                class=\"text-success size-8\"\n              />\n              <p class=\"text-muted text-sm\">三层堆叠完成，点击下方按钮可一次性全部关闭。</p>\n              <RebornButton\n                label=\"全部关闭\"\n                block\n                @click=\"closeAllNested\"\n              />\n            </div>\n          </RebornPopup>\n        </RebornPopup>\n      </RebornPopup>\n    </DemoSection>\n\n    <DemoSection\n      title=\"页脚与关闭拦截\"\n      description=\"footer 插槽用于放置操作区；before-close 接收 done 回调，调用 done(true) 即可取消本次关闭。\"\n    >\n      <DemoBlock\n        layout=\"row\"\n        align=\"center\"\n      >\n        <RebornButton\n          variant=\"outline\"\n          label=\"打开带拦截的弹出层\"\n          @click=\"formOpen = true\"\n        />\n      </DemoBlock>\n\n      <DemoNote tone=\"dimmed\">\n        <template v-if=\"lastBlocked\">\n          最近一次关闭被 <code>before-close</code> 拦截，请先勾选协议。\n        </template>\n        <template v-else> 未勾选协议时点击关闭会被拦截。 </template>\n      </DemoNote>\n\n      <RebornPopup\n        v-model=\"formOpen\"\n        append-to-body\n        position=\"center\"\n        title=\"服务条款\"\n        size=\"440px\"\n        :before-close=\"guardClose\"\n      >\n        <div class=\"flex flex-col gap-4 p-4\">\n          <p class=\"text-muted text-sm leading-relaxed\">\n            请先阅读并勾选下方协议，否则关闭动作会被 <code>before-close</code> 拦截。\n          </p>\n          <RebornCheckbox\n            v-model=\"agreed\"\n            label=\"我已阅读并同意服务条款\"\n          />\n        </div>\n\n        <template #footer>\n          <div class=\"flex w-full items-center justify-end gap-3 p-3\">\n            <RebornButton\n              variant=\"soft\"\n              color=\"neutral\"\n              label=\"稍后再说\"\n              @click=\"formOpen = false\"\n            />\n            <RebornButton\n              label=\"确认并关闭\"\n              :disabled=\"!agreed\"\n              @click=\"formOpen = false\"\n            />\n          </div>\n        </template>\n      </RebornPopup>\n    </DemoSection>\n\n    <DemoSection\n      title=\"无遮罩模式\"\n      description=\"modal 为 false 时不渲染遮罩，页面滚动也不会被锁定，适合常驻的辅助面板。\"\n    >\n      <DemoBlock\n        layout=\"row\"\n        align=\"center\"\n      >\n        <RebornButton\n          variant=\"outline\"\n          label=\"打开无遮罩面板\"\n          @click=\"maskFreeOpen = true\"\n        />\n      </DemoBlock>\n\n      <RebornPopup\n        v-model=\"maskFreeOpen\"\n        append-to-body\n        position=\"right\"\n        title=\"辅助面板\"\n        size=\"320px\"\n        :modal=\"false\"\n        :lock-scroll=\"false\"\n      >\n        <div class=\"flex flex-col gap-3 p-4\">\n          <p class=\"text-muted text-sm leading-relaxed\">\n            没有遮罩，背后的页面依旧可以滚动与点击。\n          </p>\n          <RebornButton\n            variant=\"soft\"\n            color=\"neutral\"\n            label=\"关闭面板\"\n            @click=\"maskFreeOpen = false\"\n          />\n        </div>\n      </RebornPopup>\n    </DemoSection>\n  </div>\n</template>\n",
