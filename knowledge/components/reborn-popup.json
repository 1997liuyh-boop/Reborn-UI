{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-popup",
  "title": "Popup 弹出层",
  "description": "用于从上下左右四个方向弹出面板的双端弹出层组件，支持手势滑动关闭与安全区适配。",
  "category": "navigation",
  "tags": [],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "customClass",
      "type": "string",
      "required": false,
      "description": "",
      "default": "''"
    },
    {
      "name": "customStyle",
      "type": "string",
      "required": false,
      "description": "",
      "default": "''"
    },
    {
      "name": "modelValue",
      "type": "boolean",
      "required": false,
      "description": "是否显示弹出层",
      "default": "false"
    },
    {
      "name": "position",
      "type": "PopupPosition",
      "required": false,
      "description": "'left' \\",
      "default": "'bottom'"
    },
    {
      "name": "transition",
      "type": "TransitionName",
      "required": false,
      "description": "自定义过渡动画名称",
      "default": "''"
    },
    {
      "name": "closeOnClickModal",
      "type": "boolean",
      "required": false,
      "description": "是否可以通过点击遮罩层关闭",
      "default": "true"
    },
    {
      "name": "maskClosable",
      "type": "boolean",
      "required": false,
      "description": "",
      "default": "true"
    },
    {
      "name": "duration",
      "type": "number | boolean",
      "required": false,
      "description": "动画时长 (ms)",
      "default": "300"
    },
    {
      "name": "modal",
      "type": "boolean",
      "required": false,
      "description": "是否需要遮罩层",
      "default": "true"
    },
    {
      "name": "showMask",
      "type": "boolean",
      "required": false,
      "description": "",
      "default": "true"
    },
    {
      "name": "zIndex",
      "type": "number",
      "required": false,
      "description": "弹出层的层级",
      "default": "25"
    },
    {
      "name": "overlayZIndex",
      "type": "number",
      "required": false,
      "description": "",
      "default": "25"
    },
    {
      "name": "modalStyle",
      "type": "string",
      "required": false,
      "description": "",
      "default": "''"
    },
    {
      "name": "safeAreaInsetBottom",
      "type": "boolean",
      "required": false,
      "description": "是否开启底部安全区域适配",
      "default": "true"
    },
    {
      "name": "safeAreaInsetTop",
      "type": "boolean",
      "required": false,
      "description": "是否开启顶部安全区域适配",
      "default": "true"
    },
    {
      "name": "lazyRender",
      "type": "boolean",
      "required": false,
      "description": "是否在显示时才渲染内容",
      "default": "true"
    },
    {
      "name": "lockScroll",
      "type": "boolean",
      "required": false,
      "description": "是否在出现时锁定 body 滚动",
      "default": "true"
    },
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "弹出层的标题",
      "default": "''"
    },
    {
      "name": "showHeader",
      "type": "boolean",
      "required": false,
      "description": "是否显示头部",
      "default": "true"
    },
    {
      "name": "showClose",
      "type": "boolean",
      "required": false,
      "description": "是否显示关闭按钮",
      "default": "true"
    },
    {
      "name": "size",
      "type": "number | string",
      "required": false,
      "description": "'30%'",
      "default": "'30%'"
    },
    {
      "name": "swipeClose",
      "type": "boolean",
      "required": false,
      "description": "是否开启手势滑动关闭 (仅限底部位置)",
      "default": "true"
    },
    {
      "name": "swipeCloseThreshold",
      "type": "number",
      "required": false,
      "description": "手势滑动关闭的阈值",
      "default": "120"
    },
    {
      "name": "ui",
      "type": "any",
      "required": false,
      "description": ""
    },
    {
      "name": "rootPortal",
      "type": "boolean",
      "required": false,
      "description": "是否开启插件内部 portal 渲染 (uniapp)",
      "default": "false"
    },
    {
      "name": "enablePortal",
      "type": "boolean",
      "required": false,
      "description": "",
      "default": "false"
    },
    {
      "name": "color",
      "type": "PopupColor",
      "required": false,
      "description": "主题色 (仅影响 UniApp 滑动手柄)",
      "default": "'neutral'"
    },
    {
      "name": "round",
      "type": "boolean",
      "required": false,
      "description": "是否显示圆角样式",
      "default": "true"
    },
    {
      "name": "appendToBody",
      "type": "boolean",
      "required": false,
      "description": "是否将弹出层插入至 `body` 节点",
      "default": "false"
    },
    {
      "name": "appendTo",
      "type": "string | HTMLElement",
      "required": false,
      "description": "",
      "default": "'body'"
    },
    {
      "name": "beforeClose",
      "type": "(done: (cancel?: boolean) => void) => void",
      "required": false,
      "description": ""
    },
    {
      "name": "closeOnPressEscape",
      "type": "boolean",
      "required": false,
      "description": "是否可以通过按下 ESC 键关闭",
      "default": "true"
    },
    {
      "name": "openDelay",
      "type": "number",
      "required": false,
      "description": "开启延迟 (ms)",
      "default": "0"
    },
    {
      "name": "closeDelay",
      "type": "number",
      "required": false,
      "description": "关闭延迟 (ms)",
      "default": "0"
    },
    {
      "name": "destroyOnClose",
      "type": "boolean",
      "required": false,
      "description": "关闭时是否销毁内部元素",
      "default": "false"
    },
    {
      "name": "modalPenetrable",
      "type": "boolean",
      "required": false,
      "description": "",
      "default": "false"
    },
    {
      "name": "resizable",
      "type": "boolean",
      "required": false,
      "description": "是否可以通过拖拽调整大小",
      "default": "false"
    },
    {
      "name": "modalClass",
      "type": "string",
      "required": false,
      "description": "",
      "default": "''"
    },
    {
      "name": "headerClass",
      "type": "string",
      "required": false,
      "description": "",
      "default": "''"
    },
    {
      "name": "bodyClass",
      "type": "string",
      "required": false,
      "description": "",
      "default": "''"
    },
    {
      "name": "footerClass",
      "type": "string",
      "required": false,
      "description": "",
      "default": "''"
    },
    {
      "name": "headerAriaLevel",
      "type": "string",
      "required": false,
      "description": "",
      "default": "'2'"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": ""
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "description": ""
    },
    {
      "name": "before-enter",
      "description": "过渡开始前触发",
      "payload": "-"
    },
    {
      "name": "enter",
      "description": ""
    },
    {
      "name": "before-leave",
      "description": "离开过渡开始前触发",
      "payload": "-"
    },
    {
      "name": "leave",
      "description": ""
    },
    {
      "name": "after-leave",
      "description": "离开过渡结束后触发",
      "payload": "-"
    },
    {
      "name": "after-enter",
      "description": "过渡结束后触发",
      "payload": "-"
    },
    {
      "name": "click-modal",
      "description": "点击遮罩层时触发",
      "payload": "-"
    },
    {
      "name": "close",
      "description": "关闭弹出层时触发",
      "payload": "-"
    },
    {
      "name": "open",
      "description": "开启弹出层时触发 (动画开始)",
      "payload": "-"
    },
    {
      "name": "opened",
      "description": "开启且动画完成时触发",
      "payload": "-"
