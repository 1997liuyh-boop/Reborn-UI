{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-badge",
  "title": "徽章 Badge",
  "description": "用于展示状态、数量或标识的跨端徽标组件，支持可关闭与显隐绑定。",
  "category": "basic",
  "tags": [
    "css",
    "tailwind",
    "badge",
    "uniapp",
    "cross-platform"
  ],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "gap",
      "type": "boolean",
      "required": false,
      "description": "多个徽标并排时是否自动添加左间距。",
      "default": "false"
    },
    {
      "name": "label",
      "type": "string | number",
      "required": false,
      "description": "徽标显示的文本内容。"
    },
    {
      "name": "color",
      "type": "BadgeColor",
      "required": false,
      "description": "语义化颜色，详见下方配置。",
      "default": "'primary'"
    },
    {
      "name": "variant",
      "type": "BadgeVariant",
      "required": false,
      "description": "视觉风格：`solid`, `outline`, `soft`, `subtle` 等。",
      "default": "'solid'"
    },
    {
      "name": "size",
      "type": "BadgeSize",
      "required": false,
      "description": "尺寸规格：`sm`, `md`, `lg`。",
      "default": "'md'"
    },
    {
      "name": "icon",
      "type": "string",
      "required": false,
      "description": "直接传入图标类名。Web 端建议使用插槽。"
    },
    {
      "name": "square",
      "type": "boolean",
      "required": false,
      "description": "是否为正方形（等宽高）。",
      "default": "false"
    },
    {
      "name": "closable",
      "type": "boolean",
      "required": false,
      "description": "是否显示关闭按钮。",
      "default": "false"
    },
    {
      "name": "closeIcon",
      "type": "string",
      "required": false,
      "description": "Web 默认为 `i-lucide-x`；UniApp 默认为 `i-mdi-close-circle`。",
      "default": "'i-mdi-close-circle'"
    },
    {
      "name": "customClass",
      "type": "any",
      "required": false,
      "description": "容器类名（避免 UniApp 原生 class 冲突）。"
    },
    {
      "name": "ui",
      "type": "{\n    root?: string\n    base?: string\n    label?: string\n    leadingIcon?: string\n    trailingIcon?: string\n    closeButton?: string\n    closeIcon?: string\n  }",
      "required": false,
      "description": "深度定制内部各组件样式的对象。",
      "default": "{}"
    },
    {
      "name": "show",
      "type": "boolean",
      "required": false,
      "description": "双向绑定值",
      "vModel": true,
      "default": "true"
    },
    {
      "name": "as",
      "type": "any",
      "required": false,
      "description": "该组件应渲染为的元素或组件。 @defaultValue 'span'",
      "default": "'span'"
    },
    {
      "name": "beforeClose",
      "type": "(e: MouseEvent) => boolean | Promise<boolean>",
      "required": false,
      "description": "关闭前的钩子。返回 false 或返回 rejected 的 promise 将停止关闭。"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "容器类名。"
    }
  ],
  "events": [
    {
      "name": "close",
      "description": "点击关闭按钮时触发。"
    },
    {
      "name": "click",
      "description": "点击整个徽标时触发（UniApp 显式定义）。"
    },
    {
      "name": "update:show",
      "description": "show 变化时触发（v-model 同步）"
    }
  ],
  "slots": [
    {
      "name": "leading",
      "description": "前置内容，通常用于图标、小头像。"
    },
    {
      "name": "default",
      "description": "徽标主体内容，覆盖 `label`。"
    },
    {
      "name": "trailing",
      "description": "后置内容。"
    },
    {
      "name": "close",
      "description": "自定义关闭按钮。"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-badge/RebornBadgeDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-badge/RebornBadgeDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [
    "reborn-transition"
  ],
  "whenToUse": [
    "标记条目状态（成功/警告/错误等语义色）或数量时。",
    "标签需要可关闭交互，含关闭前异步确认（beforeClose）时。",
    "需要 v-model:show 控制徽标显隐时。"
  ],
  "whenNotToUse": [
    "可选中、可交互的筛选标签，改用 reborn-chip。",
    "独立的按钮操作，改用 reborn-button。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端可用；closeIcon 默认值双端不同（web 为 i-lucide-x，uniapp 为 i-mdi-close-circle）。",
    "icon prop 直接传图标类名，web 端建议改用 leading/trailing 插槽。",
    "uniapp 端为避免原生 class 冲突提供了 customClass；click 事件仅 uniapp 端显式定义。",
    "默认插槽内容会覆盖 label；gap 用于多个徽标并排时自动加左间距。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-badge"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-badge/RebornBadge.vue",
      "app/components/reborn/ui/reborn-badge/index.ts",
      "app/components/reborn/ui/reborn-badge/reborn-badge.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-badge/RebornBadge.vue",
      "packages/uniapp-project/src/components/reborn-badge/index.ts",
      "packages/uniapp-project/src/components/reborn-badge/reborn-badge.config.ts"
    ]
  },
  "docPath": "content/2.components/button/reborn-badge.md",
  "_meta": {
    "contentHash": "b8fc33063bbc45f28b9bafa4a0b0ac34bb98e755",
    "hasOverride": true,
    "extractors": {
      "web": "ok",
      "uniapp": "ok",
      "docs": "found"
    }
  }
}
