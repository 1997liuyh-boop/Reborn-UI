{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-badge",
  "title": "徽章 Badge",
  "description": "用于展示状态、数量或标识的跨端徽标组件，支持可关闭与显隐绑定。",
  "category": "basic",
  "tags": [
    "css",
    "tailwind",
    "badge",
    "uniapp",
    "cross-platform"
  ],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "gap",
      "type": "boolean",
      "required": false,
      "description": "多个徽标并排时是否自动添加左间距。",
      "default": "false"
    },
    {
      "name": "label",
      "type": "string | number",
      "required": false,
      "description": "-",
      "default": "number"
    },
    {
      "name": "color",
      "type": "BadgeColor",
      "required": false,
      "description": "语义化颜色，详见下方配置。",
      "default": "'primary'"
    },
    {
      "name": "variant",
      "type": "BadgeVariant",
      "required": false,
      "description": "视觉风格：`solid`, `outline`, `soft`, `subtle` 等。",
      "default": "'solid'"
    },
    {
      "name": "size",
      "type": "BadgeSize",
      "required": false,
      "description": "尺寸规格：`sm`, `md`, `lg`。",
      "default": "'md'"
    },
    {
      "name": "icon",
      "type": "string",
      "required": false,
      "description": "直接传入图标类名。Web 端建议使用插槽。"
    },
    {
      "name": "square",
      "type": "boolean",
      "required": false,
      "description": "是否为正方形（等宽高）。",
      "default": "false"
    },
    {
      "name": "closable",
      "type": "boolean",
      "required": false,
      "description": "是否显示关闭按钮。",
      "default": "false"
    },
    {
      "name": "closeIcon",
      "type": "string",
      "required": false,
      "description": "Web 默认为 `i-lucide-x`；UniApp 默认为 `i-mdi-close-circle`。",
      "default": "'i-mdi-close-circle'"
    },
    {
      "name": "customClass",
      "type": "any",
      "required": false,
      "description": "容器类名（避免 UniApp 原生 class 冲突）。"
    },
    {
      "name": "ui",
      "type": "{\r\n    root?: string\r\n    base?: string\r\n    label?: string\r\n    leadingIcon?: string\r\n    trailingIcon?: string\r\n    closeButton?: string\r\n    closeIcon?: string\r\n  }",
      "required": false,
      "description": "深度定制内部各组件样式的对象。",
      "default": "{}"
    },
    {
      "name": "show",
      "type": "boolean",
      "required": false,
      "description": "双向绑定值",
      "vModel": true
    },
    {
      "name": "as",
      "type": "any",
      "required": false,
      "description": "指定渲染的 HTML 标签或组件。",
      "default": "'span'"
    },
    {
      "name": "beforeClose",
      "type": "(e: MouseEvent) => boolean | Promise<boolean>",
      "required": false,
      "description": "关闭前的钩子函数，支持异步阻断。"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "容器类名。"
    }
  ],
  "events": [
    {
      "name": "close",
      "description": "点击关闭按钮时触发。"
    },
    {
      "name": "click",
      "description": "点击整个徽标时触发（UniApp 显式定义）。"
    },
    {
      "name": "update:show",
      "description": "show 变化时触发（v-model 同步）"
    }
  ],
  "slots": [
    {
      "name": "leading",
      "description": "前置内容，通常用于图标、小头像。"
    },
    {
      "name": "default",
      "description": "徽标主体内容，覆盖 `label`。"
    },
    {
      "name": "trailing",
      "description": "后置内容。"
    },
    {
      "name": "close",
      "description": "自定义关闭按钮。"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "code": "<script setup lang=\"ts\">\r\nimport RebornBadge from \"~/components/reborn/ui/reborn-badge/RebornBadge.vue\"\r\nimport RebornSelect from \"~/components/reborn/ui/reborn-select/RebornSelect.vue\"\r\nimport RebornCheckbox from \"~/components/reborn/ui/reborn-checkbox/RebornCheckbox.vue\"\r\nimport RebornInput from \"~/components/reborn/ui/reborn-input/RebornInput.vue\"\r\nimport { badgeColors, badgeVariants, badgeSizes } from \"~/components/reborn/ui/reborn-badge/reborn-badge.config\"\r\n\r\n// Options Mapping\r\nconst colorOptions = badgeColors.map(c => ({ label: c.charAt(0).toUpperCase() + c.slice(1), value: c }))\r\nconst variantOptions = badgeVariants.map(v => ({ label: v.charAt(0).toUpperCase() + v.slice(1), value: v }))\r\nconst sizeOptions = badgeSizes.map(s => ({ label: s.toUpperCase(), value: s }))\r\n\r\n// Playground State\r\nconst color = ref<(typeof badgeColors)[number]>('primary')\r\nconst variant = ref<(typeof badgeVariants)[number]>('solid')\r\nconst size = ref<(typeof badgeSizes)[number]>('md')\r\nconst label = ref('乐一番')\r\nconst closable = ref(false)\r\nconst square = ref(false)\r\n\r\nconst showBadge = ref(true)\r\nconst handleClose = () => {\r\n    console.log('Badge closed!')\r\n}\r\n\r\nconst beforeCloseVerify = () => {\r\n    return new Promise<boolean>((resolve) => {\r\n        setTimeout(() => {\r\n            resolve(window.confirm('确定要删除这个标签吗？'))\r\n        }, 500)\r\n    })\r\n}\r\n</script>\r\n\r\n<template>\r\n    <div class=\"flex flex-col gap-12 w-full pb-24\">\r\n        <!-- Header Section -->\r\n        <div class=\"flex flex-col gap-3\">\r\n            <h2 class=\"text-3xl font-bold tracking-tight text-gray-900 dark:text-white flex items-center gap-3\">\r\n                Badge 徽标\r\n                <RebornBadge size=\"sm\" variant=\"soft\" color=\"primary\">Stable</RebornBadge>\r\n            </h2>\r\n            <p class=\"text-lg text-gray-500 dark:text-gray-400 max-w-2xl\">\r\n                用于展示状态、数量或重要标识的微型标签。支持多种色彩、感官风格及交互状态。\r\n            </p>\r\n        </div>\r\n\r\n        <section class=\"flex flex-col gap-6\">\r\n            <div class=\"flex items-center justify-between\">\r\n                <h3 class=\"text-xl font-semibold text-gray-800 dark:text-gray-200\">交互演练场</h3>\r\n                <div class=\"text-xs font-mono text-gray-400 bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded\">\r\n                    &lt;RebornBadge :color=\"{{ color }}\" :variant=\"{{ variant }}\" ... /&gt;\r\n                </div>\r\n            </div>\r\n\r\n            <div\r\n                class=\"flex flex-col lg:flex-row rounded-3xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 shadow-2xl overflow-hidden\">\r\n                <div\r\n                    class=\"w-full lg:w-80 p-8 border-b lg:border-b-0 lg:border-r border-gray-100 dark:border-gray-900 bg-gray-50/50 dark:bg-gray-900/30 backdrop-blur-xl\">\r\n                    <div class=\"flex flex-col gap-6\">\r\n                        <div class=\"flex flex-col gap-2\">\r\n                            <span class=\"text-[10px] font-bold uppercase tracking-widest text-gray-400\">内容文本</span>\r\n                            <RebornInput v-model=\"label\" placeholder=\"输入标签文字\" />\r\n                        </div>\r\n\r\n                        <div class=\"flex flex-col gap-2\">\r\n                            <span class=\"text-[10px] font-bold uppercase tracking-widest text-gray-400\">预设色彩</span>\r\n                            <RebornSelect v-model=\"color\" :options=\"colorOptions\" />\r\n                        </div>\r\n\r\n                        <div class=\"flex flex-col gap-2\">\r\n                            <span class=\"text-[10px] font-bold uppercase tracking-widest text-gray-400\">视觉风格</span>\r\n                            <RebornSelect v-model=\"variant\" :options=\"variantOptions\" />\r\n                        </div>\r\n\r\n                        <div class=\"flex flex-col gap-2\">\r\n                            <span class=\"text-[10px] font-bold uppercase tracking-widest text-gray-400\">尺寸规格</span>\r\n                            <RebornSelect v-model=\"size\" :options=\"sizeOptions\" />\r\n                        </div>\r\n\r\n                        <div class=\"pt-4 flex flex-col gap-4 border-t border-gray-100 dark:border-gray-800\">\r\n                            <RebornCheckbox v-model=\"closable\" label=\"是否可关闭？\" />\r\n                            <RebornCheckbox v-model=\"square\" label=\"是否为正方形？\" />\r\n                            <RebornCheckbox v-model=\"showBadge\" label=\"是否显示？(v-model:show)\" />\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"flex-1 p-12 flex items-center justify-center min-h-[360px] overflow-hidden group\">\r\n\r\n                    <RebornBadge v-model:show=\"showBadge\" :color=\"color\" :variant=\"variant\" :size=\"size\" :label=\"label\"\r\n                        :closable=\"closable\" :square=\"square\" />\r\n                </div>\r\n            </div>\r\n        </section>\r\n\r\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 mt-4\">\r\n            <section\r\n                class=\"flex flex-col gap-4 border border-gray-200 dark:border-gray-800 rounded-3xl p-8 bg-white/40 dark:bg-gray-900/10 backdrop-blur-sm\">\r\n                <h4 class=\"text-sm font-bold uppercase tracking-widest text-gray-400 mb-2\">变体矩阵 (Variants Matrix)</h4>\r\n                <div v-for=\"v in badgeVariants\" :key=\"v\">\r\n                    <span class=\"text-[10px] font-mono text-gray-400 uppercase tracking-tighter\">{{ v }}</span>\r\n                    <div class=\"flex flex-wrap items-center gap-3\">\r\n                        <RebornBadge v-for=\"c in badgeColors\" :key=\"c\" :variant=\"v\" :color=\"c\" size=\"sm\" :label=\"c\" />\r\n                    </div>\r\n                </div>\r\n            </section>\r\n\r\n            <div class=\"flex flex-col gap-8\">\r\n                <section\r\n                    class=\"flex flex-col gap-4 border border-gray-200 dark:border-gray-800 rounded-3xl p-8 bg-white/40 dark:bg-gray-900/10 backdrop-blur-sm\">\r\n                    <h4 class=\"text-sm font-bold uppercase tracking-widest text-gray-400\">图标集成 (Icons)</h4>\r\n                    <div class=\"flex flex-wrap items-center gap-4\">\r\n                        <RebornBadge color=\"primary\" variant=\"soft\" size=\"md\">\r\n                            <template #leading>\r\n                                <Icon name=\"lucide:star\" class=\"size-3.5 fill-current\" />\r\n                            </template>\r\n                            Star\r\n                        </RebornBadge>\r\n                        <RebornBadge color=\"success\" variant=\"outline\" size=\"md\">\r\n                            <template #trailing>\r\n                                <Icon name=\"lucide:check-circle\" class=\"size-3.5\" />\r\n                            </template>\r\n                            Completed\r\n                        </RebornBadge>\r\n                        <RebornBadge color=\"error\" variant=\"solid\" size=\"lg\" square>\r\n                            <template #default=\"{ ui }\">\r\n                                <Icon name=\"lucide:heart\" :class=\"ui.label()\" />\r\n                            </template>\r\n                        </RebornBadge>\r\n                        <RebornBadge color=\"neutral\" variant=\"subtle\" size=\"sm\">\r\n                            <template #leading>\r\n                                <Icon name=\"lucide:settings\" class=\"size-3 animate-spin-slow\" />\r\n                            </template>\r\n                            Settings\r\n                        </RebornBadge>\r\n                    </div>\r\n                </section>\r\n\r\n                <section\r\n                    class=\"flex flex-col gap-4 border border-gray-200 dark:border-gray-800 rounded-3xl p-8 bg-white/40 dark:bg-gray-900/10 backdrop-blur-sm\">\r\n                    <h4 class=\"text-sm font-bold uppercase tracking-widest text-gray-400\">插槽与扩展 (Slots)</h4>\r\n                    <div class=\"flex flex-wrap items-center gap-4\">\r\n                        <RebornBadge color=\"info\" variant=\"soft\" size=\"md\" closable @close=\"handleClose\">\r\n                            <template #default=\"{ ui }\">\r\n                                <span :class=\"ui.label()\">可关闭标签</span>\r\n                            </template>\r\n                        </RebornBadge>\r\n\r\n                        <RebornBadge color=\"warning\" variant=\"subtle\" size=\"md\" closable>\r\n                            <template #close=\"{ close }\">\r\n                                <span\r\n                                    class=\"ms-2 px-1 text-[10px] bg-warning/20 rounded-sm hover:bg-warning/40 cursor-pointer\"\r\n                                    @click=\"close\">\r\n                                    HIDE\r\n                                </span>\r\n                            </template>\r\n                            自定义关闭\r\n                        </RebornBadge>\r\n\r\n                        <RebornBadge color=\"success\" variant=\"solid\" size=\"md\" closable\r\n                            :before-close=\"beforeCloseVerify\">\r\n                            异步确认关闭\r\n                        </RebornBadge>\r\n\r\n                        <RebornBadge color=\"neutral\" variant=\"outline\" size=\"md\" class=\"py-0 px-1\">\r\n                            <template #leading>\r\n                                <div\r\n                                    class=\"size-6 bg-primary rounded-full flex items-center justify-center text-[10px] text-white font-bold\">\r\n                                    A</div>\r\n                            </template>\r\n                            <span class=\"ms-1\">Avatar Support</span>\r\n                        </RebornBadge>\r\n\r\n                        <RebornBadge color=\"neutral\" variant=\"outline\" size=\"md\" label=\"新品・未开封\" :closable=\"closable\"\r\n                            :square=\"square\" class=\"pl-0\" :ui=\"{ label: 'text-caption-lg' }\">\r\n                            <template #leading>\r\n                                <div\r\n                                    class=\"bg-gradient-to-b from-[#919191] to-[#3C3C3C] h-full text-white flex flex-col justify-center items-center px-1\">\r\n                                    <p class=\"text-[8px]\">N</p>\r\n                                    <span class=\"text-[4px]\">RANK</span>\r\n                                </div>\r\n                            </template>\r\n                        </RebornBadge>\r\n                    </div>\r\n                </section>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<style scoped>\r\n.animate-spin-slow {\r\n    animation: spin 8s linear infinite;\r\n}\r\n\r\n@keyframes spin {\r\n    from {\r\n        transform: rotate(0deg);\r\n    }\r\n\r\n    to {\r\n        transform: rotate(360deg);\r\n    }\r\n}\r\n</style>",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "code": "<script setup lang=\"ts\">\r\nimport { ref } from 'vue'\r\nimport { badgeColors, badgeSizes, badgeVariants } from '@/components/reborn-badge/reborn-badge.config'\r\nimport RebornBadge from '@/components/reborn-badge/RebornBadge.vue'\r\nimport RebornCard from '@/components/reborn-card/RebornCard.vue'\r\nimport RebornPage from '@/components/reborn-page/RebornPage.vue'\r\nimport RebornRadio from '@/components/reborn-radio/RebornRadio.vue'\r\nimport RebornRadioGroup from '@/components/reborn-radio/RebornRadioGroup.vue'\r\nimport RebornSwitch from '@/components/reborn-switch/RebornSwitch.vue'\r\nimport RebornInput from '@/components/reborn-input/RebornInput.vue'\r\n\r\n// 演练场状态\r\nconst color = ref<(typeof badgeColors)[number]>('primary')\r\nconst variant = ref<(typeof badgeVariants)[number]>('solid')\r\nconst size = ref<(typeof badgeSizes)[number]>('md')\r\nconst label = ref('乐一番')\r\nconst closable = ref(false)\r\nconst square = ref(false)\r\nconst showBadge = ref(true)\r\n\r\n/** 处理关闭事件 */\r\nfunction handleClose() {\r\n  uni.showToast({ title: '徽标已关闭！', icon: 'none' })\r\n}\r\n</script>\r\n\r\n<template>\r\n  <RebornPage title=\"Badge 徽标\" description=\"用于展示状态、数量或重要标识的微型标签。支持多种色彩、感官风格及交互状态。\">\r\n\r\n    <!-- Playground Section -->\r\n    <RebornCard title=\"交互演练场\" custom-class=\"overflow-hidden p-0\">\r\n      <!-- Preview -->\r\n      <view class=\"flex-1 p-10 flex items-center justify-center min-h-[300rpx] bg-blue-1\">\r\n        <RebornBadge v-model:show=\"showBadge\" :color=\"color\" :variant=\"variant\" :size=\"size\" :label=\"label\"\r\n          :closable=\"closable\" :square=\"square\" @close=\"handleClose\" />\r\n      </view>\r\n      <!-- Controls -->\r\n      <view class=\"space-y-2\">\r\n        <text class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400\">内容文本</text>\r\n        <RebornInput v-model=\"label\" placeholder=\"输入标签文字\" />\r\n      </view>\r\n\r\n      <view class=\"space-y-2\">\r\n        <text class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400\">预设色彩</text>\r\n        <RebornRadioGroup v-model=\"color\">\r\n          <RebornRadio v-for=\"item in badgeColors\" :key=\"item\" :value=\"item\" :showIcon=\"false\">\r\n            <template #default=\"{ isChecked }\">\r\n              <view class=\"relative flex size-5\">\r\n                <view v-if=\"isChecked\" class=\"absolute inline-flex h-full w-full animate-ping rounded-full opacity-75\"\r\n                  :class=\"`bg-${item}`\">\r\n                </view>\r\n                <view class=\"relative inline-flex size-5 rounded-full\" :class=\"`bg-${item}`\"></view>\r\n              </view>\r\n            </template>\r\n          </RebornRadio>\r\n        </RebornRadioGroup>\r\n      </view>\r\n\r\n      <view class=\"space-y-2\">\r\n        <text class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400\">视觉风格</text>\r\n        <RebornRadioGroup v-model=\"variant\">\r\n          <RebornRadio v-for=\"item in badgeVariants\" :key=\"item\" :value=\"item\" :label=\"item\">\r\n          </RebornRadio>\r\n        </RebornRadioGroup>\r\n      </view>\r\n\r\n      <view class=\"space-y-2\">\r\n        <text class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400\">尺寸规格</text>\r\n        <RebornRadioGroup v-model=\"size\">\r\n          <RebornRadio v-for=\"item in badgeSizes\" :key=\"item\" :value=\"item\" :label=\"item\">\r\n          </RebornRadio>\r\n        </RebornRadioGroup>\r\n      </view>\r\n\r\n      <view class=\"space-y-2\">\r\n        <view class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400\">关闭图标</view>\r\n        <RebornSwitch v-model=\"closable\" active-label=\"显示\" inactive-label=\"隐藏\" />\r\n      </view>\r\n\r\n      <view class=\"space-y-2\">\r\n        <view class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400\">显示控制</view>\r\n        <RebornSwitch v-model=\"showBadge\" active-label=\"显示\" inactive-label=\"隐藏\" />\r\n      </view>\r\n\r\n    </RebornCard>\r\n\r\n    <!-- Variants Matrix -->\r\n    <RebornCard title=\"变体矩阵 (Variants Matrix)\">\r\n      <view v-for=\"v in badgeVariants\" :key=\"v\">\r\n        <text class=\"text-[10px] font-mono text-slate-400 uppercase tracking-widest\">{{ v }}</text>\r\n        <view class=\"flex flex-wrap items-center gap-1\">\r\n          <RebornBadge v-for=\"c in badgeColors\" :key=\"c\" :variant=\"v\" :color=\"c\" size=\"sm\" :label=\"c\" />\r\n        </view>\r\n      </view>\r\n    </RebornCard>\r\n\r\n    <!-- Icons & Slots -->\r\n    <RebornCard title=\"图标集成 (Icons)\">\r\n      <view>\r\n        <RebornBadge icon=\"i-lucide-check\" label=\"Success\" color=\"success\" />\r\n        <RebornBadge icon=\"i-lucide-alert-circle\" label=\"Warning\" color=\"warning\" gap />\r\n        <RebornBadge icon=\"i-lucide-info\" label=\"Info\" color=\"info\" gap />\r\n        <RebornBadge icon=\"i-lucide-star\" square color=\"primary\" variant=\"soft\" gap />\r\n      </view>\r\n    </RebornCard>\r\n  </RebornPage>\r\n</template>\r\n",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [
    "reborn-transition"
  ],
  "whenToUse": [
    "标记条目状态（成功/警告/错误等语义色）或数量时。",
    "标签需要可关闭交互，含关闭前异步确认（beforeClose）时。",
    "需要 v-model:show 控制徽标显隐时。"
  ],
  "whenNotToUse": [
    "可选中、可交互的筛选标签，改用 reborn-chip。",
    "独立的按钮操作，改用 reborn-button。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端可用；closeIcon 默认值双端不同（web 为 i-lucide-x，uniapp 为 i-mdi-close-circle）。",
    "icon prop 直接传图标类名，web 端建议改用 leading/trailing 插槽。",
    "uniapp 端为避免原生 class 冲突提供了 customClass；click 事件仅 uniapp 端显式定义。",
    "默认插槽内容会覆盖 label；gap 用于多个徽标并排时自动加左间距。"
  ],
