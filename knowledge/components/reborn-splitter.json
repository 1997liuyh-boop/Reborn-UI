{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-splitter",
  "title": "分隔面板 Splitter",
  "description": "用于将区域按水平或垂直方向分隔、可拖动调整各面板大小的布局组件。",
  "category": "layout",
  "tags": [
    "css",
    "tailwind",
    "splitter",
    "layout"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "layout",
      "type": "'horizontal' | 'vertical'",
      "required": false,
      "description": "分隔面板的布局方向。可选值: `horizontal`, `vertical`。",
      "default": "'horizontal'",
      "options": [
        "horizontal",
        "vertical"
      ]
    },
    {
      "name": "lazy",
      "type": "boolean",
      "required": false,
      "description": "是否使用懒加载（拖动结束后才更新面板大小）。",
      "default": "false"
    },
    {
      "name": "class",
      "type": "ClassValue",
      "required": false,
      "description": ""
    },
    {
      "name": "ui",
      "type": "Partial<{\n    root: ClassValue\n    panel: ClassValue\n    bar: ClassValue\n    collapseButton: ClassValue\n  }>",
      "required": false,
      "description": ""
    },
    {
      "name": "size",
      "type": "string | number",
      "required": false,
      "description": "面板大小(像素或百分比)。支持 v-model:size。"
    },
    {
      "name": "min",
      "type": "string | number",
      "required": false,
      "description": "面板最小尺寸(像素或百分比)。"
    },
    {
      "name": "max",
      "type": "string | number",
      "required": false,
      "description": "面板的最大尺寸(像素或百分比)。"
    },
    {
      "name": "resizable",
      "type": "boolean",
      "required": false,
      "description": "是否可以调整面板大小。",
      "default": "true"
    },
    {
      "name": "collapsible",
      "type": "boolean",
      "required": false,
      "description": "面板是否可折叠。",
      "default": "false"
    }
  ],
  "events": [
    {
      "name": "resize-start",
      "payload": "(e: 'resize-start', index: number): void",
      "description": "开始调整面板大小时触发，index 是拖拽条的索引。"
    },
    {
      "name": "resize",
      "payload": "(e: 'resize', index: number): void",
      "description": "调整面板大小时触发，index 是拖拽条的索引。"
    },
    {
      "name": "resize-end",
      "payload": "(e: 'resize-end', index: number): void",
      "description": "面板调整大小结束时触发，index 是拖拽条的索引。"
    },
    {
      "name": "collapse",
      "payload": "(e: 'collapse', index: number): void",
      "description": "当面板折叠时触发，index 是拖拽条的索引。"
    },
    {
      "name": "update:size",
      "payload": "(e: 'update:size', value: string | number): void",
      "description": "当面板大小改变时触发。"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "面板的默认内容。"
    },
    {
      "name": "bar",
      "description": "自定义拖拽条内容。"
    },
    {
      "name": "start-collapsible",
      "description": "自定义起始折叠按钮的内容。"
    },
    {
      "name": "end-collapsible",
      "description": "结束可折叠按钮的自定义内容。"
    }
  ],
  "exposes": [
    {
      "name": "splitterRef",
      "description": ""
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "code": "<script setup lang=\"ts\">\nconst size1 = ref(50);\nconst size2 = ref(30);\n</script>\n\n<template>\n  <div class=\"flex w-full min-w-0 flex-col\">\n    <DemoSection\n      title=\"基础用法\"\n      description=\"未传入默认尺寸时，面板自动平均分配。描边盒是分割容器的演示体，内部面板只靠文字区分。\"\n    >\n      <DemoBlock\n        layout=\"stack\"\n        tone=\"inset\"\n      >\n        <div class=\"h-64\">\n          <RebornSplitter>\n            <RebornSplitterPanel>\n              <div class=\"text-muted flex h-full items-center justify-center text-sm\">面板 1</div>\n            </RebornSplitterPanel>\n            <RebornSplitterPanel>\n              <div class=\"text-muted flex h-full items-center justify-center text-sm\">面板 2</div>\n            </RebornSplitterPanel>\n          </RebornSplitter>\n        </div>\n      </DemoBlock>\n    </DemoSection>\n\n    <DemoSection\n      title=\"垂直布局\"\n      description=\"layout=vertical 时拖动手柄横向分割。\"\n    >\n      <DemoBlock\n        layout=\"stack\"\n        tone=\"inset\"\n      >\n        <div class=\"h-64\">\n          <RebornSplitter layout=\"vertical\">\n            <RebornSplitterPanel>\n              <div class=\"text-muted flex h-full items-center justify-center text-sm\">面板 1</div>\n            </RebornSplitterPanel>\n            <RebornSplitterPanel>\n              <div class=\"text-muted flex h-full items-center justify-center text-sm\">面板 2</div>\n            </RebornSplitterPanel>\n            <RebornSplitterPanel>\n              <div class=\"text-muted flex h-full items-center justify-center text-sm\">面板 3</div>\n            </RebornSplitterPanel>\n          </RebornSplitter>\n        </div>\n      </DemoBlock>\n    </DemoSection>\n\n    <DemoSection\n      title=\"可折叠\"\n      description=\"collapsible 提供快速收缩；min 防止折叠后再被拖开。\"\n    >\n      <DemoBlock\n        layout=\"stack\"\n        tone=\"inset\"\n      >\n        <div class=\"h-64\">\n          <RebornSplitter>\n            <RebornSplitterPanel\n              collapsible\n              :min=\"50\"\n            >\n              <div class=\"text-muted flex h-full items-center justify-center text-sm\">可折叠面板 1</div>\n            </RebornSplitterPanel>\n            <RebornSplitterPanel\n              collapsible\n              :min=\"50\"\n            >\n              <div class=\"text-muted flex h-full items-center justify-center text-sm\">可折叠面板 2</div>\n            </RebornSplitterPanel>\n            <RebornSplitterPanel>\n              <div class=\"text-muted flex h-full items-center justify-center text-sm\">面板 3</div>\n            </RebornSplitterPanel>\n          </RebornSplitter>\n        </div>\n      </DemoBlock>\n    </DemoSection>\n\n    <DemoSection\n      title=\"禁用拖动\"\n      description=\"任一面板 resizable=false 时，整组拖拽被禁用。\"\n    >\n      <DemoBlock\n        layout=\"stack\"\n        tone=\"inset\"\n      >\n        <div class=\"h-64\">\n          <RebornSplitter>\n            <RebornSplitterPanel\n              :resizable=\"false\"\n              :size=\"30\"\n            >\n              <div class=\"text-muted flex h-full items-center justify-center text-sm\">禁用拖动面板 1</div>\n            </RebornSplitterPanel>\n            <RebornSplitterPanel :size=\"40\">\n              <div class=\"text-muted flex h-full items-center justify-center text-sm\">面板 2</div>\n            </RebornSplitterPanel>\n            <RebornSplitterPanel>\n              <div class=\"text-muted flex h-full items-center justify-center text-sm\">面板 3</div>\n            </RebornSplitterPanel>\n          </RebornSplitter>\n        </div>\n      </DemoBlock>\n    </DemoSection>\n\n    <DemoSection\n      title=\"面板大小\"\n      description=\"v-model:size 可以获取并回写面板占比。\"\n    >\n      <DemoBlock\n        layout=\"stack\"\n        tone=\"inset\"\n      >\n        <div class=\"h-64\">\n          <RebornSplitter>\n            <RebornSplitterPanel v-model:size=\"size1\">\n              <div class=\"text-muted flex h-full flex-col items-center justify-center text-sm\">\n                <span>面板 1</span>\n                <span class=\"text-dimmed mt-1\">大小：{{ size1 }}%</span>\n              </div>\n            </RebornSplitterPanel>\n            <RebornSplitterPanel v-model:size=\"size2\">\n              <div class=\"text-muted flex h-full flex-col items-center justify-center text-sm\">\n                <span>面板 2</span>\n                <span class=\"text-dimmed mt-1\">大小：{{ size2 }}%</span>\n              </div>\n            </RebornSplitterPanel>\n            <RebornSplitterPanel>\n              <div class=\"text-muted flex h-full items-center justify-center text-sm\">面板 3</div>\n            </RebornSplitterPanel>\n          </RebornSplitter>\n        </div>\n      </DemoBlock>\n    </DemoSection>\n\n    <DemoSection\n      title=\"延迟\"\n      description=\"开启 lazy 后，面板大小只在拖动结束时更新，拖动过程中不实时回流。\"\n    >\n      <DemoBlock\n        layout=\"stack\"\n        tone=\"inset\"\n      >\n        <div class=\"h-64\">\n          <RebornSplitter lazy>\n            <RebornSplitterPanel>\n              <div class=\"text-muted flex h-full items-center justify-center text-sm\">面板 1（延迟更新）</div>\n            </RebornSplitterPanel>\n            <RebornSplitterPanel>\n              <div class=\"text-muted flex h-full items-center justify-center text-sm\">面板 2（延迟更新）</div>\n            </RebornSplitterPanel>\n            <RebornSplitterPanel>\n              <div class=\"text-muted flex h-full items-center justify-center text-sm\">面板 3（延迟更新）</div>\n            </RebornSplitterPanel>\n          </RebornSplitter>\n        </div>\n      </DemoBlock>\n    </DemoSection>\n  </div>\n</template>\n",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "编辑器、控制台等需要用户自由调整左右或上下面板比例的布局。",
    "需要面板可折叠（collapsible，配合 start-collapsible / end-collapsible 插槽自定义折叠按钮）。",
    "拖动性能敏感时开启 lazy，拖动结束后才更新面板大小。"
  ],
  "whenNotToUse": [
    "固定比例、无需用户拖拽的布局，直接用普通布局或 reborn-container。",
    "uniapp 端项目：platforms 仅 web，无 uniapp 实现。"
  ],
  "pitfalls": [
    "platforms 仅 web 端提供。",
    "面板的 size / min / max 支持数字或字符串两种写法。",
    "resizable 默认 true、collapsible 默认 false；折叠时触发 collapse 事件，index 为拖拽条索引。"
  ],
  "dependencies": [
    "clsx"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-splitter"
  },
