{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-splitter",
  "title": "分隔面板 Splitter",
  "description": "用于将区域按水平或垂直方向分隔、可拖动调整各面板大小的布局组件。",
  "category": "layout",
  "tags": [
    "css",
    "tailwind",
    "splitter",
    "layout"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "layout",
      "type": "'horizontal' | 'vertical'",
      "required": false,
      "description": "分隔面板的布局方向。可选值: `horizontal`, `vertical`。",
      "default": "'horizontal'",
      "options": [
        "horizontal",
        "vertical"
      ]
    },
    {
      "name": "lazy",
      "type": "boolean",
      "required": false,
      "description": "是否使用懒加载（拖动结束后才更新面板大小）。",
      "default": "false"
    },
    {
      "name": "class",
      "type": "ClassValue",
      "required": false,
      "description": ""
    },
    {
      "name": "ui",
      "type": "Partial<{\n    root: ClassValue\n    panel: ClassValue\n    bar: ClassValue\n    collapseButton: ClassValue\n  }>",
      "required": false,
      "description": ""
    },
    {
      "name": "size",
      "type": "string | number",
      "required": false,
      "description": "-",
      "default": "number"
    },
    {
      "name": "min",
      "type": "string | number",
      "required": false,
      "description": "-",
      "default": "number"
    },
    {
      "name": "max",
      "type": "string | number",
      "required": false,
      "description": "-",
      "default": "number"
    },
    {
      "name": "resizable",
      "type": "boolean",
      "required": false,
      "description": "是否可以调整面板大小。",
      "default": "true"
    },
    {
      "name": "collapsible",
      "type": "boolean",
      "required": false,
      "description": "面板是否可折叠。",
      "default": "false"
    }
  ],
  "events": [
    {
      "name": "resize-start",
      "payload": "(e: 'resize-start', index: number): void",
      "description": "开始调整面板大小时触发，index 是拖拽条的索引。"
    },
    {
      "name": "resize",
      "payload": "(e: 'resize', index: number): void",
      "description": "调整面板大小时触发，index 是拖拽条的索引。"
    },
    {
      "name": "resize-end",
      "payload": "(e: 'resize-end', index: number): void",
      "description": "面板调整大小结束时触发，index 是拖拽条的索引。"
    },
    {
      "name": "collapse",
      "payload": "(e: 'collapse', index: number): void",
      "description": "当面板折叠时触发，index 是拖拽条的索引。"
    },
    {
      "name": "update:size",
      "payload": "(e: 'update:size', value: string | number): void",
      "description": "number)"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "面板的默认内容。"
    },
    {
      "name": "bar",
      "description": "自定义拖拽条内容。"
    },
    {
      "name": "start-collapsible",
      "description": "自定义起始折叠按钮的内容。"
    },
    {
      "name": "end-collapsible",
      "description": "结束可折叠按钮的自定义内容。"
    }
  ],
  "exposes": [
    {
      "name": "splitterRef",
      "description": ""
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "code": "<script setup lang=\"ts\">\nimport { ref } from 'vue'\n\nconst size1 = ref(50)\nconst size2 = ref(30)\n</script>\n\n<template>\n  <div class=\"space-y-8\">\n    <!-- 基础用法 -->\n    <div>\n      <h3 class=\"text-lg font-semibold mb-4\">基础用法</h3>\n      <p class=\"text-sm text-gray-600 mb-4\">最基本的用法，如果未传入默认尺寸，将自动平均分配。</p>\n      <div class=\"h-64 border border-gray-200 rounded-lg\">\n        <RebornSplitter>\n          <RebornSplitterPanel>\n            <div class=\"h-full bg-blue-50 p-4 flex items-center justify-center\">\n              面板 1\n            </div>\n          </RebornSplitterPanel>\n          <RebornSplitterPanel>\n            <div class=\"h-full bg-green-50 p-4 flex items-center justify-center\">\n              面板 2\n            </div>\n          </RebornSplitterPanel>\n        </RebornSplitter>\n      </div>\n    </div>\n\n    <!-- 垂直布局 -->\n    <div>\n      <h3 class=\"text-lg font-semibold mb-4\">垂直布局</h3>\n      <p class=\"text-sm text-gray-600 mb-4\">使用垂直方向。</p>\n      <div class=\"h-64 border border-gray-200 rounded-lg\">\n        <RebornSplitter layout=\"vertical\">\n          <RebornSplitterPanel>\n            <div class=\"h-full bg-blue-50 p-4 flex items-center justify-center\">\n              面板 1\n            </div>\n          </RebornSplitterPanel>\n          <RebornSplitterPanel>\n            <div class=\"h-full bg-green-50 p-4 flex items-center justify-center\">\n              面板 2\n            </div>\n          </RebornSplitterPanel>\n          <RebornSplitterPanel>\n            <div class=\"h-full bg-yellow-50 p-4 flex items-center justify-center\">\n              面板 3\n            </div>\n          </RebornSplitterPanel>\n        </RebornSplitter>\n      </div>\n    </div>\n\n    <!-- 可折叠 -->\n    <div>\n      <h3 class=\"text-lg font-semibold mb-4\">可折叠</h3>\n      <p class=\"text-sm text-gray-600 mb-4\">\n        配置 collapsible 可提供快速收缩功能。可以使用 min 属性来防止折叠后通过拖拽进行扩展。\n      </p>\n      <div class=\"h-64 border border-gray-200 rounded-lg\">\n        <RebornSplitter>\n          <RebornSplitterPanel collapsible :min=\"50\">\n            <div class=\"h-full bg-blue-50 p-4 flex items-center justify-center\">\n              可折叠面板 1\n            </div>\n          </RebornSplitterPanel>\n          <RebornSplitterPanel collapsible :min=\"50\">\n            <div class=\"h-full bg-green-50 p-4 flex items-center justify-center\">\n              可折叠面板 2\n            </div>\n          </RebornSplitterPanel>\n          <RebornSplitterPanel>\n            <div class=\"h-full bg-yellow-50 p-4 flex items-center justify-center\">\n              面板 3\n            </div>\n          </RebornSplitterPanel>\n        </RebornSplitter>\n      </div>\n    </div>\n\n    <!-- 禁用拖动 -->\n    <div>\n      <h3 class=\"text-lg font-semibold mb-4\">禁用拖动</h3>\n      <p class=\"text-sm text-gray-600 mb-4\">\n        当任一面板禁用 resizable 时，拖拽功能将被禁用。\n      </p>\n      <div class=\"h-64 border border-gray-200 rounded-lg\">\n        <RebornSplitter>\n          <RebornSplitterPanel :resizable=\"false\" :size=\"30\">\n            <div class=\"h-full bg-blue-50 p-4 flex items-center justify-center\">\n              禁用拖动面板 1\n            </div>\n          </RebornSplitterPanel>\n          <RebornSplitterPanel :size=\"40\">\n            <div class=\"h-full bg-green-50 p-4 flex items-center justify-center\">\n              面板 2\n            </div>\n          </RebornSplitterPanel>\n          <RebornSplitterPanel>\n            <div class=\"h-full bg-yellow-50 p-4 flex items-center justify-center\">\n              面板 3\n            </div>\n          </RebornSplitterPanel>\n        </RebornSplitter>\n      </div>\n    </div>\n\n    <!-- 面板大小 -->\n    <div>\n      <h3 class=\"text-lg font-semibold mb-4\">面板大小</h3>\n      <p class=\"text-sm text-gray-600 mb-4\">\n        v-model:size 可以获取面板的大小。\n      </p>\n      <div class=\"h-64 border border-gray-200 rounded-lg\">\n        <RebornSplitter>\n          <RebornSplitterPanel v-model:size=\"size1\">\n            <div class=\"h-full bg-blue-50 p-4 flex flex-col items-center justify-center\">\n              <span>面板 1</span>\n              <span class=\"text-sm text-gray-600 mt-2\">大小: {{ size1 }}%</span>\n            </div>\n          </RebornSplitterPanel>\n          <RebornSplitterPanel v-model:size=\"size2\">\n            <div class=\"h-full bg-green-50 p-4 flex flex-col items-center justify-center\">\n              <span>面板 2</span>\n              <span class=\"text-sm text-gray-600 mt-2\">大小: {{ size2 }}%</span>\n            </div>\n          </RebornSplitterPanel>\n          <RebornSplitterPanel>\n            <div class=\"h-full bg-yellow-50 p-4 flex items-center justify-center\">\n              面板 3\n            </div>\n          </RebornSplitterPanel>\n        </RebornSplitter>\n      </div>\n    </div>\n\n    <!-- 延迟 -->\n    <div>\n      <h3 class=\"text-lg font-semibold mb-4\">延迟</h3>\n      <p class=\"text-sm text-gray-600 mb-4\">\n        当启用 lazy 时，面板大小将不会在拖动时实时更新，只能在拖动结束后更新。\n      </p>\n      <div class=\"h-64 border border-gray-200 rounded-lg\">\n        <RebornSplitter lazy>\n          <RebornSplitterPanel>\n            <div class=\"h-full bg-blue-50 p-4 flex items-center justify-center\">\n              面板 1 (延迟更新)\n            </div>\n          </RebornSplitterPanel>\n          <RebornSplitterPanel>\n            <div class=\"h-full bg-green-50 p-4 flex items-center justify-center\">\n              面板 2 (延迟更新)\n            </div>\n          </RebornSplitterPanel>\n          <RebornSplitterPanel>\n            <div class=\"h-full bg-yellow-50 p-4 flex items-center justify-center\">\n              面板 3 (延迟更新)\n            </div>\n          </RebornSplitterPanel>\n        </RebornSplitter>\n      </div>\n    </div>\n  </div>\n</template>",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "编辑器、控制台等需要用户自由调整左右或上下面板比例的布局。",
    "需要面板可折叠（collapsible，配合 start-collapsible / end-collapsible 插槽自定义折叠按钮）。",
    "拖动性能敏感时开启 lazy，拖动结束后才更新面板大小。"
  ],
  "whenNotToUse": [
    "固定比例、无需用户拖拽的布局，直接用普通布局或 reborn-container。",
    "uniapp 端项目：platforms 仅 web，无 uniapp 实现。"
  ],
  "pitfalls": [
    "platforms 仅 web 端提供。",
    "面板的 size / min / max 支持数字或字符串两种写法。",
    "resizable 默认 true、collapsible 默认 false；折叠时触发 collapse 事件，index 为拖拽条索引。"
  ],
  "dependencies": [
    "clsx"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-splitter"
  },
