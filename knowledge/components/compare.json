{
  "$schema": "../schema/component.schema.json",
  "id": "compare",
  "title": "对比",
  "description": "用于以滑动分割线对比两张图片或两块自定义内容的对比组件。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind",
    "aceternity-ui"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "firstImage",
      "type": "string",
      "required": false,
      "description": "第一张图片的 URL。",
      "default": "\"\""
    },
    {
      "name": "secondImage",
      "type": "string",
      "required": false,
      "description": "第二张图片的 URL。",
      "default": "\"\""
    },
    {
      "name": "firstImageAlt",
      "type": "string",
      "required": false,
      "description": "第一张图片的替代文本。",
      "default": "\"First image\""
    },
    {
      "name": "secondImageAlt",
      "type": "string",
      "required": false,
      "description": "第二张图片的替代文本。",
      "default": "\"Second image\""
    },
    {
      "name": "class",
      "type": "string",
      "required": false,
      "description": "组件的额外类名。",
      "default": "\"\""
    },
    {
      "name": "firstContentClass",
      "type": "string",
      "required": false,
      "description": "应用于第一侧内容包装器的类。",
      "default": "\"\""
    },
    {
      "name": "secondContentClass",
      "type": "string",
      "required": false,
      "description": "应用于第二侧内容包装器的类。",
      "default": "\"\""
    },
    {
      "name": "initialSliderPercentage",
      "type": "number",
      "required": false,
      "description": "滑块初始位置（0-100）。",
      "default": "50"
    },
    {
      "name": "slideMode",
      "type": "\"hover\" | \"drag\"",
      "required": false,
      "description": "滑块的交互模式。",
      "default": "\"hover\""
    },
    {
      "name": "showHandlebar",
      "type": "boolean",
      "required": false,
      "description": "是否显示手柄。",
      "default": "true"
    },
    {
      "name": "autoplay",
      "type": "boolean",
      "required": false,
      "description": "是否启用自动播放。",
      "default": "false"
    },
    {
      "name": "autoplayDuration",
      "type": "number",
      "required": false,
      "description": "自动播放周期（毫秒）。",
      "default": "5000"
    },
    {
      "name": "starsCount",
      "type": "number",
      "required": false,
      "description": "",
      "default": "130"
    }
  ],
  "events": [
    {
      "name": "update:percentage",
      "payload": "(e: \"update:percentage\", value: number): void;",
      "description": "滑块位置变化时触发（0-100）。"
    },
    {
      "name": "drag:start",
      "payload": "(e: \"drag:start\"): void;",
      "description": "开始拖动时触发。"
    },
    {
      "name": "drag:end",
      "payload": "(e: \"drag:end\"): void;",
      "description": "结束拖动时触发。"
    },
    {
      "name": "hover:enter",
      "payload": "(e: \"hover:enter\"): void;",
      "description": "鼠标进入组件时触发。"
    },
    {
      "name": "hover:leave",
      "payload": "(e: \"hover:leave\"): void;",
      "description": "鼠标离开组件时触发。"
    }
  ],
  "slots": [
    {
      "name": "handle",
      "description": "自定义滑块手柄，需自行使用绝对定位放在分割线处。"
    },
    {
      "name": "first-content",
      "description": "左/第一侧展示的内容，拥有容器的全部宽高。"
    },
    {
      "name": "second-content",
      "description": "右/第二侧展示的内容，拥有容器的全部宽高。"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/compare/CompareAutoplayDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/compare/CompareCustomContentDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/compare/CompareDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/compare/CompareDragDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "明暗主题、改版前后等两张截图的滑动对比。",
    "通过 first-content / second-content 插槽对比两段代码或任意自定义内容。",
    "需要 autoplay 自动往返演示对比效果的营销区块。"
  ],
  "whenNotToUse": [
    "多张图片轮播展示，改用 images-slider 或 reborn-carousel。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "slideMode 默认 \"hover\"（悬停即滑动），需要拖动手柄交互时设为 \"drag\"。",
    "不传 firstImage / secondImage 时必须用 first-content / second-content 插槽提供内容，插槽内容占满容器宽高。",
    "自定义 handle 插槽需自行用绝对定位放在分割线处。",
    "滑块位置通过 update:percentage 事件（0-100）监听。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add compare"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/compare/Compare.vue",
      "app/components/reborn/ui/compare/StarField.vue",
      "app/components/reborn/ui/compare/index.ts"
    ]
  },
