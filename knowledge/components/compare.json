{
  "$schema": "../schema/component.schema.json",
  "id": "compare",
  "title": "对比",
  "description": "用于以滑动分割线对比两张图片或两块自定义内容的对比组件。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind",
    "aceternity-ui"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "firstImage",
      "type": "string",
      "required": false,
      "description": "第一张图片的 URL。",
      "default": "\"\""
    },
    {
      "name": "secondImage",
      "type": "string",
      "required": false,
      "description": "第二张图片的 URL。",
      "default": "\"\""
    },
    {
      "name": "firstImageAlt",
      "type": "string",
      "required": false,
      "description": "第一张图片的替代文本。",
      "default": "\"First image\""
    },
    {
      "name": "secondImageAlt",
      "type": "string",
      "required": false,
      "description": "第二张图片的替代文本。",
      "default": "\"Second image\""
    },
    {
      "name": "class",
      "type": "string",
      "required": false,
      "description": "组件的额外类名。",
      "default": "\"\""
    },
    {
      "name": "firstContentClass",
      "type": "string",
      "required": false,
      "description": "应用于第一侧内容包装器的类。",
      "default": "\"\""
    },
    {
      "name": "secondContentClass",
      "type": "string",
      "required": false,
      "description": "应用于第二侧内容包装器的类。",
      "default": "\"\""
    },
    {
      "name": "initialSliderPercentage",
      "type": "number",
      "required": false,
      "description": "滑块初始位置（0-100）。",
      "default": "50"
    },
    {
      "name": "slideMode",
      "type": "\"hover\" | \"drag\"",
      "required": false,
      "description": "滑块的交互模式。",
      "default": "\"hover\""
    },
    {
      "name": "showHandlebar",
      "type": "boolean",
      "required": false,
      "description": "是否显示手柄。",
      "default": "true"
    },
    {
      "name": "autoplay",
      "type": "boolean",
      "required": false,
      "description": "是否启用自动播放。",
      "default": "false"
    },
    {
      "name": "autoplayDuration",
      "type": "number",
      "required": false,
      "description": "自动播放周期（毫秒）。",
      "default": "5000"
    },
    {
      "name": "starsCount",
      "type": "number",
      "required": false,
      "description": "",
      "default": "130"
    }
  ],
  "events": [
    {
      "name": "update:percentage",
      "payload": "(e: \"update:percentage\", value: number): void;",
      "description": "滑块位置变化时触发（0-100）。"
    },
    {
      "name": "drag:start",
      "payload": "(e: \"drag:start\"): void;",
      "description": "开始拖动时触发。"
    },
    {
      "name": "drag:end",
      "payload": "(e: \"drag:end\"): void;",
      "description": "结束拖动时触发。"
    },
    {
      "name": "hover:enter",
      "payload": "(e: \"hover:enter\"): void;",
      "description": "鼠标进入组件时触发。"
    },
    {
      "name": "hover:leave",
      "payload": "(e: \"hover:leave\"): void;",
      "description": "鼠标离开组件时触发。"
    }
  ],
  "slots": [
    {
      "name": "handle",
      "description": "自定义滑块手柄，需自行使用绝对定位放在分割线处。"
    },
    {
      "name": "first-content",
      "description": "左/第一侧展示的内容，拥有容器的全部宽高。"
    },
    {
      "name": "second-content",
      "description": "右/第二侧展示的内容，拥有容器的全部宽高。"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "code": "<template>\n  <div class=\"flex h-[60vh] w-full items-center justify-center px-1 [perspective:800px] [transform-style:preserve-3d] md:px-8\">\n    <!-- 外层是承载对比控件的机身外框，属于被演示对象的一部分 -->\n    <div\n      class=\"border-default bg-elevated rounded-ui-lg mx-auto h-1/2 w-3/4 border p-1 md:h-3/4 md:p-4\"\n      :style=\"{ transform: 'rotateX(15deg) translateZ(80px)' }\"\n    >\n      <Compare\n        first-image=\"https://cdn.reborn-ui.com/images/reborn-light.png\"\n        second-image=\"https://cdn.reborn-ui.com/images/reborn-dark.png\"\n        first-content-class=\"object-cover object-left-center w-full h-96\"\n        second-content-class=\"object-cover object-left-center w-full h-96\"\n        class=\"rounded-ui-md size-full\"\n        slide-mode=\"hover\"\n        :autoplay=\"true\"\n      />\n    </div>\n  </div>\n</template>\n",
