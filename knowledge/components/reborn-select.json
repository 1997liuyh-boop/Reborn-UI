{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-select",
  "title": "下拉选择",
  "description": "用于从选项列表中单选或多选的双端下拉选择组件，uniapp 端为弹层滚动选择。",
  "category": "form",
  "tags": [
    "css",
    "tailwind",
    "select",
    "dropdown",
    "uniapp"
  ],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "modelValue",
      "type": "SelectValue",
      "required": false,
      "description": "选择器的值",
      "default": "null"
    },
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "标题",
      "default": "'请选择'"
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "description": "占位符",
      "default": "'请选择'"
    },
    {
      "name": "options",
      "type": "SelectOption[]",
      "required": false,
      "description": "选项数据",
      "default": "() => []"
    },
    {
      "name": "showTrigger",
      "type": "boolean",
      "required": false,
      "description": "是否显示触发器",
      "default": "true"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用",
      "default": "false"
    },
    {
      "name": "columnCount",
      "type": "number",
      "required": false,
      "description": "列数",
      "default": "1"
    },
    {
      "name": "splitor",
      "type": "string",
      "required": false,
      "description": "分隔符",
      "default": "' - '"
    },
    {
      "name": "confirmText",
      "type": "string",
      "required": false,
      "description": "确认按钮文本",
      "default": "'确定'"
    },
    {
      "name": "showConfirm",
      "type": "boolean",
      "required": false,
      "description": "是否显示确认按钮",
      "default": "true"
    },
    {
      "name": "cancelText",
      "type": "string",
      "required": false,
      "description": "取消按钮文本",
      "default": "'取消'"
    },
    {
      "name": "showCancel",
      "type": "boolean",
      "required": false,
      "description": "是否显示取消按钮",
      "default": "true"
    },
    {
      "name": "clearable",
      "type": "boolean",
      "required": false,
      "description": "是否显示清空按钮",
      "default": "true"
    },
    {
      "name": "color",
      "type": "typeof selectColors[number]",
      "required": false,
      "description": "颜色",
      "default": "'primary'"
    },
    {
      "name": "size",
      "type": "typeof selectSizes[number]",
      "required": false,
      "description": "尺寸",
      "default": "'lg'"
    },
    {
      "name": "ui",
      "type": "Partial<{\n    empty: ClassValue\n    buttons: ClassValue\n    emptyText: ClassValue\n    cancel: ClassValue\n    cancelButton: ClassValue\n    confirm: ClassValue\n    confirmButton: ClassValue\n  }>",
      "required": false,
      "description": "用于覆盖 `RebornSelect` 内部（如选项列表）样式的 UI 配置对象。",
      "default": "{}"
    },
    {
      "name": "triggerUi",
      "type": "Partial<{\n    wrapper: ClassValue\n    content: ClassValue\n    text: ClassValue\n    placeholder: ClassValue\n    iconWrapper: ClassValue\n    clearIcon: ClassValue\n    arrowIcon: ClassValue\n  }>",
      "required": false,
      "description": "样式覆盖",
      "default": "{}"
    },
    {
      "name": "popupUi",
      "type": "Partial<{\n    wrapper: ClassValue\n    mask: ClassValue\n    popup: ClassValue\n    inner: ClassValue\n    draw: ClassValue\n    header: ClassValue\n    title: ClassValue\n    container: ClassValue\n  }>",
      "required": false,
      "description": "底部弹出层（RebornPopup）样式覆盖对象，可重写遮罩、面板、头部、标题等区域"
    },
    {
      "name": "pickerUi",
      "type": "Partial<{\n    wrapper: ClassValue\n    header: ClassValue\n    headerText: ClassValue\n    pickerContainer: ClassValue\n    item: ClassValue\n    itemText: ClassValue\n    indicator: ClassValue\n  }>",
      "required": false,
      "description": "滚轮选择器（RebornPickerView）样式覆盖对象，可重写表头、选项、指示器等区域"
    },
    {
      "name": "multiple",
      "type": "boolean",
      "required": false,
      "description": "是否开启多选模式",
      "default": "false"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "自定义类名"
    },
    {
      "name": "bordered",
      "type": "boolean",
      "required": false,
      "description": "是否显示边框",
      "default": "true"
    },
    {
      "name": "showArrow",
      "type": "boolean",
      "required": false,
      "description": "是否显示箭头",
      "default": "true"
    },
    {
      "name": "arrowAnimation",
      "type": "boolean",
      "required": false,
      "description": "展开时箭头是否旋转",
      "default": "true"
    },
    {
      "name": "closeOn",
      "type": "SelectTriggerProps[\"closeOn\"]",
      "required": false,
      "description": "关闭下拉的时机（透传给 RebornSelectTrigger）： - 'click'：在触发器外完成一次点击后才收起（默认） - 'mousedown'：在触发器外发生任意按下类鼠标事件立即收起",
      "default": "\"click\""
    },
    {
      "name": "portal",
      "type": "SelectTriggerProps[\"portal\"]",
      "required": false,
      "description": "浮层是否传送到 body（默认 true）。 关掉后浮层留在触发器内，会随父容器一起滚动、也一起被 overflow 裁剪。",
      "default": "true"
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "payload": "(e: 'update:modelValue', value: SelectValue): void",
      "description": "更新绑定值。"
    },
    {
      "name": "change",
      "payload": "(e: 'change', value: SelectValue, select: any): void",
      "description": "选择值改变时触发。Web 版本在选择时立即触发，UniApp 版本在确认后触发。"
    },
    {
      "name": "changing",
      "payload": "(e: 'changing', value: SelectValue): void",
      "description": "滚动列表选项正在改变时触发（未确认）。"
    }
  ],
  "slots": [
    {
      "name": "tag",
      "props": "(props: { selectItem: any[] }) => any",
      "description": "自定义选择后在触发器中显示的标签内容。`selectItem` 为当前选中的完整选项对象数组。"
    },
    {
      "name": "prepend",
      "props": "() => any",
      "description": "在选择列表上方插入自定义内容，位于 `RebornPickerView` 之前。"
    },
    {
      "name": "append",
      "props": "() => any",
      "description": "在选择列表下方插入自定义内容，位于 `RebornPickerView` 之后、按钮区域之前。"
    },
    {
      "name": "option",
      "props": "(props: { item: SelectOption, index: number }) => any",
      "description": "自定义选项渲染内容。Web 版本提供 `option` 对象和 `active` 状态。"
    },
    {
      "name": "empty",
      "props": "() => any",
      "description": "自定义数据为空时的显示内容，默认显示\"暂无数据\"。"
    },
    {
      "name": "cover",
      "description": "覆盖整个触发器内容的插槽，完全替代文本和图标。"
    },
    {
      "name": "default",
      "description": "自定义触发器内容。"
    }
  ],
  "exposes": [
    {
      "name": "open",
      "description": "打开底部选择弹出层；可传入回调，在点击确认时接收选中值"
    },
    {
      "name": "close",
      "description": "关闭底部选择弹出层"
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-select/RebornSelectDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-select/RebornSelectDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [
    "reborn-button",
    "reborn-picker-view",
    "reborn-popup",
    "reborn-select-trigger"
  ],
  "whenToUse": [
    "表单中从固定选项集（options: SelectOption[]）中选择一项或多项。",
    "多选场景（multiple 开启后 modelValue 为数组，可用 tag 插槽自定义标签）。",
    "多列联动选择（columnCount + splitor 分隔符展示）。"
  ],
  "whenNotToUse": [
    "层级数据逐级选择改用 reborn-cascader。",
    "日期选择改用 reborn-select-date。",
    "带输入联想、历史记录的搜索改用 reborn-search-box。"
  ],
  "pitfalls": [
    "web、uniapp 双端可用，交互形态不同：Web 为浮层选项列表，UniApp 为弹层 + RebornPickerView 滚动选择并需点确认。",
    "change 触发时机双端不同：Web 选中即触发，UniApp 在确认后触发；changing 事件为滚动未确认时触发。",
    "portal 默认 true，浮层传送到 body，不受祖先 overflow/transform 裁剪（如在 RebornDialog 内）；关闭后浮层随父容器滚动与裁剪。",
    "size 默认值双端不同（Web 默认 'lg'）；uniapp 端 disabled 兼容 reborn-form。"
  ],
  "dependencies": [
    "clsx",
    "lodash-es"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-select"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-select/RebornSelect.vue",
      "app/components/reborn/ui/reborn-select/index.ts",
      "app/components/reborn/ui/reborn-select/reborn-select.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-select/RebornSelect.vue",
      "packages/uniapp-project/src/components/reborn-select/index.ts",
      "packages/uniapp-project/src/components/reborn-select/reborn-select.config.ts"
    ]
  },
  "docPath": "content/2.components/input-and-forms/reborn-select.md",
  "_meta": {
    "contentHash": "bdfd025d5ecd3dd604e75d92c6ea908ead4a2d5b",
    "hasOverride": true,
    "extractors": {
      "web": "ok",
      "uniapp": "ok",
      "docs": "found"
    }
  }
}
