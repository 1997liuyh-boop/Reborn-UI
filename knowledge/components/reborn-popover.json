{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-popover",
  "title": "Popover",
  "description": "用于点击或悬停触发气泡浮层的双端组件，可配置定位方向、箭头与遮罩。",
  "category": "navigation",
  "tags": [],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "content",
      "type": "PopoverContentProps",
      "default": "() => ({ side: 'bottom', align: 'center', sideOffset: 0 })",
      "required": false,
      "description": "内容位置与偏移配置"
    },
    {
      "name": "arrow",
      "type": "boolean",
      "default": "true",
      "required": false,
      "description": "是否显示箭头"
    },
    {
      "name": "portal",
      "type": "boolean | string",
      "default": "false",
      "required": false,
      "description": "是否将 Popover 渲染到指定的 DOM 节点 (对于 UniApp 意义不大，保留作 API 一致性)"
    },
    {
      "name": "dismissible",
      "type": "boolean",
      "default": "true",
      "required": false,
      "description": "点击外部时是否关闭 Popover"
    },
    {
      "name": "open",
      "type": "boolean",
      "default": "false",
      "required": false,
      "description": "受控显示状态"
    },
    {
      "name": "defaultOpen",
      "type": "boolean",
      "default": "false",
      "required": false,
      "description": "非受控默认显示状态"
    },
    {
      "name": "modal",
      "type": "boolean",
      "default": "false",
      "required": false,
      "description": "是否显示遮罩层并捕获焦点"
    },
    {
      "name": "openDelay",
      "type": "number",
      "default": "0",
      "required": false,
      "description": "延迟打开时间 (ms) - 适用于 hover 模式"
    },
    {
      "name": "closeDelay",
      "type": "number",
      "default": "0",
      "required": false,
      "description": "延迟关闭时间 (ms) - 适用于 hover 模式，防止意外关闭"
    },
    {
      "name": "customClass",
      "type": "any",
      "default": "''",
      "required": false,
      "description": "额外的类名"
    },
    {
      "name": "ui",
      "type": "any",
      "default": "() => ({})",
      "required": false,
      "description": "UI 覆盖配置"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": "false",
      "required": false,
      "description": "是否禁用 popover"
    },
    {
      "name": "title",
      "type": "string | Record<string, any>[]",
      "default": "''",
      "required": false,
      "description": "显示的内容，可以通过 prop 也可以通过 slot 传入"
    },
    {
      "name": "useContentSlot",
      "type": "boolean",
      "default": "true",
      "required": false,
      "description": "是否使用 content 插槽自定义气泡内容；组件内部会按是否传入 content 插槽自动判定，通常无需手动设置"
    },
    {
      "name": "displayMode",
      "type": "'normal' | 'menu'",
      "default": "'normal'",
      "required": false,
      "description": "内容展示模式：normal 直接渲染 title 文本，menu 将 title 数组渲染为可点击的菜单列表（点击项触发 menuclick）"
    },
    {
      "name": "mode",
      "type": "\"click\" | \"hover\"",
      "required": false,
      "description": "触发方式；UniApp 端仅支持点击触发",
      "default": "\"click\""
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "追加到根元素（触发器外层容器）的自定义类名"
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "description": "显隐状态变化时触发，参数为最新的显示状态（v-model 同步）",
      "payload": "(value: boolean)"
    },
    {
      "name": "update:open",
      "description": "显隐状态变化时触发，参数为最新的 open 值（对应 v-model:open）",
      "payload": "(value: boolean)"
    },
    {
      "name": "menuclick",
      "description": "menu 模式下点击菜单项时触发，参数为 { item, index }",
      "payload": "({ item, index })"
    },
    {
      "name": "change",
      "description": "显隐状态切换时触发，参数为 { show: boolean }",
      "payload": "({ show })"
    },
    {
      "name": "open",
      "description": "气泡打开时触发",
      "payload": "-"
    },
    {
      "name": "close",
      "description": "气泡关闭时触发",
      "payload": "-"
    }
  ],
  "slots": [
    {
      "name": "content",
      "description": "气泡内容区域；UniApp 端传入后优先于 `title` / `displayMode` 渲染"
    },
    {
      "name": "default",
      "description": "触发器区域；Web 端提供作用域参数 `open` 表示当前显隐状态"
    }
  ],
  "exposes": [
    {
      "name": "open",
      "description": "手动打开 Popover"
    },
    {
      "name": "close",
      "description": "手动关闭 Popover"
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-popover/RebornPopoverDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-popover/RebornPopoverDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [
    "reborn-transition"
  ],
  "whenToUse": [
    "点击元素弹出操作项或补充说明的小型浮层。",
    "hover 展示提示内容且需要 openDelay/closeDelay 控制显隐延迟时。",
    "需要 v-model:open 受控开关或调用暴露的 open/close 方法时。"
  ],
  "whenNotToUse": [
    "纯文字提示改用 reborn-tooltip（仅 web）。",
    "右键呼出的菜单改用 reborn-context-menu（仅 web）。",
    "底部/侧边大面积面板改用 reborn-popup。"
  ],
  "pitfalls": [
    "web、uniapp 双端可用。",
    "portal 默认 true，浮层 Teleport 到 body 或指定节点。",
    "定位由 content 对象配置（side/align/sideOffset，默认 bottom/center/8）。",
    "modal 默认 false 无遮罩；hover 模式关闭延迟默认 120ms。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-popover"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-popover/RebornPopover.vue",
      "app/components/reborn/ui/reborn-popover/index.ts",
      "app/components/reborn/ui/reborn-popover/reborn-popover.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-popover/RebornPopover.vue",
      "packages/uniapp-project/src/components/reborn-popover/composables/clickoutside.ts",
      "packages/uniapp-project/src/components/reborn-popover/composables/usePopover.ts",
      "packages/uniapp-project/src/components/reborn-popover/composables/useQueue.ts",
      "packages/uniapp-project/src/components/reborn-popover/index.ts",
      "packages/uniapp-project/src/components/reborn-popover/reborn-popover.config.ts",
      "packages/uniapp-project/src/components/reborn-popover/types.ts"
    ]
  },
  "docPath": "content/2.components/navigation/reborn-popover.md",
  "_meta": {
    "contentHash": "7b21572884fc6ed3a0b280d6a25b934209f3ce57",
    "hasOverride": true,
    "extractors": {
      "web": "ok",
      "uniapp": "ok",
      "docs": "found"
    }
  }
}
