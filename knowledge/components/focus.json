{
  "$schema": "../schema/component.schema.json",
  "id": "focus",
  "title": "聚焦",
  "description": "通过动态模糊和动画框高亮句子中的单词，支持自动循环或悬停手动聚焦模式。",
  "category": "effect",
  "tags": [
    "css",
    "tailwind",
    "codepen"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "sentence",
      "type": "string",
      "required": false,
      "description": "要逐词展示和动画的句子。",
      "default": "\"reborn Focus\""
    },
    {
      "name": "manualMode",
      "type": "boolean",
      "required": false,
      "description": "若为 `true`，悬停时才高亮；否则自动循环。",
      "default": "false"
    },
    {
      "name": "blurAmount",
      "type": "number",
      "required": false,
      "description": "非聚焦单词的模糊半径（像素）。",
      "default": "5"
    },
    {
      "name": "borderColor",
      "type": "string",
      "required": false,
      "description": "动画聚焦边框的颜色。",
      "default": "\"green\""
    },
    {
      "name": "animationDuration",
      "type": "number",
      "required": false,
      "description": "聚焦框动画过渡的持续时间（秒）。",
      "default": "0.5"
    },
    {
      "name": "pauseBetweenAnimations",
      "type": "number",
      "required": false,
      "description": "自动聚焦之间的暂停时长（秒）。",
      "default": "1"
    }
  ],
