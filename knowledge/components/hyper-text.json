      "title": "Web 演示",
      "code": "<template>\r\n  <div class=\"flex flex-col items-center justify-center space-y-4\">\r\n    <HyperText\r\n      text=\"Hyper Text\"\r\n      class=\"text-4xl font-bold\"\r\n      :duration=\"800\"\r\n      :animate-on-load=\"true\"\r\n    />\r\n  </div>\r\n</template>\r\n",
      "source": "demo",
