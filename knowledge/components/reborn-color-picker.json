{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-color-picker",
  "title": "取色器",
  "description": "用于弹出面板选取颜色并以 v-model 绑定色值字符串的取色器组件，双端可用。",
  "category": "form",
  "tags": [],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "modelValue",
      "type": "string",
      "default": "'#000000'",
      "required": false,
      "description": "绑定的颜色值，支持通过 `v-model` 双向绑定"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": "false",
      "required": false,
      "description": "是否禁用整体取色器"
    },
    {
      "name": "size",
      "type": "'sm' | 'md' | 'lg'",
      "default": "'md'",
      "required": false,
      "description": "色块触发器尺寸（Web 端额外支持 `'xs'`）"
    },
    {
      "name": "defaultFormat",
      "type": "ColorFormat | undefined",
      "default": "undefined",
      "required": false,
      "description": "初始颜色输出格式，可选 'hex' | 'rgb' | 'rgba'；未设置时根据 modelValue 自动识别，用户仍可在面板中切换"
    },
    {
      "name": "format",
      "type": "ColorFormat | undefined",
      "default": "undefined",
      "required": false,
      "description": "defaultFormat 的别名，同样指定颜色输出格式；两者同时传入时 defaultFormat 优先"
    },
    {
      "name": "content",
      "type": "any",
      "default": "() => ({ side: 'right', align: 'center', sideOffset: 8 })",
      "required": false,
      "description": "Popover content config"
    },
    {
      "name": "arrow",
      "type": "boolean",
      "default": "true",
      "required": false,
      "description": "Whether to show arrow"
    },
    {
      "name": "ui",
      "type": "any",
      "default": "() => ({})",
      "required": false,
      "description": "UI 配置覆盖对象，见下方「自定义样式（ui）」"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "追加到面板根节点的自定义类名"
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "description": "颜色值变化时触发（`v-model` 同步），参数为按当前格式序列化后的颜色字符串",
      "payload": "(val: string)"
    },
    {
      "name": "onChange",
      "description": "用户在面板中选色导致颜色变化时触发，参数为面板输出的颜色字符串",
      "payload": "(val: string)"
    },
    {
      "name": "update:format",
      "payload": "(e: \"update:format\", value: ColorFormat): void;",
      "description": "用户点击格式切换按钮时触发（v-model:format 同步），参数为新的输出格式"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "自定义触发器内容，替换默认的色块按钮。仅 Web 端；UniApp 端不支持"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-color-picker/RebornColorPickerDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-color-picker/RebornColorPickerDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [
    "reborn-button",
    "reborn-input",
    "reborn-popover"
  ],
  "whenToUse": [
    "主题色、标签颜色等需要用户自选颜色的设置项。",
    "表单中需要采集颜色值（字符串）并双向绑定的场景。",
    "需要通过 content 配置弹出方向与偏移（side/align/sideOffset）的取色入口。"
  ],
  "whenNotToUse": [
    "仅 web 且不需要双端一致时，也可用 web 专用的 color-picker。",
    "从固定的预设色板中单选，用一组按钮或 reborn-radio 即可。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端可用。",
    "modelValue 为颜色字符串，默认 '#000000'；可用 format/defaultFormat 控制输出格式。",
    "弹出位置默认 side: 'right'，在贴近屏幕边缘时需通过 content 调整（示例中设为 side: 'top'）。"
  ],
  "dependencies": [
    "@uiw/color-convert"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-color-picker"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-color-picker/RebornColorPicker.vue",
      "app/components/reborn/ui/reborn-color-picker/RebornColorPickerPanel.vue",
      "app/components/reborn/ui/reborn-color-picker/reborn-color-picker-panel.config.ts",
      "app/components/reborn/ui/reborn-color-picker/reborn-color-picker.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-color-picker/RebornColorPicker.vue",
      "packages/uniapp-project/src/components/reborn-color-picker/RebornColorPickerPanel.vue",
      "packages/uniapp-project/src/components/reborn-color-picker/reborn-color-picker-panel.config.ts",
      "packages/uniapp-project/src/components/reborn-color-picker/reborn-color-picker.config.ts"
    ]
  },
  "docPath": "content/2.components/input-and-forms/reborn-color-picker.md",
  "_meta": {
    "contentHash": "b378d25e15d130ca7d1a273894b0d9dbb14010ca",
