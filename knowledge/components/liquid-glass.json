{
  "$schema": "../schema/component.schema.json",
  "id": "liquid-glass",
  "title": "液态玻璃",
  "description": "用于以 SVG 位移贴图与通道偏移模拟液态玻璃折射的容器组件。",
  "category": "effect",
  "tags": [
    "svg",
    "filter",
    "glassmorphism"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "radius",
      "type": "number",
      "required": false,
      "description": "玻璃容器圆角大小。",
      "default": "16"
    },
    {
      "name": "border",
      "type": "number",
      "required": false,
      "description": "折射边缘宽度比例。",
      "default": "0.07"
    },
    {
      "name": "lightness",
      "type": "number",
      "required": false,
      "description": "位移贴图亮度。",
      "default": "50"
    },
    {
      "name": "displace",
      "type": "number",
      "required": false,
      "description": "最终高斯模糊的位移强度。",
      "default": "14"
    },
    {
      "name": "blend",
      "type": "string",
      "required": false,
      "description": "渐变混合模式。",
      "default": "\"difference\""
    },
    {
      "name": "xChannel",
      "type": "\"R\" | \"G\" | \"B\"",
      "required": false,
      "description": "\"B\"",
      "default": "\"R\""
    },
    {
      "name": "yChannel",
      "type": "\"R\" | \"G\" | \"B\"",
      "required": false,
      "description": "\"B\"",
      "default": "\"B\""
    },
    {
      "name": "alpha",
      "type": "number",
      "required": false,
      "description": "玻璃主体透明度。",
      "default": "0.93"
    },
    {
      "name": "blur",
      "type": "number",
      "required": false,
      "description": "位移贴图模糊半径。",
      "default": "11"
    },
    {
      "name": "rOffset",
      "type": "number",
      "required": false,
      "description": "红色通道偏移量。",
      "default": "0"
    },
    {
      "name": "gOffset",
      "type": "number",
      "required": false,
      "description": "绿色通道偏移量。",
      "default": "10"
    },
    {
      "name": "bOffset",
      "type": "number",
      "required": false,
      "description": "蓝色通道偏移量。",
      "default": "20"
    },
    {
      "name": "scale",
      "type": "number",
      "required": false,
      "description": "位移缩放强度。",
      "default": "-180"
    },
    {
      "name": "frost",
      "type": "number",
      "required": false,
      "description": "玻璃磨砂层透明度。",
      "default": "0.05"
    },
    {
      "name": "position",
      "type": "\"fixed\" | \"absolute\" | \"relative\" | \"sticky\"",
      "required": false,
      "description": "\"relative\" \\",
      "default": "\"fixed\""
    },
    {
      "name": "class",
      "type": "HTMLAttributes[\"class\"]",
      "required": false,
      "description": "内层插槽容器类名。"
    },
    {
      "name": "containerClass",
      "type": "HTMLAttributes[\"class\"]",
      "required": false,
      "description": "外层效果容器类名。"
    }
  ],
  "events": [],
