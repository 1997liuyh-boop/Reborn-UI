    {
      "title": "Web 演示",
      "code": "<template>\n  <div class=\"flex flex-col overflow-hidden\">\n    <ContainerScroll>\n      <template #title>\n        <h1 class=\"text-4xl font-semibold text-black dark:text-white\">\n          Unleash the power of <br />\n          <span class=\"mt-1 text-4xl leading-none font-bold md:text-[6rem]\">\n            Scroll Animations\n          </span>\n        </h1>\n      </template>\n      <template #card>\n        <img src=\"https://cdn.reborn-ui.com/images/linear.webp\"\n          class=\"mx-auto h-full rounded-2xl object-cover object-left-top\" alt=\"hero\" height=\"720\" width=\"1400\" />\n      </template>\n    </ContainerScroll>\n  </div>\n</template>\n",
