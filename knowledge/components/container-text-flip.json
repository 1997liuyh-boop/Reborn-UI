  "related": [],
  "whenToUse": [
    "标题中轮换展示多个卖点词，且词长差异大、需要容器宽度跟随动画。",
    "需要分别用 class / textClass 控制容器与文字样式的轮换词场景。"
  ],
  "whenNotToUse": [
    "只需句中单词翻转、不需要容器宽度动画，改用 flip-words。",
    "需要文字形变过渡效果，改用 morphing-text。"
  ],
  "pitfalls": [
    "仅 web 端可用，依赖 @vueuse/core 与 motion-v。",
    "interval（默认 3000）与 animationDuration（默认 700）单位均为毫秒。",
    "无事件抛出，切换时机无法在外部监听；需要动画事件时改用 flip-words。"
  ],
  "dependencies": [
    "@vueuse/core",
    "motion-v"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add container-text-flip"
  },
