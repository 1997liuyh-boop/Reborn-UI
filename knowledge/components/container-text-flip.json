{
  "$schema": "../schema/component.schema.json",
  "id": "container-text-flip",
  "title": "容器文字翻转",
  "description": "用于循环翻转一组单词、容器宽度随词宽平滑过渡的文字组件。",
  "category": "effect",
  "tags": [
    "css",
    "tailwind",
    "aceternity-ui"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "words",
      "type": "string[]",
      "required": false,
      "description": "循环显示的单词数组。",
      "default": "() => [\"better\", \"modern\", \"beautiful\", \"awesome\"]"
    },
    {
      "name": "interval",
      "type": "number",
      "required": false,
      "description": "单词切换间隔（毫秒）。",
      "default": "3000"
    },
    {
      "name": "animationDuration",
      "type": "number",
      "required": false,
      "description": "过渡动画时长（毫秒）。",
      "default": "700"
    },
    {
      "name": "class",
      "type": "string",
      "required": false,
      "description": "应用于容器的额外 CSS 类。"
    },
    {
      "name": "textClass",
      "type": "string",
      "required": false,
      "description": "应用于文字的额外 CSS 类。"
    }
  ],
  "events": [],
  "slots": [],
  "exposes": [],
