{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-typewriter",
  "title": "打字机效果",
  "description": "用于让文本以打字机方式逐字输入与删除的文字动画组件。",
  "category": "effect",
  "tags": [
    "css",
    "tailwind",
    "animation"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "text",
      "type": "string",
      "required": true,
      "description": "要显示的文本内容",
      "default": "\"\""
    },
    {
      "name": "typeSpeed",
      "type": "number",
      "required": false,
      "description": "打字速度（毫秒/字符）",
      "default": "50"
    },
    {
      "name": "deleteSpeed",
      "type": "number",
      "required": false,
      "description": "删除速度（毫秒/字符）",
      "default": "30"
    },
    {
      "name": "pauseDuration",
      "type": "number",
      "required": false,
      "description": "删除完成后到开始打字的延迟时间（毫秒）",
      "default": "500"
    },
    {
      "name": "cursor",
      "type": "string",
      "required": false,
      "description": "光标字符",
      "default": "\"|\""
    },
    {
      "name": "showCursor",
      "type": "boolean",
      "required": false,
      "description": "是否显示光标",
      "default": "true"
    },
    {
      "name": "cursorBlinkSpeed",
      "type": "number",
      "required": false,
      "description": "光标闪烁速度（毫秒）",
      "default": "530"
    },
    {
      "name": "resetOnChange",
      "type": "boolean",
      "required": false,
      "description": "是否在文本变化时重置",
      "default": "true"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "自定义类名",
      "default": "\"\""
    }
  ],
  "events": [
    {
      "name": "typed",
      "payload": "[]",
      "description": "打字完成事件"
    },
    {
      "name": "deleted",
      "payload": "[]",
      "description": "删除完成事件"
    },
    {
      "name": "start-typing",
      "payload": "[]",
      "description": "开始打字事件"
    },
    {
      "name": "start-deleting",
      "payload": "[]",
      "description": "开始删除事件"
    }
  ],
  "slots": [],
  "exposes": [
    {
      "name": "startTyping",
      "description": ""
    },
    {
      "name": "startDeleting",
      "description": ""
    },
    {
      "name": "clear",
      "description": ""
    },
    {
      "name": "displayText",
      "description": ""
    },
    {
      "name": "isTyping",
      "description": ""
    },
    {
      "name": "isDeleting",
      "description": ""
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-typewriter/RebornTypewriterDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "首屏标题、口号的动态输入效果。",
    "模拟终端 / 命令行输出。",
    "文本内容变化时自动重打动画（resetOnChange 默认 true）。"
  ],
  "whenNotToUse": [
    "循环翻转多个词语改用 flip-words 或 container-text-flip。",
    "整段文字逐字渐显改用 text-generate-effect。",
    "uniapp 端项目：platforms 仅 web，无 uniapp 实现。"
  ],
  "pitfalls": [
    "platforms 仅 web 端提供。",
    "文本只能经 text prop 传入，组件无插槽。",
    "text 变化默认会重置动画（resetOnChange=true），不需要时须显式关闭。",
    "可通过 exposes 的 startTyping / startDeleting / clear 手动控制流程，isTyping / isDeleting 反映当前状态。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-typewriter"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-typewriter/RebornTypewriter.vue",
      "app/components/reborn/ui/reborn-typewriter/reborn-typewriter.config.ts"
    ]
  },
