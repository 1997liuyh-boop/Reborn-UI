      "name": "text",
      "type": "string",
      "required": true,
      "description": "要显示的文本内容",
      "default": "\"\""
    },
    {
      "name": "typeSpeed",
      "type": "number",
      "required": false,
      "description": "打字速度（毫秒/字符）",
      "default": "50"
