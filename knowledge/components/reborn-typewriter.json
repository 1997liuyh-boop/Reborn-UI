      "type": "boolean",
      "required": false,
      "description": "是否显示光标",
      "default": "true"
    },
    {
      "name": "cursorBlinkSpeed",
      "type": "number",
      "required": false,
      "description": "光标闪烁速度（毫秒）",
      "default": "530"
