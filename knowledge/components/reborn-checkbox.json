{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-checkbox",
  "title": "多选框",
  "description": "用于开关单项或组合多选的多选框组件，双端可用，支持布尔与数组两种绑定。",
  "category": "form",
  "tags": [
    "css",
    "tailwind",
    "checkbox",
    "uniapp"
  ],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "modelValue",
      "type": "boolean | CheckboxValue[]",
      "required": false,
      "description": "受控选中状态（布尔）或选中值数组（多选模式）。",
      "default": "false"
    },
    {
      "name": "defaultValue",
      "type": "boolean | CheckboxValue[]",
      "required": false,
      "description": "非受控模式下的初始值。",
      "default": "false"
    },
    {
      "name": "value",
      "type": "CheckboxValue",
      "required": false,
      "description": "该项的选中值，仅在绑定数组（或 web 端 CheckboxGroup）时生效。",
      "default": "\"\""
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "description": "标签文本；数组模式下未传 `value` 时兜底充当选中值。",
      "default": "\"\""
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用。",
      "default": "false"
    },
    {
      "name": "readOnly",
      "type": "boolean",
      "required": false,
      "description": "仅展示状态，不响应点击（由外层接管，避免与父级多次触发；微信小程序等与 v-model 叠加易闪勾）",
      "default": "false"
    },
    {
      "name": "size",
      "type": "typeof checkboxSizes[number]",
      "required": false,
      "description": "尺寸大小。",
      "default": "'md'"
    },
    {
      "name": "color",
      "type": "typeof checkboxColors[number]",
      "required": false,
      "description": "选中色值。",
      "default": "'primary'"
    },
    {
      "name": "customClass",
      "type": "any",
      "required": false,
      "description": "追加到根节点（wrapper）的自定义类名"
    },
    {
      "name": "ui",
      "type": "Partial<{\n    wrapper: ClassValue\n    input: ClassValue\n    control: ClassValue\n    icon: ClassValue\n    label: ClassValue\n  }>",
      "required": false,
      "description": "覆盖内部各区域样式类：wrapper 根容器、control 勾选框、icon 勾选图标、label 标签文本",
      "default": "{}"
    },
    {
      "name": "trueValue",
      "type": "any",
      "required": false,
      "description": "选中时的值 (非数组模式下生效)",
      "default": "true"
    },
    {
      "name": "falseValue",
      "type": "any",
      "required": false,
      "description": "未选中时的值 (非数组模式下生效)",
      "default": "false"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "自定义 class",
      "default": "\"\""
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "payload": "(e: 'update:modelValue', value: boolean | CheckboxValue[]): void",
      "description": "绑定值更新时触发，参数为最新值：布尔或选中值数组"
    },
    {
      "name": "change",
      "payload": "(e: \"change\", value: any): void;",
      "description": "用户切换选中状态后触发，参数与 update:modelValue 相同"
    }
  ],
  "slots": [
    {
      "name": "icon",
      "description": "自定义勾选框内的图标，替代默认对勾。"
    },
    {
      "name": "default",
      "description": "自定义标签内容，替代 `label` 文本。"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-checkbox/RebornCheckboxDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-checkbox/RebornCheckboxDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "表单中需要勾选一组可多选的选项。",
    "单个布尔开关确认项（如同意协议），v-model 绑定 boolean。",
    "需要 trueValue/falseValue 自定义选中/未选中值的场景。"
  ],
  "whenNotToUse": [
    "一组互斥选项只能选一个时，改用 reborn-radio。",
    "即时生效的开关设置项，改用 reborn-switch。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端可用。",
    "modelValue 支持 boolean 或数组两种模式：绑定数组时 value 才作为选中值生效，未提供 value 时以 label 充当 value。",
    "可通过 icon 插槽自定义选中图标，default 插槽自定义标签内容。"
  ],
  "dependencies": [
    "clsx"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-checkbox"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-checkbox/RebornCheckbox.vue",
      "app/components/reborn/ui/reborn-checkbox/RebornCheckboxGroup.vue",
      "app/components/reborn/ui/reborn-checkbox/index.ts",
      "app/components/reborn/ui/reborn-checkbox/reborn-checkbox.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-checkbox/RebornCheckbox.vue",
      "packages/uniapp-project/src/components/reborn-checkbox/index.ts",
      "packages/uniapp-project/src/components/reborn-checkbox/reborn-checkbox.config.ts"
    ]
  },
  "docPath": "content/2.components/input-and-forms/reborn-checkbox.md",
