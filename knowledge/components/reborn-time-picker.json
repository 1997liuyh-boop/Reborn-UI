{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-time-picker",
  "title": "时间选择器",
  "description": "支持滚轮选择、箭头调节、禁用时分秒和范围选择的时间选择器。",
  "category": "form",
  "tags": [],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "modelValue",
      "type": "string | string[]",
      "required": false,
      "description": "双向绑定值",
      "default": "\"\"",
      "vModel": true
    },
    {
      "name": "format",
      "type": "string",
      "required": false,
      "description": "时间显示与输出格式。",
      "default": "\"HH:mm:ss\""
    },
    {
      "name": "isRange",
      "type": "boolean",
      "required": false,
      "description": "开启时间范围选择，对应模板写法 `is-range`。",
      "default": "false"
    },
    {
      "name": "arrowControl",
      "type": "boolean",
      "required": false,
      "description": "使用上下箭头调节时间，对应模板写法 `arrow-control`。默认模式下可使用鼠标滚轮切换。",
      "default": "false"
    },
    {
      "name": "size",
      "type": "(typeof timePickerSizes)[number]",
      "required": false,
      "description": "'lg'",
      "default": "\"md\""
    },
    {
      "name": "color",
      "type": "(typeof timePickerColors)[number]",
      "required": false,
      "description": "'success' \\",
      "default": "\"primary\""
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": ""
    },
    {
      "name": "disabledHours",
      "type": "DisabledHours",
      "required": false,
      "description": "null) => number[]",
      "default": "() => []"
    },
    {
      "name": "disabledMinutes",
      "type": "DisabledMinutes",
      "required": false,
      "description": "null) => number[]",
      "default": "() => []"
    },
    {
      "name": "disabledSeconds",
      "type": "DisabledSeconds",
      "required": false,
      "description": "null) => number[]",
      "default": "() => []"
    },
    {
      "name": "disabledMilliseconds",
      "type": "DisabledMilliseconds",
      "required": false,
      "description": "",
      "default": "() => []"
    },
    {
      "name": "ui",
      "type": "Partial<{\n    wrapper: ClassValue;\n    rangeWrapper: ClassValue;\n    rangeSeparator: ClassValue;\n    section: ClassValue;\n    columns: ClassValue;\n    column: ClassValue;\n    arrowButton: ClassValue;\n    list: ClassValue;\n    item: ClassValue;\n    itemActive: ClassValue;\n    itemDisabled: ClassValue;\n    itemIdle: ClassValue;\n    indicator: ClassValue;\n    mask: ClassValue;\n    footer: ClassValue;\n  }>",
      "required": false,
      "description": "用于覆盖 `RebornTimePicker` 内部（如范围文本）样式的 UI 配置对象。",
      "default": "{}"
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "description": "单选模式占位文案。",
      "default": "\"请选择时间\""
    },
    {
      "name": "startPlaceholder",
      "type": "string",
      "required": false,
      "description": "范围模式开始时间占位文案。",
      "default": "\"开始时间\""
    },
    {
      "name": "endPlaceholder",
      "type": "string",
      "required": false,
      "description": "范围模式结束时间占位文案。",
      "default": "\"结束时间\""
    },
    {
      "name": "rangeSeparator",
      "type": "string",
      "required": false,
      "description": "范围模式触发器中的分隔符。",
      "default": "\"~\""
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用。",
      "default": "false"
    },
    {
      "name": "clearable",
      "type": "boolean",
      "required": false,
      "description": "是否显示清空按钮。",
      "default": "true"
    },
    {
      "name": "bordered",
      "type": "boolean",
      "required": false,
      "description": "是否显示边框。",
      "default": "true"
    },
    {
      "name": "showArrow",
      "type": "boolean",
      "required": false,
      "description": "是否显示右侧箭头图标。",
      "default": "true"
    },
    {
      "name": "arrowAnimation",
      "type": "boolean",
      "required": false,
      "description": "展开时箭头是否旋转动画。",
      "default": "true"
    },
    {
      "name": "portal",
      "type": "SelectTriggerProps[\"portal\"]",
      "required": false,
      "description": "浮层是否传送到 `body`。默认开启，浮层按文档坐标锚定触发器，不受祖先 `overflow` / `transform` 裁剪；关闭后浮层留在触发器内，随父容器一起滚动、一起被裁剪。",
      "default": "true"
    },
    {
      "name": "triggerUi",
      "type": "SelectTriggerProps[\"ui\"]",
      "required": false,
      "description": "用于覆盖 `RebornSelectTrigger` 内部组件样式的 UI 配置对象。",
      "default": "{}"
    }
  ],
