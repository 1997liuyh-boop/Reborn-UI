{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-time-picker",
  "title": "时间选择器",
  "description": "用于选择时分秒的时间选择器组件，支持滚轮与箭头两种调节方式及时间范围选择。",
  "category": "form",
  "tags": [],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "modelValue",
      "type": "string | string[]",
      "required": false,
      "description": "双向绑定值",
      "default": "\"\"",
      "vModel": true
    },
    {
      "name": "format",
      "type": "string",
      "required": false,
      "description": "时间显示与输出格式。",
      "default": "\"HH:mm:ss\""
    },
    {
      "name": "isRange",
      "type": "boolean",
      "required": false,
      "description": "开启时间范围选择，对应模板写法 `is-range`。",
      "default": "false"
    },
    {
      "name": "arrowControl",
      "type": "boolean",
      "required": false,
      "description": "使用上下箭头调节时间，对应模板写法 `arrow-control`。默认模式下可使用鼠标滚轮切换。",
      "default": "false"
    },
    {
      "name": "size",
      "type": "(typeof timePickerSizes)[number]",
      "required": false,
      "description": "组件尺寸。",
      "default": "\"md\""
    },
    {
      "name": "color",
      "type": "(typeof timePickerColors)[number]",
      "required": false,
      "description": "组件主题色。",
      "default": "\"primary\""
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "追加到面板根元素的自定义类名"
    },
    {
      "name": "disabledHours",
      "type": "DisabledHours",
      "required": false,
      "description": "返回禁用小时列表。范围模式下可按 `role` 区分开始和结束面板。",
      "default": "() => []"
    },
    {
      "name": "disabledMinutes",
      "type": "DisabledMinutes",
      "required": false,
      "description": "返回禁用分钟列表。",
      "default": "() => []"
    },
    {
      "name": "disabledSeconds",
      "type": "DisabledSeconds",
      "required": false,
      "description": "返回禁用秒列表。",
      "default": "() => []"
    },
    {
      "name": "disabledMilliseconds",
      "type": "DisabledMilliseconds",
      "required": false,
      "description": "返回需禁用的毫秒数组，入参为当前时、分、秒；范围模式下可按 role 区分开始/结束面板",
      "default": "() => []"
    },
    {
      "name": "ui",
      "type": "Partial<{\n    wrapper: ClassValue;\n    rangeWrapper: ClassValue;\n    rangeSeparator: ClassValue;\n    section: ClassValue;\n    columns: ClassValue;\n    column: ClassValue;\n    arrowButton: ClassValue;\n    list: ClassValue;\n    item: ClassValue;\n    itemActive: ClassValue;\n    itemDisabled: ClassValue;\n    itemIdle: ClassValue;\n    indicator: ClassValue;\n    mask: ClassValue;\n    footer: ClassValue;\n  }>",
      "required": false,
      "description": "用于覆盖 `RebornTimePicker` 内部（如范围文本）样式的 UI 配置对象。",
      "default": "{}"
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "description": "单选模式占位文案。",
      "default": "\"请选择时间\""
    },
    {
      "name": "startPlaceholder",
      "type": "string",
      "required": false,
      "description": "范围模式开始时间占位文案。",
      "default": "\"开始时间\""
    },
    {
      "name": "endPlaceholder",
      "type": "string",
      "required": false,
      "description": "范围模式结束时间占位文案。",
      "default": "\"结束时间\""
    },
    {
      "name": "rangeSeparator",
      "type": "string",
      "required": false,
      "description": "范围模式触发器中的分隔符。",
      "default": "\"~\""
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用。",
      "default": "false"
    },
    {
      "name": "clearable",
      "type": "boolean",
      "required": false,
      "description": "是否显示清空按钮。",
      "default": "true"
    },
    {
      "name": "bordered",
      "type": "boolean",
      "required": false,
      "description": "是否显示边框",
      "default": "true"
    },
    {
      "name": "showArrow",
      "type": "boolean",
      "required": false,
      "description": "是否显示箭头",
      "default": "true"
    },
    {
      "name": "arrowAnimation",
      "type": "boolean",
      "required": false,
      "description": "展开时箭头是否旋转",
      "default": "true"
    },
    {
      "name": "portal",
      "type": "SelectTriggerProps[\"portal\"]",
      "required": false,
      "description": "浮层是否传送到 body（默认 true）。 关掉后浮层留在触发器内，会随父容器一起滚动、也一起被 overflow 裁剪。",
      "default": "true"
    },
    {
      "name": "triggerUi",
      "type": "SelectTriggerProps[\"ui\"]",
      "required": false,
      "description": "触发器 (Trigger) 的 UI 微调配置",
      "default": "{}"
    }
  ],
  "events": [
    {
      "name": "change",
      "payload": "(e: \"change\", value: string | string[]): void;",
      "description": "时间变更后触发。"
    },
    {
      "name": "clear",
      "payload": "(e: \"clear\"): void;",
      "description": "点击底部「清空」按钮清空值后触发"
    },
    {
      "name": "confirm",
      "payload": "(e: \"confirm\", value: string | string[]): void;",
      "description": "点击底部「确定」按钮时触发，携带当前选中值（范围模式为 [start, end]）"
    },
    {
      "name": "update:modelValue",
      "description": "modelValue 变化时触发（v-model 同步）"
    }
  ],
  "slots": [
    {
      "name": "footer",
      "description": "自定义面板底部操作栏内容，默认渲染「清空」和「确定」按钮（`RebornTimePanel` 插槽）。"
    },
    {
      "name": "cover",
      "description": "覆盖整个触发器内容的插槽，完全替代文本和图标。"
    },
    {
      "name": "default",
      "description": "自定义触发器显示内容。"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "code": "<script setup lang=\"ts\">\nimport RebornTimePicker from \"~/components/reborn/ui/reborn-time-picker/RebornTimePicker.vue\";\nimport {\n  timePickerColors,\n  timePickerSizes,\n} from \"~/components/reborn/ui/reborn-time-picker/reborn-time-picker.config\";\n\n// ─── 交互演练场 ─────────────────────────────────────────────────\n\nconst state = ref<Record<string, any>>({\n  value: \"09:30:00\",\n  size: \"md\",\n  color: \"primary\",\n  isRange: false,\n  arrowControl: false,\n  disabled: false,\n});\n\n/** 演练场控制面板配置 */\nconst controls = [\n  {\n    title: \"核心配置\",\n    children: [\n      {\n        label: \"尺寸规格\",\n        key: \"size\",\n        component: \"select\" as const,\n        defaultValue: \"md\",\n        props: {\n          options: timePickerSizes.map((s) => ({ label: s.toUpperCase(), value: s })),\n        },\n      },\n      {\n        label: \"品牌色彩\",\n        key: \"color\",\n        component: \"select\" as const,\n        defaultValue: \"primary\",\n        props: {\n          options: timePickerColors.map((c) => ({ label: c.charAt(0).toUpperCase() + c.slice(1), value: c })),\n        },\n      },\n    ],\n  },\n  {\n    title: \"功能开关\",\n    children: [\n      { label: \"范围选择\", key: \"isRange\", component: \"checkbox\" as const, defaultValue: false },\n      { label: \"箭头控制\", key: \"arrowControl\", component: \"checkbox\" as const, defaultValue: false },\n      { label: \"禁用组件\", key: \"disabled\", component: \"checkbox\" as const, defaultValue: false },\n    ],\n  },\n];\n\n// ─── 场景演示状态 ───────────────────────────────────────────────\n\nconst basicValue = ref(\"10:00:00\");\nconst arrowValue = ref(\"14:20:00\");\nconst rangeValue = ref([\"09:00:00\", \"18:00:00\"]);\nconst limitedValue = ref(\"12:00:00\");\n\n/** 禁用凌晨 0-4 点与深夜 23 点 */\nfunction disabledHours() {\n  return [0, 1, 2, 3, 4, 23];\n}\n\n/** 12 点整只允许选择后半小时 */\nfunction disabledMinutes(hour: number) {\n  if (hour === 12) return Array.from({ length: 30 }, (_, i) => i);\n  return [];\n}\n</script>\n\n<template>\n  <div class=\"flex w-full min-w-0 flex-col\">\n    <Playground\n      v-model=\"state\"\n      :controls=\"controls\"\n      component-name=\"RebornTimePicker\"\n      title=\"交互演练场\"\n      description=\"调节左侧属性，实时预览尺寸、配色与范围选择模式。\"\n    >\n      <RebornTimePicker\n        v-model=\"state.value\"\n        :size=\"state.size\"\n        :color=\"state.color\"\n        :is-range=\"state.isRange\"\n        :arrow-control=\"state.arrowControl\"\n        :disabled=\"state.disabled\"\n        class=\"w-full max-w-xs\"\n      />\n    </Playground>\n\n    <DemoSection\n      title=\"选择模式\"\n      description=\"默认为滚轮选择；开启 arrow-control 切换为点击式步进，更适合桌面端精确调整。\"\n    >\n      <DemoBlock layout=\"grid\" align=\"start\">\n        <div class=\"flex flex-col gap-3\">\n          <span class=\"text-dimmed text-xs font-medium\">滚轮选择 · 默认</span>\n          <RebornTimePicker v-model=\"basicValue\" />\n          <DemoNote tone=\"dimmed\">\n            当前值：<span class=\"text-primary font-mono font-medium\">{{ basicValue }}</span>\n          </DemoNote>\n        </div>\n\n        <div class=\"flex flex-col gap-3\">\n          <span class=\"text-dimmed text-xs font-medium\">步进选择 · <code>arrow-control</code></span>\n          <RebornTimePicker\n            v-model=\"arrowValue\"\n            arrow-control\n            color=\"secondary\"\n          />\n          <DemoNote tone=\"dimmed\">\n            当前值：<span class=\"text-secondary font-mono font-medium\">{{ arrowValue }}</span>\n          </DemoNote>\n        </div>\n      </DemoBlock>\n    </DemoSection>\n\n    <DemoSection\n      title=\"时间范围\"\n      description=\"传入 is-range 后 v-model 变为 [开始时间, 结束时间] 数组，适用于排班、会议预约等时段场景。\"\n    >\n      <DemoBlock layout=\"stack\">\n        <RebornTimePicker\n          v-model=\"rangeValue\"\n          is-range\n          color=\"success\"\n          class=\"w-full max-w-md\"\n        />\n        <DemoNote tone=\"dimmed\">\n          选定时段：<span class=\"text-success font-mono font-medium\">{{ rangeValue[0] }} 至 {{ rangeValue[1] }}</span>\n        </DemoNote>\n      </DemoBlock>\n    </DemoSection>\n\n    <DemoSection\n      title=\"选择约束与禁用\"\n      description=\"disabled-hours / disabled-minutes 传入函数即可精确屏蔽不可选时段；disabled 则整体禁止交互。\"\n    >\n      <DemoBlock layout=\"grid\" align=\"start\">\n        <div class=\"flex flex-col gap-3\">\n          <span class=\"text-dimmed text-xs font-medium\">时段约束 · <code>disabled-hours</code></span>\n          <RebornTimePicker\n            v-model=\"limitedValue\"\n            color=\"warning\"\n            :disabled-hours=\"disabledHours\"\n            :disabled-minutes=\"disabledMinutes\"\n          />\n          <DemoNote tone=\"dimmed\">凌晨 0–4 点与 23 点不可选；12 点禁止选择前 30 分钟。</DemoNote>\n        </div>\n\n        <div class=\"flex flex-col gap-3\">\n          <span class=\"text-dimmed text-xs font-medium\">整体禁用 · <code>disabled</code></span>\n          <RebornTimePicker\n            disabled\n            value=\"08:00:00\"\n          />\n          <DemoNote tone=\"dimmed\">禁用态保留视觉一致性，但不响应任何交互。</DemoNote>\n        </div>\n      </DemoBlock>\n    </DemoSection>\n  </div>\n</template>\n",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [
    "reborn-button",
    "reborn-select-trigger"
  ],
  "whenToUse": [
    "表单中选择具体时间（format 默认 HH:mm:ss）。",
    "选择时间段（isRange，配 startPlaceholder / endPlaceholder / rangeSeparator）。",
    "需要禁用特定时 / 分 / 秒（disabledHours、disabledMinutes、disabledSeconds 函数）。"
  ],
  "whenNotToUse": [
    "需要选日期或日期加时间改用 reborn-select-date（且其为双端组件）。",
    "uniapp 端项目：platforms 仅 web，可用 reborn-select-date 的时间粒度替代。"
  ],
  "pitfalls": [
    "platforms 仅 web 端提供。",
    "默认模式用鼠标滚轮切换，arrowControl=true 改为上下箭头调节。",
    "isRange 时 modelValue 为 string[] 数组，单选时为 string。",
    "触发器基于 RebornSelectTrigger；portal 默认 true 浮层传送到 body，关闭后随父容器裁剪滚动。"
  ],
  "dependencies": [
    "clsx",
    "dayjs"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-time-picker"
  },
