{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-dropdown",
  "title": "Dropdown 下拉菜单",
  "description": "用于将一组操作折叠进浮层菜单的下拉组件，悬停或点击展开，仅 web 端。",
  "category": "misc",
  "tags": [],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "splitButton",
      "type": "boolean",
      "required": false,
      "description": "是否呈现为按钮组（左侧功能按钮 + 右侧触发按钮）",
      "default": "false"
    },
    {
      "name": "hideOnClick",
      "type": "boolean",
      "required": false,
      "description": "点击菜单项后是否自动隐藏下拉",
      "default": "true"
    },
    {
      "name": "trigger",
      "type": "\"hover\" | \"click\"",
      "required": false,
      "description": "触发方式：hover 悬浮 / click 点击",
      "default": "\"hover\""
    },
    {
      "name": "openDelay",
      "type": "number",
      "required": false,
      "description": "hover 模式下打开延迟（ms），避免误触",
      "default": "100"
    },
    {
      "name": "closeDelay",
      "type": "number",
      "required": false,
      "description": "hover 模式下关闭延迟（ms），允许鼠标移回",
      "default": "200"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用",
      "default": "false"
    },
    {
      "name": "size",
      "type": "(typeof dropdownSizes)[number]",
      "required": false,
      "description": "尺寸",
      "default": "\"md\""
    },
    {
      "name": "color",
      "type": "(typeof dropdownColors)[number]",
      "required": false,
      "description": "主题颜色",
      "default": "\"primary\""
    },
    {
      "name": "placement",
      "type": "\"bottom-start\" | \"bottom\" | \"bottom-end\" | \"top-start\" | \"top\" | \"top-end\"",
      "required": false,
      "description": "弹出位置",
      "default": "\"bottom-start\""
    },
    {
      "name": "portal",
      "type": "SelectTriggerProps[\"portal\"]",
      "required": false,
      "description": "浮层是否传送到 body（默认 true）。 关掉后浮层留在触发器内，会随父容器一起滚动、也一起被 overflow 裁剪。",
      "default": "true"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "自定义类名"
    },
    {
      "name": "ui",
      "type": "Partial<{\n    wrapper: ClassValue;\n    trigger: ClassValue;\n    splitMain: ClassValue;\n    splitArrow: ClassValue;\n    dropdown: ClassValue;\n    item: ClassValue;\n    divider: ClassValue;\n    icon: ClassValue;\n    label: ClassValue;\n  }>",
      "required": false,
      "description": "UI 局部重写",
      "default": "{}"
    },
    {
      "name": "command",
      "type": "string",
      "required": false,
      "description": "点击时传递给 command 事件的标识",
      "default": "\"\""
    },
    {
      "name": "divided",
      "type": "boolean",
      "required": false,
      "description": "是否在该项上方显示分隔线",
      "default": "false"
    }
  ],
  "events": [
    {
      "name": "command",
      "payload": "(e: \"command\", key: string): void;",
      "description": "菜单项被点击时触发，参数为该项的 command 值"
    },
    {
      "name": "visible-change",
      "payload": "(e: \"visible-change\", visible: boolean): void;",
      "description": "下拉展开/收起状态变化"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "触发下拉的元素。split-button 模式下为左侧功能按钮的内容"
    },
    {
      "name": "dropdown",
      "description": "下拉菜单面板内容，通常放入 RebornDropdownItem"
    },
    {
      "name": "icon",
      "description": "菜单项左侧图标"
    }
  ],
  "exposes": [
    {
      "name": "isOpen",
      "description": ""
    },
    {
      "name": "open",
      "description": ""
    },
    {
      "name": "close",
      "description": ""
    },
    {
      "name": "toggle",
      "description": ""
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "code": "<script setup lang=\"ts\">\nimport RebornDropdown from \"~/components/reborn/ui/reborn-dropdown/RebornDropdown.vue\";\nimport RebornDropdownItem from \"~/components/reborn/ui/reborn-dropdown/RebornDropdownItem.vue\";\nimport { dropdownColors, dropdownSizes } from \"~/components/reborn/ui/reborn-dropdown/reborn-dropdown.config\";\n\n// ─── 交互演练场 ─────────────────────────────────────────────────\n\nconst state = ref<Record<string, any>>({\n  trigger: \"hover\",\n  splitButton: false,\n  hideOnClick: true,\n  size: \"md\",\n  color: \"primary\",\n  disabled: false,\n  placement: \"bottom-start\",\n});\n\n/** 最近一次触发的 command，用于回显事件 */\nconst lastCommand = ref(\"\");\n\nfunction handleCommand(key: string) {\n  lastCommand.value = key;\n}\n\nconst triggerOptions = [\n  { label: \"Hover 悬浮\", value: \"hover\" },\n  { label: \"Click 点击\", value: \"click\" },\n];\n\nconst placementOptions = [\n  { label: \"左下 (bottom-start)\", value: \"bottom-start\" },\n  { label: \"底部居中 (bottom)\", value: \"bottom\" },\n  { label: \"右下 (bottom-end)\", value: \"bottom-end\" },\n  { label: \"左上 (top-start)\", value: \"top-start\" },\n  { label: \"顶部居中 (top)\", value: \"top\" },\n  { label: \"右上 (top-end)\", value: \"top-end\" },\n];\n\n/** 演练场控制面板配置 */\nconst controls: any = [\n  {\n    title: \"基础属性\",\n    children: [\n      {\n        label: \"触发方式\",\n        key: \"trigger\",\n        component: \"select\" as const,\n        defaultValue: \"hover\",\n        props: { options: triggerOptions },\n      },\n      {\n        label: \"尺寸规格\",\n        key: \"size\",\n        component: \"select\" as const,\n        defaultValue: \"md\",\n        props: {\n          options: dropdownSizes.map((s) => ({ label: s.toUpperCase(), value: s })),\n        },\n      },\n      {\n        label: \"配色方案\",\n        key: \"color\",\n        component: \"select\" as const,\n        defaultValue: \"primary\",\n        props: {\n          options: dropdownColors.map((c) => ({\n            label: c.charAt(0).toUpperCase() + c.slice(1),\n            value: c,\n          })),\n        },\n      },\n      {\n        label: \"弹出位置\",\n        key: \"placement\",\n        component: \"select\" as const,\n        defaultValue: \"bottom-start\",\n        props: { options: placementOptions },\n      },\n    ],\n  },\n  {\n    title: \"行为控制\",\n    children: [\n      { label: \"按钮组模式\", key: \"splitButton\", component: \"checkbox\" as const, defaultValue: false },\n      { label: \"点击后隐藏菜单\", key: \"hideOnClick\", component: \"checkbox\" as const, defaultValue: true },\n      { label: \"禁用状态\", key: \"disabled\", component: \"checkbox\" as const, defaultValue: false },\n    ],\n  },\n];\n\n/** 演练场右上角展示的等价代码 */\nconst dropdownCode = computed(() => {\n  const s = state.value;\n  const props: string[] = [];\n\n  if (s.trigger !== \"hover\") props.push(`trigger=\"${s.trigger}\"`);\n  if (s.splitButton) props.push(\"split-button\");\n  if (!s.hideOnClick) props.push(':hide-on-click=\"false\"');\n  if (s.size !== \"md\") props.push(`size=\"${s.size}\"`);\n  if (s.color !== \"primary\") props.push(`color=\"${s.color}\"`);\n  if (s.disabled) props.push(\"disabled\");\n  if (s.placement !== \"bottom-start\") props.push(`placement=\"${s.placement}\"`);\n\n  const propsStr = props.length > 0 ? \"\\n  \" + props.join(\"\\n  \") : \"\";\n  return `<RebornDropdown${propsStr}\\n  @command=\"handleCommand\"\\n>\\n  <RebornButton label=\"下拉菜单\" />\\n  <template #dropdown>\\n    <RebornDropdownItem command=\"new\">新建文件</RebornDropdownItem>\\n    <RebornDropdownItem command=\"edit\">编辑内容</RebornDropdownItem>\\n  </template>\\n</RebornDropdown>`;\n});\n</script>\n\n<template>\n  <div class=\"flex w-full min-w-0 flex-col\">\n    <Playground\n      v-model=\"state\"\n      :controls=\"controls\"\n      :code=\"dropdownCode\"\n      component-name=\"RebornDropdown\"\n      title=\"交互演练场\"\n      description=\"调节触发方式、弹出位置与配色，实时预览下拉菜单的展开表现。\"\n    >\n      <div class=\"flex flex-col items-center gap-4\">\n        <RebornDropdown\n          :trigger=\"state.trigger\"\n          :split-button=\"state.splitButton\"\n          :hide-on-click=\"state.hideOnClick\"\n          :size=\"state.size\"\n          :color=\"state.color\"\n          :disabled=\"state.disabled\"\n          :placement=\"state.placement\"\n          @command=\"handleCommand\"\n        >\n          <RebornButton\n            :size=\"state.size\"\n            :color=\"state.color\"\n            :disabled=\"state.disabled\"\n            :label=\"state.splitButton ? '提交操作' : '下拉菜单'\"\n          />\n          <template #dropdown>\n            <RebornDropdownItem command=\"new\">\n              <template #icon>\n                <Icon\n                  name=\"lucide:plus\"\n                  class=\"size-4\"\n                />\n              </template>\n              新建文件\n            </RebornDropdownItem>\n            <RebornDropdownItem command=\"edit\">\n              <template #icon>\n                <Icon\n                  name=\"lucide:pencil\"\n                  class=\"size-4\"\n                />\n              </template>\n              编辑内容\n            </RebornDropdownItem>\n            <RebornDropdownItem\n              command=\"share\"\n              divided\n            >\n              <template #icon>\n                <Icon\n                  name=\"lucide:share-2\"\n                  class=\"size-4\"\n                />\n              </template>\n              分享链接\n            </RebornDropdownItem>\n            <RebornDropdownItem command=\"download\">\n              <template #icon>\n                <Icon\n                  name=\"lucide:download\"\n                  class=\"size-4\"\n                />\n              </template>\n              下载文件\n            </RebornDropdownItem>\n            <RebornDropdownItem\n              command=\"delete\"\n              divided\n              disabled\n            >\n              <template #icon>\n                <Icon\n                  name=\"lucide:trash-2\"\n                  class=\"size-4\"\n                />\n              </template>\n              删除（禁用）\n            </RebornDropdownItem>\n          </template>\n        </RebornDropdown>\n        <DemoNote\n          v-if=\"lastCommand\"\n          tone=\"dimmed\"\n        >\n          最后触发：<code>@command=\"{{ lastCommand }}\"</code>\n        </DemoNote>\n      </div>\n    </Playground>\n\n    <DemoSection\n      title=\"配色方案\"\n      description=\"color 决定触发器与菜单项高亮态的语义色，与全站色板保持一致。\"\n    >\n      <DemoBlock\n        layout=\"grid\"\n        align=\"center\"\n      >\n        <div\n          v-for=\"c in dropdownColors\"\n          :key=\"c\"\n          class=\"flex flex-col items-center gap-3\"\n        >\n          <span class=\"text-dimmed text-xs font-medium\">{{ c }}</span>\n          <RebornDropdown\n            :color=\"c\"\n            size=\"sm\"\n            @command=\"handleCommand\"\n          >\n            <RebornButton\n              :color=\"c\"\n              size=\"sm\"\n              label=\"操作\"\n            />\n            <template #dropdown>\n              <RebornDropdownItem command=\"edit\">编辑</RebornDropdownItem>\n              <RebornDropdownItem command=\"delete\">删除</RebornDropdownItem>\n            </template>\n          </RebornDropdown>\n        </div>\n      </DemoBlock>\n    </DemoSection>\n\n    <DemoSection\n      title=\"尺寸规范\"\n      description=\"size 同时作用于触发按钮与菜单项的行高、字号和内边距。\"\n    >\n      <DemoBlock\n        layout=\"row\"\n        align=\"center\"\n        class=\"gap-10\"\n      >\n        <div\n          v-for=\"s in dropdownSizes\"\n          :key=\"s\"\n          class=\"flex flex-col items-center gap-3\"\n        >\n          <span class=\"text-dimmed text-xs font-medium\">{{ s.toUpperCase() }}</span>\n          <RebornDropdown\n            :size=\"s\"\n            color=\"info\"\n            @command=\"handleCommand\"\n          >\n            <RebornButton\n              :size=\"s\"\n              color=\"info\"\n              :label=\"s.toUpperCase()\"\n            />\n            <template #dropdown>\n              <RebornDropdownItem command=\"a\">选项 A</RebornDropdownItem>\n              <RebornDropdownItem command=\"b\">选项 B</RebornDropdownItem>\n            </template>\n          </RebornDropdown>\n        </div>\n      </DemoBlock>\n    </DemoSection>\n\n    <DemoSection\n      title=\"进阶场景\"\n      description=\"按钮组、点击触发、任意触发元素与悬停菜单，覆盖常见的业务组合方式。\"\n    >\n      <DemoBlock\n        layout=\"grid\"\n        align=\"start\"\n      >\n        <div class=\"flex flex-col items-center gap-4\">\n          <span class=\"text-dimmed text-xs font-medium\">按钮组 · <code>split-button</code></span>\n          <RebornDropdown\n            split-button\n            color=\"warning\"\n            @command=\"handleCommand\"\n          >\n            更多操作\n            <template #dropdown>\n              <RebornDropdownItem command=\"export\">\n                <template #icon>\n                  <Icon\n                    name=\"lucide:file-output\"\n                    class=\"size-4\"\n                  />\n                </template>\n                导出数据\n              </RebornDropdownItem>\n              <RebornDropdownItem command=\"import\">\n                <template #icon>\n                  <Icon\n                    name=\"lucide:file-input\"\n                    class=\"size-4\"\n                  />\n                </template>\n                导入数据\n              </RebornDropdownItem>\n              <RebornDropdownItem\n                command=\"settings\"\n                divided\n              >\n                <template #icon>\n                  <Icon\n                    name=\"lucide:settings\"\n                    class=\"size-4\"\n                  />\n                </template>\n                设置\n              </RebornDropdownItem>\n            </template>\n          </RebornDropdown>\n          <DemoNote tone=\"dimmed\">左侧为功能按钮，右侧箭头单独触发下拉。</DemoNote>\n        </div>\n\n        <div class=\"flex flex-col items-center gap-4\">\n          <span class=\"text-dimmed text-xs font-medium\">点击触发 · <code>divided</code></span>\n          <RebornDropdown\n            trigger=\"click\"\n            color=\"secondary\"\n            :hide-on-click=\"false\"\n            @command=\"handleCommand\"\n          >\n            <RebornButton\n              color=\"secondary\"\n              variant=\"outline\"\n              label=\"个人中心\"\n            >\n              <template #trailing>\n                <Icon\n                  name=\"lucide:chevron-down\"\n                  class=\"size-4\"\n                />\n              </template>\n            </RebornButton>\n            <template #dropdown>\n              <RebornDropdownItem command=\"profile\">个人资料</RebornDropdownItem>\n              <RebornDropdownItem command=\"billing\">账单管理</RebornDropdownItem>\n              <RebornDropdownItem\n                command=\"security\"\n                divided\n              >安全设置</RebornDropdownItem>\n              <RebornDropdownItem command=\"api\">API 密钥</RebornDropdownItem>\n              <RebornDropdownItem\n                command=\"logout\"\n                divided\n              >\n                <template #icon>\n                  <Icon\n                    name=\"lucide:log-out\"\n                    class=\"size-4\"\n                  />\n                </template>\n                退出登录\n              </RebornDropdownItem>\n            </template>\n          </RebornDropdown>\n          <DemoNote tone=\"dimmed\">divided 在项目间插入分隔线，用于区分操作层级。</DemoNote>\n        </div>\n\n        <div class=\"flex flex-col items-center gap-4\">\n          <span class=\"text-dimmed text-xs font-medium\">任意触发元素 · 默认插槽</span>\n          <RebornDropdown\n            trigger=\"click\"\n            @command=\"handleCommand\"\n          >\n            <span\n              class=\"border-primary text-primary hover:border-primary/70 cursor-pointer border-b-2 border-dashed font-medium transition-colors\"\n            >\n              点击这段文字\n            </span>\n            <template #dropdown>\n              <RebornDropdownItem command=\"view\">查看详情</RebornDropdownItem>\n              <RebornDropdownItem command=\"copy\">复制链接</RebornDropdownItem>\n            </template>\n          </RebornDropdown>\n          <DemoNote tone=\"dimmed\">触发器不限于按钮，任意元素均可作为默认插槽内容。</DemoNote>\n        </div>\n\n        <div class=\"flex flex-col items-center gap-4\">\n          <span class=\"text-dimmed text-xs font-medium\">悬停菜单 · 默认 <code>trigger=\"hover\"</code></span>\n          <RebornDropdown\n            color=\"error\"\n            @command=\"handleCommand\"\n          >\n            <RebornButton\n              color=\"error\"\n              variant=\"soft\"\n              label=\"危险操作\"\n            >\n              <template #trailing>\n                <Icon\n                  name=\"lucide:alert-triangle\"\n                  class=\"size-4\"\n                />\n              </template>\n            </RebornButton>\n            <template #dropdown>\n              <RebornDropdownItem command=\"archive\">归档项目</RebornDropdownItem>\n              <RebornDropdownItem command=\"transfer\">转移所有权</RebornDropdownItem>\n              <RebornDropdownItem\n                command=\"delete\"\n                divided\n                disabled\n              >\n                <template #icon>\n                  <Icon\n                    name=\"lucide:trash-2\"\n                    class=\"size-4\"\n                  />\n                </template>\n                永久删除\n              </RebornDropdownItem>\n            </template>\n          </RebornDropdown>\n          <DemoNote tone=\"dimmed\">鼠标移入即展开，移出 120ms 后自动关闭。</DemoNote>\n        </div>\n      </DemoBlock>\n    </DemoSection>\n  </div>\n</template>\n",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [
    "reborn-select-trigger"
  ],
  "whenToUse": [
    "把「更多操作」收纳到按钮触发的下拉菜单中，通过 command 事件分发点击项。",
    "需要 splitButton 模式：左侧主操作按钮 + 右侧箭头展开更多操作。",
    "需要 hover/click 两种触发方式与 6 向 placement 定位的操作菜单。"
  ],
  "whenNotToUse": [
    "uniapp 端不可用（仅 web），uniapp 下拉选值改用 reborn-dropdown-select。",
    "表单中选择数据值，改用 reborn-select。",
    "右键呼出的上下文菜单，改用 reborn-context-menu。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "菜单项需放在 dropdown 插槽内（通常为 RebornDropdownItem），通过 command 属性标识点击项，divided 在项上方加分隔线。",
    "trigger 默认 hover；hideOnClick 默认 true 点击菜单项后自动收起。",
    "portal 默认 true 浮层传送到 body，关闭后浮层随父容器裁剪；组件暴露 open/close/toggle/isOpen。"
  ],
  "dependencies": [
    "clsx"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-dropdown"
  },
