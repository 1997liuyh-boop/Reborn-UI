{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-cascader",
  "title": "级联选择器",
  "description": "用于在树形多层级数据中逐级选择的级联选择器组件，双端可用。",
  "category": "form",
  "tags": [],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "modelValue",
      "type": "(string | number)[] | (string | number)[][]",
      "required": false,
      "description": "绑定值",
      "default": "() => []"
    },
    {
      "name": "options",
      "type": "CascaderOption[]",
      "required": false,
      "description": "选项数据",
      "default": "() => []"
    },
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "标题",
      "default": "'请选择'"
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "description": "占位提示",
      "default": "'请选择'"
    },
    {
      "name": "showTrigger",
      "type": "boolean",
      "required": false,
      "description": "是否显示触发器",
      "default": "true"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用",
      "default": "false"
    },
    {
      "name": "labelKey",
      "type": "string",
      "required": false,
      "description": "标签字段",
      "default": "'label'"
    },
    {
      "name": "valueKey",
      "type": "string",
      "required": false,
      "description": "值字段",
      "default": "'value'"
    },
    {
      "name": "textSeparator",
      "type": "string",
      "required": false,
      "description": "分隔符",
      "default": "' / '"
    },
    {
      "name": "height",
      "type": "number | string",
      "required": false,
      "description": "列表高度 (rpx)",
      "default": "600"
    },
    {
      "name": "size",
      "type": "CascaderSize",
      "required": false,
      "description": "尺寸",
      "default": "'md'"
    },
    {
      "name": "color",
      "type": "CascaderColor",
      "required": false,
      "description": "颜色",
      "default": "'primary'"
    },
    {
      "name": "customClass",
      "type": "string",
      "required": false,
      "description": "自定义类名",
      "default": "''"
    },
    {
      "name": "customStyle",
      "type": "string",
      "required": false,
      "description": "自定义样式",
      "default": "''"
    },
    {
      "name": "ui",
      "type": "CascaderUI",
      "required": false,
      "description": "UI 覆盖",
      "default": "() => ({})"
    },
    {
      "name": "lazy",
      "type": "boolean",
      "required": false,
      "description": "是否动态加载子节点",
      "default": "false"
    },
    {
      "name": "lazyLoad",
      "type": "(node: CascaderOption, resolve: (children: CascaderOption[]) => void, reject: () => void) => void",
      "required": false,
      "description": "加载动态数据的方法"
    },
    {
      "name": "childrenKey",
      "type": "string",
      "required": false,
      "description": "指定选项的子选项字段",
      "default": "'children'"
    },
    {
      "name": "leafLevel",
      "type": "number",
      "required": false,
      "description": "查询次级菜单层级；为0时候查询所有",
      "default": "0"
    },
    {
      "name": "multiple",
      "type": "boolean",
      "required": false,
      "description": "是否多选",
      "default": "false"
    },
    {
      "name": "ellipsis",
      "type": "boolean",
      "required": false,
      "description": "是否显示省略号",
      "default": "true"
    },
    {
      "name": "lines",
      "type": "number",
      "required": false,
      "description": "省略号行数",
      "default": "1"
    },
    {
      "name": "clearable",
      "type": "boolean",
      "required": false,
      "description": "是否显示清空按钮",
      "default": "true"
    },
    {
      "name": "bordered",
      "type": "boolean",
      "required": false,
      "description": "是否显示边框",
      "default": "true"
    },
    {
      "name": "showArrow",
      "type": "boolean",
      "required": false,
      "description": "是否显示箭头",
      "default": "true"
    },
    {
      "name": "arrowAnimation",
      "type": "boolean",
      "required": false,
      "description": "展开时箭头是否旋转",
      "default": "true"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "自定义类名"
    },
    {
      "name": "portal",
      "type": "SelectTriggerProps[\"portal\"]",
      "required": false,
      "description": "浮层是否传送到 body（默认 true）。 关掉后浮层留在触发器内，会随父容器一起滚动、也一起被 overflow 裁剪。",
      "default": "true"
    },
    {
      "name": "triggerUi",
      "type": "SelectTriggerProps[\"ui\"]",
      "required": false,
      "description": "触发器 UI 配置",
      "default": "() => ({})"
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "payload": "(e: 'update:modelValue', value: (string | number)[] | (string | number)[][]): void",
      "description": "选中项改变时触发 (v-model)"
    },
    {
      "name": "change",
      "payload": "(e: 'change', value: (string | number)[] | (string | number)[][]): void",
      "description": "选中项改变时触发"
    }
  ],
  "slots": [
    {
      "name": "tabs",
      "description": "自定义顶部已选路径导航标签的内容（UniApp 端）"
    },
    {
      "name": "item",
      "description": "自定义选项行的内容，作用域提供选项对象、列索引与是否激活（UniApp 端）"
    },
    {
      "name": "default",
      "description": "自定义触发器显示内容；`showTrigger` 为 `false` 时整体替换触发区域，作用域提供 `open` / `close` / `clear` 等方法（Web 端）"
    },
    {
      "name": "option",
      "description": "自定义下拉面板中单个选项的渲染内容，作用域提供选项对象与所在列索引（Web 端）"
    }
  ],
  "exposes": [
    {
      "name": "open",
      "description": "打开底部弹出层（禁用状态下无效）；懒加载模式下首次打开会请求根级选项"
    },
    {
      "name": "close",
      "description": "关闭底部弹出层；关闭前未确认的浏览/勾选不会提交"
    },
    {
      "name": "clear",
      "description": "清空选中值与展开路径，并触发 update:modelValue 与 change 事件（空数组）"
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-cascader/RebornCascaderDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-cascader/RebornCascaderDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [
    "reborn-badge",
    "reborn-button",
    "reborn-loading",
    "reborn-popup",
    "reborn-select-trigger",
    "reborn-text"
  ],
  "whenToUse": [
    "省市区、组织架构等多级联动选择。",
    "商品分类等树形结构数据的逐级选择。",
    "需要通过 labelKey/valueKey/childrenKey 适配任意字段名的树形数据源。"
  ],
  "whenNotToUse": [
    "单层扁平选项选择，改用 reborn-select。",
    "uniapp 端的滚动列选择交互，可改用 reborn-picker-view。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端可用。",
    "modelValue 为数组（各层级选中值路径），v-model 绑定时注意类型。",
    "leafLevel 可限制必选层级，0 表示不限制；textSeparator 控制触发器回显文本的分隔符。",
    "portal 仅 Web 生效：默认浮层传送到 body 不受祖先 overflow/transform 裁剪，关闭后浮层留在触发器内随父容器裁剪。",
    "showTrigger 设为 false 可隐藏默认触发器自行触发；组件暴露 open/close/clear 方法。"
  ],
  "dependencies": [
    "clsx"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-cascader"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-cascader/RebornCascader.vue",
      "app/components/reborn/ui/reborn-cascader/index.ts",
      "app/components/reborn/ui/reborn-cascader/reborn-cascader.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-cascader/RebornCascader.vue",
      "packages/uniapp-project/src/components/reborn-cascader/reborn-cascader.config.ts"
    ]
  },
  "docPath": "content/2.components/input-and-forms/reborn-cascader.md",
