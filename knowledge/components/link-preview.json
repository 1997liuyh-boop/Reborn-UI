{
  "$schema": "../schema/component.schema.json",
  "id": "link-preview",
  "title": "链接预览",
  "description": "用于悬停链接文字时弹出目标网页预览图的行内链接组件。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind",
    "aceternity-ui"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "isStatic",
      "type": "true",
      "required": false,
      "description": "预览图是否为静态图；设为 `true` 使用静态模式。",
      "default": "false"
    },
    {
      "name": "imageSrc",
      "type": "string",
      "required": false,
      "description": "静态模式下要显示的图片来源（`isStatic` 为 `true` 时必填）。",
      "default": "\"\""
    },
    {
      "name": "url",
      "type": "string",
      "required": false,
      "description": "optional in static mode",
      "default": "\"\""
    },
    {
      "name": "class",
      "type": "string",
      "required": false,
      "description": "应用于主元素的自定义类。",
      "default": "\"\""
    },
    {
      "name": "linkClass",
      "type": "string",
      "required": false,
      "description": "应用于链接元素的自定义类。",
      "default": "\"\""
    },
    {
      "name": "width",
      "type": "number",
      "required": false,
      "description": "预览图的宽度。",
      "default": "200"
    },
    {
      "name": "height",
      "type": "number",
      "required": false,
      "description": "预览图的高度。",
      "default": "125"
    }
  ],
