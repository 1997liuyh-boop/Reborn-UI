{
  "$schema": "../schema/component.schema.json",
  "id": "testimonial-slider",
  "title": "评价滑块",
  "description": "用于轮播展示用户评价（头像、引言、姓名、职位）的轻量滑块组件。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "testimonials",
      "type": "Testimonial[]",
      "required": false,
      "description": "滑块中显示的评价对象数组。",
      "default": "() => []"
    },
    {
      "name": "autoRotate",
      "type": "boolean",
      "required": false,
      "description": "若为 `true`，滑块每隔 `duration` 秒自动切换。",
      "default": "true"
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "description": "启用自动轮播时的切换间隔（秒）。",
      "default": "5"
    }
  ],
