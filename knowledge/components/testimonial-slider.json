{
  "$schema": "../schema/component.schema.json",
  "id": "testimonial-slider",
  "title": "评价滑块",
  "description": "用于轮播展示用户评价（头像、引言、姓名、职位）的轻量滑块组件。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "testimonials",
      "type": "Testimonial[]",
      "required": false,
      "description": "滑块中显示的评价对象数组。",
      "default": "() => []"
    },
    {
      "name": "autoRotate",
      "type": "boolean",
      "required": false,
      "description": "若为 `true`，滑块每隔 `duration` 秒自动切换。",
      "default": "true"
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "description": "启用自动轮播时的切换间隔（秒）。",
      "default": "5"
    }
  ],
  "events": [],
  "slots": [],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "code": "<script lang=\"ts\" setup>\nimport { rand } from \"@vueuse/core\";\n\nconst testimonials = [\n  {\n    img: `https://randomuser.me/api/portraits/men/${getRandomNumber()}.jpg`,\n    quote:\n      \"Reborn UI is sleeker than my star cruiser. Launch-ready in seconds. Zero crashes, zero gravity.\",\n    name: \"Buzz Lightyear\",\n    role: \"Intergalactic Interface Command\",\n  },\n  {\n    img: `https://randomuser.me/api/portraits/women/${getRandomNumber()}.jpg`,\n    quote:\n      \"Clickin' around this thing feels like ridin' a horse with turbo boosters. reborn’s got giddyup!\",\n    name: \"Jessie\",\n    role: \"Yeehaw Engagement & Barnyard UX\",\n  },\n  {\n    img: `https://randomuser.me/api/portraits/men/${getRandomNumber()}.jpg`,\n    quote:\n      \"I’ve seen some clunky UIs in my day... but this one? Smoother than a tumbleweed on Tuesday.\",\n    name: \"Woody\",\n    role: \"Sheriff\",\n  },\n  {\n    img: `https://randomuser.me/api/portraits/men/${getRandomNumber()}.jpg`,\n    quote:\n      \"I was terrified. Then I clicked. Nothing exploded. Reborn UI is a safe space. I’m thriving.\",\n    name: \"Rex\",\n    role: \"Senior Panic Tester, Dinosaur Usability Lab\",\n  },\n];\n\nfunction getRandomNumber() {\n  return rand(1, 99);\n}\n</script>\n\n<template>\n  <div class=\"bg-background relative h-[500px] w-full overflow-hidden rounded-lg border\">\n    <div class=\"mt-[64px] flex justify-center px-12\">\n      <TestimonialSlider :testimonials=\"testimonials\" />\n    </div>\n  </div>\n</template>\n",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "落地页客户评价、用户推荐语区块。",
    "需要按固定间隔自动轮播评价内容时（autoRotate + duration）。"
  ],
  "whenNotToUse": [
    "需要更丰富动效的评价展示，改用 animated-testimonials。",
    "通用内容轮播（图片、卡片等），改用 reborn-carousel。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "testimonials 数据项包含 img/quote/name/role 字段。",
    "duration 单位为秒（默认 5），autoRotate 默认开启。",
    "无插槽与事件，展示结构不可自定义。"
  ],
