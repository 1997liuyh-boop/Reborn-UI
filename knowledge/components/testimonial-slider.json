{
  "$schema": "../schema/component.schema.json",
  "id": "testimonial-slider",
  "title": "评价滑块",
  "description": "用于轮播展示用户评价（头像、引言、姓名、职位）的轻量滑块组件。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "testimonials",
      "type": "Testimonial[]",
      "required": false,
      "description": "滑块中显示的评价对象数组。",
      "default": "() => []"
    },
    {
      "name": "autoRotate",
      "type": "boolean",
      "required": false,
      "description": "若为 `true`，滑块每隔 `duration` 秒自动切换。",
      "default": "true"
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "description": "启用自动轮播时的切换间隔（秒）。",
      "default": "5"
    }
  ],
  "events": [],
  "slots": [],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/testimonial-slider/TestimonialSliderDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "落地页客户评价、用户推荐语区块。",
    "需要按固定间隔自动轮播评价内容时（autoRotate + duration）。"
  ],
  "whenNotToUse": [
    "需要更丰富动效的评价展示，改用 animated-testimonials。",
    "通用内容轮播（图片、卡片等），改用 reborn-carousel。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "testimonials 数据项包含 img/quote/name/role 字段。",
    "duration 单位为秒（默认 5），autoRotate 默认开启。",
    "无插槽与事件，展示结构不可自定义。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add testimonial-slider"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/testimonial-slider/TestimonialSlider.vue",
