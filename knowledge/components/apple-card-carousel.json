{
  "$schema": "../schema/component.schema.json",
  "id": "apple-card-carousel",
  "title": "Apple 卡片轮播",
  "description": "用于以 Apple 官网风格横向滚动卡片、点击展开为模态详情的轮播组件。",
  "category": "data-display",
  "tags": [
    "css",
    "tailwind",
    "card",
    "aceternity-ui"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "height",
      "type": "number | string",
      "required": false,
      "description": "高度属性；使用 `fill` 时会省略。",
      "default": "undefined"
    },
    {
      "name": "width",
      "type": "number | string",
      "required": false,
      "description": "宽度属性；使用 `fill` 时会省略。",
      "default": "undefined"
    },
    {
      "name": "src",
      "type": "string",
      "required": true,
      "description": "图片源地址。_必填。_",
      "default": "**—**"
    },
    {
      "name": "class",
      "type": "string",
      "required": false,
      "description": "通过 `cn()` 合并的额外类名。",
      "default": "\"\""
    },
    {
      "name": "alt",
      "type": "string",
      "required": false,
      "description": "图片的替代文本。",
      "default": "\"Background of a beautiful view\""
    },
    {
      "name": "fill",
      "type": "boolean",
      "required": false,
      "description": "若为 `true`，通过工具类设置 `width:100%; height:100%`。",
      "default": "false"
    },
    {
      "name": "card",
      "type": "Card",
      "required": true,
      "description": "卡片数据对象。",
      "default": "—"
    },
    {
      "name": "index",
      "type": "number",
      "required": true,
      "description": "卡片在轮播中的位置。",
      "default": "—"
    },
    {
      "name": "layout",
      "type": "boolean",
      "required": false,
      "description": "启用共享布局的 FLIP 动画。",
      "default": "false"
    },
    {
      "name": "initialScroll",
      "type": "number",
      "required": false,
      "description": "挂载时应用的水平滚动偏移量（px）。",
      "default": "0"
    }
  ],
  "events": [],
  "slots": [
    {
      "name": "default",
      "description": ""
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/apple-card-carousel/AppleCardCarouselDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "产品特性、案例故事的横向卡片陈列。",
    "图文卡片需要点击放大查看详情内容的场景。",
    "落地页需要平滑滚动控制与模糊加载图片的轮播。"
  ],
  "whenNotToUse": [
    "两组内容的滑动对比，改用 compare。",
    "单张卡片的悬停 3D 交互，改用 card-3d。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "需组合 AppleCardCarousel、AppleCarouselItem、AppleCard 多个子组件使用。",
    "AppleCard 的 card 与 index 为必填 prop，卡片详情内容通过默认插槽传入。"
  ],
  "dependencies": [
    "@vueuse/core",
    "motion-v"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add apple-card-carousel"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/apple-card-carousel/AppleBlurImage.vue",
      "app/components/reborn/ui/apple-card-carousel/AppleCard.vue",
