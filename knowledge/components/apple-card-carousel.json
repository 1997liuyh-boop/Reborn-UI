      "title": "Web 演示",
      "code": "<script lang=\"ts\" setup>\nconst data = [\n  {\n    category: \"人工智能\",\n    title: \"用 AI 做更多事。\",\n    src: \"https://images.unsplash.com/photo-1593508512255-86ab42a8e620?q=80&w=3556&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\",\n  },\n  {\n    category: \"效率\",\n    title: \"把生产力再抬一档。\",\n    src: \"https://images.unsplash.com/photo-1531554694128-c4c6665f59c2?q=80&w=3387&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\",\n  },\n  {\n    category: \"产品\",\n    title: \"全新 Apple Vision Pro。\",\n    src: \"https://images.unsplash.com/photo-1713869791518-a770879e60dc?q=80&w=2333&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\",\n  },\n  {\n    category: \"产品\",\n    title: \"iPhone 15 Pro Max 地图。\",\n    src: \"https://images.unsplash.com/photo-1599202860130-f600f4948364?q=80&w=2515&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\",\n  },\n  {\n    category: \"iOS\",\n    title: \"拍照，又进步了一点。\",\n    src: \"https://images.unsplash.com/photo-1602081957921-9137a5d6eaee?q=80&w=2793&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\",\n  },\n  {\n    category: \"招聘\",\n    title: \"招一位 Staff 软件工程师。\",\n    src: \"https://images.unsplash.com/photo-1511984804822-e16ba72f5848?q=80&w=2048&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\",\n  },\n];\n</script>\n\n<template>\n  <DemoSection\n    title=\"基础用法\"\n    description=\"卡片展开后的内容区是卡片自己的表面，用 elevated 填充，不再套中性色硬编码。\"\n  >\n    <div class=\"w-full overflow-hidden\">\n      <AppleCardCarousel>\n        <AppleCarouselItem\n          v-for=\"(card, index) in data\"\n          :key=\"index\"\n          :index=\"index\"\n        >\n          <AppleCard\n            :card=\"card\"\n            :index=\"index\"\n            :layout=\"true\"\n          >\n            <div\n              :key=\"`dummy-content${index}`\"\n              class=\"bg-elevated rounded-ui-lg mb-4 p-8 md:p-14\"\n            >\n              <p class=\"text-muted mx-auto max-w-3xl text-base md:text-2xl\">\n                <span class=\"text-highlighted font-bold\">第一法则：大胆展示你的作品。</span>\n                随手记下待办、课堂笔记；需要转成文字也没问题。\n              </p>\n              <img\n                src=\"https://assets.aceternity.com/macbook.png\"\n                alt=\"MacBook 示意图\"\n                height=\"500\"\n                width=\"500\"\n                class=\"mx-auto size-full object-contain md:size-1/2\"\n              >\n            </div>\n          </AppleCard>\n        </AppleCarouselItem>\n      </AppleCardCarousel>\n    </div>\n  </DemoSection>\n</template>\n",
      "source": "demo",
      "platform": "web"
    }
  ],
