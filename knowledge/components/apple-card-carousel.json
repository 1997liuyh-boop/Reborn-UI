      "app/components/reborn/ui/apple-card-carousel/AppleCarouselContext.ts",
      "app/components/reborn/ui/apple-card-carousel/AppleCarouselItem.vue",
      "app/components/reborn/ui/apple-card-carousel/index.ts"
    ]
  },
