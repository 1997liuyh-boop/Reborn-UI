{
  "$schema": "../schema/component.schema.json",
  "id": "meteors",
  "title": "流星雨",
  "description": "用于在卡片等容器内渲染划过的流星雨背景动画的装饰组件。",
  "category": "effect",
  "tags": [
    "css",
    "tailwind",
    "aceternity-ui"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "count",
      "type": "number",
      "default": "20",
      "required": false,
      "description": "动画中显示的流星数量。"
    },
    {
      "name": "class",
      "type": "string",
      "default": "\"\"",
      "required": false,
      "description": "应用于流星的额外 CSS 类，便于自定义。"
    }
  ],
  "events": [],
  "slots": [],
  "exposes": [],
