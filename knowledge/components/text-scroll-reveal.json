      "title": "Web 演示",
      "code": "<template>\n  <DemoSection\n    title=\"基础用法\"\n    description=\"随滚动逐词点亮；画布内部不再另套填充层。\"\n  >\n    <DemoBlock\n      layout=\"stack\"\n      align=\"center\"\n    >\n      <div class=\"z-10 flex min-h-64 items-center justify-center\">\n        <TextScrollReveal text=\"用 Reborn UI 把界面做漂亮。\" />\n      </div>\n    </DemoBlock>\n  </DemoSection>\n</template>\n",
