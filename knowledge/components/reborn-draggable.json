{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-draggable",
  "title": "Draggable 拖拽排序",
  "description": "用于列表项拖拽排序并同步 v-model 数据顺序的容器组件，双端可用。",
  "category": "misc",
  "tags": [],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "className",
      "type": "string",
      "default": "\"\"",
      "required": false,
      "description": "PassThrough 样式配置"
    },
    {
      "name": "ui",
      "type": "any",
      "default": "() => ({})",
      "required": false,
      "description": "UI 配置"
    },
    {
      "name": "modelValue",
      "type": "any[]",
      "default": "() => []",
      "required": false,
      "description": "数据数组，支持双向绑定"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": "false",
      "required": false,
      "description": "是否禁用拖拽功能"
    },
    {
      "name": "columns",
      "type": "number",
      "default": "1",
      "required": false,
      "description": "列数：1为单列纵向布局，>1为多列网格布局"
    },
    {
      "name": "longPress",
      "type": "boolean",
      "default": "true",
      "required": false,
      "description": "是否需要长按触发"
    },
    {
      "name": "gap",
      "type": "number",
      "default": "4",
      "required": false,
      "description": "间距"
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "description": "绑定的数据列表发生变化时触发",
      "payload": "(val: Array)` 最新数据列表"
    },
    {
      "name": "change",
      "description": "列表项顺序改变时触发",
      "payload": "(val: Array)` 最新数据列表"
    },
    {
      "name": "start",
      "description": "拖拽开始时触发",
      "payload": "(index: Number|Object)` 拖拽元素的索引或信息"
    },
    {
      "name": "end",
      "description": "拖拽结束时触发",
      "payload": "(index: Number)` 最终落点元素索引"
    }
  ],
  "slots": [
    {
      "name": "item",
      "props": "",
      "description": "自定义列表项内容"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-draggable/RebornDraggableDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-draggable/RebornDraggableDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "自定义常用功能、图标宫格等需要用户手动调整顺序的列表。",
    "需要监听拖拽过程（start/end/change 事件）并持久化新顺序的场景。",
    "uniapp 端需要多列网格拖拽排序（columns > 1）。"
  ],
  "whenNotToUse": [
    "列表项需要左滑呼出删除等操作而非排序，uniapp 端改用 reborn-swiper-action。",
    "顺序固定的静态列表，直接用普通列表渲染即可。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端可用。",
    "columns（网格列数）与 longPress（长按触发，默认 true）仅 UniApp 端生效。",
    "列表项内容通过 item 作用域插槽渲染，数据用 v-model 绑定数组。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-draggable"
  },
  "sourceRefs": {
