{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-chip",
  "title": "提示点/标记",
  "description": "用于在元素角标位置显示提示点或数字标记的组件，双端可用。",
  "category": "basic",
  "tags": [
    "css",
    "tailwind",
    "chip",
    "uniapp"
  ],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "color",
      "type": "typeof chipColors[number]",
      "required": false,
      "description": "角标背景色（语义色）。",
      "default": "'primary'"
    },
    {
      "name": "size",
      "type": "typeof chipSizes[number]",
      "required": false,
      "description": "角标尺寸，两端档位不同（web 为 px、uniapp 为 rpx 标尺）。",
      "default": "'md'"
    },
    {
      "name": "text",
      "type": "string | number",
      "required": false,
      "description": "角标文本内容；不传（或空）时仅显示纯色小圆点。"
    },
    {
      "name": "position",
      "type": "typeof chipPositions[number]",
      "required": false,
      "description": "相对宿主的四角定位。",
      "default": "'top-right'"
    },
    {
      "name": "show",
      "type": "boolean",
      "required": false,
      "description": "是否显示角标，可配合 `v-model:show` 使用。",
      "default": "true"
    },
    {
      "name": "inset",
      "type": "boolean",
      "required": false,
      "description": "是否内嵌贴合宿主边缘（默认角标中心压在宿主角上）。",
      "default": "false"
    },
    {
      "name": "standalone",
      "type": "boolean",
      "required": false,
      "description": "是否作为独立角标渲染（无宿主内容时使用）。",
      "default": "false"
    },
    {
      "name": "customClass",
      "type": "any",
      "required": false,
      "description": "**仅 UniApp**。追加到根元素的自定义类名。"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "追加到根元素的自定义类名"
    },
    {
      "name": "ui",
      "type": "any",
      "required": false,
      "description": "按内部结构键（root/base/label）覆盖对应节点的样式类"
    }
  ],
  "events": [
    {
      "name": "update:show",
      "description": "显隐状态变化时触发，配合 `v-model:show` 同步"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "宿主内容，作为角标的定位锚点；`standalone` 场景下可为空。"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-chip/RebornChipDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-chip/RebornChipDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "图标、头像或按钮右上角显示未读数量（text 传数字或文本）。",
    "仅需红点提醒而无文字的消息提示（不传 text 即为小圆点）。",
    "需要通过 v-model:show 动态控制标记显隐的场景。"
  ],
  "whenNotToUse": [
    "独立展示状态文字标签（非角标叠加），改用 reborn-badge。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端可用。",
    "默认以默认插槽内容为锚点定位（position 默认 top-right），无宿主独立使用时需设 standalone。",
    "inset 使标记内嵌于宿主边缘，与 position 组合调整贴合位置。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-chip"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-chip/RebornChip.vue",
      "app/components/reborn/ui/reborn-chip/index.ts",
      "app/components/reborn/ui/reborn-chip/reborn-chip.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-chip/RebornChip.vue",
      "packages/uniapp-project/src/components/reborn-chip/index.ts",
      "packages/uniapp-project/src/components/reborn-chip/reborn-chip.config.ts"
    ]
  },
  "docPath": "content/2.components/button/reborn-chip.md",
