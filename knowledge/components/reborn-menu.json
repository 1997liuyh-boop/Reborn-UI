{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-menu",
  "title": "菜单",
  "description": "用于站点侧边或顶部导航的菜单组件，支持垂直/水平模式、折叠与多级子菜单。",
  "category": "misc",
  "tags": [],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "mode",
      "type": "MenuMode",
      "required": false,
      "description": "菜单模式",
      "default": "\"vertical\""
    },
    {
      "name": "collapse",
      "type": "boolean",
      "required": false,
      "description": "是否折叠菜单",
      "default": "false"
    },
    {
      "name": "defaultOpeneds",
      "type": "string[]",
      "required": false,
      "description": "默认展开的子菜单索引数组",
      "default": "() => []"
    },
    {
      "name": "uniqueOpened",
      "type": "boolean",
      "required": false,
      "description": "是否只保持一个子菜单的展开（手风琴模式）",
      "default": "false"
    },
    {
      "name": "menuTrigger",
      "type": "MenuTrigger",
      "required": false,
      "description": "子菜单打开的触发方式 (仅水平模式或折叠时生效)",
      "default": "\"hover\""
    },
    {
      "name": "router",
      "type": "boolean",
      "required": false,
      "description": "是否使用 vue-router 的模式，启用后 index 会作为 path 进行路由跳转",
      "default": "false"
    },
    {
      "name": "collapseTransition",
      "type": "boolean",
      "required": false,
      "description": "是否开启折叠过渡动画",
      "default": "true"
    },
    {
      "name": "expandType",
      "type": "ExpandType",
      "required": false,
      "description": "二级菜单展开方式：平铺展开(normal) / 浮层展开(popup)",
      "default": "\"popup\""
    },
    {
      "name": "expandMutex",
      "type": "boolean",
      "required": false,
      "description": "同级别是否互斥展开，即同级只有一个子菜单展开",
      "default": "false"
    },
    {
      "name": "closeOnClickOutside",
      "type": "boolean",
      "required": false,
      "description": "触发方式为点击时，点击菜单外部是否关闭展开的子菜单",
      "default": "true"
    },
    {
      "name": "color",
      "type": "MenuColor",
      "required": false,
      "description": "主题颜色",
      "default": "\"primary\""
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "required": false,
      "description": "菜单背景色",
      "default": "\"\""
    },
    {
      "name": "textColor",
      "type": "string",
      "required": false,
      "description": "菜单文字颜色",
      "default": "\"\""
    },
    {
      "name": "activeTextColor",
      "type": "string",
      "required": false,
      "description": "激活状态的文字颜色",
      "default": "\"\""
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "自定义类名",
      "default": "undefined"
    },
    {
      "name": "ui",
      "type": "Partial<{\n    root: ClassValue;\n    menu: ClassValue;\n    menuItem: ClassValue;\n    menuItemContent: ClassValue;\n    menuItemTitle: ClassValue;\n    menuItemIcon: ClassValue;\n    menuItemArrow: ClassValue;\n    subMenu: ClassValue;\n    subMenuPopup: ClassValue;\n    subMenuContent: ClassValue;\n    menuItemGroup: ClassValue;\n    menuItemGroupTitle: ClassValue;\n  }>",
      "required": false,
      "description": "UI 局部重写配置",
      "default": "() => ({})"
    },
    {
      "name": "active",
      "type": "string[]",
      "required": false,
      "description": "双向绑定值",
      "vModel": true,
      "default": "[]"
    },
    {
      "name": "expanded",
      "type": "MenuValue[]",
      "required": false,
      "description": "双向绑定值",
      "vModel": true
    },
    {
      "name": "index",
      "type": "string",
      "required": true,
      "description": "唯一标识"
    },
    {
      "name": "route",
      "type": "string | object",
      "required": false,
      "description": "预留路由参数"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用",
      "default": "false"
    },
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "组标题",
      "default": "\"\""
    },
    {
      "name": "popperOffset",
      "type": "number",
      "required": false,
      "description": "弹出层偏移量",
      "default": "6"
    }
  ],
  "events": [
    {
      "name": "select",
      "payload": "(e: \"select\", index: string, indexPath: string[]): void;",
      "description": "菜单项被选中时触发"
    },
    {
      "name": "open",
      "payload": "(e: \"open\", index: string, indexPath: string[]): void;",
      "description": "子菜单展开时触发"
    },
    {
      "name": "close",
      "payload": "(e: \"close\", index: string, indexPath: string[]): void;",
      "description": "子菜单收起时触发"
    },
    {
      "name": "update:active",
      "description": "active 变化时触发（v-model 同步）",
      "payload": "(indexPath: string[]) => void"
    },
    {
      "name": "update:expanded",
      "description": "expanded 变化时触发（v-model 同步）"
    },
    {
      "name": "click",
      "payload": "(e: \"click\", index: string): void;",
      "description": "点击菜单项时触发"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "菜单内容"
    },
    {
      "name": "icon",
      "description": "子菜单图标"
    },
    {
      "name": "title",
      "description": "子菜单标题"
    }
  ],
  "exposes": [
    {
      "name": "open",
      "description": "展开指定菜单"
    },
    {
      "name": "close",
      "description": "收起指定菜单"
    },
    {
      "name": "updateActive",
      "description": "更新当前激活的菜单路径"
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-menu/RebornMenuDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "后台管理系统侧边导航（mode=\"vertical\"，可配 collapse 折叠）。",
    "顶部水平导航栏（mode=\"horizontal\"）。",
    "启用 router 模式后点击菜单项以 index 作为 path 进行路由跳转。",
    "需要 v-model:active / v-model:expanded 受控管理选中与展开状态时。"
  ],
  "whenNotToUse": [
    "uniapp 端导航（本组件仅 web），底部页签改用 reborn-tabbar。",
    "点击触发的轻量浮层菜单改用 reborn-dropdown，右键菜单改用 reborn-context-menu。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "collapse 仅在 mode=\"vertical\" 时生效。",
    "router 模式下菜单项的 index 会被当作路由 path 使用，命名需与路由一致。",
    "子菜单展开方式由 expandType 控制（默认 popup），触发方式由 menuTrigger 控制（默认 hover）。"
  ],
  "dependencies": [
    "@vueuse/core",
    "clsx"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-menu"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-menu/RebornMenu.vue",
      "app/components/reborn/ui/reborn-menu/RebornMenuItem.vue",
      "app/components/reborn/ui/reborn-menu/RebornMenuItemGroup.vue",
      "app/components/reborn/ui/reborn-menu/RebornSubMenu.vue",
      "app/components/reborn/ui/reborn-menu/index.ts",
      "app/components/reborn/ui/reborn-menu/reborn-menu.config.ts"
    ]
  },
  "docPath": "content/2.components/miscellaneous/reborn-menu.md",
  "_meta": {
    "contentHash": "435f521cf5e11a97ea5749b80ed0db201c5e2941",
    "hasOverride": true,
    "extractors": {
      "web": "ok",
      "uniapp": "absent",
      "docs": "found"
    }
  }
}
