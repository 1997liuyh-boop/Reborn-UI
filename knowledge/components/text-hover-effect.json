      "name": "strokeWidth",
      "type": "number",
      "required": false,
      "description": "文字描边宽度。",
      "default": "0.75"
    },
    {
      "name": "text",
      "type": "string",
      "required": true,
      "description": "应用悬停效果的文字。",
      "default": "Required"
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "description": "蒙版过渡动画的持续时间（秒）。",
      "default": "0.2"
    },
    {
      "name": "opacity",
      "type": "number",
      "required": false,
      "description": "文字的不透明度。",
      "default": "0.75"
    }
  ],
