  "examples": [
    {
      "title": "Web 演示",
      "code": "<template>\n  <ClientOnly>\n    <div class=\"flex h-auto flex-col items-center justify-center gap-4 max-lg:w-full md:flex-1\">\n      <span class=\"text-xl font-medium\">Hover below to reveal</span>\n      <TextHoverEffect class=\"w-[90%] lg:min-h-64\" text=\"reborn\" />\n    </div>\n  </ClientOnly>\n</template>\n",
