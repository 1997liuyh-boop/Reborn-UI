{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-tooltip",
  "title": "Tooltip 文字提示",
  "description": "用于鼠标悬停时在元素旁显示文字提示气泡的组件。",
  "category": "navigation",
  "tags": [],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "content",
      "type": "string",
      "required": false,
      "description": "提示内容",
      "default": "''"
    },
    {
      "name": "placement",
      "type": "TooltipPlacement",
      "required": false,
      "description": "出现方向与对齐方式",
      "default": "'bottom'"
    },
    {
      "name": "effect",
      "type": "TooltipEffect",
      "required": false,
      "description": "主题效果",
      "default": "'dark'"
    },
    {
      "name": "arrow",
      "type": "boolean",
      "required": false,
      "description": "是否显示箭头",
      "default": "true"
    },
    {
      "name": "openDelay",
      "type": "number",
      "required": false,
      "description": "打开延时",
      "default": "100"
    },
    {
      "name": "closeDelay",
      "type": "number",
      "required": false,
      "description": "关闭延时",
      "default": "100"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用",
      "default": "false"
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false,
      "description": "双向绑定值",
      "vModel": true
    }
  ],
  "events": [
    {
      "name": "open",
      "payload": "(e: 'open'): void;",
      "description": "提示层显示后触发（经 openDelay 延时）"
    },
    {
      "name": "close",
      "payload": "(e: 'close'): void;",
      "description": "提示层关闭后触发（经 closeDelay 延时）"
    },
    {
      "name": "update:open",
      "description": "open 变化时触发（v-model 同步）"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "触发提示的元素"
    },
    {
      "name": "content",
      "description": "自定义提示内容，优先级高于 `content` 属性"
    }
  ],
  "exposes": [
    {
      "name": "open",
      "description": "手动打开提示层（仍受 disabled 与 openDelay 约束，无内容时不生效）"
    },
    {
      "name": "close",
      "description": "手动关闭提示层（经 closeDelay 延时后隐藏）"
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-tooltip/RebornTooltipDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [
    "reborn-transition"
  ],
  "whenToUse": [
    "悬停解释图标、按钮或缩写的含义（content 属性传入短文本）。",
    "需要控制提示的方向与主题（placement、effect dark / light）。",
    "需要受控显示（v-model:open）或用 content 插槽自定义提示内容。"
  ],
  "whenNotToUse": [
    "承载可交互的复杂内容改用 reborn-popover。",
    "uniapp 端项目：platforms 仅 web，无 uniapp 实现。"
  ],
  "pitfalls": [
    "platforms 仅 web 端提供。",
    "触发元素放在 default 插槽内；content 插槽优先级高于 content 属性。",
    "openDelay / closeDelay 默认各 100ms；effect 默认 'dark'，placement 默认 'bottom'。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-tooltip"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-tooltip/RebornTooltip.vue",
      "app/components/reborn/ui/reborn-tooltip/index.ts",
      "app/components/reborn/ui/reborn-tooltip/reborn-tooltip.config.ts"
    ]
  },
  "docPath": "content/2.components/navigation/reborn-tooltip.md",
  "_meta": {
    "contentHash": "d7b68ba18d512c93c70f93b326af929c9d4df006",
    "hasOverride": true,
    "extractors": {
      "web": "ok",
      "uniapp": "absent",
      "docs": "found"
    }
  }
}
