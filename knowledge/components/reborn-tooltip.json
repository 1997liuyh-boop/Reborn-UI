      "name": "open",
      "payload": "(e: 'open'): void;",
      "description": ""
    },
    {
      "name": "close",
      "payload": "(e: 'close'): void;",
      "description": ""
    },
    {
      "name": "update:open",
      "description": "open 变化时触发（v-model 同步）"
    }
  ],
