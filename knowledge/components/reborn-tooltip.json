{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-tooltip",
  "title": "Tooltip 文字提示",
  "description": "用于鼠标悬停时在元素旁显示文字提示气泡的组件。",
  "category": "navigation",
  "tags": [],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "content",
      "type": "string",
      "required": false,
      "description": "提示内容",
      "default": "''"
    },
    {
      "name": "placement",
      "type": "TooltipPlacement",
      "required": false,
      "description": "出现方向与对齐方式",
      "default": "'bottom'"
    },
    {
      "name": "effect",
      "type": "TooltipEffect",
      "required": false,
      "description": "主题效果",
      "default": "'dark'"
    },
    {
      "name": "arrow",
      "type": "boolean",
      "required": false,
      "description": "是否显示箭头",
      "default": "true"
    },
    {
      "name": "openDelay",
      "type": "number",
      "required": false,
      "description": "打开延时",
      "default": "100"
    },
    {
      "name": "closeDelay",
      "type": "number",
      "required": false,
      "description": "关闭延时",
      "default": "100"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用",
      "default": "false"
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false,
      "description": "双向绑定值",
      "vModel": true
    }
  ],
  "events": [
