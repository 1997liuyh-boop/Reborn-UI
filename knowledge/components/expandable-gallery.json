  "whenToUse": [
    "落地页展示 4-5 张图片、悬停聚焦当前项的横向画廊。",
    "只需传入图片 URL 数组即可成型的轻量图片展示。"
  ],
  "whenNotToUse": [
    "网格相册布局，改用 photo-gallery。",
