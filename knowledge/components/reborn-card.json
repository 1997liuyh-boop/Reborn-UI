{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-card",
  "title": "卡片 Card",
  "description": "用于分组展示内容区块的基础卡片容器组件，带可选标题，仅 uniapp 端。",
  "category": "data-display",
  "tags": [
    "uniapp",
    "card",
    "container"
  ],
  "platforms": [
    "uniapp"
  ],
  "props": [
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "卡片标题文本，未提供 `title` 插槽时渲染为默认标题",
      "default": "—"
    },
    {
      "name": "padding",
      "type": "boolean",
      "required": false,
      "description": "内容体是否保留默认内边距，设为 `false` 可让内容通铺卡片",
      "default": "true"
    },
    {
      "name": "customClass",
      "type": "string",
      "required": false,
      "description": "追加到内容体容器的自定义类名",
      "default": "''"
    },
    {
      "name": "overflowVisible",
      "type": "boolean",
      "required": false,
      "description": "是否允许内容溢出卡片显示，默认裁剪超出部分",
      "default": "false"
    }
  ],
  "events": [],
  "slots": [
    {
      "name": "title",
      "description": "自定义标题区域，提供后完全替换 `title` 属性的默认标题渲染"
    },
    {
      "name": "default",
      "description": "卡片内容体"
    }
  ],
  "exposes": [],
