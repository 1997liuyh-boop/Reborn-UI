{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-loading",
  "title": "Loading 加载指令",
  "description": "v-loading 指令与 useLoading 服务式调用，为任意元素或整页添加加载遮罩。",
  "category": "misc",
  "tags": [],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "ui",
      "type": "LoadingUI",
      "required": false,
      "description": "",
      "default": "() => ({})"
    },
    {
      "name": "type",
      "type": "'outline' | 'ring' | 'spinner' | 'bars-scale' | 'blocks-shuffle' | 'blocks-wave' | 'gooey-balls'",
      "required": false,
      "description": "加载图标类型。",
      "default": "'ring'",
      "options": [
        "outline",
        "ring",
        "spinner",
        "bars-scale",
        "blocks-shuffle",
        "blocks-wave",
        "gooey-balls"
      ]
    },
    {
      "name": "color",
      "type": "'primary' | 'secondary' | 'success' | 'info' | 'warning' | 'error' | 'neutral'",
      "required": false,
      "description": "图标与文字颜色：预设色名或任意 CSS 颜色。",
      "default": "'primary'",
      "options": [
        "primary",
        "secondary",
        "success",
        "info",
        "warning",
        "error",
        "neutral"
      ]
    },
    {
      "name": "size",
      "type": "string | number",
      "required": false,
      "description": "'24px'",
      "default": "'30px'"
    },
    {
      "name": "customClass",
      "type": "string",
      "required": false,
      "description": "遮罩根节点附加类名。"
    },
    {
      "name": "visible",
      "type": "boolean",
      "required": false,
      "description": "",
      "default": "false"
    },
    {
      "name": "fixed",
      "type": "boolean",
      "required": false,
      "description": "",
      "default": "false"
    },
    {
      "name": "text",
      "type": "string",
      "required": false,
      "description": "加载文字（显示在图标下方）。"
    },
    {
      "name": "background",
      "type": "string",
      "required": false,
      "description": "遮罩背景色（任意 CSS 颜色，覆盖默认 `bg-white/80 dark:bg-gray-9/80`）。"
    },
    {
      "name": "viewportStyle",
      "type": "Record<string, string>",
      "required": false,
      "description": ""
    },
    {
      "name": "zIndex",
      "type": "number",
      "required": false,
      "description": "遮罩层级。",
      "default": "2000"
    }
  ],
  "events": [
    {
      "name": "afterLeave",
      "payload": "(e: 'afterLeave'): void",
      "description": ""
    }
  ],
