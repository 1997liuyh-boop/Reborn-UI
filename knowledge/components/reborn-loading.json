{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-loading",
  "title": "Loading 加载器",
  "description": "用于给元素或整页添加加载遮罩的组件，提供 v-loading 指令与 useLoading 服务式调用。",
  "category": "misc",
  "tags": [],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "ui",
      "type": "LoadingUI",
      "required": false,
      "description": "",
      "default": "() => ({})"
    },
    {
      "name": "type",
      "type": "'outline' | 'ring' | 'spinner' | 'bars-scale' | 'blocks-shuffle' | 'blocks-wave' | 'gooey-balls'",
      "required": false,
      "description": "",
      "default": "'ring'",
      "options": [
        "outline",
        "ring",
        "spinner",
        "bars-scale",
        "blocks-shuffle",
        "blocks-wave",
        "gooey-balls"
      ]
    },
    {
      "name": "color",
      "type": "'primary' | 'secondary' | 'success' | 'info' | 'warning' | 'error' | 'neutral'",
      "required": false,
      "description": "",
      "default": "'primary'",
      "options": [
        "primary",
        "secondary",
        "success",
        "info",
        "warning",
        "error",
        "neutral"
      ]
    },
    {
      "name": "size",
      "type": "string | number",
      "required": false,
      "description": "",
      "default": "'30px'"
    },
    {
      "name": "customClass",
      "type": "string",
      "required": false,
      "description": ""
    },
    {
      "name": "visible",
      "type": "boolean",
      "required": false,
      "description": "是否可见（false 时走淡出过渡，过渡结束触发 afterLeave）",
      "default": "false"
    },
    {
      "name": "fixed",
      "type": "boolean",
      "required": false,
      "description": "是否 fixed 定位：全屏遮罩或 body 挂载模式为 true，局部遮罩为 false",
      "default": "false"
    },
    {
      "name": "text",
      "type": "string",
      "required": false,
      "description": "加载文字（显示在图标下方）"
    },
    {
      "name": "background",
      "type": "string",
      "required": false,
      "description": "遮罩背景色（任意 CSS 颜色，内联覆盖默认半透明背景类）"
    },
    {
      "name": "viewportStyle",
      "type": "Record<string, string>",
      "required": false,
      "description": "可视区容器内联样式：局部模式下由 useLoading 注入宿主可视区宽高，供 sticky 图标区定位"
    },
    {
      "name": "zIndex",
      "type": "number",
      "required": false,
      "description": "遮罩层级",
      "default": "2000"
    }
  ],
  "events": [
    {
      "name": "afterLeave",
      "payload": "(e: 'afterLeave'): void",
      "description": "退场过渡结束（外部据此安全卸载实例）"
    }
  ],
  "slots": [],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-loading/RebornLoadingDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-loading/RebornLoadingDirectiveDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-loading/RebornLoadingDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "异步请求期间需要在容器或整页显示加载遮罩时。",
    "需要多种加载图标类型（ring/spinner/bars-scale/gooey-balls 等）时。",
    "需要通过 useLoading 在逻辑代码中动态开关加载态时。"
  ],
  "whenNotToUse": [
    "uniapp 列表触底的加载状态提示改用 reborn-loadmore。",
    "操作结果的短暂反馈改用 reborn-toast。"
  ],
  "pitfalls": [
    "web、uniapp 双端可用。",
    "type 默认 ring，size 默认 30px，zIndex 默认 2000。",
    "background 可传任意 CSS 颜色，覆盖默认的 bg-white/80（暗色 bg-gray-9/80）遮罩背景。",
    "afterLeave 事件在遮罩离场动画结束后触发。"
  ],
  "dependencies": [
    "tailwind-variants"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-loading"
  },
