{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-dialog",
  "title": "Dialog 对话框",
  "description": "用于模态确认与内容展示的对话框组件，支持触发器/受控、拖拽与全屏，仅 web 端。",
  "category": "misc",
  "tags": [],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "open",
      "type": "boolean",
      "required": false,
      "description": "是否打开对话框 @default undefined",
      "default": "undefined"
    },
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "对话框标题 @default \"\"",
      "default": "\"\""
    },
    {
      "name": "description",
      "type": "string",
      "required": false,
      "description": "对话框描述 @default \"\"",
      "default": "\"\""
    },
    {
      "name": "close",
      "type": "boolean | ButtonProps",
      "required": false,
      "description": "关闭按钮配置 @description 可以是布尔值（是否显示默认按钮）或按钮属性对象 @default true",
      "default": "true"
    },
    {
      "name": "closeIcon",
      "type": "string",
      "required": false,
      "description": "关闭按钮图标 @default \"lucide:x\"",
      "default": "\"lucide:x\""
    },
    {
      "name": "overlay",
      "type": "boolean",
      "required": false,
      "description": "是否显示遮罩层 @default true",
      "default": "true"
    },
    {
      "name": "dismissible",
      "type": "boolean",
      "required": false,
      "description": "是否可以通过点击遮罩层或按下 Esc 键关闭 @default true",
      "default": "true"
    },
    {
      "name": "scrollable",
      "type": "boolean",
      "required": false,
      "description": "内容是否可滚动 @default false",
      "default": "false"
    },
    {
      "name": "fullscreen",
      "type": "boolean",
      "required": false,
      "description": "是否全屏显示 @default false",
      "default": "false"
    },
    {
      "name": "draggable",
      "type": "boolean",
      "required": false,
      "description": "是否可拖拽（非全屏模式下有效） @default false",
      "default": "false"
    },
    {
      "name": "cancelBtn",
      "type": "DialogActionButton",
      "required": false,
      "description": "取消按钮配置 @description 可以是字符串（标签）、false（隐藏）或按钮属性对象 @default \"取消\"",
      "default": "\"取消\""
    },
    {
      "name": "confirmBtn",
      "type": "DialogActionButton",
      "required": false,
      "description": "确认按钮配置 @description 可以是字符串（标签）、false（隐藏）或按钮属性对象 @default \"确认\"",
      "default": "\"确认\""
    },
    {
      "name": "beforeClose",
      "type": "(done: () => void) => void",
      "required": false,
      "description": "关闭前的回调 @param done 调用此函数以完成关闭过程",
      "default": "undefined"
    },
    {
      "name": "openDelay",
      "type": "number",
      "required": false,
      "description": "打开延迟（毫秒） @default 0",
      "default": "0"
    },
    {
      "name": "closeDelay",
      "type": "number",
      "required": false,
      "description": "关闭延迟（毫秒） @default 0",
      "default": "0"
    },
    {
      "name": "zIndex",
      "type": "number",
      "required": false,
      "description": "层级 @default 2400",
      "default": "2400"
    },
    {
      "name": "lockScroll",
      "type": "boolean",
      "required": false,
      "description": "是否锁定背景滚动 @default true",
      "default": "true"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "自定义类名（作用于面板）"
    },
    {
      "name": "ui",
      "type": "RebornDialogUi",
      "required": false,
      "description": "UI 样式透传配置",
      "default": "() => ({})"
    }
  ],
  "events": [
    {
      "name": "update:open",
      "payload": "(e: \"update:open\", value: boolean): void;",
      "description": "更新打开状态"
    },
    {
      "name": "open",
      "payload": "(e: \"open\"): void;",
      "description": "打开事件"
    },
    {
      "name": "opened",
      "payload": "(e: \"opened\"): void;",
      "description": "打开完成事件"
    },
    {
      "name": "close",
      "payload": "(e: \"close\"): void;",
      "description": "关闭事件"
    },
    {
      "name": "closed",
      "payload": "(e: \"closed\"): void;",
      "description": "关闭完成事件"
    },
    {
      "name": "openAutoFocus",
      "payload": "(e: \"openAutoFocus\"): void;",
      "description": "打开时自动聚焦事件"
    },
    {
      "name": "closeAutoFocus",
      "payload": "(e: \"closeAutoFocus\"): void;",
      "description": "关闭时自动聚焦事件"
    },
    {
      "name": "confirm",
      "payload": "(e: \"confirm\"): void;",
      "description": "点击确认按钮事件"
    },
    {
      "name": "cancel",
      "payload": "(e: \"cancel\"): void;",
      "description": "点击取消按钮事件"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "触发器内容，点击该插槽区域会尝试打开 Dialog。"
    },
    {
      "name": "header",
      "description": "自定义头部内容。"
    },
    {
      "name": "content",
      "description": "Dialog 正文内容。"
    },
    {
      "name": "footer",
      "description": "自定义底部区域。"
    }
  ],
  "exposes": [
    {
      "name": "open",
      "description": ""
    },
    {
      "name": "close",
      "description": ""
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-dialog/RebornDialogDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [
    "reborn-button",
    "reborn-transition"
  ],
  "whenToUse": [
    "需要确认/取消按钮的模态操作确认（confirm/cancel 事件）。",
    "把触发按钮放默认插槽、点击即开的免受控弹窗用法。",
    "关闭前需要异步拦截（beforeClose 调用 done() 才关闭）的场景。",
    "需要可拖拽（draggable）或全屏（fullscreen）展示的弹窗。"
  ],
  "whenNotToUse": [
    "uniapp 端不可用（仅 web），双端弹层改用 reborn-popup。",
    "轻量操作结果提示，改用 reborn-toast。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "默认插槽是触发器（点击打开），正文必须放 content 插槽，勿混淆。",
    "点击确认按钮触发 confirm 事件但默认不自动关闭，取消按钮默认会关闭。",
    "draggable 在 fullscreen 模式下无效；lockScroll 默认 true 打开时锁定页面滚动。",
    "支持受控（open + update:open）与非受控两种模式，也可用暴露的 open/close 方法。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-dialog"
  },
  "sourceRefs": {
