      "app/components/reborn/ui/reborn-dialog/RebornDialog.vue",
      "app/components/reborn/ui/reborn-dialog/index.ts",
      "app/components/reborn/ui/reborn-dialog/reborn-dialog.config.ts"
    ]
  },
