{
  "$schema": "../schema/component.schema.json",
  "id": "lens",
  "title": "放大镜",
  "description": "用于在图片等插槽内容上叠加圆形放大镜的局部放大组件。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind",
    "aceternity-ui"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "zoomFactor",
      "type": "number",
      "required": false,
      "description": "镜头的放大倍率。",
      "default": "1.5"
    },
    {
      "name": "lensSize",
      "type": "number",
      "required": false,
      "description": "镜头直径（像素）。",
      "default": "170"
    },
    {
      "name": "position",
      "type": "{\n    x: number;\n    y: number;\n  }",
      "required": false,
      "description": "静态模式下镜头的位置。",
      "default": "() => ({ x: 200, y: 150 })"
    },
    {
      "name": "isStatic",
      "type": "boolean",
      "required": false,
      "description": "为 `true` 时镜头固定；否则跟随鼠标。",
      "default": "false"
    },
    {
      "name": "hovering",
      "type": "boolean",
      "required": false,
      "description": "外部控制悬停状态。",
      "default": "undefined"
    }
  ],
  "events": [
    {
      "name": "hover-update",
      "payload": "(e: \"hover-update\", value: boolean): void;",
      "description": ""
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": ""
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/lens/LensDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/lens/StaticLensDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "商品图、设计稿等需要鼠标悬停局部放大查看细节时。",
    "需要固定位置的静态放大展示（isStatic + position）。",
    "需要联动外部 UI（如放大时模糊周边文案）时，配合 hovering 与 hover-update。"
  ],
  "whenNotToUse": [
    "整图点击放大预览，改用 reborn-image。",
    "两图对比查看，改用 compare。"
  ],
  "pitfalls": [
    "仅 web 端可用，依赖 motion-v。",
    "isStatic 为 true 时镜头固定在 position 指定坐标，不跟随鼠标。",
    "hovering 为外部受控 prop，需监听 hover-update 事件回写，否则悬停状态不更新。",
    "zoomFactor 默认 1.5，lensSize 为镜头直径（默认 170px）。"
  ],
  "dependencies": [
    "motion-v"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add lens"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/lens/Lens.vue",
      "app/components/reborn/ui/lens/index.ts"
    ]
  },
