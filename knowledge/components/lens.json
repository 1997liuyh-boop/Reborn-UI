{
  "$schema": "../schema/component.schema.json",
  "id": "lens",
  "title": "放大镜",
  "description": "用于在图片等插槽内容上叠加圆形放大镜的局部放大组件。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind",
    "aceternity-ui"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "zoomFactor",
      "type": "number",
      "required": false,
      "description": "镜头的放大倍率。",
      "default": "1.5"
    },
    {
      "name": "lensSize",
      "type": "number",
      "required": false,
      "description": "镜头直径（像素）。",
      "default": "170"
    },
    {
      "name": "position",
      "type": "{\n    x: number;\n    y: number;\n  }",
      "required": false,
      "description": "静态模式下镜头的位置。",
      "default": "() => ({ x: 200, y: 150 })"
    },
    {
      "name": "isStatic",
      "type": "boolean",
      "required": false,
      "description": "为 `true` 时镜头固定；否则跟随鼠标。",
      "default": "false"
    },
    {
      "name": "hovering",
      "type": "boolean",
      "required": false,
      "description": "外部控制悬停状态。",
      "default": "undefined"
    }
  ],
  "events": [
    {
      "name": "hover-update",
      "payload": "(e: \"hover-update\", value: boolean): void;",
      "description": ""
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": ""
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "code": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\n\nconst hovering = ref(false);\n\nfunction setHovering(value: boolean) {\n  hovering.value = value;\n}\n</script>\n\n<template>\n  <div\n    class=\"relative my-10 w-full overflow-hidden rounded-3xl bg-gradient-to-r from-[#1D2235] to-[#121318] p-8\"\n  >\n    <Rays />\n    <Beams />\n    <div class=\"relative z-10\">\n      <Lens\n        :hovering=\"hovering\"\n        @hover-update=\"setHovering\"\n      >\n        <img\n          src=\"https://images.unsplash.com/photo-1713869820987-519844949a8a?q=80&w=3500&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\"\n          alt=\"image\"\n          width=\"500\"\n          height=\"500\"\n          class=\"rounded-2xl\"\n        />\n      </Lens>\n      <div\n        :style=\"{ filter: hovering ? 'blur(2px)' : 'blur(0px)' }\"\n        class=\"relative z-20 py-4\"\n      >\n        <h2 class=\"text-left text-2xl font-bold text-white\">Apple Vision Pro</h2>\n        <p class=\"mt-4 text-left text-neutral-200\">\n          The all new apple vision pro was the best thing that happened around 8 months ago, not\n          anymore.\n        </p>\n      </div>\n    </div>\n  </div>\n</template>\n",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "Web 演示",
      "code": "<script setup lang=\"ts\">\nimport { ref } from \"vue\";\n\nconst hovering = ref(false);\n\nfunction setHovering(value: boolean) {\n  hovering.value = value;\n}\n</script>\n\n<template>\n  <div\n    class=\"relative my-10 w-full overflow-hidden rounded-3xl bg-gradient-to-r from-[#1D2235] to-[#121318] p-8\"\n  >\n    <Rays />\n    <Beams />\n    <div class=\"relative z-10\">\n      <Lens is-static>\n        <img\n          src=\"https://images.unsplash.com/photo-1713869820987-519844949a8a?q=80&w=3500&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\"\n          alt=\"image\"\n          width=\"500\"\n          height=\"500\"\n          class=\"rounded-2xl\"\n        />\n      </Lens>\n      <div\n        :style=\"{ filter: hovering ? 'blur(2px)' : 'blur(0px)' }\"\n        class=\"relative z-20 py-4\"\n      >\n        <h2 class=\"text-left text-2xl font-bold text-white\">Apple Vision Pro</h2>\n        <p class=\"mt-4 text-left text-neutral-200\">\n          The all new apple vision pro was the best thing that happened around 8 months ago, not\n          anymore.\n        </p>\n      </div>\n    </div>\n  </div>\n</template>\n",
      "source": "demo",
