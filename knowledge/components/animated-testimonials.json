{
  "$schema": "../schema/component.schema.json",
  "id": "animated-testimonials",
  "title": "动态评价",
  "description": "用于轮播展示用户评价（头像、姓名、职称、引言）并支持自动播放的组件。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind",
    "aceternity-ui"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "testimonials",
      "type": "Testimonial[]",
      "required": false,
      "description": "评价对象数组，包含引用、姓名、头像与职称。",
      "default": "() => []"
    },
    {
      "name": "autoplay",
      "type": "boolean",
      "required": false,
      "description": "是否自动轮播评价。",
      "default": "() => false"
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "description": "自动切换到下一条评价前等待的时间（毫秒）。",
      "default": "5000"
    }
  ],
  "events": [],
  "slots": [],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/animated-testimonials/AnimatedTestimonialsDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "官网或落地页的客户评价区块。",
    "需要自动轮播的推荐语、案例引言展示。",
    "展示带头像与职位信息的团队成员语录。"
  ],
  "whenNotToUse": [
    "只需悬停头像显示姓名职位时，改用 animated-tooltip。",
    "通用图文卡片轮播，改用 apple-card-carousel。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "duration 为自动切换等待时间（毫秒，默认 5000），需开启 autoplay 才会自动轮播。",
    "testimonials 每项需包含 quote、name、designation、image 字段，示例中外层包裹了 ClientOnly。"
  ],
  "dependencies": [
    "motion-v"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add animated-testimonials"
  },
  "sourceRefs": {
    "web": [
