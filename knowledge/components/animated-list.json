  "examples": [
    {
      "title": "Web 演示",
      "code": "<script setup lang=\"ts\">\r\nconst notifications = [\r\n  {\r\n    name: \"Payment received\",\r\n    description: \"Reborn UI\",\r\n    time: \"15m ago\",\r\n    icon: \"💸\",\r\n    color: \"#00C9A7\",\r\n  },\r\n  {\r\n    name: \"User signed up\",\r\n    description: \"Reborn UI\",\r\n    time: \"10m ago\",\r\n    icon: \"👤\",\r\n    color: \"#FFB800\",\r\n  },\r\n  {\r\n    name: \"New message\",\r\n    description: \"Reborn UI\",\r\n    time: \"5m ago\",\r\n    icon: \"💬\",\r\n    color: \"#FF3D71\",\r\n  },\r\n  {\r\n    name: \"New event\",\r\n    description: \"Reborn UI\",\r\n    time: \"2m ago\",\r\n    icon: \"🗞️\",\r\n    color: \"#1E86FF\",\r\n  },\r\n  {\r\n    name: \"Task completed\",\r\n    description: \"Reborn UI\",\r\n    time: \"1m ago\",\r\n    icon: \"✅\",\r\n    color: \"#45B26B\",\r\n  },\r\n];\r\n</script>\r\n\r\n<template>\r\n  <ClientOnly>\r\n    <div class=\"relative flex h-[500px] w-full flex-col overflow-hidden p-6\">\r\n      <AnimatedList>\r\n        <template #default>\r\n          <Notification v-for=\"(item, idx) in notifications\" :key=\"idx\" :name=\"item.name\"\r\n            :description=\"item.description\" :icon=\"item.icon\" :color=\"item.color\" :time=\"item.time\" />\r\n        </template>\r\n      </AnimatedList>\r\n    </div>\r\n  </ClientOnly>\r\n</template>\r\n",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "落地页模拟实时通知、消息推送效果。",
    "展示支付、注册等事件流的动态演示。",
    "需要列表项逐个进入视图的营销区块。"
  ],
  "whenNotToUse": [
    "轮播展示用户评价，改用 animated-testimonials。",
    "静态数据列表，直接用普通列表渲染即可。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "delay 单位为毫秒（默认 1000），控制每项进场间隔。",
    "列表项需通过默认插槽传入（如配套的 Notification 子组件），示例中外层包裹了 ClientOnly。"
  ],
  "dependencies": [
