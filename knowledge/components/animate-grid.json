  "examples": [
    {
      "title": "Web 演示",
      "code": "<script lang=\"ts\" setup>\nimport cloudflare from \"./cloudflare.svg\";\n\ninterface Props {\n  textGlowStartColor: string;\n  perspective: number;\n  textGlowEndColor: string;\n  rotateX: number;\n  rotateY: number;\n}\n\nconst props = defineProps<Props>();\n\nconst cards = Array.from({ length: 16 }, () => ({\n  logo: cloudflare,\n}));\n</script>\n\n<template>\n  <div class=\"flex items-center justify-center p-4\">\n    <AnimateGrid\n      :cards\n      v-bind=\"props\"\n    >\n      <template #logo=\"{ logo }\">\n        <img\n          class=\"logo mx-auto h-10 w-auto\"\n          :src=\"logo\"\n        />\n      </template>\n    </AnimateGrid>\n  </div>\n</template>\n",
      "source": "demo",
      "platform": "web"
    }
