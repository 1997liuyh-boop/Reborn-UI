  "related": [],
  "whenToUse": [
    "分享链接、收款码等需要动态生成二维码的场景。",
    "需要品牌 Logo 居中展示（logo + logoSize/logoMargin）时。",
    "需要圆点等自定义码点风格（mode/dotsType，默认 circular）时。",
    "需要导出图片时（暴露 toPng 方法）。"
  ],
  "whenNotToUse": [
    "展示服务端已生成的二维码图片，直接用 reborn-image。"
  ],
  "pitfalls": [
    "web、uniapp 双端可用。",
    "text 默认值是示例链接（https://cool-js.com/），务必传入实际内容。",
    "dotsGradient、backgroundGradient、cornersSquareGradient 等多个参数标注为预留参数，传入可能无实际效果。",
    "ecc 默认 H 级纠错，加 Logo 时保持高纠错级别更稳妥。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-qrcode"
  },
