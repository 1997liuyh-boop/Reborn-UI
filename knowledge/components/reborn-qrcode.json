{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-qrcode",
  "title": "二维码 Qrcode",
  "description": "用于生成二维码的双端组件，支持前景/背景色、码点样式、中央 Logo 与纠错级别。",
  "category": "misc",
  "tags": [
    "qrcode",
    "canvas",
    "svg",
    "uniapp",
    "web"
  ],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "size",
      "type": "number",
      "required": false,
      "description": "二维码尺寸（px）。",
      "default": "200"
    },
    {
      "name": "foreground",
      "type": "string",
      "required": false,
      "description": "前景色（码点颜色）。",
      "default": "\"#131313\""
    },
    {
      "name": "background",
      "type": "string",
      "required": false,
      "description": "背景色。",
      "default": "\"#FFFFFF\""
    },
    {
      "name": "pdColor",
      "type": "string | null",
      "required": false,
      "description": "码眼颜色（不传默认跟随 `foreground`）。",
      "default": "null"
    },
    {
      "name": "pdRadius",
      "type": "number",
      "required": false,
      "description": "码眼圆角半径（兼容参数）。",
      "default": "10"
    },
    {
      "name": "text",
      "type": "string",
      "required": false,
      "description": "二维码内容。",
      "default": "\"https://cool-js.com/\""
    },
    {
      "name": "logo",
      "type": "string",
      "required": false,
      "description": "中央 Logo 图片地址。",
      "default": "\"\""
    },
    {
      "name": "logoSize",
      "type": "number",
      "required": false,
      "description": "Logo 尺寸（px）。",
      "default": "40"
    },
    {
      "name": "padding",
      "type": "number",
      "required": false,
      "description": "二维码内边距（px）。",
      "default": "5"
    },
    {
      "name": "mode",
      "type": "ClQrcodeMode",
      "required": false,
      "description": "码点样式。",
      "default": "\"circular\""
    },
    {
      "name": "ecc",
      "type": "eccLevel",
      "required": false,
      "description": "纠错级别。",
      "default": "eccLevel.H"
    },
    {
      "name": "pdOuterRadius",
      "type": "number",
      "required": false,
      "description": "码眼外框圆角。",
      "default": "undefined"
    },
    {
      "name": "pdInnerRadius",
      "type": "number",
      "required": false,
      "description": "码眼内点圆角。",
      "default": "undefined"
    },
    {
      "name": "dotsGradient",
      "type": "any",
      "required": false,
      "description": "预留参数，保持与 UniApp 一致。"
    },
    {
      "name": "dotsImage",
      "type": "string | null",
      "required": false,
      "description": "预留参数，保持与 UniApp 一致。"
    },
    {
      "name": "backgroundGradient",
      "type": "any",
      "required": false,
      "description": "预留参数，保持与 UniApp 一致。"
    },
    {
      "name": "backgroundTransparent",
      "type": "boolean",
      "required": false,
      "description": "是否背景透明。"
    },
    {
      "name": "logoOptions",
      "type": "any",
      "required": false,
      "description": "Logo 细节配置（预留参数）。"
    },
    {
      "name": "cornersSquareGradient",
      "type": "any",
      "required": false,
      "description": "预留参数。"
    },
    {
      "name": "cornersDotGradient",
      "type": "any",
      "required": false,
      "description": "预留参数。"
    },
    {
      "name": "cornersSquareOptions",
      "type": "any",
      "required": false,
      "description": "预留参数。"
    },
    {
      "name": "cornersDotOptions",
      "type": "any",
      "required": false,
      "description": "预留参数。"
    },
    {
      "name": "dotsColor",
      "type": "string",
      "required": false,
      "description": "别名：前景色"
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "required": false,
      "description": "别名：背景颜色"
    },
    {
      "name": "logoImage",
      "type": "string",
      "required": false,
      "description": "别名：Logo 图片地址"
    },
    {
      "name": "margin",
      "type": "number | string",
      "required": false,
      "description": "别名：内边距"
    },
    {
      "name": "logoMargin",
      "type": "number | string",
      "required": false,
      "description": "Logo 外部预留边空 (用于遮住背景点点)",
      "default": "4"
    },
    {
      "name": "logoHideBackgroundDots",
      "type": "boolean",
      "required": false,
      "description": "是否隐藏 Logo 下方的点",
      "default": "false"
    },
    {
      "name": "logoShadow",
      "type": "boolean",
      "required": false,
      "description": "Logo 是否显示阴影",
      "default": "false"
    },
    {
      "name": "logoShape",
      "type": "'circle' | 'square'",
      "required": false,
      "description": "Logo 形状: 'circle' | 'square'"
    },
    {
      "name": "dotsType",
      "type": "ClQrcodeMode",
      "required": false,
      "description": "别名：渲染模式"
    },
    {
      "name": "cornersSquareType",
      "type": "'rect' | 'dot' | 'square' | 'extra-rounded'",
      "required": false,
      "description": "定位点 (Eyes) 外框渲染类型: 'rect' (直角), 'extra-rounded' (圆角), 'dot' (圆形)"
    },
    {
      "name": "cornersDotType",
      "type": "'rect' | 'dot' | 'square'",
      "required": false,
      "description": "定位点 (Eyes) 中央内点渲染类型: 'rect' (直角), 'dot' (圆形)"
    }
  ],
  "events": [],
  "slots": [],
  "exposes": [
    {
      "name": "toPng",
      "description": ""
    }
  ],
  "examples": [
    {
