{
  "$schema": "../schema/component.schema.json",
  "id": "text-reveal",
  "title": "文字揭示",
  "description": "用于基于 GSAP SplitText 将段落按行依次入场的文字动画组件。",
  "category": "effect",
  "tags": [
    "css",
    "tailwind",
    "gsap"
  ],
  "platforms": [
    "web"
  ],
  "props": [
