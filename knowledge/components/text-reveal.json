      "name": "class",
      "type": "HTMLAttributes[\"class\"]",
      "required": false,
      "description": "内层文字容器的额外类。"
    },
    {
      "name": "containerClass",
      "type": "HTMLAttributes[\"class\"]",
      "required": false,
      "description": "外层容器的额外类。"
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "description": "逐行揭示的动画时长。",
      "default": "0.6"
    },
    {
      "name": "delay",
      "type": "number",
      "required": false,
