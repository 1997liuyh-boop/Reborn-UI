  "examples": [
    {
      "title": "Web 演示",
      "code": "<template>\n  <div class=\"flex items-center justify-center p-8\">\n    <TextReveal class=\"text-center text-4xl leading-relaxed font-semibold\">\n      With Reborn UI, you can build beautiful websites powered by Vue and Nuxt in record time.\n    </TextReveal>\n  </div>\n</template>\n",
