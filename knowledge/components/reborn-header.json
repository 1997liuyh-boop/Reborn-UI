  "examples": [
    {
      "title": "Web 演示",
      "code": "<script setup lang=\"ts\">\nimport RebornHeader from \"~/components/reborn/ui/reborn-header/RebornHeader.vue\";\n\n// ─── 交互演练场 ─────────────────────────────────────────────────\n\nconst state = ref<Record<string, any>>({\n  title: \"Reborn UI\",\n  toggleSide: \"right\",\n  sticky: true,\n});\n\n/** 演练场控制面板配置 */\nconst controls = [\n  {\n    title: \"基础属性\",\n    children: [\n      { label: \"站点标题\", key: \"title\", component: \"input\" as const, defaultValue: \"Reborn UI\" },\n      {\n        label: \"侧边栏方向\",\n        key: \"toggleSide\",\n        component: \"select\" as const,\n        defaultValue: \"right\",\n        props: {\n          options: [\n            { label: \"右侧展开\", value: \"right\" },\n            { label: \"左侧展开\", value: \"left\" },\n          ],\n        },\n      },\n      { label: \"滚动吸顶\", key: \"sticky\", component: \"checkbox\" as const, defaultValue: true },\n    ],\n  },\n];\n\n/** 演练场右上角展示的等价代码 */\nconst headerCode = computed(() => {\n  const s = state.value;\n  const props: string[] = [`title=\"${s.title}\"`, 'to=\"/\"'];\n\n  if (s.toggleSide !== \"right\") props.push(`toggle-side=\"${s.toggleSide}\"`);\n  if (s.sticky) props.push(\"sticky\");\n\n  return `<RebornHeader\\n  ${props.join(\"\\n  \")}\\n>\\n  <nav>…</nav>\\n  <template #right>…</template>\\n  <template #content=\"{ close }\">…</template>\\n</RebornHeader>`;\n});\n\n// ─── 场景演示数据 ───────────────────────────────────────────────\n\n/** 中间区域的导航项 */\nconst links = [\n  { label: \"入门指南\", to: \"#\" },\n  { label: \"组件列表\", to: \"#\" },\n  { label: \"设计规范\", to: \"#\" },\n  { label: \"GitHub\", to: \"https://github.com/1997liuyh-boop/Reborn-UI\" },\n];\n</script>\n\n<template>\n  <div class=\"flex w-full min-w-0 flex-col\">\n    <Playground\n      v-model=\"state\"\n      :controls=\"controls\"\n      :code=\"headerCode\"\n      component-name=\"RebornHeader\"\n      title=\"交互演练场\"\n      description=\"在下方可滚动的宿主区域内滚动内容，即可观察吸顶行为；窄屏时右上角会出现侧边栏开关。\"\n    >\n      <!-- 宿主区域：仅描边不填充，模拟一个独立的滚动视口 -->\n      <div\n        class=\"border-default rounded-ui-sm relative h-[420px] w-full overflow-y-auto border\"\n      >\n        <RebornHeader\n          :title=\"state.title\"\n          to=\"/\"\n          :toggle-side=\"state.toggleSide\"\n          :sticky=\"state.sticky\"\n        >\n          <!-- 中间导航：默认插槽 -->\n          <nav class=\"flex items-center gap-8\">\n            <NuxtLink\n              v-for=\"link in links\"\n              :key=\"link.label\"\n              :to=\"link.to\"\n              class=\"text-muted hover:text-highlighted text-sm font-medium transition-colors\"\n            >\n              {{ link.label }}\n              <Icon\n                v-if=\"link.label === 'GitHub'\"\n                name=\"lucide:external-link\"\n                class=\"ml-1 inline size-3 opacity-50\"\n              />\n            </NuxtLink>\n          </nav>\n\n          <!-- 右侧操作区 -->\n          <template #right>\n            <div class=\"flex items-center gap-2\">\n              <RebornButton\n                size=\"sm\"\n                color=\"success\"\n                variant=\"circle\"\n              >\n                <Icon name=\"lucide:search\" />\n              </RebornButton>\n              <RebornButton\n                size=\"sm\"\n                color=\"secondary\"\n                variant=\"circle\"\n              >\n                <Icon name=\"lucide:moon\" />\n              </RebornButton>\n              <RebornButton\n                size=\"sm\"\n                class=\"hidden sm:flex\"\n                label=\"立即体验\"\n              />\n            </div>\n          </template>\n\n          <!-- 移动端侧边栏内容，作用域参数 close 用于关闭弹层 -->\n          <template #content=\"{ close }\">\n            <div class=\"flex flex-col gap-4\">\n              <div class=\"border-default border-b px-2 py-4\">\n                <p class=\"text-dimmed px-2 text-xs font-semibold tracking-wider uppercase\">\n                  导航页面\n                </p>\n                <nav class=\"mt-4 flex flex-col gap-1\">\n                  <NuxtLink\n                    v-for=\"link in links\"\n                    :key=\"link.label\"\n                    :to=\"link.to\"\n                    class=\"text-default hover:text-highlighted rounded-ui-sm px-3 py-2 text-base font-medium transition-colors\"\n                    @click=\"close\"\n                  >\n                    {{ link.label }}\n                  </NuxtLink>\n                </nav>\n              </div>\n\n              <div class=\"px-2\">\n                <RebornButton\n                  block\n                  label=\"登录账户\"\n                  @click=\"close\"\n                />\n              </div>\n            </div>\n          </template>\n        </RebornHeader>\n\n        <!-- 占位内容：制造足够的滚动高度以观察吸顶 -->\n        <div class=\"flex flex-col gap-4 p-6\">\n          <p class=\"text-muted text-sm\">\n            向下滚动这块区域，{{ state.sticky ? \"顶栏将保持吸顶\" : \"顶栏会随内容一起滚走\" }}。\n          </p>\n          <div\n            v-for=\"i in 6\"\n            :key=\"i\"\n            class=\"border-default rounded-ui-sm h-32 shrink-0 border border-dashed\"\n          />\n        </div>\n      </div>\n    </Playground>\n\n    <DemoSection\n      title=\"插槽结构\"\n      description=\"顶栏分为左、中、右三个区域，默认插槽填充中间导航，#right 承载操作按钮，#content 则是窄屏侧边栏的内容。\"\n    >\n      <DemoNote tone=\"dimmed\">\n        <code>toggle-side</code> 决定侧边栏从哪一侧滑出；<code>auto-close</code> 控制点击内部链接后是否自动收起；\n        <code>before-toggle</code> 可返回 <code>false</code> 阻止本次开合，适合做未保存提示。\n      </DemoNote>\n    </DemoSection>\n  </div>\n</template>\n",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [
    "reborn-popup"
  ],
  "whenToUse": [
    "文档站、官网需要顶部导航栏时。",
    "需要吸顶导航（sticky）并跟随页面滚动固定。",
    "移动端需要通过 toggle 按钮展开弹窗式菜单，并自定义其 header/body/footer 内容。"
  ],
  "whenNotToUse": [
    "uniapp 页面的导航结构，本组件仅 web 端；小程序底部导航改用 reborn-tabbar。",
    "页面内消息循环播报改用 reborn-notice-bar。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "open 为双向绑定值（update:open 事件同步），控制移动端菜单开合。",
    "autoClose 默认 true，路由变化时自动关闭菜单；beforeToggle 可返回 boolean 或 Promise<boolean> 拦截切换。",
    "通常与 reborn-main 配套使用，后者会自动适配 Header 高度。"
  ],
  "dependencies": [
    "@vueuse/core",
    "tailwind-variants"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-header"
  },
