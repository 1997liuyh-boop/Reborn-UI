{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-header",
  "title": "标题",
  "description": "用于站点顶部导航的响应式头部组件，移动端可切换为弹窗菜单。",
  "category": "navigation",
  "tags": [],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "导航栏标题文本",
      "default": "'Nuxt UI'"
    },
    {
      "name": "to",
      "type": "string",
      "required": false,
      "description": "标题链接地址",
      "default": "'/'"
    },
    {
      "name": "toggleSide",
      "type": "'left' | 'right'",
      "required": false,
      "description": "移动端菜单切换按钮侧边 (左/右)",
      "default": "'right'"
    },
    {
      "name": "mode",
      "type": "HeaderMode",
      "required": false,
      "description": "移动端菜单模式",
      "default": "'popup'"
    },
    {
      "name": "as",
      "type": "string",
      "required": false,
      "description": "自定义包装标签",
      "default": "'header'"
    },
    {
      "name": "sticky",
      "type": "boolean",
      "required": false,
      "description": "是否吸顶显示",
      "default": "false"
    },
    {
      "name": "autoClose",
      "type": "boolean",
      "required": false,
      "description": "路由改变时是否自动关闭菜单",
      "default": "true"
    },
    {
      "name": "beforeToggle",
      "type": "() => boolean | Promise<boolean>",
      "required": false,
      "description": "菜单展开前的拦截函数"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "根元素的自定义类名"
    },
    {
      "name": "ui",
      "type": "Partial<{\n        root: string;\n        container: string;\n        left: string;\n        title: string;\n        center: string;\n        right: string;\n        toggle: string;\n        popup: string;\n        popupHeader: string;\n        popupBody: string;\n        popupFooter: string;\n    }>",
      "required": false,
      "description": "UI 插槽样式覆盖",
      "default": "() => ({})"
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false,
      "description": "双向绑定值",
      "vModel": true,
      "default": "false"
    }
  ],
  "events": [
    {
      "name": "update:open",
      "description": "open 变化时触发（v-model 同步）"
    }
  ],
  "slots": [
    {
      "name": "toggle",
      "description": "自定义切换按钮"
    },
    {
      "name": "left",
      "description": "自定义左侧区域"
    },
    {
      "name": "title",
      "description": "自定义标题内容"
    },
    {
      "name": "right",
      "description": "自定义右侧区域"
    },
    {
      "name": "top",
      "description": "导航栏根容器顶部插槽"
    },
    {
      "name": "default",
      "description": "导航栏中间区域内容"
    },
    {
      "name": "bottom",
      "description": "导航栏根容器底部插槽"
    },
    {
      "name": "header",
      "description": "移动端弹窗头部背景"
    },
    {
      "name": "content",
      "description": "移动端弹窗内容区"
    },
    {
      "name": "body",
      "description": "移动端弹窗主体 (位于 content 内)"
    },
    {
      "name": "footer",
      "description": "移动端弹窗底部"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-header/RebornHeaderDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [
    "reborn-popup"
  ],
  "whenToUse": [
    "文档站、官网需要顶部导航栏时。",
    "需要吸顶导航（sticky）并跟随页面滚动固定。",
    "移动端需要通过 toggle 按钮展开弹窗式菜单，并自定义其 header/body/footer 内容。"
  ],
  "whenNotToUse": [
    "uniapp 页面的导航结构，本组件仅 web 端；小程序底部导航改用 reborn-tabbar。",
    "页面内消息循环播报改用 reborn-notice-bar。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "open 为双向绑定值（update:open 事件同步），控制移动端菜单开合。",
    "autoClose 默认 true，路由变化时自动关闭菜单；beforeToggle 可返回 boolean 或 Promise<boolean> 拦截切换。",
    "通常与 reborn-main 配套使用，后者会自动适配 Header 高度。"
  ],
  "dependencies": [
    "@vueuse/core",
    "tailwind-variants"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-header"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-header/RebornHeader.vue",
      "app/components/reborn/ui/reborn-header/index.ts",
      "app/components/reborn/ui/reborn-header/reborn-header.config.ts"
    ]
  },
  "docPath": "content/2.components/navigation/reborn-header.md",
  "_meta": {
    "contentHash": "5b28d2c091094247a89fae914925fed410cc6a8c",
    "hasOverride": true,
    "extractors": {
      "web": "ok",
      "uniapp": "absent",
      "docs": "found"
    }
  }
}
