{
  "$schema": "../schema/component.schema.json",
  "id": "spring-calendar",
  "title": "弹性日历",
  "description": "用于横向选择日期并以弹簧动画展开当日事件的日历条组件。",
  "category": "effect",
  "tags": [
    "css",
    "tailwind",
    "motion-v"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "calendarData",
      "type": "CalendarDay[]",
      "required": true,
      "description": "定义每一天及可选事件的数组。_必填。_",
      "default": "**—**"
    },
    {
      "name": "initialIndex",
      "type": "number",
      "required": false,
      "description": "初始选中的日期索引。",
      "default": "0"
    },
    {
      "name": "class",
      "type": "string",
      "required": false,
      "description": ""
    },
    {
      "name": "text",
      "type": "string",
      "required": true,
      "description": ""
    },
    {
      "name": "morphTime",
      "type": "number",
      "required": false,
      "description": "",
      "default": "1.5"
    },
    {
      "name": "coolDownTime",
      "type": "number",
      "required": false,
      "description": "",
      "default": "0.5"
    }
  ],
  "events": [
    {
      "name": "update:activeIndex",
      "payload": "(e: \"update:activeIndex\", value: number): void;",
      "description": "当点击日期按钮时触发，返回新的激活索引。"
    }
  ],
  "slots": [],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/spring-calendar/SpringCalendarDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "活动、日程页横向展示若干日期并预览当日事件时。",
    "需要点击日期后以弹性动画展开事件列表的交互。",
    "需要通过 update:activeIndex 感知选中日期变化的场景。"
  ],
  "whenNotToUse": [
    "表单中选择日期值，改用 reborn-select-date 或 reborn-date-picker-panel。",
    "需要完整月视图日历时不适用，本组件仅按 calendarData 数组渲染给定的日期条目。"
  ],
  "pitfalls": [
    "仅 web 端可用，依赖 motion-v。",
    "calendarData 必填，元素含 month/date/day 与可选 events（title/day/time）。",
    "props 中的 text/morphTime/coolDownTime 来自内部 TextMorph 子组件的提取结果，示例中无需传入，常规用法只传 calendarData 与 initialIndex。"
  ],
  "dependencies": [
    "motion-v"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add spring-calendar"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/spring-calendar/SpringCalendar.vue",
      "app/components/reborn/ui/spring-calendar/TextMorph.vue",
      "app/components/reborn/ui/spring-calendar/index.ts"
    ]
  },
