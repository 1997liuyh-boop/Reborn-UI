{
  "$schema": "../schema/component.schema.json",
  "id": "shader-toy",
  "title": "Shader Toy Viewer",
  "description": "用于在浏览器中渲染 ShaderToy GLSL 片段着色器的 WebGL 组件。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind",
    "shader-toy",
    "ogl",
    "webgl"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "mouseMode",
      "type": "MouseMode",
      "required": false,
      "description": "鼠标跟踪模式：点击或持续悬停。",
      "default": "\"click\""
    },
    {
      "name": "class",
      "type": "HTMLAttributes[\"class\"]",
      "required": false,
      "description": "应用于容器的自定义类。"
    },
    {
      "name": "shaderCode",
      "type": "string",
      "required": true,
      "description": "来自 ShaderToy 的 GLSL 片段着色器源码。"
    },
    {
      "name": "hue",
      "type": "number",
      "required": false,
      "description": "调整着色器输出的色相。",
      "default": "0"
    },
    {
      "name": "saturation",
      "type": "number",
      "required": false,
      "description": "调整着色器输出的饱和度。",
      "default": "1"
    },
    {
      "name": "brightness",
      "type": "number",
      "required": false,
      "description": "调整着色器输出的亮度。",
      "default": "1"
    },
    {
      "name": "speed",
      "type": "number",
      "required": false,
      "description": "调整着色器输出的速度。",
      "default": "1"
    },
    {
      "name": "mouseSensitivity",
      "type": "number",
      "required": false,
      "description": "",
      "default": "1"
    },
    {
      "name": "damping",
      "type": "number",
      "required": false,
      "description": "",
      "default": "0"
    }
  ],
  "events": [],
  "slots": [],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/shader-toy/ShaderToyDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "直接复用 ShaderToy 上的着色器代码做页面背景或视觉区块。",
    "需要通过 hue/saturation/brightness/speed 调节着色器输出效果。",
    "需要鼠标交互（iMouse）驱动的着色器画面。"
  ],
  "whenNotToUse": [
    "仅需图像有序抖动的像素风效果，改用 dither-shader。",
    "简单星光粒子背景，改用 sparkles，无需引入 WebGL。"
  ],
  "pitfalls": [
    "仅 web 端可用，基于 WebGL（依赖 ogl）。",
    "shaderCode 为必填，需传入 ShaderToy 风格的 GLSL 片段着色器源码（含 mainImage 入口）。",
    "mouseMode 默认为 'click'，另有 mouseSensitivity、damping 调节鼠标交互。",
    "运行时切换着色器需配合 :key 重建组件（见示例）。"
  ],
  "dependencies": [
    "ogl"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add shader-toy"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/shader-toy/ShaderToy.vue",
