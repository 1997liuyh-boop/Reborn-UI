{
  "$schema": "../schema/component.schema.json",
  "id": "file-upload",
  "title": "文件上传",
  "description": "用于拖放或点击选择文件、带动效展示区的文件上传入口组件。",
  "category": "form",
  "tags": [
    "css",
    "tailwind",
    "input",
    "aceternity-ui"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "class",
      "type": "HTMLAttributes[\"class\"]",
      "required": false,
      "description": "用于容器元素的额外样式类。"
    }
  ],
  "events": [
    {
      "name": "onChange",
      "payload": "(e: \"onChange\", files: File[]): void;",
      "description": "添加/上传文件时触发，回调为累计的完整文件列表。"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "背景装饰层插槽，渲染在上传区域后方的绝对定位容器内（带径向渐变遮罩），通常放置 `FileUploadGrid`。"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/file-upload/FileUploadDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "表单中需要拖拽上传文件的交互入口。",
    "需要配合 FileUploadGrid 网格背景的视觉化上传区块。"
  ],
  "whenNotToUse": [
    "需要上传进度、文件列表增删等受控管理：组件未提供相关 props / exposes。"
  ],
  "pitfalls": [
    "仅 web 端可用，依赖 motion-v。",
    "所选文件通过 onChange 事件抛出（payload 为 File[]），组件本身不含上传请求逻辑，需在回调中自行处理。",
    "背景网格是独立子组件 FileUploadGrid，需放入默认插槽。"
  ],
  "dependencies": [
    "motion-v"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add file-upload"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/file-upload/FileUpload.vue",
