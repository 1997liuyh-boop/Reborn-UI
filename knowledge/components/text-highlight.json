  "whenToUse": [
    "标题或段落中强调关键词，配合渐变背景类名使用。",
    "页面进入后需要延迟（delay）再高亮的重点语句。"
  ],
  "whenNotToUse": [
    "需要闪光点缀文字，改用 sparkles-text。",
    "需要文字本身的高光扫过效果，改用 radiant-text。"
