{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-rate",
  "title": "评分",
  "description": "用于星级评分录入与展示的双端组件，支持半星与悬停预览。",
  "category": "form",
  "tags": [
    "css",
    "tailwind",
    "rate",
    "rating",
    "star",
    "uniapp"
  ],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "modelValue",
      "type": "number",
      "required": false,
      "description": "当前评分",
      "default": "0"
    },
    {
      "name": "count",
      "type": "number",
      "required": false,
      "description": "星星总数",
      "default": "5"
    },
    {
      "name": "allowHalf",
      "type": "boolean",
      "required": false,
      "description": "允许半星",
      "default": "false"
    },
    {
      "name": "showValue",
      "type": "boolean",
      "required": false,
      "description": "显示分数",
      "default": "false"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用",
      "default": "false"
    },
    {
      "name": "readonly",
      "type": "boolean",
      "required": false,
      "description": "是否只读",
      "default": "false"
    },
    {
      "name": "icon",
      "type": "string",
      "required": false,
      "description": "未选中图标 class",
      "default": "'i-lucide-star'"
    },
    {
      "name": "activeIcon",
      "type": "string",
      "required": false,
      "description": "选中图标 class",
      "default": "'i-lucide-star'"
    },
    {
      "name": "halfIcon",
      "type": "string",
      "required": false,
      "description": "半星选中图标 class"
    },
    {
      "name": "size",
      "type": "(typeof rateSizes)[number]",
      "required": false,
      "description": "尺寸",
      "default": "'md'"
    },
    {
      "name": "color",
      "type": "(typeof rateColors)[number]",
      "required": false,
      "description": "颜色",
      "default": "'warning'"
    },
    {
      "name": "ui",
      "type": "Partial<{\n    wrapper: ClassValue\n    star: ClassValue\n    icon: ClassValue\n    iconActive: ClassValue\n    value: ClassValue\n  }>",
      "required": false,
      "description": "样式覆盖",
      "default": "() => ({})"
    },
    {
      "name": "customClass",
      "type": "any",
      "required": false,
      "description": "自定义 class"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "自定义 class"
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "payload": "(e: 'update:modelValue', value: number): void",
      "description": "评分值变化。"
    },
    {
      "name": "change",
      "payload": "(e: 'change', value: number): void",
      "description": "评分值确认变化。"
    }
  ],
  "slots": [
    {
      "name": "icon",
      "description": "自定义星星图标。"
    },
    {
      "name": "value",
      "description": "自定义分数显示。"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-rate/RebornRateDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-rate/RebornRateDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "商品、服务评价打分（allowHalf 支持半星）。",
    "只读展示平均评分（readonly）。",
    "需要在星星旁显示当前分数（showValue）时。"
  ],
  "whenNotToUse": [
    "连续数值取值改用 reborn-slider。",
    "整数数量增减改用 reborn-input-number。"
  ],
  "pitfalls": [
    "web、uniapp 双端可用。",
    "icon/activeIcon/halfIcon 仅支持 Nuxt Icon 类名（默认 i-lucide-star）。",
    "默认主题色为 warning（而非 primary）。",
    "disabled 与 readonly 是两个独立属性，语义不同。"
  ],
  "dependencies": [
    "clsx"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-rate"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-rate/RebornRate.vue",
      "app/components/reborn/ui/reborn-rate/index.ts",
      "app/components/reborn/ui/reborn-rate/reborn-rate.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-rate/RebornRate.vue",
      "packages/uniapp-project/src/components/reborn-rate/index.ts",
      "packages/uniapp-project/src/components/reborn-rate/reborn-rate.config.ts"
    ]
  },
  "docPath": "content/2.components/input-and-forms/reborn-rate.md",
  "_meta": {
    "contentHash": "aea9f94f6518074efa4e7b84547cbb481e899e8c",
    "hasOverride": true,
    "extractors": {
      "web": "ok",
      "uniapp": "ok",
      "docs": "found"
    }
  }
}
