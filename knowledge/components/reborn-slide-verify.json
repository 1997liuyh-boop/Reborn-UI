{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-slide-verify",
  "title": "滑块验证",
  "description": "用于人机校验的滑块验证组件，向右拖动超过阈值即通过，支持失败回弹与自动重置。",
  "category": "misc",
  "tags": [],
  "platforms": [
    "uniapp"
  ],
  "props": [
    {
      "name": "customClass",
      "type": "any",
      "required": false,
      "description": "自定义 class",
      "default": "''"
    },
    {
      "name": "customStyle",
      "type": "any",
      "required": false,
      "description": "自定义 style",
      "default": "''"
    },
    {
      "name": "ui",
      "type": "SlideVerifyUI",
      "required": false,
      "description": "样式覆盖",
      "default": "() => ({})"
    },
    {
      "name": "size",
      "type": "SlideVerifySize",
      "required": false,
      "description": "尺寸",
      "default": "'md'"
    },
    {
      "name": "color",
      "type": "SlideVerifyColor",
      "required": false,
      "description": "主题色",
      "default": "'primary'"
    },
    {
      "name": "shape",
      "type": "SlideVerifyShape",
      "required": false,
      "description": "滑动容器形态，pill 为胶囊形，square 为项目规范圆角的方形",
      "default": "'pill'"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用",
      "default": "false"
    },
    {
      "name": "loading",
      "type": "boolean",
      "required": false,
      "description": "是否加载中",
      "default": "false"
    },
    {
      "name": "threshold",
      "type": "number",
      "required": false,
      "description": "通过阈值，0.92 表示滑到 92% 即通过",
      "default": "0.92"
    },
    {
      "name": "showThresholdText",
      "type": "boolean",
      "required": false,
      "description": "是否根据通过阈值自动生成默认提示文案",
      "default": "false"
    },
    {
      "name": "thresholdText",
      "type": "string",
      "required": false,
      "description": "阈值提示文案模板，使用 {threshold} 插入百分比",
      "default": "'拖动超过 {threshold}% 完成验证'"
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "description": "回弹与通过动画时长，单位 ms",
      "default": "220"
    },
    {
      "name": "defaultText",
      "type": "string",
      "required": false,
      "description": "默认提示文案",
      "default": "'向右滑动完成验证'"
    },
    {
      "name": "successText",
      "type": "string",
      "required": false,
      "description": "通过文案",
      "default": "'验证通过'"
    },
    {
      "name": "loadingText",
      "type": "string",
      "required": false,
      "description": "加载文案",
      "default": "'验证中...'"
    },
    {
      "name": "splitText",
      "type": "boolean",
      "required": false,
      "description": "是否启用左右分层文案，开启后左侧进度区域展示通过文案，右侧展示默认文案",
      "default": "true"
    },
    {
      "name": "failText",
      "type": "string",
      "required": false,
      "description": "未通过文案",
      "default": "'请拖动到最右侧'"
    },
    {
      "name": "showFailText",
      "type": "boolean",
      "required": false,
      "description": "未通过时是否展示失败文案",
      "default": "true"
    },
    {
      "name": "failDuration",
      "type": "number",
      "required": false,
      "description": "未通过文案展示时长，单位 ms",
      "default": "900"
    },
    {
      "name": "autoReset",
      "type": "boolean",
      "required": false,
      "description": "通过后是否自动重置",
      "default": "false"
    },
    {
      "name": "resetDelay",
      "type": "number",
      "required": false,
      "description": "自动重置延迟，单位 ms",
      "default": "1200"
    },
    {
      "name": "thumbIcon",
      "type": "string",
      "required": false,
      "description": "默认滑块图标",
      "default": "'i-lucide-chevrons-right'"
    },
    {
      "name": "successIcon",
      "type": "string",
      "required": false,
      "description": "通过滑块图标",
      "default": "'i-lucide-check'"
    },
    {
      "name": "loadingIcon",
      "type": "string",
      "required": false,
      "description": "加载滑块图标",
      "default": "'i-svg-spinners-180-ring-with-bg'"
    },
    {
      "name": "defaultVerified",
      "type": "boolean",
      "required": false,
      "description": "初始是否已验证通过，无需外部 ref(true) + v-model",
      "default": "false"
    },
    {
      "name": "showToast",
      "type": "boolean",
      "required": false,
      "description": "验证通过后是否自动弹出 Toast 提示",
      "default": "false"
    },
    {
      "name": "toastText",
      "type": "string",
      "required": false,
      "description": "Toast 提示文案，默认使用 successText",
      "default": "''"
    },
    {
      "name": "width",
      "type": "string",
      "required": false,
      "description": "滑动容器宽度，支持任意 CSS 单位（如 '600rpx'、'80%'），默认撑满父容器",
      "default": "''"
    },
    {
      "name": "modelValue",
      "type": "boolean",
      "required": false,
      "description": "双向绑定值",
      "vModel": true
    }
  ],
  "events": [
    {
      "name": "start",
      "payload": "(e: 'start', payload: SlideVerifyPayload): void",
      "description": "开始拖动（触摸开始且通过交互校验后）"
    },
    {
      "name": "drag",
      "payload": "(e: 'drag', payload: SlideVerifyPayload): void",
      "description": "拖动过程中连续触发"
    },
    {
      "name": "success",
      "payload": "(e: 'success', payload: SlideVerifyPayload): void",
      "description": "达到阈值并完成验证"
    },
    {
      "name": "fail",
      "payload": "(e: 'fail', payload: SlideVerifyPayload): void",
      "description": "松手时未达阈值"
    },
    {
      "name": "reset",
      "payload": "(e: 'reset'): void",
      "description": "调用 `reset` 或自动重置将状态清空时"
    },
    {
      "name": "change",
      "payload": "(e: 'change', value: boolean): void",
      "description": "v-model` 对应布尔值变化（与表单 `validate('change')` 联动）"
    },
    {
      "name": "update:modelValue",
      "description": "modelValue 变化时触发（v-model 同步）"
    }
  ],
  "slots": [
    {
      "name": "default",
      "props": "(props: { verified: boolean, loading: boolean, progress: number, text: string, ui: any }) => any",
      "description": "中间文案区：`text` 为当前展示文案（与内部 `displayText` 一致）；提供后**不再**使用内置 `splitText` 分层叠层"
    },
    {
      "name": "thumb",
      "props": "(props: { verified: boolean, loading: boolean, progress: number, icon: string, ui: any }) => any",
      "description": "滑块内容：`icon` 为当前应展示的图标 class；默认渲染为带 `icon` 的视图"
    }
  ],
  "exposes": [
    {
      "name": "reset",
      "description": ""
    },
    {
      "name": "verify",
      "description": ""
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-slide-verify/RebornSlideVerifyDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-slide-verify/RebornSlideVerifyDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "登录、注册、发送验证码前的轻量级人机校验。",
    "表单中需要一个「已验证」布尔字段（v-model 绑定，change 与表单校验联动）。",
    "需要通过 loading / disabled 控制验证时机，或验证通过后自动重置（autoReset + resetDelay）。"
  ],
  "whenNotToUse": [
    "web 端项目：platforms 仅 uniapp，web 端无对应实现。",
    "在数值区间内取值改用 reborn-slider。"
  ],
  "pitfalls": [
    "platforms 仅 uniapp 端提供。",
    "threshold 默认 0.92（滑到约 92% 即通过）；若传大于 1 的数（如 92），内部会除以 100 当作比例。",
    "splitText 默认 true 的左右分层文案，仅在未使用默认插槽、未验证、非加载、非失败展示时生效。",
    "defaultVerified=true 且 v-model 仍为 false 时，挂载即视为已通过。",
    "showToast 通过后调用 uni.showToast，toastText 为空时用 successText。"
  ],
  "dependencies": [
    "clsx"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-slide-verify"
  },
  "sourceRefs": {
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-slide-verify/RebornSlideVerify.vue",
      "packages/uniapp-project/src/components/reborn-slide-verify/index.ts",
      "packages/uniapp-project/src/components/reborn-slide-verify/reborn-slide-verify.config.ts"
    ]
  },
