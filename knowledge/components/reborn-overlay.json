{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-overlay",
  "title": "Overlay 遮罩",
  "description": "用于弹层背后的全屏或局部遮罩组件，支持点击关闭与滚动锁定。",
  "category": "misc",
  "tags": [],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "customClass",
      "type": "string",
      "default": "''",
      "required": false,
      "description": "组件自定义类名"
    },
    {
      "name": "customStyle",
      "type": "string",
      "default": "''",
      "required": false,
      "description": "组件自定义样式"
    },
    {
      "name": "modelValue",
      "type": "boolean",
      "default": "false",
      "required": false,
      "description": "是否展示遮罩层，支持通过 `v-model` 双向绑定"
    },
    {
      "name": "duration",
      "type": "Record<string, number> | number | boolean",
      "default": "300",
      "required": false,
      "description": "动画持续时间，单位毫秒"
    },
    {
      "name": "lockScroll",
      "type": "boolean",
      "default": "true",
      "required": false,
      "description": "背景是否锁定滚动"
    },
    {
      "name": "zIndex",
      "type": "number",
      "default": "10",
      "required": false,
      "description": "遮罩层的 z-index"
    },
    {
      "name": "closeOnClickOverlay",
      "type": "boolean",
      "default": "true",
      "required": false,
      "description": "是否允许点击遮罩层关闭"
    },
    {
      "name": "absolute",
      "type": "boolean",
      "default": "false",
      "required": false,
      "description": "是否绝对定位。开启后将在祖先元素(position非static)内展示，用于指定节点的部分遮罩"
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "description": "遮罩层状态变化时触发",
      "payload": "(val: Boolean)"
    },
    {
      "name": "close",
      "description": "关闭时触发",
      "payload": "-"
    },
    {
      "name": "click",
      "description": ""
    },
    {
      "name": "afterLeave",
      "payload": "(e: \"afterLeave\"): void;",
      "description": ""
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": ""
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-overlay/RebornOverlayDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-overlay/RebornOverlayDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [
    "reborn-transition"
  ],
  "whenToUse": [
    "自研弹层需要独立控制的背景遮罩时。",
    "需要在某个定位容器内做局部遮罩（absolute 模式）时。",
    "需要自定义遮罩显隐动画时长（duration）时。"
  ],
  "whenNotToUse": [
    "完整弹窗交互直接用自带遮罩的 reborn-popup 或 reborn-dialog。",
    "加载中的遮罩状态改用 reborn-loading。"
  ],
  "pitfalls": [
    "web、uniapp 双端可用。",
    "absolute=true 时在最近的非 static 定位祖先内展示，用于局部遮罩。",
    "zIndex 默认仅 10，与其他弹层（如 reborn-popup 默认 25）叠放时注意层级。",
    "closeOnClickOverlay 与 lockScroll 默认均为 true。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-overlay"
  },
  "sourceRefs": {
