  "examples": [
    {
      "title": "Web 演示",
      "code": "<template>\n  <DemoSection title=\"基础用法\">\n    <div class=\"w-full overflow-hidden p-8\">\n      <BoxReveal color=\"#E1251B\">\n        <p class=\"text-highlighted text-[3.5rem] font-semibold\">\n          Reborn UI<span class=\"text-[#E1251B]\">.</span>\n        </p>\n      </BoxReveal>\n\n      <BoxReveal\n        color=\"#E1251B\"\n        :duration=\"0.8\"\n      >\n        <h2 class=\"text-muted mt-[.5rem] text-[1rem]\">\n          为\n          <span class=\"text-[#E1251B]\">Vue &amp; Nuxt</span>\n          准备的精美组件。\n        </h2>\n      </BoxReveal>\n\n      <BoxReveal\n        color=\"#E1251B\"\n        :duration=\"1\"\n      >\n        <div class=\"text-muted mt-6\">\n          <p>\n            -&gt; 免费开源的动效组件，基于\n            <span class=\"font-semibold text-[#E1251B]\"> Vue/Nuxt</span>、\n            <span class=\"font-semibold text-[#E1251B]\"> TypeScript</span>、\n            <span class=\"font-semibold text-[#E1251B]\"> Tailwind CSS</span>\n            与\n            <span class=\"font-semibold text-[#E1251B]\"> motion-v</span>\n            构建。<br>\n            -&gt; 100% 开源，可按需定制。<br>\n          </p>\n        </div>\n      </BoxReveal>\n    </div>\n  </DemoSection>\n</template>\n",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "落地页标题、段落逐块揭示的首屏排版（可多个实例配不同 duration 形成节奏）。",
    "需要自定义遮罩色块颜色（color）呼应品牌色的入场动画。"
  ],
  "whenNotToUse": [
    "需要模糊淡入而非色块滑开的效果，改用 blur-reveal。",
    "滚动驱动的整段文字揭示，改用 text-reveal。"
  ],
  "pitfalls": [
    "仅 web 端可用，依赖 motion-v。",
    "duration 与 delay 单位为秒（默认 0.5 和 0.25）。",
    "color 是遮罩色块的背景色（默认 #5046e6），不是文字颜色。"
  ],
  "dependencies": [
    "motion-v"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add box-reveal"
  },
