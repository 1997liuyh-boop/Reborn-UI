{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-notice-bar",
  "title": "NoticeBar 通知栏",
  "description": "用于循环播放一组消息通知的通告栏组件，支持水平滚动与垂直轮播。",
  "category": "navigation",
  "tags": [],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "text",
      "type": "string | string[]",
      "required": false,
      "description": "通知文本内容，支持单条或多条",
      "default": "''"
    },
    {
      "name": "speed",
      "type": "number",
      "required": false,
      "description": "滚动速率，单位 px/s（水平滚动时生效）",
      "default": "60"
    },
    {
      "name": "scrollable",
      "type": "boolean",
      "required": false,
      "description": "是否开启滚动播放，内容溢出时生效",
      "default": "true"
    },
    {
      "name": "wrapable",
      "type": "boolean",
      "required": false,
      "description": "是否开启多行展示",
      "default": "false"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用",
      "default": "false"
    },
    {
      "name": "color",
      "type": "string",
      "required": false,
      "description": "文本颜色",
      "default": "'#888A8C'"
    },
    {
      "name": "background",
      "type": "string",
      "required": false,
      "description": "背景色",
      "default": "'#F7F7F9'"
    },
    {
      "name": "leftIcon",
      "type": "string",
      "required": false,
      "description": "左侧图标类名 (e.g. i-lucide-volume-2)"
    },
    {
      "name": "rightIcon",
      "type": "string",
      "required": false,
      "description": "右侧图标类名 (e.g. i-lucide-chevron-right)"
    },
    {
      "name": "direction",
      "type": "NoticeBarDirection",
      "required": false,
      "description": "滚动方向：horizontal 水平滚动，vertical 垂直滚动",
      "default": "'horizontal'"
    },
    {
      "name": "interval",
      "type": "number",
      "required": false,
      "description": "垂直滚动时的轮播间隔时间，单位 ms",
      "default": "3000"
    },
    {
      "name": "customClass",
      "type": "string",
      "required": false,
      "description": "自定义类名",
      "default": "''"
    },
    {
      "name": "customStyle",
      "type": "string",
      "required": false,
      "description": "自定义样式",
      "default": "''"
    },
    {
      "name": "ui",
      "type": "NoticeBarUI",
      "required": false,
      "description": "UI 覆盖",
      "default": "() => ({})"
    }
  ],
  "events": [
    {
      "name": "click",
      "payload": "(e: 'click'): void;",
      "description": "点击通知栏时触发"
    },
    {
      "name": "close",
      "payload": "(e: 'close'): void;",
      "description": "关闭通知栏时触发"
    },
    {
      "name": "replay",
      "payload": "(e: 'replay'): void;",
      "description": "重新播放动画时触发"
    },
    {
      "name": "change",
      "payload": "(e: 'change', index: number): void;",
      "description": "垂直滚动切换时触发"
    }
  ],
  "slots": [
    {
      "name": "default",
      "props": "",
      "description": "通知主体内容。垂直模式下提供 `{ item: string, index: number }"
    },
    {
      "name": "left-icon",
      "props": "",
      "description": "左侧图标区域"
    },
    {
      "name": "right-icon",
      "props": "",
      "description": "右侧图标区域"
    }
  ],
  "exposes": [
    {
      "name": "pause",
      "description": "暂停播放：水平滚动动画停在原地，垂直轮播停止自动切换"
    },
    {
      "name": "resume",
      "description": "恢复被 pause 暂停的滚动/轮播"
    },
    {
      "name": "replay",
      "description": "从头重播：垂直模式回到第 0 条并重启轮播计时（触发 change），水平模式重新测量并重启滚动动画；完成后触发 replay 事件"
    },
    {
      "name": "checkOverflow",
      "description": "重新检测文本是否溢出并更新水平滚动状态；内容或容器尺寸变化后可手动调用（垂直模式下无效）"
    },
    {
      "name": "goTo",
      "description": "goTo(index)：垂直轮播模式下带过渡动画切换到指定索引并触发 change；水平模式或索引越界时无操作"
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-notice-bar/RebornNoticeBarDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-notice-bar/RebornNoticeBarDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "页面顶部公告、促销信息循环播报。",
    "多条消息垂直轮播切换（direction=\"vertical\" + interval）。",
    "单条长文本需要匀速水平滚动展示（speed 控制 px/s）。"
  ],
  "whenNotToUse": [
    "图文卡片类内容的循环滚动（web 营销区块）改用 reborn-marquee。",
    "操作结果的短暂反馈改用 reborn-toast。"
  ],
  "pitfalls": [
    "web、uniapp 双端可用。",
    "scrollable 仅在内容溢出且非垂直模式时生效；wrapable 多行仅水平模式生效。",
    "speed 单位为 px/s（默认 60）；interval 为垂直轮播间隔毫秒（默认 3000）。",
    "垂直模式下默认插槽提供 { item, index } 作用域参数；组件暴露 pause/resume/replay/goTo 方法。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-notice-bar"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-notice-bar/RebornNoticeBar.vue",
      "app/components/reborn/ui/reborn-notice-bar/reborn-notice-bar.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-notice-bar/RebornNoticeBar.vue",
      "packages/uniapp-project/src/components/reborn-notice-bar/index.ts",
      "packages/uniapp-project/src/components/reborn-notice-bar/reborn-notice-bar.config.ts"
    ]
  },
  "docPath": "content/2.components/navigation/reborn-notice-bar.md",
  "_meta": {
    "contentHash": "39ed525335b4fd748dfed5a697d25e0c83c0aa24",
    "hasOverride": true,
    "extractors": {
      "web": "ok",
      "uniapp": "ok",
      "docs": "found"
    }
  }
}
