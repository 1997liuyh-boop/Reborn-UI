{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-fab",
  "title": "悬浮按钮 (Fab)",
  "description": "用于固定位置悬浮操作入口的按钮组件，支持拖拽吸边与展开动作面板，双端可用。",
  "category": "navigation",
  "tags": [],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "modelValue",
      "type": "boolean",
      "required": false,
      "description": "绑定值，控制展开状态",
      "default": "false",
      "vModel": true
    },
    {
      "name": "active",
      "type": "boolean",
      "required": false,
      "description": "是否默认展开",
      "default": "false"
    },
    {
      "name": "position",
      "type": "FabPosition",
      "required": false,
      "description": "预设位置",
      "default": "'right-bottom'"
    },
    {
      "name": "top",
      "type": "string | number",
      "required": false,
      "description": "自定义位置"
    },
    {
      "name": "bottom",
      "type": "string | number",
      "required": false,
      "description": "自定义底部距离。"
    },
    {
      "name": "left",
      "type": "string | number",
      "required": false,
      "description": "自定义左侧距离。"
    },
    {
      "name": "right",
      "type": "string | number",
      "required": false,
      "description": "自定义右侧距离。"
    },
    {
      "name": "direction",
      "type": "FabDirection",
      "required": false,
      "description": "展开方向",
      "default": "'top'"
    },
    {
      "name": "color",
      "type": "FabColor",
      "required": false,
      "description": "主题颜色",
      "default": "'primary'"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用",
      "default": "false"
    },
    {
      "name": "draggable",
      "type": "boolean",
      "required": false,
      "description": "是否可拖拽",
      "default": "false"
    },
    {
      "name": "expandable",
      "type": "boolean",
      "required": false,
      "description": "是否可展开",
      "default": "false"
    },
    {
      "name": "gap",
      "type": "{ top?: number; left?: number; right?: number; bottom?: number }",
      "required": false,
      "description": "距离边缘的间距",
      "default": "() => ({ top: 16, left: 16, right: 16, bottom: 16 })"
    },
    {
      "name": "inactiveIcon",
      "type": "string",
      "required": false,
      "description": "非激活状态图标",
      "default": "'i-lucide-plus'"
    },
    {
      "name": "activeIcon",
      "type": "string",
      "required": false,
      "description": "激活状态图标",
      "default": "'i-lucide-plus'"
    },
    {
      "name": "zIndex",
      "type": "number",
      "required": false,
      "description": "层级",
      "default": "99"
    },
    {
      "name": "customStyle",
      "type": "string",
      "required": false,
      "description": "自定义样式"
    },
    {
      "name": "customClass",
      "type": "string",
      "required": false,
      "description": "自定义类名"
    },
    {
      "name": "ui",
      "type": "Partial<UiMap>",
      "required": false,
      "description": "UI 配置",
      "default": "() => ({\n        root: '',\n        trigger: '',\n        icon: '',\n        actions: '',\n        action: ''\n    })"
    },
    {
      "name": "items",
      "type": "FabActionItem[]",
      "required": false,
      "description": "动作列表：有数据时由组件内 v-for 渲染（推荐小程序端使用），无数据时回退为默认插槽。",
      "default": "() => []"
    },
    {
      "name": "trigger",
      "type": "FabTrigger",
      "required": false,
      "description": "触发方式 (click | hover)",
      "default": "\"click\""
    },
    {
      "name": "variant",
      "type": "\"float\" | \"capsule\" | \"circle\"",
      "required": false,
      "description": "UI变体",
      "default": "\"float\""
    },
    {
      "name": "attract",
      "type": "boolean",
      "required": false,
      "description": "是否开启自动吸边",
      "default": "true"
    },
    {
      "name": "peekOnScroll",
      "type": "boolean",
      "required": false,
      "description": "滚动时是否自动贴边并半隐藏",
      "default": "false"
    },
    {
      "name": "divider",
      "type": "boolean",
      "required": false,
      "description": "是否显示分割线"
    },
    {
      "name": "radius",
      "type": "number",
      "required": false,
      "description": "环形布局半径"
    },
    {
      "name": "startAngle",
      "type": "number",
      "required": false,
      "description": "环形布局起始角度 (默认 -90, 正上方)"
    },
    {
      "name": "totalAngle",
      "type": "number",
      "required": false,
      "description": "环形布局总角度 (默认 360, 一整圈)"
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "payload": "[boolean]",
      "description": "更新展开状态绑定值。"
    },
    {
      "name": "click",
      "payload": "[]",
      "description": "当组件非可展开（`expandable` 为假）状态下被点击时触发。"
    },
    {
      "name": "action",
      "payload": "[payload: { name: string; index: number }]",
      "description": "点击某条 items 动作"
    },
    {
      "name": "open",
      "description": "动作面板开始展开时立即触发（动画启动时刻）"
    },
    {
      "name": "opened",
      "description": "动作面板展开动画结束后触发（约 400ms 后，此时 v-model 同步为 true）"
    },
    {
      "name": "close",
      "description": "动作面板开始收起时立即触发（动画启动时刻）"
    },
    {
      "name": "closed",
      "description": "动作面板收起动画结束后触发（约 400ms 后，此时 v-model 同步为 false）"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "动作面板内容。可解构获取展开与位移状态（UniApp 端仅 `isActive`）。"
    },
    {
      "name": "trigger",
      "description": "自定义主触发按钮的渲染内容。"
    },
    {
      "name": "divider",
      "description": "胶囊变体下自定义动作区与触发按钮之间的分割线内容。"
    }
  ],
  "exposes": [
    {
      "name": "open",
      "description": "手动展开动作面板"
    },
    {
      "name": "close",
      "description": "手动收起动作面板"
    },
    {
      "name": "restore",
      "description": "从 peekOnScroll 的半隐藏状态立即复位到正常停靠位置"
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-fab/RebornFabDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-fab/RebornFabDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "页面角落固定的快捷操作入口（客服、发布、回到顶部集合等）。",
    "点击/悬停展开多个子动作（items 或 default 插槽），含环形布局（radius/startAngle/totalAngle）。",
    "需要可拖拽并自动吸附屏幕左右边（draggable + attract）的悬浮球。",
    "滚动时自动贴边半隐藏（peekOnScroll）的场景。"
  ],
  "whenNotToUse": [
    "普通文档流中的操作按钮，改用 reborn-button。",
    "把一组操作折叠为下拉菜单（web），改用 reborn-dropdown。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端可用。",
    "expandable 默认值双端不同（web 默认 true、uniapp 默认 false）：为 false 时点击直接触发 click 事件，不会展开动作面板。",
    "draggable 拖拽结束后按左右侧自动吸附并决定展开方向；attract 默认 true 自动吸边。",
    "inactiveIcon/activeIcon 在 Web 版默认依赖 nuxt-icon 图标体系。",
    "展开状态可用 v-model 绑定；variant 支持 float/capsule/circle 三种形态。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-fab"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-fab/RebornFab.vue",
      "app/components/reborn/ui/reborn-fab/reborn-fab.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-fab/RebornFab.vue",
      "packages/uniapp-project/src/components/reborn-fab/reborn-fab.config.ts"
    ]
  },
  "docPath": "content/2.components/navigation/reborn-fab.md",
  "_meta": {
    "contentHash": "7fac72e1ecb7bf5a73d77209c8c9ad443a4936db",
    "hasOverride": true,
    "extractors": {
      "web": "ok",
      "uniapp": "ok",
      "docs": "found"
    }
  }
}
