{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-transition",
  "title": "Transition 过渡",
  "description": "用于控制内容显隐过渡动画的容器组件，内置 fade、slide、zoom 等动画名称。",
  "category": "misc",
  "tags": [],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "customClass",
      "type": "string",
      "default": "''",
      "required": false,
      "description": "组件自定义类名"
    },
    {
      "name": "customStyle",
      "type": "string",
      "default": "''",
      "required": false,
      "description": "组件自定义样式"
    },
    {
      "name": "show",
      "type": "boolean",
      "default": "false",
      "required": false,
      "description": "是否展示组件"
    },
    {
      "name": "duration",
      "type": "Record<string, number> | number | boolean",
      "default": "300",
      "required": false,
      "description": "过渡动画持续时间，单位 ms。可传入对象如 `{ enter: 300, leave: 300 }`。传入 `false` 为禁用动画"
    },
    {
      "name": "lazyRender",
      "type": "boolean",
      "default": "false",
      "required": false,
      "description": "是否懒加载，为 `true` 时，只有在第一次出现时才会渲染内部元素"
    },
    {
      "name": "name",
      "type": "TransitionName | TransitionName[]",
      "default": "'fade'",
      "required": false,
      "description": "过渡动画名称，可选值为 `fade` `fade-up` `fade-down` `fade-left` `fade-right` `slide-up` `slide-down` `slide-left` `slide-right` `zoom-in` `zoom-out"
    },
    {
      "name": "destroy",
      "type": "boolean",
      "default": "true",
      "required": false,
      "description": "是否在隐藏时销毁内容"
    },
