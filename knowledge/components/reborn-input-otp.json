{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-input-otp",
  "title": "验证码输入",
  "description": "用于短信验证码、OTP 等固定位数分格输入的双端组件。",
  "category": "form",
  "tags": [
    "css",
    "tailwind",
    "otp",
    "input",
    "uniapp"
  ],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "ui",
      "type": "any",
      "required": false,
      "description": "细粒度样式覆盖对象，按 root/inner/list/item/value/cursor 键位重写对应节点类名",
      "default": "() => ({})"
    },
    {
      "name": "customClass",
      "type": "any",
      "required": false,
      "description": "追加到根节点的自定义类名（等价于 web 端的 class）"
    },
    {
      "name": "modelValue",
      "type": "string",
      "required": false,
      "description": "输入值。",
      "default": "''"
    },
    {
      "name": "autofocus",
      "type": "boolean",
      "required": false,
      "description": "是否自动聚焦。",
      "default": "false"
    },
    {
      "name": "length",
      "type": "number",
      "required": false,
      "description": "验证码位数。",
      "default": "4"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用。",
      "default": "false"
    },
    {
      "name": "inputType",
      "type": "'text' | 'number' | 'digit'",
      "required": false,
      "description": "输入类型；number 时自动过滤非数字字符。digit 仅 uniapp 端支持。",
      "default": "'number'"
    },
    {
      "name": "size",
      "type": "typeof inputOtpSizes[number]",
      "required": false,
      "description": "尺寸大小。",
      "default": "'md'"
    },
    {
      "name": "color",
      "type": "typeof inputOtpColors[number]",
      "required": false,
      "description": "颜色主题。",
      "default": "'primary'"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "追加到根节点的自定义类名"
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "description": "输入值变化。"
    },
    {
      "name": "done",
      "description": "输入完成（达到指定位数），并自动收起焦点/键盘。"
    },
    {
      "name": "focus",
      "description": "输入框获焦。"
    },
    {
      "name": "blur",
      "description": "输入框失焦。"
    }
  ],
  "slots": [],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-input-otp/RebornInputOtpDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-input-otp/RebornInputOtpDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [
    "reborn-input"
  ],
  "whenToUse": [
    "登录、注册时输入短信/邮箱验证码。",
    "支付密码等固定位数的分格输入。",
    "输入满位后需要自动触发提交（done 事件）时。"
  ],
  "whenNotToUse": [
    "普通文本输入改用 reborn-input。",
    "数值步进增减改用 reborn-input-number。"
  ],
  "pitfalls": [
    "web、uniapp 双端可用。",
    "length 默认 4 位；输满指定位数触发 done 事件。",
    "inputType 默认 number；web 端支持 text/number，uniapp 端额外支持 digit。",
    "无插槽，格子样式通过 ui/size/color 配置。"
  ],
  "dependencies": [
    "clsx"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-input-otp"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-input-otp/RebornInputOtp.vue",
      "app/components/reborn/ui/reborn-input-otp/index.ts",
      "app/components/reborn/ui/reborn-input-otp/reborn-input-otp.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-input-otp/RebornInputOtp.vue",
      "packages/uniapp-project/src/components/reborn-input-otp/index.ts",
      "packages/uniapp-project/src/components/reborn-input-otp/reborn-input-otp.config.ts"
    ]
  },
  "docPath": "content/2.components/input-and-forms/reborn-input-otp.md",
  "_meta": {
    "contentHash": "8c7494b9fd236f22ae217b8a842f6c4b56aa0399",
    "hasOverride": true,
    "extractors": {
      "web": "ok",
      "uniapp": "ok",
      "docs": "found"
    }
  }
}
