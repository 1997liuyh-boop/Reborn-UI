{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-pagination",
  "title": "分页",
  "description": "用于大数据量列表分页切换的双端分页组件，提供多页码与简洁两种模式。",
  "category": "navigation",
  "tags": [],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "modelValue",
      "type": "number",
      "required": false,
      "description": "当前页码",
      "default": "1",
      "vModel": true
    },
    {
      "name": "total",
      "type": "number",
      "required": false,
      "description": "数据总数",
      "default": "0"
    },
    {
      "name": "pageSize",
      "type": "number",
      "required": false,
      "description": "每页条数",
      "default": "10"
    },
    {
      "name": "mode",
      "type": "PaginationMode",
      "required": false,
      "description": "显示模式",
      "default": "'multi'"
    },
    {
      "name": "color",
      "type": "PaginationColor",
      "required": false,
      "description": "主题颜色",
      "default": "'primary'"
    },
    {
      "name": "prevText",
      "type": "string",
      "required": false,
      "description": "上一页文字",
      "default": "''"
    },
    {
      "name": "nextText",
      "type": "string",
      "required": false,
      "description": "下一页文字",
      "default": "''"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用",
      "default": "false"
    },
    {
      "name": "background",
      "type": "boolean",
      "required": false,
      "description": "是否显示背景",
      "default": "false"
    },
    {
      "name": "hideOnSinglePage",
      "type": "boolean",
      "required": false,
      "description": "是否隐藏只有一页时的分页",
      "default": "false"
    },
    {
      "name": "ui",
      "type": "any",
      "required": false,
      "description": "各部分 UI 自定义",
      "default": "() => ({})"
    },
    {
      "name": "size",
      "type": "PaginationSize",
      "required": false,
      "description": "尺寸",
      "default": "'md'"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "自定义类名"
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "description": "当前页码变化时触发（v-model 双向同步），参数为新页码"
    },
    {
      "name": "change",
      "description": "页码切换后触发，参数为切换后的页码；点击当前页、省略号或禁用时不触发"
    }
  ],
  "slots": [
    {
      "name": "prev",
      "description": "自定义上一页按钮"
    },
    {
      "name": "page",
      "description": "自定义页码项 (仅 multi 模式)"
    },
    {
      "name": "simpleContent",
      "description": "自定义简单模式内容"
    },
    {
      "name": "next",
      "description": "自定义下一页按钮"
    }
  ],
  "exposes": [
    {
      "name": "prev",
      "description": "翻到上一页（当前页 - 1）：禁用或已在第一页时无操作，成功时同步 v-model 并触发 change"
    },
    {
      "name": "next",
      "description": "翻到下一页（当前页 + 1）：禁用或已在最后一页时无操作，成功时同步 v-model 并触发 change"
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-pagination/RebornPaginationDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-pagination/RebornPaginationDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "表格、列表数据量大需要按页浏览时。",
    "移动端需要简洁的上一页/下一页翻页（mode=\"simple\"）时。",
    "只有一页时希望自动隐藏分页器（hideOnSinglePage）时。"
  ],
  "whenNotToUse": [
    "uniapp 滚动触底加载更多改用 reborn-loadmore。",
    "内容按类别切换改用 reborn-tabs。"
  ],
  "pitfalls": [
    "web、uniapp 双端可用，但 size 属性仅 web 端支持。",
    "v-model 绑定当前页码（默认 1），需配合 total 与 pageSize 计算页数。",
    "page 插槽仅在 multi 模式下可用，simple 模式用 simpleContent 插槽。",
    "组件暴露 prev/next 方法可命令式翻页。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-pagination"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-pagination/RebornPagination.vue",
      "app/components/reborn/ui/reborn-pagination/index.ts",
      "app/components/reborn/ui/reborn-pagination/reborn-pagination.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-pagination/RebornPagination.vue",
      "packages/uniapp-project/src/components/reborn-pagination/reborn-pagination.config.ts"
    ]
  },
  "docPath": "content/2.components/navigation/reborn-pagination.md",
  "_meta": {
    "contentHash": "87adcd235625209f5432133b48fe5e0087306766",
    "hasOverride": true,
    "extractors": {
      "web": "ok",
      "uniapp": "ok",
      "docs": "found"
    }
  }
}
