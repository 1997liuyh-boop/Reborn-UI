{
  "$schema": "../schema/component.schema.json",
  "id": "dither-shader",
  "title": "抖动着色器",
  "description": "用于对图片实时应用有序抖动与像素化处理的复古风着色器组件。",
  "category": "effect",
  "tags": [
    "tailwind",
    "background",
    "card",
    "aceternity-ui"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "src",
      "type": "string",
      "required": true,
      "description": "Source image URL"
    },
    {
      "name": "gridSize",
      "type": "number",
      "required": false,
      "description": "Size of the dithering grid cells",
      "default": "4"
    },
    {
      "name": "ditherMode",
      "type": "DitheringMode",
      "required": false,
      "description": "Type of dithering pattern",
      "default": "\"bayer\""
    },
    {
      "name": "colorMode",
      "type": "ColorMode",
      "required": false,
      "description": "Color processing mode",
      "default": "\"original\""
    },
    {
      "name": "invert",
      "type": "boolean",
      "required": false,
      "description": "Invert the dithered output colors",
      "default": "false"
    },
    {
      "name": "pixelRatio",
      "type": "number",
      "required": false,
      "description": "Pixelation multiplier (1 = no pixelation, higher = more pixelated)",
      "default": "1"
    },
    {
      "name": "primaryColor",
      "type": "string",
      "required": false,
      "description": "Primary color for duotone mode",
      "default": "\"#000000\""
    },
    {
      "name": "secondaryColor",
      "type": "string",
      "required": false,
      "description": "Secondary color for duotone mode",
      "default": "\"#ffffff\""
    },
    {
      "name": "customPalette",
      "type": "string[]",
      "required": false,
      "description": "Custom color palette array for custom mode",
      "default": "() => [\"#000000\", \"#ffffff\"]"
    },
    {
      "name": "brightness",
      "type": "number",
      "required": false,
      "description": "Brightness adjustment (-1 to 1)",
      "default": "0"
    },
    {
      "name": "contrast",
      "type": "number",
      "required": false,
      "description": "Contrast adjustment (0 to 2, 1 = normal)",
      "default": "1"
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "required": false,
      "description": "Background color behind the dithered image",
      "default": "\"transparent\""
    },
    {
      "name": "objectFit",
      "type": "\"cover\" | \"contain\" | \"fill\" | \"none\"",
      "required": false,
      "description": "Object fit behavior",
      "default": "\"cover\""
    },
    {
      "name": "threshold",
      "type": "number",
      "required": false,
      "description": "Threshold bias for dithering (0 to 1)",
      "default": "0.5"
    },
    {
      "name": "animated",
      "type": "boolean",
      "required": false,
      "description": "Enable animation effect",
      "default": "false"
    },
    {
      "name": "animationSpeed",
      "type": "number",
      "required": false,
      "description": "Animation speed (lower = slower)",
      "default": "0.02"
    },
    {
      "name": "class",
      "type": "string",
      "required": false,
      "description": "Additional CSS classes for the container"
    }
  ],
  "events": [],
  "slots": [],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/dither-shader/DitherShaderDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "像素风、复古印刷风的图片展示区块。",
    "用 duotone 双色调或 customPalette 调色板做海报化图片处理。",
    "需要 animated 噪点动画效果的装饰图。"
  ],
  "whenNotToUse": [
    "普通图片展示（uniapp 场景），改用 reborn-image。",
    "需要自定义 shader 动画背景而非处理现有图片，改用 shader-toy。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "src 为必填；容器尺寸需通过 class 自行设置（如 Tailwind 尺寸类）。",
    "primaryColor / secondaryColor 仅在双色调（duotone）模式生效，customPalette 仅在自定义调色板模式生效。",
    "animated 默认 false；animationSpeed 数值越小越慢（默认 0.02）。",
    "brightness 取值 -1 至 1，contrast 取值 0 至 2（1 为正常）。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add dither-shader"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/dither-shader/DitherShader.vue",
      "app/components/reborn/ui/dither-shader/index.ts"
    ]
  },
  "docPath": "content/2.components/special-effects/dither-shader.md",
