{
  "$schema": "../schema/component.schema.json",
  "id": "neon-border",
  "title": "霓虹边框",
  "description": "用于给插槽内容包裹双色霓虹流转边框的装饰容器组件。",
  "category": "effect",
  "tags": [
    "css",
    "tailwind",
    "border"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "color1",
      "type": "string",
      "required": false,
      "description": "霓虹边框的主色。",
      "default": "\"#0496ff\""
    },
    {
      "name": "color2",
      "type": "string",
      "required": false,
      "description": "霓虹边框的辅色。",
      "default": "\"#ff0a54\""
    },
    {
      "name": "animationType",
      "type": "\"none\" | \"half\" | \"full\"",
      "required": false,
      "description": "\"full\"",
      "default": "\"half\""
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "description": "动画持续时间（秒）。",
      "default": "6"
    },
    {
      "name": "class",
      "type": "HTMLAttributes[\"class\"]",
      "required": false,
      "description": "用于样式的额外 CSS 类。",
      "default": "\"\""
    }
  ],
  "events": [],
  "slots": [
    {
      "name": "default",
      "description": ""
    }
  ],
