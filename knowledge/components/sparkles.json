  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "background",
      "type": "string",
      "required": false,
      "description": "画布背景色；作为叠加层使用时通常显式设为 `\"transparent\"`。",
      "default": "\"#0d47a1\""
    },
    {
      "name": "particleColor",
      "type": "string",
      "required": false,
      "description": "粒子颜色，需为 6 位十六进制值（内部会拼接透明度通道）。",
      "default": "\"#ffffff\""
    },
    {
      "name": "minSize",
      "type": "number",
      "required": false,
      "description": "粒子最小半径（px）。",
      "default": "1"
    },
    {
      "name": "maxSize",
      "type": "number",
      "required": false,
      "description": "粒子最大半径（px）。",
      "default": "3"
    },
    {
      "name": "speed",
      "type": "number",
      "required": false,
      "description": "粒子漂移速度倍率。",
      "default": "4"
    },
    {
      "name": "particleDensity",
      "type": "number",
      "required": false,
      "description": "粒子数量；密集星光效果常用 800-1200。",
      "default": "120"
    }
  ],
