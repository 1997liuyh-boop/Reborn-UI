{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-watermark",
  "title": "水印 Watermark",
  "description": "用于在内容容器上平铺文本或图片水印的组件。",
  "category": "data-display",
  "tags": [
    "data",
    "watermark"
  ],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "width",
      "type": "number",
      "required": false,
      "description": "水印的宽度",
      "default": "120"
    },
    {
      "name": "height",
      "type": "number",
      "required": false,
      "description": "水印的高度",
      "default": "64"
    },
    {
      "name": "rotate",
      "type": "number",
      "required": false,
      "description": "水印的旋转角度, 单位 °",
      "default": "-22"
    },
    {
      "name": "zIndex",
      "type": "number",
      "required": false,
      "description": "水印元素的 z-index 值",
      "default": "9"
    },
    {
      "name": "image",
      "type": "string",
      "required": false,
      "description": "水印图片，建议使用 2x 或 3x 图像",
      "default": "—"
    },
    {
      "name": "content",
      "type": "string | string[]",
      "required": false,
      "description": "水印文本内容",
      "default": "'Reborn UI'"
    },
    {
      "name": "font",
      "type": "RebornWatermarkFont",
      "required": false,
      "description": "文字样式",
      "default": "—"
    },
    {
      "name": "gap",
      "type": "[number, number]",
      "required": false,
      "description": "水印之间的间距 [x, y]",
      "default": "() => [100, 100]"
    },
    {
      "name": "offset",
      "type": "[number, number]",
      "required": false,
      "description": "水印从容器左上角的偏移，默认值为 `gap/2",
      "default": "[gap[0]/2, gap[1]/2]"
    },
    {
      "name": "customClass",
      "type": "any",
      "required": false,
      "description": ""
    },
    {
      "name": "ui",
      "type": "any",
      "required": false,
      "description": "",
      "default": "() => ({})"
    }
  ],
  "events": [],
  "slots": [
    {
      "name": "default",
      "description": "需要添加水印的内容容器"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-watermark/RebornWatermarkDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-watermark/RebornWatermarkDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "敏感数据页面添加用户标识水印防泄露。",
    "文档、图片预览区域叠加版权水印。",
    "需要多行文本水印（content 传字符串数组）或图片水印（image）。"
  ],
  "whenNotToUse": [
    "元素角标、数量标记改用 reborn-badge。",
    "全屏遮罩层改用 reborn-overlay。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端均可用。",
    "被加水印的内容须放在 default 插槽内，水印覆盖该容器。",
    "image 建议使用 2x 或 3x 图像；知识条目未说明 image 与 content 同时传入时的优先级。",
    "offset 默认为 gap 的一半，rotate 默认 -22 度。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-watermark"
  },
