{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-back-top",
  "title": "BackTop",
  "description": "用于长页面滚动超过阈值后显示返回顶部按钮的跨端导航组件。",
  "category": "navigation",
  "tags": [],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "scrollTop",
      "type": "number",
      "required": false,
      "description": "当前页面的滚动距离",
      "default": "0"
    },
    {
      "name": "threshold",
      "type": "number",
      "required": false,
      "description": "滚动多少距离后显示",
      "default": "300"
    },
    {
      "name": "bottom",
      "type": "number",
      "required": false,
      "description": "底部距离 (px)",
      "default": "20"
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "description": "滚动动画时长 (ms)",
      "default": "300"
    },
    {
      "name": "isTab",
      "type": "boolean",
      "required": false,
      "description": "是否是 TabBar 页面 (如果是，会自动抬高 50px)",
      "default": "false"
    },
    {
      "name": "safeArea",
      "type": "boolean",
      "required": false,
      "description": "是否适配安全区域",
      "default": "true"
    },
    {
      "name": "color",
      "type": "typeof backTopColors[number]",
      "required": false,
      "description": "按钮颜色。可选值：`primary`, `secondary`, `success`, `info`, `warning`, `error`, `neutral`。",
      "default": "'primary'"
    },
    {
      "name": "size",
      "type": "typeof backTopSizes[number]",
      "required": false,
      "description": "按钮大小。可选值：`sm`, `md`, `lg`。",
      "default": "'md'"
    },
    {
      "name": "ui",
      "type": "{\n    wrapper?: ClassValue\n    base?: ClassValue\n    icon?: ClassValue\n  }",
      "required": false,
      "description": "覆盖各个 slots 的样式，见下方「自定义样式（ui）」。",
      "default": "{}"
    }
  ],
  "events": [
    {
      "name": "click",
      "description": "点击返回顶部按钮时触发，无参数；组件已先发起回到顶部滚动，无需在回调中重复处理",
      "payload": "-"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "自定义按钮内容，替换默认的圆形箭头按钮。"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-back-top/RebornBackTopDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-back-top/RebornBackTopDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "长列表、长文章页面需要一键回到顶部时。",
    "uniapp TabBar 页面需要按钮自动抬高避开 TabBar（isTab）时。",
    "需要预设色彩（primary/success 等）与尺寸（sm/md/lg）的回顶按钮。"
  ],
  "whenNotToUse": [
    "需要可拖拽的悬浮入口，改用 reborn-affix。",
    "常驻的悬浮操作按钮，改用 reborn-fab。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端可用；uniapp 端必须通过 onPageScroll 把 scrollTop 传入组件，否则按钮不会随滚动显示。",
    "threshold 默认 300px，滚动超过该距离才显示按钮。",
    "isTab 为 true 时组件自动抬高 50px 避开 TabBar；safeArea 默认开启底部安全区适配。",
    "自定义按钮外观用默认插槽，细粒度样式覆盖用 ui 对象（wrapper/base/icon）。"
  ],
  "dependencies": [
    "@vueuse/core",
    "clsx"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-back-top"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-back-top/RebornBackTop.vue",
      "app/components/reborn/ui/reborn-back-top/reborn-back-top.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-back-top/RebornBackTop.vue",
      "packages/uniapp-project/src/components/reborn-back-top/index.ts",
      "packages/uniapp-project/src/components/reborn-back-top/reborn-back-top.config.ts"
    ]
  },
  "docPath": "content/2.components/navigation/reborn-back-top.md",
  "_meta": {
    "contentHash": "e35e2ca2d3f93e61ecf21ad47dac4fbf4a2c345e",
    "hasOverride": true,
    "extractors": {
      "web": "ok",
      "uniapp": "ok",
      "docs": "found"
    }
  }
}
