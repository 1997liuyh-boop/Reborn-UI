{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-loadmore",
  "title": "加载更多",
  "description": "用于列表底部展示加载中、加载失败与没有更多状态的 uniapp 组件。",
  "category": "misc",
  "tags": [],
  "platforms": [
    "uniapp"
  ],
  "props": [
    {
      "name": "customClass",
      "type": "string",
      "required": false,
      "description": "",
      "default": "''"
    },
    {
      "name": "customStyle",
      "type": "string",
      "required": false,
      "description": "",
      "default": "''"
    },
    {
      "name": "state",
      "type": "'loading' | 'error' | 'finished'",
      "required": true,
      "description": "",
      "default": "'loading'",
      "options": [
        "loading",
        "error",
        "finished"
      ]
    },
    {
      "name": "loadingText",
      "type": "string",
      "required": false,
      "description": ""
    },
    {
      "name": "finishedText",
      "type": "string",
      "required": false,
      "description": ""
    },
    {
      "name": "errorText",
      "type": "string",
      "required": false,
      "description": ""
    },
    {
      "name": "color",
      "type": "'primary' | 'secondary' | 'success' | 'info' | 'warning' | 'error' | 'neutral'",
      "required": false,
      "description": "",
      "default": "'neutral'",
      "options": [
        "primary",
        "secondary",
        "success",
        "info",
        "warning",
        "error",
        "neutral"
      ]
    },
    {
      "name": "ui",
      "type": "LoadMoreUI",
      "required": false,
      "description": "",
      "default": "() => ({})"
    },
    {
      "name": "loadingProps",
      "type": "RebornLoadingProps",
      "required": false,
      "description": "",
      "default": "() => ({\n        size: '40rpx'\n    })"
    }
  ],
  "events": [
    {
      "name": "reload",
      "description": ""
    }
  ],
