  "whenToUse": [
    "落地页 logo 墙、引言卡等需要悬停高光质感的展示卡。",
    "全幅图片卡片需要光泽扫过效果的场景。"
  ],
  "whenNotToUse": [
    "需要鼠标跟随的 3D 透视与子元素分层，改用 card-3d。",
    "需要按进入方向滑出覆盖层，改用 direction-aware-hover。"
  ],
  "pitfalls": [
