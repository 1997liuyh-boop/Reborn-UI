{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-image",
  "title": "图片 Image",
  "description": "用于展示图片并提供预览、加载/错误状态与多种裁剪模式的双端图片组件。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind",
    "image",
    "media",
    "uniapp",
    "viewerjs"
  ],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "customClass",
      "type": "ClassValue",
      "required": false,
      "description": "用于自定义根节点的样式类。"
    },
    {
      "name": "src",
      "type": "string",
      "required": true,
      "description": "**必填**。图片地址。"
    },
    {
      "name": "mode",
      "type": "typeof imageMode[number]",
      "required": false,
      "description": "图片裁剪、缩放的模式",
      "default": "'aspectFill'"
    },
    {
      "name": "preview",
      "type": "boolean",
      "required": false,
      "description": "是否显示边框",
      "default": "false"
    },
    {
      "name": "previewList",
      "type": "string[]",
      "required": false,
      "description": "是否显示边框",
      "default": "[]"
    },
    {
      "name": "height",
      "type": "string | number",
      "required": false,
      "description": "图片高度。数字默认为 px，字符串支持 rpx, %, vw 等。",
      "default": "120"
    },
    {
      "name": "width",
      "type": "string | number",
      "required": false,
      "description": "图片宽度。数字默认为 px，字符串支持 rpx, %, vw 等。",
      "default": "120"
    },
    {
      "name": "showLoading",
      "type": "boolean",
      "required": false,
      "description": "是否显示加载状态",
      "default": "true"
    },
    {
      "name": "lazyLoad",
      "type": "boolean",
      "required": false,
      "description": "是否懒加载",
      "default": "false"
    },
    {
      "name": "fadeShow",
      "type": "boolean",
      "required": false,
      "description": "图片显示动画效果",
      "default": "false"
    },
    {
      "name": "webp",
      "type": "boolean",
      "required": false,
      "description": "是否解码webp格式",
      "default": "false"
    },
    {
      "name": "showMenuByLongpress",
      "type": "boolean",
      "required": false,
      "description": "是否长按显示菜单",
      "default": "false"
    },
    {
      "name": "round",
      "type": "boolean",
      "required": false,
      "description": "是否显示圆角",
      "default": "false"
    },
    {
      "name": "loadingType",
      "type": "typeof LoadingTypes[number]",
      "required": false,
      "description": "是否显示圆角",
      "default": "'outline'"
    },
    {
      "name": "loadingSize",
      "type": "string | number",
      "required": false,
      "description": ""
    },
    {
      "name": "ui",
      "type": "Partial<{\n    root: ClassValue\n    error: ClassValue\n    errorIcon: ClassValue\n    loading: ClassValue\n    loadingIcon: ClassValue\n    inner: ClassValue\n  }>",
      "required": false,
      "description": "覆盖子组件样式的 UI 配置对象。"
    },
    {
      "name": "magnifier",
      "type": "boolean",
      "required": false,
      "description": "是否启用放大镜功能",
      "default": "false"
    },
    {
      "name": "magnifierZoom",
      "type": "number",
      "required": false,
      "description": "放大倍率 (控制透镜部分的放大比例)",
      "default": "2"
    },
    {
      "name": "magnifierSize",
      "type": "number",
      "required": false,
      "description": "放大镜尺寸 (控制原图上透镜的大小)",
      "default": "100"
    },
    {
      "name": "magnifierWidth",
      "type": "number | string",
      "required": false,
      "description": "预览窗口宽度 (默认与原图一致)",
      "default": "\"\""
    },
    {
      "name": "magnifierHeight",
      "type": "number | string",
      "required": false,
      "description": "预览窗口高度 (默认与原图一致)",
      "default": "\"\""
    }
  ],
  "events": [
    {
      "name": "load",
      "description": "图片加载成功时触发。"
    },
    {
      "name": "error",
      "description": "图片加载失败时触发。"
    }
  ],
  "slots": [
    {
      "name": "error",
      "description": "自定义错误状态的内容。"
    },
    {
      "name": "loading",
      "description": "自定义加载状态的内容。"
    },
    {
      "name": "default",
      "description": "自定义图片上的覆盖内容（如角标）。"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-image/RebornImageDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-image/RebornImageDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [
    "reborn-loading"
  ],
  "whenToUse": [
    "需要点击放大预览图片（preview + previewList）时。",
    "需要加载中占位与加载失败占位（showLoading、error 插槽）时。",
    "商品详情图需要放大镜效果（magnifier 及配套 zoom/size 参数）时。",
    "uniapp 端需要懒加载、webp 解码、长按菜单等原生 image 能力时。"
  ],
  "whenNotToUse": [
    "仅需在设备外壳中展示截图，改用 iphone-mockup 或 safari-mockup。",
    "web 端只需悬停局部放大效果，可用 lens。"
  ],
  "pitfalls": [
    "web、uniapp 双端可用。",
    "src 为必填项；width/height 默认均为 120，mode 默认 aspectFill。",
    "previewList 不传时默认仅预览当前 src。",
    "lazyLoad、webp、showMenuByLongpress 等属性对应 uniapp 原生 image 能力。",
    "magnifier 默认关闭，magnifierZoom 默认 2、magnifierSize 默认 100。"
  ],
  "dependencies": [
    "@vueuse/core",
    "clsx",
    "viewerjs"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-image"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-image/RebornImage.vue",
      "app/components/reborn/ui/reborn-image/reborn-image.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-image/RebornImage.vue",
      "packages/uniapp-project/src/components/reborn-image/index.ts",
      "packages/uniapp-project/src/components/reborn-image/reborn-image.config.ts"
    ]
  },
  "docPath": "content/2.components/miscellaneous/reborn-image.md",
  "_meta": {
    "contentHash": "5b38739bca8c346c84072fc2f936b732f540d52a",
    "hasOverride": true,
    "extractors": {
      "web": "ok",
      "uniapp": "ok",
      "docs": "found"
    }
  }
}
