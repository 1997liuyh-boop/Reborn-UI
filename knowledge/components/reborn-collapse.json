  "examples": [
    {
      "title": "Web 演示",
      "code": "<script setup lang=\"ts\">\n/** 基础用法的展开状态 */\nconst visible = ref(false);\n\n/** 手风琴：每一项独立维护展开状态 */\nconst panels = ref([\n  {\n    title: \"组件是什么\",\n    open: true,\n    content:\n      \"RebornCollapse 只负责折叠区域的高度过渡与状态管理，触发器与内容都由插槽提供，不预设任何视觉样式，便于嵌入各类业务卡片。\",\n  },\n  {\n    title: \"如何控制展开\",\n    open: false,\n    content:\n      \"通过 v-model 双向绑定展开状态；也可以监听 toggle 事件在展开或收起时执行额外逻辑，例如懒加载内容。\",\n  },\n  {\n    title: \"向上展开\",\n    open: false,\n    content:\n      \"position 设为 top 时内容向上方展开，配合 absolute 可让内容脱离文档流悬浮显示，适合底部工具栏场景。\",\n  },\n]);\n</script>\n\n<template>\n  <div class=\"flex w-full min-w-0 flex-col\">\n    <DemoSection\n      title=\"基础用法\"\n      description=\"默认插槽是触发器，可通过作用域参数 open 拿到当前状态；content 插槽是折叠内容，高度过渡由组件自动计算。\"\n    >\n      <DemoBlock layout=\"stack\">\n        <RebornCollapse\n          v-model=\"visible\"\n          custom-class=\"w-full\"\n        >\n          <template #default=\"{ open }\">\n            <div\n              class=\"border-default rounded-ui-sm flex cursor-pointer items-center justify-between border px-4 py-3\"\n            >\n              <span class=\"text-default text-sm font-medium\">点击展开 / 收起</span>\n              <Icon\n                name=\"lucide:chevron-down\"\n                class=\"text-muted size-4 transition-transform duration-200\"\n                :class=\"{ 'rotate-180': open }\"\n              />\n            </div>\n          </template>\n\n          <template #content>\n            <div class=\"text-muted space-y-2 px-4 py-3 text-sm leading-relaxed\">\n              <p>\n                张若虚（约公元 660—约公元 720），唐代诗人，扬州（今属江苏）人，曾任兖州兵曹，生卒年与字号均已不详。\n              </p>\n              <p>\n                其诗仅存两首于《全唐诗》中，《春江花月夜》抒写离情别绪与人生感慨，意境空明、韵律悠扬，素有「孤篇盖全唐」之誉。\n              </p>\n            </div>\n          </template>\n        </RebornCollapse>\n\n        <DemoNote tone=\"dimmed\">\n          当前状态：<code>{{ visible ? \"展开\" : \"收起\" }}</code>\n        </DemoNote>\n      </DemoBlock>\n    </DemoSection>\n\n    <DemoSection\n      title=\"组合成手风琴\"\n      description=\"每一项各自持有一份状态即可组合出列表；这里用一条分隔线代替卡片外壳，避免层层嵌套的背景块。\"\n    >\n      <DemoBlock layout=\"stack\">\n        <div class=\"divide-default border-default rounded-ui-md w-full divide-y border\">\n          <RebornCollapse\n            v-for=\"panel in panels\"\n            :key=\"panel.title\"\n            v-model=\"panel.open\"\n            custom-class=\"w-full\"\n          >\n            <template #default=\"{ open }\">\n              <div class=\"flex cursor-pointer items-center justify-between px-4 py-3\">\n                <span class=\"text-default text-sm font-medium\">{{ panel.title }}</span>\n                <Icon\n                  name=\"lucide:chevron-down\"\n                  class=\"text-muted size-4 transition-transform duration-200\"\n                  :class=\"{ 'rotate-180': open }\"\n                />\n              </div>\n            </template>\n\n            <template #content>\n              <p class=\"text-muted px-4 pb-3 text-sm leading-relaxed\">\n                {{ panel.content }}\n              </p>\n            </template>\n          </RebornCollapse>\n        </div>\n      </DemoBlock>\n    </DemoSection>\n  </div>\n</template>\n",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "code": "<script lang=\"ts\" setup>\nimport { ref } from 'vue'\n\nimport RebornButton from '@/components/reborn-button/RebornButton.vue'\nimport RebornCard from '@/components/reborn-card/RebornCard.vue'\nimport RebornCollapse from '@/components/reborn-collapse/RebornCollapse.vue'\nimport RebornPage from '@/components/reborn-page/RebornPage.vue'\n// demo组件\nimport Pinyin from './components/pinyin.vue'\n\nconst visible = ref(false)\nconst collapseRef = ref<InstanceType<typeof RebornCollapse> | null>(null)\n\nfunction toggle() {\n  collapseRef.value?.toggle?.()\n}\n</script>\n\n<template>\n  <RebornPage title=\"Collapse\" description=\"折叠面板组件用于展示和隐藏内容区域，支持平滑的展开收起动画效果，常用于 FAQ、详情展示等场景。\">\n    <RebornCard title=\"基本用法\">\n      <RebornCollapse v-model=\"visible\">\n        <template #default=\"{ open }\">\n          <view\n            class=\"\n              flex select-none items-center justify-between rounded-lg\n              bg-slate-50 p-4 transition-colors\n              active:bg-slate-100\n              dark:bg-slate-800\n              dark:active:bg-slate-700\n            \"\n          >\n            <text\n              class=\"\n                text-sm font-semibold text-slate-700\n                dark:text-white\n              \"\n            >\n              春江花月夜\n            </text>\n            <view\n              class=\"\n                i-lucide-chevron-down size-5 text-slate-500 transition-transform\n                duration-200\n              \"\n              :class=\"{ 'rotate-180': open }\"\n            />\n          </view>\n        </template>\n        <template #content>\n          <Pinyin />\n        </template>\n      </RebornCollapse>\n    </RebornCard>\n\n    <RebornCard title=\"ref 方式调用\">\n      <RebornButton @click=\"toggle\">\n        切换状态\n      </RebornButton>\n\n      <RebornCollapse ref=\"collapseRef\" :ui=\"{ content: 'pt-4' }\">\n        <template #content>\n          <Pinyin />\n        </template>\n      </RebornCollapse>\n    </RebornCard>\n  </RebornPage>\n</template>\n",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "FAQ、说明文字等默认收起、点击展开的内容块。",
    "筛选面板、更多选项等需要展开收起切换的区域。",
    "需要程序化控制展开（暴露 show/hide/toggle/resize 方法）的折叠区域。"
  ],
  "whenNotToUse": [
    "内容需要浮层覆盖页面而非推挤布局时，改用 reborn-popup 或 reborn-dialog。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端可用。",
    "触发区放默认插槽，被折叠的内容必须放 content 插槽，二者不可混放。",
    "内容尺寸动态变化后需调用暴露的 resize 方法重新测量高度。",
    "position 可设 top 使内容向上展开，absolute 控制展开内容是否脱离文档流。"
  ],
  "dependencies": [
    "tailwind-variants"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-collapse"
  },
