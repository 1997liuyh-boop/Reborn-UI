{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-collapse",
  "title": "折叠面板",
  "description": "用于点击触发区展开或收起内容区域的折叠组件，带高度过渡动画，双端可用。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind",
    "collapse",
    "accordion",
    "uniapp"
  ],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "customClass",
      "type": "any",
      "required": false,
      "description": "根节点的自定义样式类。",
      "default": "''"
    },
    {
      "name": "ui",
      "type": "{\n    root?: any\n    trigger?: any\n    content?: any\n  }",
      "required": false,
      "description": "自定义内部插槽样式的配置对象。",
      "default": "() => ({})"
    },
    {
      "name": "modelValue",
      "type": "unknown",
      "required": false,
      "description": "双向绑定值",
      "vModel": true,
      "default": "false"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "",
      "default": "false"
    },
    {
      "name": "position",
      "type": "'bottom' | 'top'",
      "required": false,
      "description": "",
      "default": "'bottom'"
    },
    {
      "name": "absolute",
      "type": "boolean",
      "required": false,
      "description": "",
      "default": "false"
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "description": "modelValue 变化时触发（v-model 同步）"
    },
    {
      "name": "toggle",
      "payload": "(e: 'toggle', value: boolean): void",
      "description": ""
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "触发区域的内容。"
    },
    {
      "name": "content",
      "description": "折叠展示的内容区域。"
    }
  ],
  "exposes": [
    {
      "name": "show",
      "description": ""
    },
    {
      "name": "hide",
      "description": ""
    },
    {
      "name": "toggle",
      "description": ""
    },
    {
      "name": "resize",
      "description": ""
    },
    {
      "name": "isAnimating",
      "description": ""
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-collapse/RebornCollapseDemo.vue",
      "source": "demo",
      "platform": "web"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-collapse/RebornCollapseDemo.vue",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "FAQ、说明文字等默认收起、点击展开的内容块。",
    "筛选面板、更多选项等需要展开收起切换的区域。",
    "需要程序化控制展开（暴露 show/hide/toggle/resize 方法）的折叠区域。"
  ],
  "whenNotToUse": [
    "内容需要浮层覆盖页面而非推挤布局时，改用 reborn-popup 或 reborn-dialog。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端可用。",
    "触发区放默认插槽，被折叠的内容必须放 content 插槽，二者不可混放。",
    "内容尺寸动态变化后需调用暴露的 resize 方法重新测量高度。",
    "position 可设 top 使内容向上展开，absolute 控制展开内容是否脱离文档流。"
  ],
  "dependencies": [
    "tailwind-variants"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-collapse"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-collapse/RebornCollapse.vue",
      "app/components/reborn/ui/reborn-collapse/index.ts",
      "app/components/reborn/ui/reborn-collapse/reborn-collapse.config.ts"
    ],
    "uniapp": [
      "packages/uniapp-project/src/components/reborn-collapse/RebornCollapse.vue",
      "packages/uniapp-project/src/components/reborn-collapse/index.ts",
      "packages/uniapp-project/src/components/reborn-collapse/reborn-collapse.config.ts"
    ]
  },
  "docPath": "content/2.components/miscellaneous/reborn-collapse.md",
