      "title": "UniApp 演示",
      "code": "<script lang=\"ts\" setup>\r\nimport { ref } from 'vue'\r\n\r\nimport RebornButton from '@/components/reborn-button/RebornButton.vue'\r\nimport RebornCard from '@/components/reborn-card/RebornCard.vue'\r\nimport RebornCollapse from '@/components/reborn-collapse/RebornCollapse.vue'\r\nimport RebornPage from '@/components/reborn-page/RebornPage.vue'\r\n// demo组件\r\nimport Pinyin from './components/pinyin.vue'\r\n\r\nconst visible = ref(false)\r\nconst collapseRef = ref<InstanceType<typeof RebornCollapse> | null>(null)\r\n\r\nfunction toggle() {\r\n  collapseRef.value?.toggle?.()\r\n}\r\n</script>\r\n\r\n<template>\r\n  <RebornPage title=\"Collapse\" description=\"折叠面板组件用于展示和隐藏内容区域，支持平滑的展开收起动画效果，常用于 FAQ、详情展示等场景。\">\r\n    <RebornCard title=\"基本用法\">\r\n      <RebornCollapse v-model=\"visible\">\r\n        <template #default=\"{ open }\">\r\n          <view\r\n            class=\"\r\n              flex select-none items-center justify-between rounded-lg\r\n              bg-slate-50 p-4 transition-colors\r\n              active:bg-slate-100\r\n              dark:bg-slate-800\r\n              dark:active:bg-slate-700\r\n            \"\r\n          >\r\n            <text\r\n              class=\"\r\n                text-sm font-semibold text-slate-700\r\n                dark:text-white\r\n              \"\r\n            >\r\n              春江花月夜\r\n            </text>\r\n            <view\r\n              class=\"\r\n                i-lucide-chevron-down size-5 text-slate-500 transition-transform\r\n                duration-200\r\n              \"\r\n              :class=\"{ 'rotate-180': open }\"\r\n            />\r\n          </view>\r\n        </template>\r\n        <template #content>\r\n          <Pinyin />\r\n        </template>\r\n      </RebornCollapse>\r\n    </RebornCard>\r\n\r\n    <RebornCard title=\"ref 方式调用\">\r\n      <RebornButton @click=\"toggle\">\r\n        切换状态\r\n      </RebornButton>\r\n\r\n      <RebornCollapse ref=\"collapseRef\" :ui=\"{ content: 'pt-4' }\">\r\n        <template #content>\r\n          <Pinyin />\r\n        </template>\r\n      </RebornCollapse>\r\n    </RebornCard>\r\n  </RebornPage>\r\n</template>\r\n",
      "source": "demo",
      "platform": "uniapp"
    }
  ],
  "related": [],
  "whenToUse": [
    "FAQ、说明文字等默认收起、点击展开的内容块。",
    "筛选面板、更多选项等需要展开收起切换的区域。",
    "需要程序化控制展开（暴露 show/hide/toggle/resize 方法）的折叠区域。"
  ],
  "whenNotToUse": [
    "内容需要浮层覆盖页面而非推挤布局时，改用 reborn-popup 或 reborn-dialog。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端可用。",
    "触发区放默认插槽，被折叠的内容必须放 content 插槽，二者不可混放。",
    "内容尺寸动态变化后需调用暴露的 resize 方法重新测量高度。",
    "position 可设 top 使内容向上展开，absolute 控制展开内容是否脱离文档流。"
  ],
  "dependencies": [
    "tailwind-variants"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-collapse"
  },
