{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-fireworks",
  "title": "礼花",
  "description": "用于给容器内元素附加点击礼花/烟花粒子特效的组件，仅 web 端。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind",
    "canvas"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "burstCount",
      "type": "number",
      "default": "160",
      "required": false,
      "description": "单次发射的粒子数量"
    },
    {
      "name": "teleport",
      "type": "boolean",
      "default": "false",
      "required": false,
      "description": "是否将 canvas 传送到 body 下（解决在特定容器中 z-index 被遮挡的问题）"
    },
    {
      "name": "angleCenter",
      "type": "number",
      "default": "270",
      "required": false,
      "description": "发射的中心角度，270度默认向上发射"
    },
    {
      "name": "angleSpread",
      "type": "number",
      "default": "130",
      "required": false,
      "description": "发射角度的散射范围，130度表示一个扇形区域"
    },
    {
      "name": "speedMin",
      "type": "number",
      "default": "8",
      "required": false,
      "description": "粒子的最小初速度"
    },
    {
      "name": "speedMax",
      "type": "number",
      "default": "25",
      "required": false,
      "description": "粒子的最大初速度"
    },
    {
      "name": "particleScale",
      "type": "number",
      "default": "1",
      "required": false,
      "description": "粒子尺寸的整体缩放比例（1 为默认大小，>1 变大，<1 变小）"
    }
  ],
  "events": [],
  "slots": [
