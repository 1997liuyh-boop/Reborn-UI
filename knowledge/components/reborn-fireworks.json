{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-fireworks",
  "title": "礼花",
  "description": "用于给容器内元素附加点击礼花/烟花粒子特效的组件，仅 web 端。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind",
    "canvas"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "burstCount",
      "type": "number",
      "default": "160",
      "required": false,
      "description": "单次发射的粒子数量"
    },
    {
      "name": "teleport",
      "type": "boolean",
      "default": "false",
      "required": false,
      "description": "是否将 canvas 传送到 body 下（解决在特定容器中 z-index 被遮挡的问题）"
    },
    {
      "name": "angleCenter",
      "type": "number",
      "default": "270",
      "required": false,
      "description": "发射的中心角度，270度默认向上发射"
    },
    {
      "name": "angleSpread",
      "type": "number",
      "default": "130",
      "required": false,
      "description": "发射角度的散射范围，130度表示一个扇形区域"
    },
    {
      "name": "speedMin",
      "type": "number",
      "default": "8",
      "required": false,
      "description": "粒子的最小初速度"
    },
    {
      "name": "speedMax",
      "type": "number",
      "default": "25",
      "required": false,
      "description": "粒子的最大初速度"
    },
    {
      "name": "particleScale",
      "type": "number",
      "default": "1",
      "required": false,
      "description": "粒子尺寸的整体缩放比例（1 为默认大小，>1 变大，<1 变小）"
    }
  ],
  "events": [],
  "slots": [
    {
      "name": "default",
      "description": ""
    },
    {
      "name": "overlay",
      "description": "有需要定位布局的元素内容，需要写在这个插槽中"
    }
  ],
  "exposes": [
    {
      "name": "launch",
      "description": ""
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-fireworks/RebornFireworksDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "签到成功、支付完成等庆祝反馈的点击礼花效果。",
    "营销活动页按钮点击时的纸片喷射特效。",
    "需要通过暴露的 launch 方法编程触发礼花的场景。"
  ],
  "whenNotToUse": [
    "uniapp 端不可用（仅 web）。",
    "非点击触发的持续性背景粒子装饰，改用 sparkles 或 meteors。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "需要定位布局的元素必须放在 overlay 插槽中，普通内容放默认插槽。",
    "teleport 设为 true 时画布覆盖整个浏览器窗口，默认仅限容器内。",
    "angleSpread 设为 360 即全向烟花扩散；默认 angleCenter 270（向上）、扩散 130 度。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-fireworks"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-fireworks/RebornFireworks.vue",
      "app/components/reborn/ui/reborn-fireworks/index.ts"
    ]
  },
  "docPath": "content/2.components/miscellaneous/reborn-fireworks.md",
  "_meta": {
