{
  "$schema": "../schema/component.schema.json",
  "id": "color-picker",
  "title": "取色器",
  "description": "用于弹层中选取颜色的取色器组件，支持 hex/hsl/rgb 等格式与预设色板。",
  "category": "form",
  "tags": [
    "css",
    "tailwind",
    "input",
    "color-picker",
    "uplusion23"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "value",
      "type": "`#${string}` | HsvaColor | HslaColor | RgbaColor",
      "required": false,
      "description": "当前颜色值，支持多种格式。",
      "default": "undefined"
    },
    {
      "name": "type",
      "type": "\"hsl\" | \"hsla\" | \"rgb\" | \"rgba\" | \"hex\"",
      "required": false,
      "description": "输入中默认显示的颜色格式。",
      "default": "\"hsl\""
    },
    {
      "name": "swatches",
      "type": "HexColor[]",
      "required": false,
      "description": "预设色板数组。",
      "default": "() => []"
    },
    {
      "name": "hideContrastRatio",
      "type": "boolean",
      "required": false,
      "description": "隐藏无障碍对比度区域。",
      "default": "false"
    },
    {
      "name": "hideDefaultSwatches",
      "type": "boolean",
      "required": false,
      "description": "隐藏默认色板。",
      "default": "false"
    },
    {
      "name": "class",
      "type": "string",
      "required": false,
      "description": "用于弹出内容的额外 CSS 类。",
      "default": "\"\""
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false,
      "description": "控制取色器的打开/关闭状态。",
      "default": "false"
    },
    {
      "name": "color",
      "type": "HsvaColor",
      "required": true,
      "description": "用于计算无障碍对比度的当前颜色（HSVA 对象），变化时自动重新计算 AA/AAA 达标状态",
      "default": "必填"
    },
    {
      "name": "label",
      "type": "\"hsl\" | \"hsla\" | \"rgb\" | \"rgba\"",
      "required": true,
      "description": "数字输入组的颜色格式：hsl/hsla 显示 H/S/L 通道，rgb/rgba 显示 R/G/B 通道；带 a 的格式追加透明度输入（0-100）",
      "default": "必填"
    }
  ],
  "events": [
    {
      "name": "value-change",
      "payload": "[value: ColorPickerValue]",
      "description": "当所选颜色变化时触发。"
    },
    {
      "name": "update:open",
      "payload": "[value: boolean]",
      "description": "当弹出层打开状态改变时触发。"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "触发器内容（如一个按钮），点击后切换弹层开关；组件自身不渲染默认触发器，必须提供。"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/color-picker/ColorPickerDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "主题色、自定义外观等需要精确取色的设置项。",
    "需要通过 swatches 提供品牌预设色板快速选色。",
    "需要展示颜色对比度（无障碍）参考的取色场景。"
  ],
  "whenNotToUse": [
    "uniapp 端项目，改用 reborn-color-picker。"
  ],
  "pitfalls": [
    "仅 web 端可用，依赖 @uiw/color-convert。",
    "默认插槽内容作为触发器（如按钮），弹层开关由 open prop 与 update:open 事件控制。",
    "选中值通过 value-change 事件获取（payload 为 ColorPickerValue，含 hex/hsl/hsla/rgb/rgba），不是 v-model。",
    "type prop 控制输入区显示的颜色格式，默认 \"hsl\"；hideContrastRatio / hideDefaultSwatches 可隐藏对应区域。"
  ],
  "dependencies": [
    "@uiw/color-convert"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add color-picker"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/color-picker/ColorPicker.vue",
      "app/components/reborn/ui/color-picker/ContrastRatio.vue",
      "app/components/reborn/ui/color-picker/ObjectColorInput.vue",
      "app/components/reborn/ui/color-picker/index.ts"
    ]
  },
  "docPath": "content/2.components/input-and-forms/color-picker.md",
  "_meta": {
    "contentHash": "b791400e5248751b7308ed4b8f897b44be40343e",
    "hasOverride": true,
    "extractors": {
      "web": "ok",
      "uniapp": "absent",
      "docs": "found"
    }
  }
}
