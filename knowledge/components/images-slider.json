{
  "$schema": "../schema/component.schema.json",
  "id": "images-slider",
  "title": "图片滑块",
  "description": "用于全屏轮播一组背景图并叠加覆盖层内容的图片滑块组件。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind",
    "images",
    "aceternity-ui"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "images",
      "type": "string[]",
      "default": "() => []",
      "required": false,
      "description": "要在滑块中展示的图片 URL 数组。"
    },
    {
      "name": "hideOverlay",
      "type": "boolean",
      "default": "false",
      "required": false,
      "description": "是否隐藏图片滑块的覆盖层（槽位将不会渲染）。"
    },
    {
      "name": "overlayClass",
      "type": "string",
      "default": "\"\"",
      "required": false,
      "description": "应用于覆盖层容器的类名。"
    },
    {
      "name": "imageClass",
      "type": "string",
      "default": "\"bg-cover bg-center bg-no-repeat\"",
      "required": false,
      "description": "应用于每张图片的类名。"
    },
    {
      "name": "enterFromClass",
      "type": "string",
      "default": "\"scale-0 origin-center\"",
      "required": false,
      "description": "进入过渡的初始类名。"
    },
    {
      "name": "enterActiveClass",
      "type": "string",
      "default": "\"transition-transform duration-300 ease-in-out\"",
      "required": false,
      "description": "进入过渡的激活类名。"
    },
    {
      "name": "leaveActiveClass",
      "type": "string",
      "default": "\"transition-transform duration-300 ease-in-out\"",
      "required": false,
      "description": "离开过渡的激活类名。"
    },
    {
      "name": "autoplay",
      "type": "[boolean, number, string]",
      "default": "false",
      "required": false,
      "description": "自动播放间隔（毫秒），或 `false` 禁用。"
    },
    {
      "name": "direction",
      "type": "string",
      "default": "\"vertical\"",
      "required": false,
      "description": "滑块运行的轴向。"
    },
    {
      "name": "perspective",
      "type": "string",
      "default": "\"1000px\"",
      "required": false,
      "description": "应用于滑块容器的透视值。"
    },
    {
      "name": "modelValue",
      "type": "unknown",
      "required": false,
      "description": "双向绑定值",
      "vModel": true,
      "default": "0"
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "description": "modelValue 变化时触发（v-model 同步）"
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": ""
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "code": "<script lang=\"ts\" setup>\n/** 轮播用的示例图片，实际使用时替换为业务图即可 */\nconst images = [\n  \"https://picsum.photos/seed/waiting/1920/1080\",\n  \"https://picsum.photos/seed/full-collapse/1920/1080\",\n  \"https://picsum.photos/seed/five-stories-falling/1920/1080\",\n  \"https://picsum.photos/seed/war-all-the-time/1920/1080\",\n  \"https://picsum.photos/seed/a-city-by-the-light-divided/1920/1080\",\n  \"https://picsum.photos/seed/common-existence/1920/1080\",\n  \"https://picsum.photos/seed/no-devolucion/1920/1080\",\n];\n</script>\n\n<template>\n  <DemoSection\n    title=\"基础用法\"\n    description=\"ImagesSlider 会预加载全部图片后再开始切换，默认插槽覆盖在图片之上，可用于放置标题与行动按钮。\"\n  >\n    <DemoBlock layout=\"stack\">\n      <ImagesSlider\n        :images=\"images\"\n        autoplay\n      >\n        <!-- 内容层叠在图片之上，底部渐变仅用于保证文字可读性 -->\n        <div\n          class=\"flex size-full items-end justify-center bg-linear-to-b from-transparent via-transparent to-black/80 p-8\"\n        >\n          <div class=\"max-w-prose text-center text-white\">\n            <h3 class=\"mb-8 text-5xl max-md:text-2xl\">没人要求，但它就是很好看的图片轮播</h3>\n            <button\n              type=\"button\"\n              class=\"border-current/50 rounded-full border px-4 py-2 text-sm transition-colors hover:border-current\"\n            >\n              立即加入\n            </button>\n          </div>\n        </div>\n      </ImagesSlider>\n    </DemoBlock>\n  </DemoSection>\n</template>\n",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [],
  "whenToUse": [
    "Hero 区需要全屏图片轮播并在图上叠加标题、按钮时。",
    "需要键盘导航或 autoplay 自动播放的图片背景切换。",
    "需要通过 v-model 获取或控制当前图片索引时。"
  ],
  "whenNotToUse": [
    "常规卡片式轮播或跨端场景，改用 reborn-carousel。",
    "卡片内容轮播展示，改用 apple-card-carousel。"
  ],
  "pitfalls": [
    "仅 web 端可用，依赖 @vueuse/core。",
    "图片以背景图方式渲染（默认 imageClass 为 bg-cover bg-center），非 img 标签。",
    "覆盖层内容通过默认插槽传入；hideOverlay 为 true 时插槽不渲染。",
    "过渡方向默认 vertical，可通过 direction 与 enterFromClass 等类名自定义动画。"
  ],
  "dependencies": [
    "@vueuse/core"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add images-slider"
  },
