{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-guide",
  "title": "引导 Guide",
  "description": "用于按步骤高亮页面元素并弹出说明的新手引导组件，仅 web 端。",
  "category": "basic",
  "tags": [
    "css",
    "tailwind",
    "guide",
    "tour"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "current",
      "type": "number",
      "required": false,
      "description": "当前步骤（支持 v-model）",
      "default": "undefined",
      "vModel": true
    },
    {
      "name": "defaultCurrent",
      "type": "number",
      "required": false,
      "description": "非受控当前步骤",
      "default": "-1"
    },
    {
      "name": "steps",
      "type": "GuideStep[]",
      "required": true,
      "description": "引导步骤数组",
      "default": "[]"
    },
    {
      "name": "mode",
      "type": "\"popup\" | \"dialog\"",
      "required": false,
      "description": "引导框类型",
      "default": "\"popup\""
    },
    {
      "name": "hideCounter",
      "type": "boolean",
      "required": false,
      "description": "是否隐藏计数器",
      "default": "false"
    },
    {
      "name": "hidePrev",
      "type": "boolean",
      "required": false,
      "description": "是否隐藏上一步按钮",
      "default": "false"
    },
    {
      "name": "hideSkip",
      "type": "boolean",
      "required": false,
      "description": "是否隐藏跳过按钮",
      "default": "false"
    },
    {
      "name": "finishButtonProps",
      "type": "ButtonProps",
      "required": false,
      "description": "完成按钮属性",
      "default": "() => ({})"
    },
    {
      "name": "nextButtonProps",
      "type": "ButtonProps",
      "required": false,
      "description": "下一步按钮属性",
      "default": "() => ({})"
    },
    {
      "name": "prevButtonProps",
      "type": "ButtonProps",
      "required": false,
      "description": "上一步按钮属性",
      "default": "() => ({})"
    },
    {
      "name": "skipButtonProps",
      "type": "ButtonProps",
      "required": false,
      "description": "跳过按钮属性",
      "default": "() => ({})"
    },
    {
      "name": "showOverlay",
      "type": "boolean",
      "required": false,
      "description": "是否出现遮罩层",
      "default": "true"
    },
    {
      "name": "highlightPadding",
      "type": "number",
      "required": false,
      "description": "高亮框内边距",
      "default": "8"
    },
    {
      "name": "zIndex",
      "type": "number",
      "required": false,
      "description": "提示框层级",
      "default": "999999"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "自定义类名",
      "default": "undefined"
    },
    {
      "name": "ui",
      "type": "Partial<{\n    overlay: ClassValue;\n    highlightMask: ClassValue;\n    guideBox: ClassValue;\n    guideArrow: ClassValue;\n    guideHeader: ClassValue;\n    guideTitle: ClassValue;\n    guideBody: ClassValue;\n    guideFooter: ClassValue;\n    counter: ClassValue;\n    buttonGroup: ClassValue;\n    skipLink: ClassValue;\n    dialogOverlay: ClassValue;\n    dialogBox: ClassValue;\n  }>",
      "required": false,
      "description": "UI 局部重写",
      "default": "() => ({})"
    }
  ],
  "events": [
    {
      "name": "change",
      "payload": "(e: \"change\", current: number, context?: { e: MouseEvent; total: number }): void;",
      "description": "当前步骤变化时触发"
    },
    {
      "name": "finish",
      "payload": "(e: \"finish\", context: { e: MouseEvent; current: number; total: number }): void;",
      "description": "点击完成按钮时触发"
    },
    {
      "name": "next-step-click",
      "payload": "(e: \"next-step-click\", context: { e: MouseEvent; next: number; current: number; total: number }): void;",
      "description": "点击下一步时触发"
    },
    {
      "name": "prev-step-click",
      "payload": "(e: \"prev-step-click\", context: { e: MouseEvent; prev: number; current: number; total: number }): void;",
      "description": "点击上一步时触发"
    },
    {
      "name": "skip",
      "payload": "(e: \"skip\", context: { e: MouseEvent; current: number; total: number }): void;",
      "description": "点击跳过按钮时触发"
    },
    {
      "name": "update:current",
      "description": "current 变化时触发（v-model 同步）"
    }
  ],
  "slots": [
    {
      "name": "counter",
      "description": "自定义计数器"
    }
  ],
  "exposes": [
    {
      "name": "next",
      "description": "进入下一步"
    },
    {
      "name": "prev",
      "description": "退回上一步"
    },
    {
      "name": "finish",
      "description": "完成引导"
    },
    {
      "name": "skip",
      "description": "跳过引导"
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-guide/RebornGuideDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [
    "reborn-button"
  ],
  "whenToUse": [
    "新功能上线或用户首次进入页面时的分步操作指引。",
    "需要遮罩高亮目标元素并配上一步/下一步/跳过按钮的引导流程。",
    "需要 v-model:current 受控步骤、监听 finish/skip 事件上报引导完成情况的场景。"
  ],
  "whenNotToUse": [
    "uniapp 端不可用（仅 web）。",
    "单个元素的悬浮提示说明，改用 reborn-tooltip 或 reborn-popover。"
  ],
  "pitfalls": [
    "仅 web 端可用。",
    "defaultCurrent 默认 -1 表示未开始，启动引导需将 current 设为步骤索引。",
    "mode 支持 popup（贴靠高亮元素）与 dialog 两种展示形态。",
    "zIndex 默认 999999，注意与其他弹层的层级关系；highlightPadding 控制高亮框内边距（默认 8）。",
    "步骤对象的 content / highlightContent 字段声明的是动态插槽名：提供同名 <template #名称> 即可自定义该步骤的弹框正文（替代 body）或高亮框内容。"
  ],
  "dependencies": [
    "clsx"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-guide"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-guide/RebornGuide.vue",
      "app/components/reborn/ui/reborn-guide/index.ts",
      "app/components/reborn/ui/reborn-guide/reborn-guide.config.ts"
    ]
  },
  "docPath": "content/2.components/button/reborn-guide.md",
  "_meta": {
    "contentHash": "ded1160300dee84b516676854f6f123e38ecb1d2",
    "hasOverride": true,
    "extractors": {
      "web": "ok",
      "uniapp": "absent",
      "docs": "found"
    }
  }
}
