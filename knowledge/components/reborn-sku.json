{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-sku",
  "title": "商品规格 Sku",
  "description": "用于商品规格（SKU）选择的选项组件，按 options 渲染规格项并以对象形式双向绑定选中结果。",
  "category": "form",
  "tags": [
    "web",
    "sku",
    "form",
    "select"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "options",
      "type": "SkuOption[]",
      "required": false,
      "description": "属性组配置列表",
      "default": "() => []"
    },
    {
      "name": "modelValue",
      "type": "Record<string, any>",
      "required": false,
      "description": "双向绑定值，key 为 SkuOption.key，value 为选中的 valueKey 值（多选时为数组）",
      "default": "() => ({})"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "自定义类名",
      "default": "—"
    },
    {
      "name": "ui",
      "type": "SkuUi",
      "required": false,
      "description": "UI 覆盖",
      "default": "() => ({})"
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "payload": "(e: \"update:modelValue\", value: Record<string, any>): void;",
      "description": "选中结果变化时触发（v-model）"
    },
    {
      "name": "change",
      "payload": "(e: \"change\", key: string, value: any): void;",
      "description": "单个属性组选中值变化时触发，`key` 为该属性组的 key"
    }
  ],
  "slots": [
    {
      "name": "item",
      "description": "自定义单个选项内容，作用域参数：`item`（选项数据）、`option`（所属属性组）、`selected`（是否选中）"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-sku/RebornSkuDemo.vue",
      "source": "demo",
      "platform": "web"
    }
  ],
  "related": [
    "reborn-badge"
  ],
  "whenToUse": [
    "商品详情页选择颜色、尺码等规格组合，需要 v-model 收集选中值。",
    "需要通过 item 插槽自定义规格选项的渲染。"
  ],
  "whenNotToUse": [
    "多层级联动选择（省市区、分类）改用 reborn-cascader。",
    "单组互斥选项改用 reborn-radio。",
    "uniapp 端项目：platforms 仅 web，无 uniapp 实现。"
  ],
  "pitfalls": [
    "platforms 仅 web 端提供。",
    "modelValue 为 Record<string, any> 对象，change 与 update:modelValue 同步选中状态。",
    "无文档页与演示示例，props 描述缺失，SkuOption 具体结构需查阅源码（RebornSku.vue）。"
  ],
  "dependencies": [],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-sku"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-sku/RebornSku.vue",
      "app/components/reborn/ui/reborn-sku/reborn-sku.config.ts"
    ]
  },
