{
  "$schema": "../schema/component.schema.json",
  "id": "text-generate-effect",
  "title": "文字生成效果",
  "description": "用于让段落文字逐字渐显、可带模糊过渡的入场动画组件。",
  "category": "effect",
  "tags": [
    "css",
    "tailwind",
    "aceternity-ui"
  ],
  "platforms": [
    "web"
