  "props": [
    {
      "name": "words",
      "type": "string",
      "required": true,
      "description": "要展示并生成的文字。",
      "default": "Required"
    },
    {
      "name": "filter",
      "type": "boolean",
      "required": false,
      "description": "文字的模糊效果。",
      "default": "true"
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "description": "文字生成动画的持续时间（秒）。",
      "default": "0.7"
    },
    {
      "name": "delay",
      "type": "number",
      "required": false,
