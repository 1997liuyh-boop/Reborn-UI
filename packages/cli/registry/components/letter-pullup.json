{
  "name": "letter-pullup",
  "title": "字符上提",
  "description": "用于让一段文字逐字符错落上提进场的文字动画组件。",
  "category": "effect",
  "tags": [
    "css",
    "tailwind",
    "magic-ui"
  ],
  "dependencies": [
    "motion-v"
  ],
  "files": [
    {
      "path": "index.ts",
      "content": "export { default as LetterPullup } from \"./LetterPullup.vue\";\n"
    },
    {
      "path": "LetterPullup.vue",
      "content": "<script setup lang=\"ts\">\nimport { Motion } from \"motion-v\";\n\ninterface LetterPullupProps {\n  class?: string;\n  words: string;\n  delay?: number;\n}\n\nconst props = defineProps<LetterPullupProps>();\n\nconst letters = props.words.split(\"\");\n\nconst pullupVariant = {\n  initial: { y: 100, opacity: 0 },\n  animate: {\n    y: 0,\n    opacity: 1,\n  },\n};\n</script>\n\n<template>\n  <div class=\"flex justify-center\">\n    <div\n      v-for=\"(letter, index) in letters\"\n      :key=\"letter\"\n    >\n      <Motion\n        as=\"h1\"\n        :initial=\"pullupVariant.initial\"\n        :animate=\"pullupVariant.animate\"\n        :transition=\"{\n          delay: index * (props.delay ? props.delay : 0.05),\n        }\"\n        class=\"font-display text-center text-4xl font-bold tracking-[-0.02em] text-black drop-shadow-sm md:text-4xl md:leading-[5rem]\"\n        :class=\"[props.class]\"\n      >\n        <span v-if=\"letter === ' '\">&nbsp;</span>\n        <span v-else>{{ letter }}</span>\n      </Motion>\n    </div>\n  </div>\n</template>\n",
      "target": "web"
    }
  ],
  "fileCount": 2,
  "contentHash": "308e770505e4eee08e6b5e4f613ffe22615e213a"
}
