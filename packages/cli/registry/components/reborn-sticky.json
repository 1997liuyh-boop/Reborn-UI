    {
      "path": "reborn-sticky.config.ts",
      "content": "export default {\n  slots: {\n    wrapper: 'reborn-sticky-wrapper relative',\n    content: 'w-full relative transition-[top] duration-200',\n  },\n  variants: {\n    sticky: {\n      true: {\n        content: 'fixed w-full z-50',\n      },\n      false: {\n        content: 'relative w-full',\n      },\n    },\n  },\n  defaultVariants: {\n    sticky: false,\n  },\n} as const\n",
