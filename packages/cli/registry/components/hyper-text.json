{
  "name": "hyper-text",
  "title": "超能文字",
  "description": "用于文字以字符快速乱序滚动后定格显现的动画组件，悬停可重播。",
  "category": "effect",
  "tags": [
    "css",
    "tailwind",
    "magic-ui"
  ],
  "dependencies": [
    "@vueuse/core",
    "motion-v"
  ],
  "files": [
    {
      "path": "HyperText.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from \"vue\";\nimport { useIntervalFn } from \"@vueuse/core\";\nimport { Motion } from \"motion-v\";\nimport { computed, ref, watch } from \"vue\";\n\nconst props = withDefaults(\n  defineProps<{\n    class?: HTMLAttributes[\"class\"];\n    text: string;\n    duration?: number;\n    animateOnLoad: boolean;\n  }>(),\n  {\n    duration: 800,\n  },\n);\n\nconst alphabets = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\";\nconst displayText = ref(props.text.split(\"\"));\nconst iterations = ref(0);\n\nfunction getRandomLetter() {\n  return alphabets[Math.floor(Math.random() * alphabets.length)];\n}\nfunction triggerAnimation() {\n  iterations.value = 0;\n  startAnimation();\n}\n\nconst { pause, resume } = useIntervalFn(\n  () => {\n    if (iterations.value < props.text.length) {\n      const arr = displayText.value?.map((l, i) =>\n        l === \" \" ? l : i <= iterations.value ? props.text[i] : getRandomLetter(),\n      );\n      displayText.value = (arr ?? []) as string[];\n      iterations.value += 0.1;\n    } else {\n      pause();\n    }\n  },\n  computed(() => props.duration / (props.text.length * 10)),\n);\n\nfunction startAnimation() {\n  pause();\n  resume();\n}\n\nwatch(\n  () => props.text,\n  (newText) => {\n    displayText.value = newText.split(\"\");\n    triggerAnimation();\n  },\n);\n\nif (props.animateOnLoad) {\n  triggerAnimation();\n}\n</script>\n\n<template>\n  <div class=\"flex scale-100 cursor-default overflow-hidden py-2\" :class=\"[$props.class]\"\n    @mouseenter=\"triggerAnimation\">\n    <div class=\"flex\">\n      <Motion v-for=\"(letter, i) in displayText\" :key=\"i\" as=\"span\" :class=\"[letter === ' ' ? 'w-3' : '', $props.class]\"\n        class=\"inline-block font-mono\" :initial=\"{ opacity: 0, y: -10 }\" :animate=\"{ opacity: 1, y: 0 }\"\n        :delay=\"i * (duration / (text.length * 10))\">\n        {{ letter.toUpperCase() }}\n      </Motion>\n    </div>\n  </div>\n</template>\n",
      "target": "web"
    },
    {
      "path": "index.ts",
      "content": "export { default as HyperText } from \"./HyperText.vue\";\n"
    }
  ],
  "fileCount": 2,
  "contentHash": "0bf8d923d398bca9583d1440cd4354e704b08e04"
}
