    {
      "path": "index.ts",
      "content": "export { default as RebornMenu } from \"./RebornMenu.vue\";\nexport { default as RebornSubMenu } from \"./RebornSubMenu.vue\";\nexport { default as RebornMenuItem } from \"./RebornMenuItem.vue\";\nexport { default as RebornMenuItemGroup } from \"./RebornMenuItemGroup.vue\";\n"
