{
  "name": "photo-gallery",
  "title": "照片画廊",
  "description": "用于以动画展开一组照片的画廊展示组件，图片经 items 传入。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind",
    "gallery"
  ],
  "dependencies": [],
  "files": [
    {
      "path": "index.ts",
      "content": "export { default as PhotoGallery } from \"./PhotoGallery.vue\";\n"
    },
    {
      "path": "PhotoGallery.vue",
      "content": "<script setup lang=\"ts\">\ninterface Props {\n  containerClass?: string;\n  class?: string;\n  items: {\n    src: string;\n  }[];\n}\nconst props = defineProps<Props>();\n</script>\n\n<template>\n  <div\n    class=\"gallery mb-[var(--size)] grid grid-cols-6 gap-1\"\n    :class=\"[props.containerClass]\"\n  >\n    <img\n      v-for=\"(image, index) in props.items\"\n      :key=\"index\"\n      :src=\"image.src\"\n      :alt=\"`image+${index}`\"\n      class=\"gallery-img size-[calc(var(--size)*2)] rounded object-cover transition-[clip-path,filter] duration-75\"\n      :class=\"[props.class]\"\n    />\n  </div>\n</template>\n\n<style scoped>\n.gallery {\n  --size: 100px;\n  grid-auto-rows: var(--size);\n\n  &:has(:hover) img:not(:hover),\n  &:has(:focus) img:not(:focus) {\n    filter: brightness(0.5) contrast(0.5);\n  }\n\n  img {\n    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);\n    grid-column: auto / span 2;\n\n    &:nth-child(5n-1) {\n      grid-column: 2 / span 2;\n    }\n\n    &:hover,\n    &:focus {\n      clip-path: polygon(100% 0, 100% 100%, 0 100%, 0 0);\n      z-index: 1;\n      transition:\n        clip-path 0.25s,\n        filter 0.25s;\n      filter: saturate(150%);\n    }\n\n    &:focus {\n      outline: 10px dashed black;\n      outline-offset: -5px;\n    }\n  }\n}\n</style>\n",
      "target": "web"
    }
  ],
