{
  "name": "text-scroll-reveal",
  "title": "滚动文字揭示",
  "description": "用于随页面滚动进度将一句话逐词由淡变实显现的文字组件。",
  "category": "effect",
  "tags": [
    "css",
    "tailwind",
    "magic-ui"
  ],
  "dependencies": [],
  "files": [
    {
      "path": "index.ts",
      "content": "export { default as TextScrollReveal } from \"./TextScrollReveal.vue\";\n"
    },
    {
      "path": "ScrollWord.vue",
      "content": "<script lang=\"ts\" setup>\nimport { computed } from \"vue\";\n\ninterface Props {\n  word: string;\n  progress: number;\n  range: Array<number>;\n}\n\nconst props = defineProps<Props>();\n\nconst computedOpacity = computed(() => {\n  const [start, end] = props.range;\n  const progress = props.progress;\n\n  // Calculate opacity based on the progress and range\n  if (progress < start) return 0;\n  if (progress > end) return 1;\n\n  // Linear interpolation for opacity between 0 and 1\n  return (progress - start) / (end - start);\n});\n</script>\n\n<template>\n  <span class=\"xl:lg-3 relative mx-1 lg:mx-2.5\">\n    <span class=\"absolute opacity-30 dark:opacity-70\">{{ word }}</span>\n    <span\n      :style=\"{ opacity: computedOpacity }\"\n      class=\"text-black dark:text-white\"\n    >\n      {{ word }}\n    </span>\n  </span>\n</template>\n",
      "target": "web"
    },
    {
      "path": "TextScrollReveal.vue",
      "content": "<script lang=\"ts\" setup>\nimport { computed, onMounted, onUnmounted, ref } from \"vue\";\n\ninterface Props {\n  class?: string;\n  text: string;\n}\n\n// Props\nconst props = defineProps<Props>();\n\nconst textScrollRevealRef = ref<HTMLElement | null>(null);\n\nconst words = computed(() => props.text.split(\" \"));\n\nconst scrollYProgress = ref(0);\n\nfunction updateScrollYProgress() {\n  if (textScrollRevealRef.value) {\n    const boundingRect = textScrollRevealRef.value.getBoundingClientRect();\n    const windowHeight = window.innerHeight;\n\n    scrollYProgress.value = (boundingRect.y / windowHeight) * -1;\n  }\n}\n\nonMounted(() => {\n  window.addEventListener(\"scroll\", updateScrollYProgress);\n  window.addEventListener(\"resize\", updateScrollYProgress);\n  updateScrollYProgress();\n});\n\nonUnmounted(() => {\n  window.removeEventListener(\"scroll\", updateScrollYProgress);\n  window.removeEventListener(\"resize\", updateScrollYProgress);\n});\n</script>\n\n<template>\n  <div\n    ref=\"textScrollRevealRef\"\n    class=\"relative z-0 h-[200vh]\"\n    :class=\"[$props.class]\"\n  >\n    <div class=\"sticky top-0 mx-auto flex h-1/2 max-w-4xl items-center bg-transparent px-4 py-20\">\n      <p\n        class=\"flex flex-wrap p-5 text-2xl font-bold text-black/20 md:p-8 md:text-3xl lg:p-10 lg:text-4xl xl:text-5xl dark:text-white/20\"\n      >\n        <ScrollWord\n          v-for=\"(word, i) in words\"\n          :key=\"i\"\n          :word=\"word\"\n          :progress=\"scrollYProgress\"\n          :range=\"[i / words.length, (i + 1) / words.length]\"\n        />\n      </p>\n    </div>\n  </div>\n</template>\n",
      "target": "web"
    }
  ],
  "fileCount": 3,
  "contentHash": "600ad2efa298e74ede31fcd75e4b0466b9450d08"
}
