{
  "name": "box-reveal",
  "title": "盒子揭示",
  "description": "用于内容被色块滑开后显现的揭示入场动画组件。",
  "category": "effect",
  "tags": [
    "css",
    "tailwind",
    "magic-ui"
  ],
  "dependencies": [
    "motion-v"
  ],
  "files": [
    {
      "path": "BoxReveal.vue",
      "content": "<script lang=\"ts\" setup>\nimport type { HTMLAttributes } from \"vue\";\nimport { Motion } from \"motion-v\";\n\ninterface BoxRevealProps {\n  color?: string;\n  duration?: number;\n  class?: HTMLAttributes[\"class\"];\n  delay?: number;\n}\n\nconst props = withDefaults(defineProps<BoxRevealProps>(), {\n  color: \"#5046e6\",\n  duration: 0.5,\n  delay: 0.25,\n});\n\n// Motion variants\nconst initialMainVariants = { opacity: 0, y: 25 };\nconst visibleMainVariants = {\n  opacity: 1,\n  y: 0,\n};\n\nconst initialSlideVariants = { left: \"0%\" };\nconst visibleSlideVariants = {\n  left: \"100%\",\n};\n</script>\n\n<template>\n  <div\n    class=\"relative\"\n    :class=\"[$props.class]\"\n  >\n    <Motion\n      :initial=\"initialMainVariants\"\n      :while-in-view=\"visibleMainVariants\"\n      :transition=\"{\n        duration: props.duration,\n        delay: props.delay * 2,\n      }\"\n    >\n      <slot />\n    </Motion>\n    <Motion\n      class=\"box-background absolute inset-0 z-20\"\n      :initial=\"initialSlideVariants\"\n      :while-in-view=\"visibleSlideVariants\"\n      :transition=\"{\n        duration: props.duration,\n        ease: 'easeIn',\n        delay: props.delay,\n      }\"\n    />\n  </div>\n</template>\n\n<style scoped>\n.box-background {\n  background: v-bind(color);\n}\n</style>\n",
      "target": "web"
    },
    {
      "path": "index.ts",
      "content": "export { default as BoxReveal } from \"./BoxReveal.vue\";\n"
    }
  ],
