{
  "name": "hyper-text",
  "title": "超能文字",
  "description": "悬停时快速变化的文字动画。",
  "category": "effect",
  "tags": [
    "css",
    "tailwind",
    "magic-ui"
  ],
  "dependencies": [
    "@vueuse/core",
    "motion-v"
  ],
  "files": [
    {
      "path": "HyperText.vue",
      "content": "<script setup lang=\"ts\">\r\nimport type { HTMLAttributes } from \"vue\";\r\nimport { useIntervalFn } from \"@vueuse/core\";\r\nimport { Motion } from \"motion-v\";\r\nimport { computed, ref, watch } from \"vue\";\r\n\r\nconst props = withDefaults(\r\n  defineProps<{\r\n    class?: HTMLAttributes[\"class\"];\r\n    text: string;\r\n    duration?: number;\r\n    animateOnLoad: boolean;\r\n  }>(),\r\n  {\r\n    duration: 800,\r\n  },\r\n);\r\n\r\nconst alphabets = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\";\r\nconst displayText = ref(props.text.split(\"\"));\r\nconst iterations = ref(0);\r\n\r\nfunction getRandomLetter() {\r\n  return alphabets[Math.floor(Math.random() * alphabets.length)];\r\n}\r\nfunction triggerAnimation() {\r\n  iterations.value = 0;\r\n  startAnimation();\r\n}\r\n\r\nconst { pause, resume } = useIntervalFn(\r\n  () => {\r\n    if (iterations.value < props.text.length) {\r\n      const arr = displayText.value?.map((l, i) =>\r\n        l === \" \" ? l : i <= iterations.value ? props.text[i] : getRandomLetter(),\r\n      );\r\n      displayText.value = (arr ?? []) as string[];\r\n      iterations.value += 0.1;\r\n    } else {\r\n      pause();\r\n    }\r\n  },\r\n  computed(() => props.duration / (props.text.length * 10)),\r\n);\r\n\r\nfunction startAnimation() {\r\n  pause();\r\n  resume();\r\n}\r\n\r\nwatch(\r\n  () => props.text,\r\n  (newText) => {\r\n    displayText.value = newText.split(\"\");\r\n    triggerAnimation();\r\n  },\r\n);\r\n\r\nif (props.animateOnLoad) {\r\n  triggerAnimation();\r\n}\r\n</script>\r\n\r\n<template>\r\n  <div class=\"flex scale-100 cursor-default overflow-hidden py-2\" :class=\"[$props.class]\"\r\n    @mouseenter=\"triggerAnimation\">\r\n    <div class=\"flex\">\r\n      <Motion v-for=\"(letter, i) in displayText\" :key=\"i\" as=\"span\" :class=\"[letter === ' ' ? 'w-3' : '', $props.class]\"\r\n        class=\"inline-block font-mono\" :initial=\"{ opacity: 0, y: -10 }\" :animate=\"{ opacity: 1, y: 0 }\"\r\n        :delay=\"i * (duration / (text.length * 10))\">\r\n        {{ letter.toUpperCase() }}\r\n      </Motion>\r\n    </div>\r\n  </div>\r\n</template>\r\n",
      "target": "web"
    },
    {
      "path": "index.ts",
      "content": "export { default as HyperText } from \"./HyperText.vue\";\r\n"
    }
  ],
  "fileCount": 2,
  "contentHash": "89f6840ee5a5f96c2ec4a6d2c1065bf9990e4821"
}
