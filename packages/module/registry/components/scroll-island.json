{
  "name": "scroll-island",
  "title": "滚动岛",
  "description": "用于以灵动岛样式悬浮显示页面滚动进度并可展开附加内容的组件。",
  "category": "misc",
  "tags": [
    "css",
    "tailwind",
    "number-flow"
  ],
  "dependencies": [
    "@number-flow/vue",
    "@vueuse/core",
    "motion-v"
  ],
  "files": [
    {
      "path": "index.ts",
      "content": "export { default as ScrollIsland } from \"./ScrollIsland.vue\";\n"
    },
    {
      "path": "ScrollIsland.vue",
      "content": "<script lang=\"ts\" setup>\nimport NumberFlow from \"@number-flow/vue\";\nimport { useColorMode } from \"@vueuse/core\";\nimport { motion, MotionConfig } from \"motion-v\";\nimport { computed, onMounted, onUnmounted, ref, useSlots } from \"vue\";\n\ninterface Props {\n  class?: string;\n  title?: string;\n  height?: number;\n}\n\nconst props = withDefaults(defineProps<Props>(), {\n  class: \"\",\n  title: \"Progress\",\n  height: 44,\n});\n\nconst open = ref(false);\nconst slots = useSlots();\n\nconst scrollPercentage = ref(0);\n\nconst isDark = computed(() => useColorMode().value == \"dark\");\nconst isSlotAvailable = computed(() => !!slots.default);\nconst borderRadius = computed(() => `${props.height / 2}px`);\n\nonMounted(() => {\n  if (window === undefined) return;\n\n  window.addEventListener(\"scroll\", updatePageScroll);\n  updatePageScroll();\n});\n\nfunction updatePageScroll() {\n  scrollPercentage.value = window.scrollY / (document.body.scrollHeight - window.innerHeight);\n}\n\nonUnmounted(() => {\n  window.removeEventListener(\"scroll\", updatePageScroll);\n});\n</script>\n\n<template>\n  <MotionConfig :transition=\"{\n    duration: 0.7,\n    type: 'spring',\n    bounce: 0.5,\n  }\">\n    <div class=\"bg-primary/90 border-radius fixed top-12 left-1/2 z-[999] -translate-x-1/2 backdrop-blur-lg\"\n      :class=\"[$props.class]\" @click=\"() => (open = !open)\">\n      <motion.div id=\"motion-id\" layout :initial=\"{\n        height: props.height,\n        width: 0,\n      }\" :animate=\"{\n          height: open && isSlotAvailable ? 'auto' : props.height,\n          width: open && isSlotAvailable ? 320 : 260,\n        }\" class=\"bg-natural-900 text-secondary relative cursor-pointer overflow-hidden\">\n        <header class=\"gray- flex h-11 cursor-pointer items-center gap-2 px-4\">\n          <AnimatedCircularProgressBar :value=\"scrollPercentage * 100\" :min=\"0\" :max=\"100\" :circle-stroke-width=\"10\"\n            class=\"w-6\" :show-percentage=\"false\" :duration=\"0.3\"\n            :gauge-secondary-color=\"isDark ? '#6b728055' : '#6b728099'\"\n            :gauge-primary-color=\"isDark ? 'black' : 'white'\" />\n          <h1 class=\"grow text-center font-bold text-white\">{{ title }}</h1>\n          <NumberFlow :value=\"scrollPercentage\" :format=\"{ style: 'percent' }\" locales=\"en-US\" />\n        </header>\n        <motion.div v-if=\"isSlotAvailable\"\n          class=\"mb-2 flex h-full max-h-60 flex-col gap-1 overflow-y-auto px-4 text-sm\">\n          <slot />\n        </motion.div>\n      </motion.div>\n    </div>\n  </MotionConfig>\n</template>\n\n<style scoped>\n.border-radius {\n  border-radius: v-bind(borderRadius);\n}\n</style>\n",
      "target": "web"
    }
  ],
  "fileCount": 2,
  "contentHash": "3686aab381c8f0bc7eedde774a5f78627069bf29"
}
